<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>x64</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.Controls"/>
        <InternalsVisibleTo Include="Adamantium.UI"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Drag feedback cursors (arrow + green plus, arrow + link arrow): Windows has no IDC_* for either - the shapes
             Explorer draws sit in ole32.dll's resources - so ship .cur files and load them via LoadCursorFromFile.
             Copied next to the app so Cursors.DragCopy/DragLink resolve them at AppContext.BaseDirectory. -->
        <Content Include="Resources\dragcopy.cur">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Resources\draglink.cur">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.ECS\Adamantium.ECS.csproj"/>
        <ProjectReference Include="..\Adamantium.Fonts\Adamantium.Fonts.csproj"/>
        <ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
        <ProjectReference Include="..\Adamantium.Navigation\Adamantium.Navigation.csproj" />
        <ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="obj\**" />
    </ItemGroup>

</Project>
