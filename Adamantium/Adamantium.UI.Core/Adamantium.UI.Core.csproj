<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>x64</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.Controls"/>
        <InternalsVisibleTo Include="Adamantium.UI"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Drag-copy cursor (arrow + green plus): no standard Win32 IDC_COPY exists, so ship a .cur and load it via
             LoadCursorFromFile. Copied next to the app so Cursors.DragCopy can resolve it at AppContext.BaseDirectory. -->
        <Content Include="Resources\dragcopy.cur">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.ECS\Adamantium.ECS.csproj"/>
        <ProjectReference Include="..\Adamantium.Fonts\Adamantium.Fonts.csproj"/>
        <ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
        <ProjectReference Include="..\Adamantium.Navigation\Adamantium.Navigation.csproj" />
        <ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="obj\**" />
    </ItemGroup>

</Project>
