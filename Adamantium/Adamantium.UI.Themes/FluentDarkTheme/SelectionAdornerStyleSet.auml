<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- Designer SELECTION frame: an accent outline plus a small square handle tucked into each corner. The adorner stage
         sizes it to the selected element's bounds; restyle it here. -->
    <Style Selector="SelectionAdorner">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SelectionAdorner">
                    <controls:Grid>
                        <controls:Border BorderThickness="2" CornerRadius="2"
                                         BorderBrush="{ThemeResource AccentFillColorDefault}"/>
                        <controls:Border Width="6" Height="6" Background="{ThemeResource AccentFillColorDefault}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <controls:Border Width="6" Height="6" Background="{ThemeResource AccentFillColorDefault}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <controls:Border Width="6" Height="6" Background="{ThemeResource AccentFillColorDefault}"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <controls:Border Width="6" Height="6" Background="{ThemeResource AccentFillColorDefault}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</StyleSet>
