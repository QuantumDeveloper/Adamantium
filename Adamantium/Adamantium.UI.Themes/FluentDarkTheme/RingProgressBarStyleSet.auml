<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Circular progress gauge: a dim full ring under an accent arc RingProgressBar sweeps to Percentage. The control is
         always square (MeasureOverride), so Center alignment lets arrange settle onto that square. Per the small-styles
         convention each concern is its own <Style>. -->

    <Style Selector="RingProgressBar">
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="RingThickness" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="RingProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RingProgressBar">
                    <Grid>
                        <!-- The ring is a SHAPE, not a stroke: RingThickness leaves a band that thick inward from the
                             outline (Ellipse.RingThickness), and a swept band is an annular sector - a donut slice, which
                             is what a gauge actually is. Drawn as a thick STROKE before, which spent the pen on the shape:
                             the band could carry no outline of its own, and its thickness had to be a stroke width.
                             The outer edge lands in the same place either way - a centred stroke on a box deflated by half
                             its width reaches exactly the bounds, and a band measured inward from the bounds starts there.
                             Sector, because a band's ends are radial whichever closing is asked for (see the cut bake). -->
                        <Ellipse Fill="{ResourceReference ControlFillColorTertiary}"
                                RingThickness="{TemplateBinding RingThickness}"
                                EllipseType="Sector"/>
                        <Ellipse x:Name="PART_Indicator"
                                Fill="{ThemeResource AccentFillColorDefault}"
                                RingThickness="{TemplateBinding RingThickness}"
                                EllipseType="Sector"
                                StartAngle="0"
                                StopAngle="0"
                                RenderTransformOrigin="0.5,0.5"/>
                        <TextBlock x:Name="PART_ValueText"
                                Text="{TemplateBinding ValueText}"
                                Visibility="Collapsed"
                                FontSize="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalTextAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Centre percentage label, opt-in via ShowValueText. -->
    <Style Selector="RingProgressBar">
        <PropertyTrigger Property="ShowValueText" Value="true">
            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
