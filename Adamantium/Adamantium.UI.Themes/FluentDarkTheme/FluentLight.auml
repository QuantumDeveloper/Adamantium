<?xml version="1.0" encoding="utf-8" ?>
<Theme xmlns="http://adamantium/ui"
       xmlns:x="http://adamantium/ui/xaml/extensions"
	   xmlns:fluentDark="clr-namespace:Adamantium.UI.Themes.FluentDarkTheme"
	   Name="FluentLight"
       ResourceContext.Source="{ResourceLink Source={x:Type fluentDark:BrushesLight}, Scope=Theme}">

	<Theme.StyleIncludes>
		<StyleInclude Source="{x:Type fluentDark:TextBlockStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:DropInsertionIndicatorStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:DragHandleStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:SelectionAdornerStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:HoverAdornerStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:FocusAdornerStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:KeyTipAdornerStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:BorderStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:ButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ContentControlStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:RepeatButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ThumbStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ScrollBarStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ScrollViewerStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ZoomBoxStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ToggleButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:CheckBoxStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:RadioButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ToggleSwitchStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:SliderStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:RangeSliderStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:NumericUpDownStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ProgressBarStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:RingProgressBarStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:BusyIndicatorStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ItemsControlStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ListBoxStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ListBoxItemStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:TilesHostStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:FlipTileStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:DropDownStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:DropDownItemStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:TextBoxStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ToolTipStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:TabControlStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:TabItemStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:RibbonStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:SlidePanelStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:OverlayWindowStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:TitleBarStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ResizeGripperStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:WindowStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:MenuStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:TreeViewStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:GridSplitterStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:DockingStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ColorPickerStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ColorPickerButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ColorWheelStyleSet}"/>
	</Theme.StyleIncludes>

	<!-- Accent: ONE seed; the theme derives the ramp + on-accent text colour (see FluentDark.auml). A darker seed here
	     yields white text on checked controls, matching WinUI's light-theme accent. -->
	<Theme.AccentColor><SolidColorBrush Color="#005FB8"/></Theme.AccentColor>
	<Theme.AccentFillColorDisabled><SolidColorBrush Color="#E0E0E0"/></Theme.AccentFillColorDisabled>
	<Theme.FocusStrokeColorOuter><SolidColorBrush Color="#000000"/></Theme.FocusStrokeColorOuter>
	<Theme.FocusStrokeColorInner><SolidColorBrush Color="#FFFFFF"/></Theme.FocusStrokeColorInner>
</Theme>
