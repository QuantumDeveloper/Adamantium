<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns:math="clr-namespace:Adamantium.Mathematics;assembly=Adamantium.Mathematics"
        xmlns="http://adamantium/ui">

    <!-- FluentDark static palette (WinUI dark tokens). Accent/focus are NOT here - they live on the Theme as
         runtime-mutable properties (see FluentDark.auml + {ThemeResource}). Colour syntax: #RRGGBB is opaque,
         #AARRGGBB carries explicit alpha (the translucent "over the layer" fills Fluent is built on). -->

    <!-- Layer / background fills -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBase" Color="#202020"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondary" Color="#1C1C1C"/>
    <!-- Scrim behind a modal/busy overlay: a translucent dimmer over content (theme-independent). -->
    <SolidColorBrush x:Key="SmokeFillColorDefault" Color="#99000000"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiary" Color="#282828"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="LayerFillColorDefault" Color="#4C3A3A3A"/>

    <!-- The tile face. Its OWN token, not ControlFillColorDefault: that one is a control fill designed to sit over the
         window's solid base, and every button/checkbox/toggle uses it there correctly - but a tile sits on the CARD
         surface, and on the light palette the same brush is white-on-white (invisible tiles). Both palettes state it as a
         subtle overlay ON THE CARD: a light veil over a dark card here, a dark one over a white card in the light palette. -->
    <SolidColorBrush x:Key="TileFillColorDefault" Color="#0FFFFFFF"/>

    <!-- Control fills (translucent whites layered over the background) -->
    <SolidColorBrush x:Key="ControlFillColorDefault" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondary" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorTertiary" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorDisabled" Color="#0BFFFFFF"/>

    <!-- Subtle fills (WinUI tokens): hover/press washes for chrome-less items - menu rows, title-bar buttons. These were
         REFERENCED by MenuStyleSet/TitleBarStyleSet but missing from the palette, so those hovers silently never applied
         (a {ResourceReference} that fails to resolve is a silent no-op). -->
    <SolidColorBrush x:Key="SubtleFillColorSecondary" Color="#0FFFFFFF"/>

    <!-- Dock compass. Its own tokens rather than the control ramp's: those are tuned to sit ON the window base, while a
         compass floats over WHATEVER is being docked onto - a document, an image, another panel. A 6%-white control fill
         over that is invisible, which is exactly what it was. Strong plate, clearly drawn edge. -->
    <!-- State layer for a button sitting ON an accent bar (a tool panel's caption). The control ramp is no use there: its
         fills are tuned against the window base, and the accent ramp only darkens the SAME hue by 12/24%, which on a
         28px square over that hue is not visible at all. A translucent overlay reads instantly on any accent - override
         these two if a theme's accent is pale enough to want a dark overlay instead. -->
    <SolidColorBrush x:Key="OnAccentOverlayPointerOver" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="OnAccentOverlayPressed" Color="#73FFFFFF"/>

    <!-- The strip of a PUT-AWAY panel. A folded panel is nothing but its tabs, and without a fill of its own it reads as
         a row of labels floating on the background - there is no way to tell "this panel is put away" from "these are
         just some tabs". Its own token rather than a control fill: it sits against the docking area, not against a
         control, and it has to stay distinguishable from the panels around it in either palette. -->
    <SolidColorBrush x:Key="DockFoldedStripFill" Color="#14FFFFFF"/>

    <SolidColorBrush x:Key="DockCompassFillColor" Color="#E62F2F2F"/>
    <SolidColorBrush x:Key="DockCompassStrokeColor" Color="#59FFFFFF"/>
    <!-- The translucent rectangle showing where the pane would land. Accent-tinted, and translucent on purpose: it covers
         the very content it describes. -->
    <SolidColorBrush x:Key="DockCompassPreviewColor" Color="#592D7FF9"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiary" Color="#0AFFFFFF"/>

    <!-- Control strokes -->
    <SolidColorBrush x:Key="ControlStrokeColorDefault" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondary" Color="#18FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorSecondary" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorTertiary" Color="#87FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorDisabled" Color="#5DFFFFFF"/>

    <!-- Semantic (success / caution / critical) -->
    <SolidColorBrush x:Key="SystemFillColorSuccess" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="SystemFillColorCaution" Color="#FCE100"/>
    <SolidColorBrush x:Key="SystemFillColorCritical" Color="#FF99A4"/>

    <!-- Loading skeleton fill. ONE brush for EVERY loading card of every list (ItemsControlStyleSet's ItemSkeletonTemplate
         paints with it) - deliberately shared, because that is what makes a screenful of cards cost ONE pulse animation
         instead of one per card. Its Opacity is what breathes (the PulseAnimation in ItemsControlStyleSet drives it
         between the rest value here and its Max); the colour stays put. -->
    <SolidColorBrush x:Key="SkeletonPulseFill" Color="#FFFFFF" Opacity="0.05"/>

    <!-- Shimmer indicator. The TRACK is the card; the sliding highlight band's PEAK is a themed Color (a gradient stop now
         takes a {ResourceReference} - see ResourceResolver.SetDeferred). Here (dark) the peak is a WHITE glare over a dark
         card; the light palette inverts it to a DARK sweep, which is what actually reads on a light surface. -->
    <SolidColorBrush x:Key="ShimmerTrackFill" Color="#14FFFFFF"/>
    <math:Color x:Key="ShimmerPeakColor">#99FFFFFF</math:Color>
    <!-- The track as a COLOUR as well as a brush: the card is now painted by ONE gradient whose flanks are the track, so
         the flanking stops need a colour. Keep the two in step - they are the same surface. -->
    <math:Color x:Key="ShimmerTrackColor">#14FFFFFF</math:Color>

</ResourceDictionary>
