<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- OverlayWindow: a draggable in-window "child window" (analog of MahApps SimpleChildWindow). The template is the chrome
         card - Border(PART_Window) > accent title bar (PART_TitleThumb is a transparent Grid over the icon+title that starts
         the drag; PART_PinButton toggles always-on-top; PART_CloseButton closes) + PART_ContentPresenter + PART_ResizeGrip.
         The overlay, dim scrim, cascade, z-order (pinned on top) and Escape/overlay dismissal are owned by the
         OverlayWindowManager. Per the small-styles convention: properties, template, triggers. -->

    <Style Selector="OverlayWindow">
        <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="OverlayBrush" Value="{ResourceReference SmokeFillColorDefault}"/>
        <Setter Property="TitleBarBackground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="TitleForeground" Value="{ThemeResource AccentForegroundColor}"/>
        <!-- Sized to content and centred on the overlay; the manager then offsets/drags it via the popup. -->
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="OverlayWindow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="OverlayWindow">
                    <Border x:Name="PART_Window"
                            MinWidth="300"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">

                            <!-- Title bar: PART_TitleThumb (transparent, hit-testable) drags the whole strip; pin + close sit
                                 in their own columns so they stay clickable. -->
                            <Grid x:Name="PART_TitleBar" Grid.Row="0" ColumnDefinitions="*,Auto,Auto"
                                    Background="{TemplateBinding TitleBarBackground}" Height="40">
                                <Grid x:Name="PART_TitleThumb" Grid.Column="0" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}"
                                                Foreground="{TemplateBinding TitleForeground}"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ContentPresenter x:Name="PART_Title" Content="{TemplateBinding Title}"
                                                Foreground="{TemplateBinding TitleForeground}" FontSize="15"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="PART_PinButton" Grid.Column="1" Visibility="Collapsed"
                                        Classes="CaptionButton" Height="40" MinWidth="46" VerticalAlignment="Stretch">
                                    <!-- Thumbtack, symmetric about x=7: cap (5..9), flared shoulders (3..11), tapering neck
                                         (6..8), point at (7,12) - the classic push-pin silhouette. -->
                                    <Path x:Name="PinGlyph"
                                            Data="M5,2 L9,2 L9,4 L11,6 L11,7 L8,7 L8,10 L7,12 L6,10 L6,7 L3,7 L3,6 L5,4 Z"
                                            Stroke="{TemplateBinding TitleForeground}" StrokeThickness="1" Fill="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Button x:Name="PART_CloseButton" Grid.Column="2"
                                        Classes="CaptionButton CloseButton" Height="40" MinWidth="46"
                                        VerticalAlignment="Stretch">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                                            Stroke="{TemplateBinding TitleForeground}" StrokeThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    Margin="{TemplateBinding Padding}"/>

                            <!-- Resize grip: the shared ResizeGripper control (dotted-triangle visual + hit box, dots in the
                                 corner so the cursor sits right on them). PublishToWindow=False: this is an in-window card,
                                 not the OS window, so it must NOT drive the native window resize - OverlayWindow resizes
                                 itself with a managed drag. -->
                            <ResizeGripper x:Name="PART_ResizeGrip" Grid.Row="1" Visibility="Collapsed"
                                    PublishToWindow="False" Width="18" Height="18"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="OverlayWindow">
        <PropertyTrigger Property="CanClose" Value="false">
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanPin" Value="true">
            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanResize" Value="true">
            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- Pinned = filled pin glyph. -->
        <PropertyTrigger Property="IsPinned" Value="true">
            <Setter TargetName="PinGlyph" Property="Fill" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowTitleBar" Value="false">
            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Inactive (not the front-most window): dim the title bar like an inactive OS window. Overrides the window's own
             TitleBarBackground/TitleForeground, which the bar, title, icon and pin/close glyphs all bind to. -->
        <PropertyTrigger Property="IsActive" Value="false">
            <Setter Property="TitleBarBackground" Value="{ResourceReference ControlFillColorSecondary}"/>
            <Setter Property="TitleForeground" Value="{ResourceReference TextFillColorSecondary}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
