<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ItemsControl: a Border around a ScrollViewer that hosts the items. CanContentScroll=true so the ScrollViewer
         delegates scrolling to the virtualizing items panel (item scrolling, not pixel translation). PART_ItemsPresenter
         is the items host; its panel comes from ItemsPanel (default = a vertical virtualizing StackPanel). Per the
         small-styles convention this is just the template. -->
    <Style Selector="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                               HorizontalScrollBarVisibility="Disabled"
                                               VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Loading skeleton CARD (theme-authored): one is shown PER budget-deferred slot by a virtualizing panel while a big
         cold fill / fast fling outruns the per-frame bind budget - the classic per-item skeleton look. A muted rounded card
         that gently BREATHES, hit-transparent so clicks fall through to real tiles. Cards are pooled and reused by the
         panel, which positions them and shows/hides them as slots enter/leave the pending set. No C# owns the look.
         The card paints with the SHARED {SkeletonPulseFill} brush (the palette's, one instance for every card of every
         list) rather than a private brush per card: the breathe is then ONE animation on ONE brush, not one per card -
         and one brush-change fan-out per frame instead of thousands (a screenful can be 4000+ cards; per-card pulses cost
         ~140 ms/frame of animation tick alone). {ObservableResource} (not {ResourceReference}) so a live theme swap
         re-points the pooled cards at the new palette's brush - the one the pulse then runs on. -->
    <!-- The hole a drag opens at its insertion point. Reads as an OUTLINE, not as a filled card: a dashed accent frame
         around empty space says "what you are holding goes here", where the skeleton's filled pulsing plate says
         "content is loading". Keeping them visually distinct matters most when both are on screen at once - dropping
         into a list that is still filling. -->
    <Style Selector="ItemsControl">
        <Setter Property="DropPlaceholderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- A Shape, not a Border: the dashes live on Shape.StrokeDashArray. -->
                    <Rectangle IsHitTestVisible="False" Fill="Transparent" StrokeThickness="2"
                                        StrokeDashArray="4,3"
                                        Stroke="{ThemeResource AccentFillColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ItemsControl">
        <Setter Property="ItemSkeletonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- No margin here: the PANEL insets the card by the REAL item's margin (read from a realized tile) so
                         cards line up exactly with the real tiles and keep the same inter-tile gaps for any list. A faint
                         static border outlines the card even at the pulse's low point. -->
                    <Border CornerRadius="4" BorderThickness="1" IsHitTestVisible="False"
                                     Background="{ObservableResource SkeletonPulseFill}">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FFFFFFFF" Opacity="0.10"/>
                        </Border.BorderBrush>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The skeleton BREATHE (its own style). The pulse belongs to the LIST, not to a card: IsLoadingItems is true exactly
         while the panel is showing skeleton cards, so one EnterAction starts the prebuilt PulseAnimation (a baked Min<->Max
         loop) on the shared skeleton brush's Opacity and one ExitAction stops it once the last card is recycled. Every card
         re-renders from its brush-change subscription, so they all breathe in step. TargetName resolves a keyed RESOURCE
         here (no template part by that name) - which is exactly how a trigger reaches a deliberately shared brush. A
         second list loading at the same time RETAINS the same brush, so whichever finishes first doesn't stop the other's
         pulse (AnimationManager.Retain/Release). -->
    <Style Selector="ItemsControl">
        <PropertyTrigger Property="IsLoadingItems" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="SkeletonPulseFill">
                    <PulseAnimation Property="Opacity" Min="0.05" Max="0.15" Duration="0:0:1.2" Easing="CubicInOut"/>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="SkeletonPulseFill"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

</StyleSet>
