<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- FlipTile: custom-rendered (draws its front/back in OnRender, no ControlTemplate), so the theme can only seed
         its properties. FrontBrush is the tile face shown until it flips - a subtle veil over the board's card
         background, the WinUI tile look. A tile item that binds FrontBrush (e.g. to its own colour) overrides this
         default, since a Style setter sits below a {Binding} in priority.

         TileFillColorDefault, not ControlFillColorDefault: the latter is a fill for a control sitting on the window's
         solid base, and on the LIGHT palette it is a 70%-white - white-on-white once a tile puts it on the card, i.e.
         invisible tiles. The tile face is its own palette token, defined per theme against the CARD surface. -->
    <Style Selector="FlipTile">
        <Setter Property="FrontBrush" Value="{ResourceReference TileFillColorDefault}"/>
    </Style>

</StyleSet>
