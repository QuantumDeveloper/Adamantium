<?xml version="1.0" encoding="utf-8"?>
<StyleSet
        xmlns="http://adamantium/ui"
        xmlns:local="http://adamantium/ui">
    <Style Selector="Border">
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
</StyleSet>