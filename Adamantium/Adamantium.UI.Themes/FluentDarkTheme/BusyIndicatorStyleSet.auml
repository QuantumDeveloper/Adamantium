<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- The loading-indicator pack. The BusyIndicator control has NO look of its own - only IsActive - so every indicator
         here is purely a theme template, selected by class (<BusyIndicator Classes="Dots"/>), the same way ProgressBar.Ring
         picks its circular look. A new indicator is a new <Style>, not a new enum value in the engine, and an app can add
         its own the same way.

         Each look starts its animation on an IsActive trigger and STOPS it on the way out: these loops never end by
         themselves (IterationCount="Infinity"), so without the ExitAction a hidden indicator would keep animating - and a
         looping animation on a detached element is a leak. Per the small-styles convention, one <Style> per concern. -->

    <!-- ============================== Ring (default): a sweeping arc, spinning ============================== -->
    <Style Selector="BusyIndicator">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <controls:Grid>
                        <!-- The dim full ring the arc travels over. -->
                        <controls:Ellipse Stroke="{ResourceReference ControlFillColorTertiary}"
                                          StrokeThickness="4"
                                          Fill="Transparent"
                                          EllipseType="EdgeToEdge"/>
                        <!-- The accent arc; it is the ARC that spins. RenderTransformOrigin is a FRACTION of the element's
                             own size, so the arc turns about its centre at ANY size the control is given - an absolute
                             pixel centre would be correct only at the one size this template happened to be written for. -->
                        <controls:Ellipse Stroke="{ThemeResource AccentFillColorDefault}"
                                          StrokeThickness="4"
                                          Fill="Transparent"
                                          EllipseType="EdgeToEdge"
                                          StartAngle="0"
                                          StopAngle="90"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="RingSpin"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="BusyIndicator">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="RingSpin">
                    <Animation Duration="0:0:1.1" IterationCount="Infinity">
                        <KeyFrame Cue="0"><Setter Property="RotationAngle" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="RotationAngle" Value="360"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="RingSpin"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Dots: three dots breathing in sequence ============================== -->
    <Style Selector="BusyIndicator.Dots">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <controls:StackPanel Orientation="Horizontal">
                        <controls:Ellipse Width="10" Height="10" Margin="3,0"
                                          Fill="{ThemeResource AccentFillColorDefault}"
                                          EllipseType="EdgeToEdge"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="Dot1"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                        <controls:Ellipse Width="10" Height="10" Margin="3,0"
                                          Fill="{ThemeResource AccentFillColorDefault}"
                                          EllipseType="EdgeToEdge"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="Dot2"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                        <controls:Ellipse Width="10" Height="10" Margin="3,0"
                                          Fill="{ThemeResource AccentFillColorDefault}"
                                          EllipseType="EdgeToEdge"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="Dot3"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                    </controls:StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The wave is ONE animation played by three dots at three Delays - that is what makes it read as a travelling wave
         rather than three things blinking. Scale, not opacity: a scaled dot keeps its colour and the motion stays legible
         on any background. -->
    <Style Selector="BusyIndicator.Dots">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="Dot1">
                    <Animation Duration="0:0:0.6" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleX" Value="0.5"/><Setter Property="ScaleY" Value="0.5"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Dot2">
                    <Animation Duration="0:0:0.6" Delay="0:0:0.15" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleX" Value="0.5"/><Setter Property="ScaleY" Value="0.5"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Dot3">
                    <Animation Duration="0:0:0.6" Delay="0:0:0.3" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleX" Value="0.5"/><Setter Property="ScaleY" Value="0.5"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="Dot1"/>
                <StopAnimationAction TargetName="Dot2"/>
                <StopAnimationAction TargetName="Dot3"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Bar: an indeterminate sweep along a track ============================== -->
    <Style Selector="BusyIndicator.Bar">
        <Setter Property="Width" Value="160"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <!-- ClipToBounds is what makes it a SWEEP and not a stripe wandering across the page: the pill runs
                         from off the left edge to off the right one and the track hides it outside itself. -->
                    <controls:Border Background="{ResourceReference ControlFillColorTertiary}"
                                     CornerRadius="2"
                                     ClipToBounds="True">
                        <controls:Border x:Name="BarPill"
                                         Width="56" Height="4" CornerRadius="2"
                                         HorizontalAlignment="Left"
                                         Background="{ThemeResource AccentFillColorDefault}">
                            <controls:Border.RenderTransform>
                                <Transform x:Name="BarSlide" TranslateX="-56"/>
                            </controls:Border.RenderTransform>
                        </controls:Border>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="BusyIndicator.Bar">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="BarSlide">
                    <Animation Duration="0:0:1.4" IterationCount="Infinity" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="TranslateX" Value="-56"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="TranslateX" Value="160"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="BarSlide"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Ripple: two rings expanding out of the centre ============================== -->
    <Style Selector="BusyIndicator.Ripple">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <controls:Grid>
                        <controls:Ellipse x:Name="Ripple1"
                                          Stroke="{ThemeResource AccentFillColorDefault}"
                                          StrokeThickness="3"
                                          Fill="Transparent"
                                          EllipseType="EdgeToEdge"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="RippleScale1" ScaleX="0.2" ScaleY="0.2"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                        <controls:Ellipse x:Name="Ripple2"
                                          Stroke="{ThemeResource AccentFillColorDefault}"
                                          StrokeThickness="3"
                                          Fill="Transparent"
                                          EllipseType="EdgeToEdge"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="RippleScale2" ScaleX="0.2" ScaleY="0.2"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two rings, half a period apart, each growing while it fades - so one is always arriving as the other dies. The
         fade is on the ELEMENT (Opacity) and the growth on its transform, which is why each ring needs both actions. -->
    <Style Selector="BusyIndicator.Ripple">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="RippleScale1">
                    <Animation Duration="0:0:1.6" IterationCount="Infinity" Easing="CubicOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleX" Value="0.2"/><Setter Property="ScaleY" Value="0.2"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Ripple1">
                    <Animation Duration="0:0:1.6" IterationCount="Infinity">
                        <KeyFrame Cue="0"><Setter Property="Opacity" Value="0.9"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="RippleScale2">
                    <Animation Duration="0:0:1.6" Delay="0:0:0.8" IterationCount="Infinity" Easing="CubicOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleX" Value="0.2"/><Setter Property="ScaleY" Value="0.2"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Ripple2">
                    <Animation Duration="0:0:1.6" Delay="0:0:0.8" IterationCount="Infinity">
                        <KeyFrame Cue="0"><Setter Property="Opacity" Value="0.9"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="RippleScale1"/>
                <StopAnimationAction TargetName="Ripple1"/>
                <StopAnimationAction TargetName="RippleScale2"/>
                <StopAnimationAction TargetName="Ripple2"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Arc: the arc itself grows and shrinks while it spins ============================== -->
    <Style Selector="BusyIndicator.Arc">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <controls:Ellipse x:Name="ArcStroke"
                                      Stroke="{ThemeResource AccentFillColorDefault}"
                                      StrokeThickness="4"
                                      StartLineCap="ConvexRound"
                                      EndLineCap="ConvexRound"
                                      Fill="Transparent"
                                      EllipseType="EdgeToEdge"
                                      StrokeTrimStart="0"
                                      StrokeTrimEnd="0.1"
                                      RenderTransformOrigin="0.5,0.5">
                        <controls:Ellipse.RenderTransform>
                            <Transform x:Name="ArcSpin"/>
                        </controls:Ellipse.RenderTransform>
                    </controls:Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two independent loops on the SAME ring: a steady spin, and the arc's LENGTH breathing (stroke trim). Because the
         two have different periods they never line up, so the thing never looks like it is repeating - that is the whole
         trick of the Material spinner. AutoReverse on the trim means the arc retracts the way it grew: no seam at the loop
         boundary, which a one-way 0->1 trim would show as a jump. -->
    <Style Selector="BusyIndicator.Arc">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="ArcSpin">
                    <Animation Duration="0:0:1.3" IterationCount="Infinity">
                        <KeyFrame Cue="0"><Setter Property="RotationAngle" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="RotationAngle" Value="360"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="ArcStroke">
                    <Animation Duration="0:0:0.9" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="StrokeTrimEnd" Value="0.08"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="StrokeTrimEnd" Value="0.85"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="ArcSpin"/>
                <StopAnimationAction TargetName="ArcStroke"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Ants: a dashed ring whose dashes march ============================== -->
    <Style Selector="BusyIndicator.Ants">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <!-- Nothing here rotates: the dashes travel ALONG the contour (StrokeDashOffset), which is a different
                         motion from a spin - the ring stands still and the pattern flows through it. -->
                    <!-- A RECTANGLE, not a ring, and that is the whole effect rather than a styling preference: on a
                         circle "the dashes travel along the contour" and "the dashed ring spins" are the SAME motion -
                         nothing can tell them apart, so the marching reads as a spin (which the Ring class already is).
                         Straight runs and corners are what make it legible, which is also why every selection marquee
                         this effect is named after is rectangular.
                         The numbers are in pixels (the array is not scaled by thickness): a dash must be longer than the
                         stroke is thick or it reads as a dot, and a ROUND dash cap adds half the thickness at each end,
                         fattening the dash and eating the gap. Flat caps, dash a little shorter than the gap. -->
                    <controls:Rectangle x:Name="AntsRing"
                                        CornerRadius="2"
                                        Stroke="{ThemeResource AccentFillColorDefault}"
                                        StrokeThickness="3"
                                        StrokeDashArray="5 7"
                                        StrokeDashCap="Flat"
                                        StrokeDashFit="True"
                                        StrokeDashOffset="0"
                                        Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StrokeDashPhase is measured in PERIODS, so 0 -> 1 is exactly one step of the pattern and the loop is seamless by
         construction - no adding up the dash array here, and nothing to re-derive when the pattern changes. -->
    <Style Selector="BusyIndicator.Ants">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="AntsRing">
                    <!-- One period every third of a second: slower than this and the eye has nothing to lock onto, since
                         every dash looks like every other and only the SPEED says which way the pattern is going. -->
                    <Animation Duration="0:0:0.33" IterationCount="Infinity">
                        <KeyFrame Cue="0"><Setter Property="StrokeDashPhase" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="StrokeDashPhase" Value="1"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="AntsRing"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Shimmer: a light band sweeping across a card ============================== -->
    <Style Selector="BusyIndicator.Shimmer">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <!-- ONE rounded card, painted by ONE gradient whose stops travel. Not a band sliding inside a clipping
                         Grid, which is what this used to be: the clip is RECTANGULAR (it knows nothing about CornerRadius),
                         so as the band reached an end it filled the card's rounded corner square while the other end stayed
                         round. With a single shape there is nothing to clip and the rounding is the card's own - the bug
                         cannot come back. See docs/TECH_DEBT.md for the clip gap itself, which is still open.
                         The colours are themed resources (a white glare on dark, a dark sweep on light); a gradient STOP
                         takes a resource reference just like an element property. -->
                    <controls:Rectangle CornerRadius="6" Stroke="Transparent">
                        <controls:Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="ShimmerLead" Color="{ResourceReference ShimmerTrackColor}" Offset="0"/>
                                <GradientStop x:Name="ShimmerPeak" Color="{ResourceReference ShimmerPeakColor}" Offset="0.15"/>
                                <GradientStop x:Name="ShimmerTrail" Color="{ResourceReference ShimmerTrackColor}" Offset="0.3"/>
                            </LinearGradientBrush>
                        </controls:Rectangle.Fill>
                    </controls:Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The three stops travel together, keeping the 0.3-wide highlight rigid as it crosses. They stay INSIDE 0..1 for the
         whole sweep on purpose: gradient offsets are clamped to that range, so a stop that ran past an edge would stall
         there and the glare would pile up in the corner instead of gliding. AutoReverse so it comes back rather than
         snapping to the left edge each loop. Offset is a PAINT property - measured as the channel that costs nothing. -->
    <Style Selector="BusyIndicator.Shimmer">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="ShimmerLead">
                    <Animation Duration="0:0:2.0" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="Offset" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="Offset" Value="0.7"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="ShimmerPeak">
                    <Animation Duration="0:0:2.0" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="Offset" Value="0.15"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="Offset" Value="0.85"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="ShimmerTrail">
                    <Animation Duration="0:0:2.0" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="Offset" Value="0.3"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="Offset" Value="1"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="ShimmerLead"/>
                <StopAnimationAction TargetName="ShimmerPeak"/>
                <StopAnimationAction TargetName="ShimmerTrail"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Flip: three cards turning in perspective (real 3D) ============================== -->
    <Style Selector="BusyIndicator.Flip">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <controls:StackPanel Orientation="Horizontal">
                        <!-- Perspective is what makes this a FLIP and not a horizontal squash: without the depth
                             foreshortening a Y-rotation is just a width scale. Origin at the centre so each card turns
                             about its own middle. -->
                        <controls:Border Width="18" Height="26" Margin="4,0" CornerRadius="3"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,0.5">
                            <controls:Border.RenderTransform>
                                <Transform x:Name="Flip1" Perspective="240"/>
                            </controls:Border.RenderTransform>
                        </controls:Border>
                        <controls:Border Width="18" Height="26" Margin="4,0" CornerRadius="3"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,0.5">
                            <controls:Border.RenderTransform>
                                <Transform x:Name="Flip2" Perspective="240"/>
                            </controls:Border.RenderTransform>
                        </controls:Border>
                        <controls:Border Width="18" Height="26" Margin="4,0" CornerRadius="3"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,0.5">
                            <controls:Border.RenderTransform>
                                <Transform x:Name="Flip3" Perspective="240"/>
                            </controls:Border.RenderTransform>
                        </controls:Border>
                    </controls:StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="BusyIndicator.Flip">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="Flip1">
                    <Animation Duration="0:0:1.2" IterationCount="Infinity" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="RotationY" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="RotationY" Value="360"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Flip2">
                    <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="Infinity" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="RotationY" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="RotationY" Value="360"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Flip3">
                    <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="Infinity" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="RotationY" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="RotationY" Value="360"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="Flip1"/>
                <StopAnimationAction TargetName="Flip2"/>
                <StopAnimationAction TargetName="Flip3"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Equalizer: five bars dancing ============================== -->
    <Style Selector="BusyIndicator.Equalizer">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <!-- Origin at the BOTTOM centre (0.5,1): a bar must grow UPWARD out of the floor, not out of its own
                         middle - with a centred origin it would stretch both ways and the row would have no baseline. -->
                    <controls:StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <controls:Border Width="5" Height="28" Margin="2,0" CornerRadius="2"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,1">
                            <controls:Border.RenderTransform><Transform x:Name="Eq1" ScaleY="0.3"/></controls:Border.RenderTransform>
                        </controls:Border>
                        <controls:Border Width="5" Height="28" Margin="2,0" CornerRadius="2"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,1">
                            <controls:Border.RenderTransform><Transform x:Name="Eq2" ScaleY="0.3"/></controls:Border.RenderTransform>
                        </controls:Border>
                        <controls:Border Width="5" Height="28" Margin="2,0" CornerRadius="2"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,1">
                            <controls:Border.RenderTransform><Transform x:Name="Eq3" ScaleY="0.3"/></controls:Border.RenderTransform>
                        </controls:Border>
                        <controls:Border Width="5" Height="28" Margin="2,0" CornerRadius="2"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,1">
                            <controls:Border.RenderTransform><Transform x:Name="Eq4" ScaleY="0.3"/></controls:Border.RenderTransform>
                        </controls:Border>
                        <controls:Border Width="5" Height="28" Margin="2,0" CornerRadius="2"
                                         Background="{ThemeResource AccentFillColorDefault}"
                                         RenderTransformOrigin="0.5,1">
                            <controls:Border.RenderTransform><Transform x:Name="Eq5" ScaleY="0.3"/></controls:Border.RenderTransform>
                        </controls:Border>
                    </controls:StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deliberately MISMATCHED durations, not just staggered delays: bars on the same period would lock into a visible
         marching pattern, while different periods keep drifting in and out of phase - which is what makes it look alive. -->
    <Style Selector="BusyIndicator.Equalizer">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="Eq1">
                    <Animation Duration="0:0:0.50" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleY" Value="0.25"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Eq2">
                    <Animation Duration="0:0:0.68" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleY" Value="0.9"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleY" Value="0.3"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Eq3">
                    <Animation Duration="0:0:0.42" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleY" Value="0.35"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Eq4">
                    <Animation Duration="0:0:0.75" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleY" Value="0.28"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="Eq5">
                    <Animation Duration="0:0:0.58" IterationCount="Infinity" AutoReverse="True" Easing="CubicInOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleY" Value="0.3"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleY" Value="0.95"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="Eq1"/>
                <StopAnimationAction TargetName="Eq2"/>
                <StopAnimationAction TargetName="Eq3"/>
                <StopAnimationAction TargetName="Eq4"/>
                <StopAnimationAction TargetName="Eq5"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

    <!-- ============================== Heartbeat: a double beat, then rest ============================== -->
    <Style Selector="BusyIndicator.Heartbeat">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <controls:Grid>
                        <controls:Ellipse x:Name="BeatHalo"
                                          Fill="{ThemeResource AccentFillColorDefault}"
                                          Opacity="0.25"
                                          EllipseType="EdgeToEdge"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="BeatHaloScale" ScaleX="0.6" ScaleY="0.6"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                        <controls:Ellipse Width="20" Height="20"
                                          Fill="{ThemeResource AccentFillColorDefault}"
                                          EllipseType="EdgeToEdge"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                            <controls:Ellipse.RenderTransform>
                                <Transform x:Name="BeatCore"/>
                            </controls:Ellipse.RenderTransform>
                        </controls:Ellipse>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The reason this reads as a HEARTBEAT and not a pulse is the shape of the curve, not its speed: two quick beats
         (cues 0.10 and 0.28) and then a long rest for the remaining ~70% of the period. A two-keyframe sine would just
         breathe. The halo expands and fades on the same beat, like the pressure wave. -->
    <Style Selector="BusyIndicator.Heartbeat">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="BeatCore">
                    <Animation Duration="0:0:1.4" IterationCount="Infinity" Easing="CubicOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                        <KeyFrame Cue="0.10"><Setter Property="ScaleX" Value="1.35"/><Setter Property="ScaleY" Value="1.35"/></KeyFrame>
                        <KeyFrame Cue="0.20"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                        <KeyFrame Cue="0.28"><Setter Property="ScaleX" Value="1.25"/><Setter Property="ScaleY" Value="1.25"/></KeyFrame>
                        <KeyFrame Cue="0.40"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="BeatHaloScale">
                    <Animation Duration="0:0:1.4" IterationCount="Infinity" Easing="CubicOut">
                        <KeyFrame Cue="0"><Setter Property="ScaleX" Value="0.6"/><Setter Property="ScaleY" Value="0.6"/></KeyFrame>
                        <KeyFrame Cue="0.40"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="ScaleX" Value="1.0"/><Setter Property="ScaleY" Value="1.0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="BeatHalo">
                    <Animation Duration="0:0:1.4" IterationCount="Infinity" Easing="CubicOut">
                        <KeyFrame Cue="0"><Setter Property="Opacity" Value="0.30"/></KeyFrame>
                        <KeyFrame Cue="0.40"><Setter Property="Opacity" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="BeatCore"/>
                <StopAnimationAction TargetName="BeatHaloScale"/>
                <StopAnimationAction TargetName="BeatHalo"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

</StyleSet>
