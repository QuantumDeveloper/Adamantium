<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- ScrollViewer: a content host with two OVERLAY scrollbars (Fluent-style, no arrow buttons). The content
         presenter fills the whole area and scrolls UNDER the bars; the bars float on the right / bottom edges and
         show themselves only when that axis overflows (Auto). Pointer-leave auto-hide is layered on in a later pass.
         One template, per the small-styles convention. -->
    <Style Selector="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <controls:Grid>
                        <controls:ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <controls:ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"/>
                        <controls:ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"/>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
