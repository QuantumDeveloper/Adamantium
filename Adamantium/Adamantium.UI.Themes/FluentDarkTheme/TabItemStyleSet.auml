<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- TabItem: ONE template; rest/hover/selected brushes live as properties and the triggers project them onto the
         chrome via {TemplateBinding}. Colors come from the palette/theme via {ResourceReference}/{ThemeResource} so a
         theme or accent swap restyles them live. Per the small-styles convention: simple properties, template, triggers. -->

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorSecondary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference ControlFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="ForegroundSelected" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4 4 0 0"/>
        <Setter Property="Padding" Value="12 6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- What marks the tab, drawn from DATA by IconTemplate. Nothing is reserved when there is no
                                 icon: an empty presenter measures to nothing, so a tab without one is unchanged. -->
                            <ContentPresenter x:Name="PART_Icon"
                                    VerticalAlignment="Center"
                                    Margin="0 0 6 0"
                                    Content="{TemplateBinding Icon}"
                                    ContentTemplate="{TemplateBinding IconTemplate}"/>
                            <ContentPresenter
                                    x:Name="PART_ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"/>
                            <!-- The close button; its LOOK is CloseButtonTemplate (a themed 'x' from TabControlStyleSet).
                                 Collapsed unless the owner turns close buttons on (see the ShowCloseButton trigger). -->
                            <Button x:Name="PART_CloseButton"
                                    Template="{TemplateBinding CloseButtonTemplate}"
                                    Margin="8 0 0 0"
                                    MinWidth="0" MinHeight="0" Padding="0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TabItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="TabBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="TabBorder" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </PropertyTrigger>
        <!-- Close button reveals on hover (and stays on the selected tab, like a browser/WinUI tab), but only when the
             owner enabled it and this tab is closable (TabItem folds both into ShowCloseButton). Off = Collapsed (no
             space); on-but-idle = Hidden (RESERVES space so the tab width doesn't jump when it reveals); on+hover/selected
             = Visible. Later triggers win on the value stack, so hover/selected override the reserved Hidden. -->
        <PropertyTrigger Property="ShowCloseButton" Value="true">
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowCloseButton" Value="true"/>
                <Condition Property="IsMouseOver" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowCloseButton" Value="true"/>
                <Condition Property="IsSelected" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
    </Style>

</StyleSet>
