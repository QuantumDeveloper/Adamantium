<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- Default Thumb visual: a rounded fill that the Track sizes/positions. Used by the ScrollBar (the Slider supplies
         its own round accent thumb inline, so this only affects the scrollbar). Rounded is fine here: the thumb sits
         INSIDE the (square) trough, so its corners are over the trough fill, not over the scrolled content - no corner
         show-through. Split per the small-styles convention: one style for the template. -->
    <Style Selector="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <controls:Border CornerRadius="4"
                                     Background="{ResourceReference TextFillColorTertiary}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
