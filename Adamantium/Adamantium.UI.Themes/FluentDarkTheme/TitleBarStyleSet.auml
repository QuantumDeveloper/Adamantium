<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- TitleBar: the custom-chrome caption. A draggable caption area (icon + title) on the left and the
         minimize / maximize-restore / close buttons on the right. The control resolves the window it is hosted in and
         drives DragMove / Minimize / ToggleMaximizeRestore / Close; the template just wires the named parts. Per the
         small-styles convention: properties, then template. -->

    <Style Selector="TitleBar">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <!-- A standalone TitleBar's own height. Inside a Window the template binds it to Window.TitleBarHeight, which
             wins over this - the window is the one that has to know how tall its caption is. -->
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TitleBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TitleBar">
                    <Grid Background="{TemplateBinding Background}" ColumnDefinitions="Auto,Auto,*,Auto">

                        <!-- A neutral slot before everything else: a quick-access bar, a search box, whatever the
                             application puts there. -->
                        <ContentPresenter x:Name="PART_LeadingContent" Grid.Column="0"
                                Content="{TemplateBinding LeadingContent}"
                                VerticalAlignment="Center"/>

                        <!-- LEFT commands: interactive, sit before the drag area (so they stay clickable). -->
                        <ItemsControl Grid.Column="1" ItemsSource="{TemplateBinding LeftWindowCommands}"
                                VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="CaptionButton" VerticalAlignment="Stretch"
                                            ToolTip="{Binding ToolTip}"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding CommandParameter}">
                                        <!-- {Ancestor} walks the visual tree up to the hosting TitleBar and binds its LIVE
                                             Foreground, so a command icon follows the SAME active/inactive colour as the
                                             title text + window buttons (and re-resolves if the tree rebuilds). -->
                                        <Path Data="{Binding Icon}"
                                                Stroke="{Ancestor TitleBar, Foreground}" StrokeThickness="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- THE draggable zone: icon + title, fills the middle `*` column. Transparent = invisible but fully
                             hit-testable (hit-testing is decoupled from Background in this engine), so the whole strip drags.
                             Clips so a long title doesn't spill onto the commands. The command columns (0 and 2) sit outside
                             this element, so their buttons stay clickable; the drag is initiated from managed input here
                             (see TitleBar), which respects z-order so overlays on top keep their clicks. -->
                        <Grid x:Name="PART_DragArea" Grid.Column="2" Background="Transparent" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="{TemplateBinding TitleAlignment}" Margin="12,0,0,0">
                                <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}"
                                        Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- RIGHT zone (interactive): right commands + "..." overflow menu + the window buttons. -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <ItemsControl ItemsSource="{TemplateBinding RightWindowCommands}" VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="CaptionButton" VerticalAlignment="Stretch"
                                                ToolTip="{Binding ToolTip}"
                                                Command="{Binding Command}"
                                                CommandParameter="{Binding CommandParameter}">
                                            <Path Data="{Binding Icon}"
                                                    Stroke="{Ancestor TitleBar, Foreground}" StrokeThickness="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Drops a list, so the second press has to put it away - but a Button, not a ToggleButton:
                                 Button.CaptionButton would not name a ToggleButton (they are siblings under ButtonBase)
                                 and it would fall back to the default toggle look. The open state is the menu's. -->
                            <Button x:Name="PART_RightOverflowButton" Classes="CaptionButton" VerticalAlignment="Stretch">
                                <Path Data="M0,4 L2,4 L2,6 L0,6 Z M4,4 L6,4 L6,6 L4,6 Z M8,4 L10,4 L10,6 L8,6 Z"
                                        Fill="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <ContextMenu x:Name="PART_RightOverflowMenu" ItemsSource="{TemplateBinding RightWindowCommands}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <MenuItem Header="{Binding OverflowLabel}"
                                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}">
                                            <MenuItem.Icon>
                                                <!-- The ROW's foreground: a popup is a detached subtree, so {Ancestor}
                                                     cannot reach the TitleBar from here. -->
                                                <Path Data="{Binding Icon}"
                                                        Stroke="{Ancestor MenuItem, Foreground}"
                                                        StrokeThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                            </ContextMenu>

                            <!-- Window buttons. Flat caption buttons (Button.CaptionButton); close highlights red. VECTOR Path
                                 icons (SVG Data + Stroke), NOT font glyphs - crisp and font-independent.
                                 Focusable is stated HERE as well as in the class style: a value set on a template PART
                                 wins over a style setter, so this is the one that is guaranteed to hold. Without it a
                                 click left the button focused and the button template drew its focus ring around it -
                                 a frame sitting in the caption long after the click. -->
                            <StackPanel x:Name="PART_ButtonsPanel" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Button x:Name="PART_MinButton" Classes="CaptionButton" Focusable="False" Height="{TemplateBinding Height}">
                                <Path Data="M0,5 L10,5"
                                        Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <!-- Maximize <-> restore: two overlaid glyphs, only one shown; the IsWindowMaximized trigger
                                 swaps their Opacity (the CheckBox pattern). -->
                            <Button x:Name="PART_MaxButton" Classes="CaptionButton" Focusable="False" Height="{TemplateBinding Height}">
                                <Grid>
                                    <Path x:Name="MaximizeGlyph" Data="M0,0 L10,0 L10,10 L0,10 Z"
                                            Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="RestoreGlyph" Data="M0,3 L7,3 L7,10 L0,10 Z M3,3 L3,0 L10,0 L10,7 L7,7"
                                            Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="PART_CloseButton" Classes="CaptionButton CloseButton" Focusable="False" Height="{TemplateBinding Height}">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                        Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TitleBar">
        <PropertyTrigger Property="ShowMinButton" Value="false">
            <Setter TargetName="PART_MinButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowMaxRestoreButton" Value="false">
            <Setter TargetName="PART_MaxButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowCloseButton" Value="false">
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowTitle" Value="false">
            <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowIcon" Value="false">
            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- No right commands -> hide the "..." overflow button so an empty caption doesn't show an orphaned button. -->
        <PropertyTrigger Property="HasRightWindowCommands" Value="false">
            <Setter TargetName="PART_RightOverflowButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Maximized: hide the single-square (maximize) glyph, show the overlapping-squares (restore) glyph. A trigger
             overrides the local Opacity defaults (trigger outranks a local value), so the swap applies both ways. -->
        <PropertyTrigger Property="IsWindowMaximized" Value="true">
            <Setter TargetName="MaximizeGlyph" Property="Opacity" Value="0"/>
            <Setter TargetName="RestoreGlyph" Property="Opacity" Value="1"/>
        </PropertyTrigger>
    </Style>

    <!-- Caption buttons: reuse the base Button template but flatten it (no rounding, no border, no min-height) and give
         a subtle hover. They are click-only, so not focus targets. The close button overrides the hover to red. -->
    <Style Selector="Button.CaptionButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.CloseButton">
        <Setter Property="BackgroundPointerOver" Value="#E81123"/>
        <Setter Property="BackgroundPressed" Value="#F1707A"/>
    </Style>

</StyleSet>
