<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- Docking. Style matching is by EXACT type here, so a derived control inherits nothing by default - that is why
         each of these says BasedOn explicitly instead of quietly relying on its base. A pane group IS a tab control and
         a pane IS a tab item, so they take those looks whole; the splitter needs its own, because a Thumb has no look
         at all - and a control with no template renders nothing and cannot be hit, which is exactly what makes a grip
         that refuses to be dragged. -->

    <!-- A floating panel's window looks like any other window. Stated explicitly because matching here is by EXACT type:
         without this line a DockingWindow gets no template at all - and a window with no template is a frame with
         nothing in it, not a window that merely looks plain. -->
    <Style Selector="DockingWindow" BasedOn="Window"/>

    <Style Selector="PaneGroup" BasedOn="TabControl"/>

    <Style Selector="Pane" BasedOn="TabItem"/>

    <!-- A tab whose panel has folded down against a SIDE: the label lies on its side, because the strip that is left is
         a narrow column. BOTH sides turn the same way - top to bottom - so a glance down one edge reads the same as a
         glance down the other; every editor does it this way. Facing the text out of its own panel (up on the left,
         down on the right) sounded symmetrical and reads as two different conventions in one window.
         Two styles with a literal angle each rather than one with a bound angle - a Transform is not a component and
         cannot be a binding target at all. -->
    <Style Selector="Pane[LabelRotation=Left]">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- LAYOUT transform, not render: the strip has to be as WIDE as the turned text is tall. A render
                         transform would leave it measured for text lying flat and then draw it outside those bounds. -->
                    <controls:ContentPresenter Content="{Binding}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ContentPresenter.LayoutTransform>
                            <Transform RotationAngle="90"/>
                        </controls:ContentPresenter.LayoutTransform>
                    </controls:ContentPresenter>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Pane[LabelRotation=Right]">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <controls:ContentPresenter Content="{Binding}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ContentPresenter.LayoutTransform>
                            <Transform RotationAngle="90"/>
                        </controls:ContentPresenter.LayoutTransform>
                    </controls:ContentPresenter>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A TOOL group is dressed differently from a document one, and the difference is not decoration: a tool has a
         HEADER carrying its name and the two things you do to a tool and never to a document - pin it away and close it -
         while its tabs sit along the BOTTOM. A document has many siblings and no caption of its own; a tool has few and
         is part of the workspace rather than of the work. Every editor draws this distinction; until now we drew none. -->
    <!-- A DOCUMENT is closed from its own tab: it has no caption to hang a button on, and a document you cannot close
         without the keyboard is not a document. A tool keeps its caption button instead (below), so its tabs stay
         plain - closing a tool means putting the PANEL away, which is a statement about the panel, not about the tab. -->
    <Style Selector="PaneGroup[Kind=Document]">
        <Setter Property="ShowCloseButton" Value="True"/>
    </Style>

    <Style Selector="PaneGroup[Kind=Tool]">
        <Setter Property="TabStripPlacement" Value="Bottom"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PaneGroup">
                    <!-- The panel's OWN edge. A tool group states it here because it replaces the tab control's template
                         wholesale and would otherwise have none - and the divider between two panels draws nothing, so
                         without this there is no line anywhere and the panels bleed into each other. -->
                    <controls:Border x:Name="Chrome"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                    <!-- Rows AND columns, because the strip belongs on a different side in each state: along the BOTTOM
                         while docked, and in a narrow COLUMN on the edge once folded (the triggers below move it). The
                         middle cell is the body; the outer tracks are Auto, so the one the strip is not in costs
                         nothing. -->
                    <controls:Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">
                        <!-- The header. Its buttons are PARTS, so the group wires them once and a restyle cannot lose
                             them silently: a missing part is a button that does nothing, which is worse than none.
                             ACCENT-filled: a tool's caption is the one piece of chrome that says which panel you are in,
                             and its text colour is DERIVED from the accent for contrast (Theme.AccentForegroundColor),
                             so it stays readable whatever accent is set at runtime. -->
                        <controls:Border x:Name="PART_Header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="{ThemeResource AccentFillColorDefault}"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                BorderThickness="0 0 0 1"
                                Padding="8 2 8 2">
                            <controls:Grid ColumnDefinitions="*,Auto,Auto">
                                <controls:ContentPresenter Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Title}"
                                        Foreground="{ThemeResource AccentForegroundColor}"/>
                                <!-- Both header buttons are 28x28 and their glyphs centred in that square. Sized for a
                                     FINGER, not for a mouse: a 14px glyph with a couple of pixels of padding is an
                                     accurate-pointing-device-only target, and a header is exactly where someone on a
                                     tablet reaches to put a panel away. The square also makes them line up with each
                                     other and sit centred in the header without anyone counting paddings. -->
                                <controls:Button x:Name="PART_PinButton" Grid.Column="1"
                                        Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                        Classes="CaptionButton"

                                        BackgroundPointerOver="{ResourceReference OnAccentOverlayPointerOver}"

                                        BackgroundPressed="{ResourceReference OnAccentOverlayPressed}"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        VerticalAlignment="Center">
                                    <!-- The same thumbtack the overlay window's caption uses: cap (5..9), flared
                                         shoulders (3..11), tapering neck (6..8), point at (7,12). Drawn, never typed -
                                         a glyph depends on a font having it, and the one this started as is missing
                                         from most UI fonts, so the button rendered empty. -->
                                    <controls:Path x:Name="PinGlyph"
                                            Data="M5,2 L9,2 L9,4 L11,6 L11,7 L8,7 L8,10 L7,12 L6,10 L6,7 L3,7 L3,6 L5,4 Z"
                                            Stroke="{ThemeResource AccentForegroundColor}" StrokeThickness="1"
                                            Fill="{ThemeResource AccentForegroundColor}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </controls:Button>
                                <controls:Button x:Name="PART_CloseButton" Grid.Column="2"
                                        Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                        Classes="CaptionButton CloseButton"

                                        BackgroundPointerOver="{ResourceReference OnAccentOverlayPointerOver}"

                                        BackgroundPressed="{ResourceReference OnAccentOverlayPressed}"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        VerticalAlignment="Center">
                                    <controls:Path Data="M0,0 L10,10 M10,0 L0,10"
                                            Stroke="{ThemeResource AccentForegroundColor}" StrokeThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </controls:Button>
                            </controls:Grid>
                        </controls:Border>

                        <controls:Border x:Name="Body" Grid.Row="1" Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <!-- DockedContent, not SelectedContent: while the panel is revealed its body lives in the
                                 flyout, and one piece of content belongs to one tree. -->
                            <controls:ContentPresenter x:Name="PART_SelectedContentHost"
                                    Content="{TemplateBinding DockedContent}"
                                    ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"/>
                        </controls:Border>

                        <!-- Tabs BELOW the content, which is where a tool window keeps them while it is docked. -->
                        <TabStripScroller x:Name="PART_TabStrip" Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <!-- The strip carries the SELECTION INDICATOR over the headers, exactly as a plain TabControl's
                                 does: the control places and slides it (TabControl.PlaceIndicator) and it only needs to
                                 exist and be out of the way of the pointer. A tool group had none at all, so which pane
                                 was showing could only be guessed from the body. -->
                            <!-- Auto both ways: a Grid with no definitions stretches to whatever it is offered, and this one sits in the
                                     Auto column of a folded strip - so it made the narrow column as wide as the body used to
                                     be. Sized to its content, the column is the width of a turned label and nothing more. -->
                                <controls:Grid x:Name="StripFill" RowDefinitions="Auto" ColumnDefinitions="Auto">
                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                <controls:Rectangle x:Name="PART_SelectionIndicator"
                                                    Fill="{TemplateBinding SelectionIndicatorBrush}"
                                                    Width="1"
                                                    Height="{TemplateBinding SelectionIndicatorThickness}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    IsHitTestVisible="False"/>
                            </controls:Grid>
                        </TabStripScroller>

                        <!-- The FLYOUT of a revealed panel. Only the panel's BODY travels here - its tabs stay on the
                             edge, because that is what a revealed panel is: a strip you are glancing behind. It is a
                             popup so that it draws OVER the neighbours instead of pushing them aside (rule 3.10); the
                             strip is what it is placed against, so it opens exactly where the panel would have been.
                             Its own caption, because the docked one is not on screen in this state - and a flyout you
                             cannot pin is a panel you can only look at. -->
                        <!-- Placed against the GROUP, not the tab strip inside it: the strip sits at whatever inset the
                             chrome gives it, and a flyout lined up with the strip carried that inset along - so it
                             started left of the panel and ran off the far end. The group is what the docking area puts
                             on the edge, so it is what the area's offsets are measured against. -->
                        <controls:Popup x:Name="PART_RevealFlyout" Grid.Row="2" Grid.Column="1"
                                PlacementTarget="{Binding ElementName=Chrome}"
                                Placement="Top" KeepOpen="False">
                            <!-- The size lives on the CONTENT, never on the popup: a popup is an element of this tree
                                 whether it is open or not, and a 240-wide one sat in the strip's own cell and took that
                                 room out of the layout even while shut. -->
                            <controls:Border x:Name="FlyoutRoot"
                                    Background="{ResourceReference SolidBackgroundFillColorBase}"
                                    BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                    BorderThickness="1">
                                <controls:Grid RowDefinitions="Auto,*">
                                    <!-- A PART, because this is the caption a revealed panel is dragged by: while the
                                         flyout is up it is the only caption the panel has on screen. -->
                                    <controls:Border x:Name="PART_FlyoutHeader" Grid.Row="0"
                                            Background="{ThemeResource AccentFillColorDefault}"
                                            Padding="8 2 8 2">
                                        <controls:Grid ColumnDefinitions="*,Auto,Auto">
                                            <controls:ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                    Content="{TemplateBinding Title}"
                                                    Foreground="{ThemeResource AccentForegroundColor}"/>
                                            <controls:Button x:Name="PART_FlyoutPinButton" Grid.Column="1"
                                                    Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                    Classes="CaptionButton"
                                                    BackgroundPointerOver="{ResourceReference OnAccentOverlayPointerOver}"
                                                    BackgroundPressed="{ResourceReference OnAccentOverlayPressed}"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <!-- Hollow: this panel is NOT pinned - that is the whole reason it is a
                                                     flyout. Pressing it is what docks it, and the tack fills in. -->
                                                <controls:Path Data="M5,2 L9,2 L9,4 L11,6 L11,7 L8,7 L8,10 L7,12 L6,10 L6,7 L3,7 L3,6 L5,4 Z"
                                                        Stroke="{ThemeResource AccentForegroundColor}" StrokeThickness="1"
                                                        Fill="Transparent"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </controls:Button>
                                            <controls:Button x:Name="PART_FlyoutCloseButton" Grid.Column="2"
                                                    Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                    Classes="CaptionButton CloseButton"
                                                    BackgroundPointerOver="{ResourceReference OnAccentOverlayPointerOver}"
                                                    BackgroundPressed="{ResourceReference OnAccentOverlayPressed}"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <controls:Path Data="M0,0 L10,10 M10,0 L0,10"
                                                        Stroke="{ThemeResource AccentForegroundColor}" StrokeThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </controls:Button>
                                        </controls:Grid>
                                    </controls:Border>

                                    <!-- The body itself. The DOCKED presenter is emptied while this is open (see the
                                         Revealed trigger): one piece of content belongs to one tree, and a presenter
                                         holds its child even with the body hidden. -->
                                    <controls:Border Grid.Row="1" x:Name="FlyoutBody"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            ClipToBounds="True">
                                        <controls:ContentPresenter x:Name="PART_FlyoutContentHost"
                                                Content="{TemplateBinding FlyoutContent}"
                                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"/>
                                    </controls:Border>
                                </controls:Grid>
                            </controls:Border>
                        </controls:Popup>
                    </controls:Grid>
                    </controls:Border>
                    <ControlTemplate.Triggers>
                        <!-- Folded (put away OR being looked at): the strip is a row of buttons rather than a strip you
                             rearrange - there is no docked panel here to rearrange in. The CAPTION stays: a revealed
                             panel still has to say which panel it is. -->
                        <PropertyTrigger Property="IsFolded" Value="true">
                            <!-- Unpinned: the thumbtack is an OUTLINE. Pinned it is SOLID - that filled/hollow pair is how
                                 every editor shows the state of the pin, and it is the button telling you what it did. -->
                            <Setter TargetName="PinGlyph" Property="Fill" Value="Transparent"/>
                        </PropertyTrigger>
                        <!-- Put AWAY: caption and body both go, and the strip is all that is left, exactly where the
                             panel was. Revealed keeps both - that is the whole difference between the two folded states.
                             How much room the strip needs is measured by the strip (the group's length becomes Auto), so
                             there is no size stated here for anything to disagree with. -->
                        <!-- Not on an EDGE: there is nowhere to fold to, so the pin has nothing it could do. A button
                             that is present and does nothing is worse than one that is not there - it says the panel
                             refused, when in fact nothing was ever asked of it. -->
                        <PropertyTrigger Property="Edge" Value="None">
                            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- The whole of a floating window: the window's own title bar names it and carries the system's
                             close button, so a caption here would repeat the name word for word, in a second colour, with
                             a pin that has no edge left to fold against. -->
                        <PropertyTrigger Property="IsFloatingRoot" Value="true">
                            <Setter TargetName="PART_Header" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- One tab in a window of its own is not a choice, so there is no strip to make it with: the
                             window's title bar already says what this is, and a row of one button only takes room from
                             the thing being looked at. Dock a second panel in and the strip is back. -->
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="PART_TabStrip" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- REVEALED: in the tree this panel is still just its strip - the same as put away - and its
                             body is shown in the flyout OVER the neighbours. Emptying the docked presenter is not
                             cosmetic: one piece of content belongs to one tree, and a presenter goes on holding its
                             child even when the body around it is hidden, so the flyout would be handed an element
                             that already has a parent. -->
                        <PropertyTrigger Property="State" Value="Revealed">
                            <Setter TargetName="PART_Header" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="StripFill" Property="Background" Value="{ResourceReference DockFoldedStripFill}"/>
                            <!-- IsOpen is driven by the control (PaneGroup.SyncFold), not from here: a trigger has to be
                                 UNDONE to close the popup, and undoing it left the property Unset. -->

                        </PropertyTrigger>
                        <!-- Which way the flyout opens, and how big it is: OUT of the edge the strip is on, as far across
                             as the panel is worth docked (RevealExtent) and as long as the strip itself (RevealLength).
                             Stated per edge because "out of" is a different direction on each side. Harmless while the
                             panel is docked - the popup is shut. -->
                        <PropertyTrigger Property="Edge" Value="Left">
                            <Setter TargetName="PART_RevealFlyout" Property="Placement" Value="Relative"/>
                            <Setter TargetName="PART_RevealFlyout" Property="HorizontalOffset" Value="{TemplateBinding RevealOffsetX}"/><Setter TargetName="PART_RevealFlyout" Property="VerticalOffset" Value="{TemplateBinding RevealOffsetY}"/>
                            <Setter TargetName="FlyoutRoot" Property="Width" Value="{TemplateBinding RevealExtent}"/>
                            <Setter TargetName="FlyoutRoot" Property="Height" Value="{TemplateBinding RevealLength}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="Edge" Value="Right">
                            <Setter TargetName="PART_RevealFlyout" Property="Placement" Value="Relative"/>
                            <Setter TargetName="PART_RevealFlyout" Property="HorizontalOffset" Value="{TemplateBinding RevealOffsetX}"/><Setter TargetName="PART_RevealFlyout" Property="VerticalOffset" Value="{TemplateBinding RevealOffsetY}"/>
                            <Setter TargetName="FlyoutRoot" Property="Width" Value="{TemplateBinding RevealExtent}"/>
                            <Setter TargetName="FlyoutRoot" Property="Height" Value="{TemplateBinding RevealLength}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="Edge" Value="Top">
                            <Setter TargetName="PART_RevealFlyout" Property="Placement" Value="Relative"/>
                            <Setter TargetName="PART_RevealFlyout" Property="HorizontalOffset" Value="{TemplateBinding RevealOffsetX}"/><Setter TargetName="PART_RevealFlyout" Property="VerticalOffset" Value="{TemplateBinding RevealOffsetY}"/>
                            <Setter TargetName="FlyoutRoot" Property="Height" Value="{TemplateBinding RevealExtent}"/>
                            <Setter TargetName="FlyoutRoot" Property="Width" Value="{TemplateBinding RevealLength}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="Edge" Value="Bottom">
                            <Setter TargetName="PART_RevealFlyout" Property="Placement" Value="Relative"/>
                            <Setter TargetName="PART_RevealFlyout" Property="HorizontalOffset" Value="{TemplateBinding RevealOffsetX}"/><Setter TargetName="PART_RevealFlyout" Property="VerticalOffset" Value="{TemplateBinding RevealOffsetY}"/>
                            <Setter TargetName="FlyoutRoot" Property="Height" Value="{TemplateBinding RevealExtent}"/>
                            <Setter TargetName="FlyoutRoot" Property="Width" Value="{TemplateBinding RevealLength}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="State" Value="Collapsed">
                            <!-- Only a PUT-AWAY strip is a row of buttons rather than a strip you rearrange in: there is
                                 no panel open here to rearrange. A REVEALED panel IS open - its body is showing in the
                                 flyout - so its tabs reorder and tear off like any other. Keyed on Collapsed rather than
                                 on IsFolded, which covers both states and so switched dragging off for a panel that was
                                 open in front of the user. -->
                            <Setter Property="AllowTabDrag" Value="false"/>
                            <Setter TargetName="PART_Header" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            <!-- No frame around a put-away panel: a border encloses an AREA, and all that is left here is
                                 a strip of buttons on the edge. Framing it drew a box around nothing. -->
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="0"/>
                            <!-- The strip gets a fill of its own instead, which is what makes it READ as a put-away panel.
                                 Without it a folded panel is a row of labels floating on the background, indistinguishable
                                 from just some tabs - and the selection bar is gone too (nothing is open), so there is
                                 otherwise nothing at all to tell the two states apart. -->
                            <Setter TargetName="StripFill" Property="Background" Value="{ResourceReference DockFoldedStripFill}"/>
                        </PropertyTrigger>
                        <!-- Folded against a SIDE, the tabs queue DOWN a narrow column on THAT edge - not along the
                             bottom band, which belongs to a docked panel. Moving the strip between cells is what keeps it
                             on the edge while a revealed body is showing beside it; the labels are turned by the Pane
                             styles above. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFolded" Value="true"/>
                                <Condition Property="Edge" Value="Left"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TabStrip" Property="Orientation" Value="Vertical"/>
                            <Setter TargetName="PART_TabStrip" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="PART_TabStrip" Property="Grid.Column" Value="0"/>
                            <!-- The bar turns with the strip: a stripe along the column, on the side facing the body. Its
                                 template geometry is the horizontal one, so the turned case states its own. -->
                            <Setter TargetName="PART_SelectionIndicator" Property="Width" Value="{TemplateBinding SelectionIndicatorThickness}"/>
                            <Setter TargetName="PART_SelectionIndicator" Property="Height" Value="1"/>
                            <Setter TargetName="PART_SelectionIndicator" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="PART_SelectionIndicator" Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate><TabPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFolded" Value="true"/>
                                <Condition Property="Edge" Value="Right"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TabStrip" Property="Orientation" Value="Vertical"/>
                            <Setter TargetName="PART_TabStrip" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="PART_TabStrip" Property="Grid.Column" Value="2"/>
                            <Setter TargetName="PART_SelectionIndicator" Property="Width" Value="{TemplateBinding SelectionIndicatorThickness}"/>
                            <Setter TargetName="PART_SelectionIndicator" Property="Height" Value="1"/>
                            <Setter TargetName="PART_SelectionIndicator" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="PART_SelectionIndicator" Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate><TabPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The grip between two areas. Same shape as GridSplitter's: a thin subtle bar that lights up accent under the
         pointer, so it is visible ENOUGH to aim at without drawing attention when it is not wanted. -->
    <!-- INVISIBLE at rest, like every editor's. A drawn line here has nothing to say: the panels already have their own
         edges, and a stroke laid between two of them lands right next to those edges and reads as a double border, with
         a lump wherever three splitters meet. What the gap is for is GRABBING, and that is what Transparent gives -
         a hit-testable band of DividerThickness with nothing drawn in it. It shows itself when it matters: under the
         pointer, and while it is being dragged. -->
    <Style Selector="PaneSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PaneSplitter">
                    <controls:Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="PaneSplitter">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter Property="Background" Value="{ResourceReference AccentFillColorDefault}"/>
        </PropertyTrigger>
        <!-- And it STAYS lit while dragging: the pointer leaves the band the moment the boundary starts moving, so
             hover alone made the divider blink out exactly during the gesture it belongs to. -->
        <PropertyTrigger Property="IsDragging" Value="true">
            <Setter Property="Background" Value="{ResourceReference AccentFillColorDefault}"/>
        </PropertyTrigger>
    </Style>

    <!-- The compass shown while a pane is being dragged. Its brushes live here rather than in the control: which of the
         five targets is armed is said with COLOUR, and colour is the theme's business. -->
    <Style Selector="DockCompass">
        <Setter Property="IndicatorBrush" Value="{ResourceReference DockCompassFillColor}"/>
        <Setter Property="IndicatorStroke" Value="{ResourceReference DockCompassStrokeColor}"/>
        <Setter Property="ActiveBrush" Value="{ResourceReference AccentFillColorDefault}"/>
        <Setter Property="PreviewBrush" Value="{ResourceReference DockCompassPreviewColor}"/>
    </Style>

    <!-- Both overlays are WINDOWS, so they arrive with a window's look - a title bar, a border, a resize grip. An
         overlay has none of that: it is a plate that appears over everything for the length of a drag. Hence a bare
         template of its own rather than the one Window carries. -->
    <!-- This window covers the WHOLE docking area, so it must have nothing of its own: no caption, no border, and a
         background that is not there. Anything opaque here would black out the very layout the compass points at. -->
    <Style Selector="DockCompassWindow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DockCompassWindow">
                    <!-- The Content binding is NOT optional: without it the presenter presents nothing, the window lays
                         itself out and its content never does. Measured - the window arranged 8 times at the right size
                         while the compass inside it arranged zero. -->
                    <controls:ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>

