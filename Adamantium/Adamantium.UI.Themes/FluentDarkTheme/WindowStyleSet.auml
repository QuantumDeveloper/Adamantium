<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- Caption/border colours: theme defaults the user can override on the window (accent when focused, neutral when not). -->
    <Style Selector="Window">
        <Setter Property="TitleBarBackground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="InactiveTitleBarBackground" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <!-- Caption foreground: active = the theme's on-accent contrast colour (so title text + button glyphs read on the
             accent-painted bar), inactive = neutral primary text. Both overridable on the window. -->
        <Setter Property="TitleBarForeground" Value="{ThemeResource AccentForegroundColor}"/>
        <Setter Property="InactiveTitleBarForeground" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="Window">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <controls:Border x:Name="PART_WindowBorder" Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                        <controls:Grid RowDefinitions="Auto,*">
                            <controls:TitleBar x:Name="PART_TitleBar" Grid.Row="0"
                                    Background="{TemplateBinding InactiveTitleBarBackground}"
                                    Foreground="{TemplateBinding InactiveTitleBarForeground}"
                                    Title="{TemplateBinding Title}"
                                    Icon="{TemplateBinding Icon}"
                                    LeftWindowCommands="{TemplateBinding LeftWindowCommands}"
                                    RightWindowCommands="{TemplateBinding RightWindowCommands}"/>
                            <controls:ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <controls:ResizeGripper x:Name="PART_ResizeGripper" Grid.Row="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Width="26" Height="26" Visibility="Collapsed"/>
                        </controls:Grid>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Window">
        <!-- Native frame (custom chrome off): hide the custom caption; the OS draws its own title bar. -->
        <PropertyTrigger Property="UseCustomChrome" Value="false">
            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Grip-only resize mode: show the corner grip (the only sizing affordance; edge borders are off in this mode). -->
        <PropertyTrigger Property="ResizeMode" Value="CanResizeWithGrip">
            <Setter TargetName="PART_ResizeGripper" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- Active (focused) window: paint the caption + outline with the accent (like a native title-bar focus highlight).
             Inactive keeps the neutral base caption + subtle stroke (the template/setter defaults). -->
        <PropertyTrigger Property="IsActive" Value="true">
            <Setter TargetName="PART_TitleBar" Property="Background" Value="{TemplateBinding TitleBarBackground}"/>
            <Setter TargetName="PART_TitleBar" Property="Foreground" Value="{TemplateBinding TitleBarForeground}"/>
            <Setter TargetName="PART_WindowBorder" Property="BorderBrush" Value="{TemplateBinding TitleBarBackground}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
