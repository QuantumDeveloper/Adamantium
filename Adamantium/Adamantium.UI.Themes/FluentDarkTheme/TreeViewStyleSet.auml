<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- TreeView: a scrollable host of top-level TreeViewItem nodes. The nested nodes come from each item's own template. -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TreeView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <controls:Border Background="{TemplateBinding Background}">
                        <!-- Horizontal scroll DISABLED so the ScrollViewer constrains content to the viewport width - rows then
                             stretch full-width (the whole row is clickable + the selection highlight spans it), instead of
                             sizing to the widest node (Auto measures content unconstrained on X to find the extent). -->
                        <controls:ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <controls:ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </controls:ScrollViewer>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TreeViewItem: [expander] header  |  its child nodes below, indented one step, shown while IsExpanded. The indent
         COMPOUNDS through nesting (each level's child presenter insets by the same step), so depth N sits N steps in. -->
    <Style Selector="TreeViewItem">
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The expander glyph, its own swappable template (TreeViewItem.ExpanderTemplate). Checked = expanded, so the ▶ swaps
         to ▼. Restyle the arrow by overriding ExpanderTemplate alone - the node template just hosts PART_Expander. -->
    <Style Selector="TreeViewItem">
        <Setter Property="ExpanderTemplate">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <controls:Grid Width="16" Height="16" Background="Transparent">
                        <controls:Path x:Name="ChevronRight" Data="M0,0 L5,4 L0,8 Z"
                                Fill="{ResourceReference TextFillColorSecondary}"
                                Width="5" 
                                Height="8" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                        <controls:Path x:Name="ChevronDown" Data="M0,0 L8,0 L4,5 Z"
                                Fill="{ResourceReference TextFillColorSecondary}"
                                Width="8" 
                               Height="5" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                                Visibility="Collapsed"/>
                    </controls:Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsChecked" Value="true">
                            <Setter TargetName="ChevronRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ChevronDown" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <!-- Vertical StackPanel: header row, then the child nodes below it. It stretches the Root border to the
                         full row width (a Stretch child now fills the panel's arranged cross extent - see StackPanel
                         .ArrangePlain), so rows span the viewport (clickable + selection highlight edge-to-edge) at any depth. -->
                    <controls:StackPanel Orientation="Vertical">
                        <!-- Root.Background carries the SELECTION; a separate translucent HoverOverlay ABOVE it carries HOVER.
                             Layering them (rather than both writing Root.Background) means a selected+hovered row stays accent
                             - just a touch lighter - instead of reverting to the hover grey and looking deselected. Padding
                             moved onto the inner content grid so BOTH the selection fill and the hover overlay span the row. -->
                        <controls:Border x:Name="Root" Background="Transparent" CornerRadius="4" MinHeight="26">
                            <controls:Grid>
                                <controls:Border x:Name="HoverOverlay" Background="Transparent" CornerRadius="4"/>
                                <controls:Grid ColumnDefinitions="16,*" Margin="4 3 6 3">
                                    <!-- Pin the expander to its 16x16 glyph: the base ToggleButton style leaks MinHeight=32 +
                                         Padding via the IS-A selector, which inflated the button and pushed the arrow off its
                                         row centre. Un-inherit them here so the chevron sits dead-centre. -->
                                    <controls:ToggleButton x:Name="PART_Expander" Grid.Column="0"
                                            Template="{TemplateBinding ExpanderTemplate}"
                                            Width="16" Height="16" MinWidth="0" MinHeight="0" Padding="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <controls:ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            VerticalAlignment="Center" Margin="4 0 0 0"/>
                                </controls:Grid>
                            </controls:Grid>
                        </controls:Border>
                        <controls:ItemsPresenter x:Name="PART_ItemsPresenter" Margin="16 0 0 0" Visibility="Collapsed"/>
                    </controls:StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TreeViewItem">
        <!-- Hover uses IsPointerOverHeader (this row only), NOT IsMouseOver (true across the whole subtree - would light up
             every ancestor of a hovered deep node). -->
        <PropertyTrigger Property="IsPointerOverHeader" Value="true">
            <Setter TargetName="HoverOverlay" Property="Background" Value="{ResourceReference SubtleFillColorSecondary}"/>
        </PropertyTrigger>
        <!-- A branch node shows its children when expanded; a leaf hides the expander entirely. -->
        <PropertyTrigger Property="IsExpanded" Value="true">
            <Setter TargetName="PART_ItemsPresenter" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="HasItems" Value="false">
            <Setter TargetName="PART_Expander" Property="Visibility" Value="Hidden"/>
        </PropertyTrigger>
        <!-- Selection last so it wins the Root background over hover. -->
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
