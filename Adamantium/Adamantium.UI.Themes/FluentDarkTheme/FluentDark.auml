<?xml version="1.0" encoding="utf-8" ?>
<Theme xmlns="http://adamantium/ui"
       xmlns:x="http://adamantium/ui/xaml/extensions"
       xmlns:fluentDark="clr-namespace:Adamantium.UI.Themes.FluentDarkTheme"
	   Name="FluentDark"
       ResourceContext.Source="{ResourceLink Source={x:Type fluentDark:Brushes}, Scope=Theme}">

	<Theme.StyleIncludes>
		<StyleInclude Source="{x:Type fluentDark:RectangleStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:BorderStyleSet}"/>
		<StyleInclude Source="{x:Type fluentDark:ButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ContentControlStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ThumbStyleSet}"/>
        <StyleInclude Source="{x:Type fluentDark:ScrollBarStyleSet}"/>
	</Theme.StyleIncludes>

	<!-- Accent / focus: the theme's runtime-mutable identity. Referenced via {ThemeResource Key}; change any of these
	     at runtime (theme.AccentFillColorDefault = ...) and every binding refreshes live. Static palette is in Brushes.auml. -->
	<Theme.AccentFillColorDefault><SolidColorBrush Color="#60CDFF"/></Theme.AccentFillColorDefault>
	<Theme.AccentFillColorSecondary><SolidColorBrush Color="#57B8E6"/></Theme.AccentFillColorSecondary>
	<Theme.AccentFillColorTertiary><SolidColorBrush Color="#4FA6CF"/></Theme.AccentFillColorTertiary>
	<Theme.AccentFillColorDisabled><SolidColorBrush Color="#3D3D3D"/></Theme.AccentFillColorDisabled>
	<Theme.AccentForegroundColor><SolidColorBrush Color="#000000"/></Theme.AccentForegroundColor>
	<Theme.FocusStrokeColorOuter><SolidColorBrush Color="#FFFFFF"/></Theme.FocusStrokeColorOuter>
	<Theme.FocusStrokeColorInner><SolidColorBrush Color="#000000"/></Theme.FocusStrokeColorInner>
</Theme>