<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns:math="clr-namespace:Adamantium.Mathematics;assembly=Adamantium.Mathematics"
        xmlns="http://adamantium/ui">

    <!-- FluentLight static palette: the SAME keys as Brushes.auml (dark), light values (WinUI light tokens). The styles
         reference these keys via {ResourceReference}, so swapping FluentDark <-> FluentLight only swaps this dictionary -
         the templates are shared. Accent/focus live on the Theme (FluentLight.auml). -->

    <!-- Layer / background fills -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBase" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondary" Color="#EEEEEE"/>
    <!-- Scrim behind a modal/busy overlay: a translucent dimmer over content (theme-independent). -->
    <SolidColorBrush x:Key="SmokeFillColorDefault" Color="#99000000"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiary" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LayerFillColorDefault" Color="#80FFFFFF"/>

    <!-- The tile face - see Brushes.auml. Mirrors the dark palette's veil, inverted: a subtle DARK overlay over the white
         card. (ControlFillColorDefault below is a 70%-white control fill: right over the grey window base, invisible on a
         white card - which is exactly why a tile must not borrow it.) -->
    <SolidColorBrush x:Key="TileFillColorDefault" Color="#0F000000"/>

    <!-- Control fills (subtle dark translucent over the light background) -->
    <SolidColorBrush x:Key="ControlFillColorDefault" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondary" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="ControlFillColorTertiary" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="ControlFillColorDisabled" Color="#4DF9F9F9"/>

    <!-- Subtle fills (WinUI tokens): hover/press washes for chrome-less items - menu rows, title-bar buttons. Missing
         counterparts of the dark palette's entries (a {ResourceReference} miss is a silent no-op - see Brushes.auml). -->
    <SolidColorBrush x:Key="SubtleFillColorSecondary" Color="#09000000"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiary" Color="#06000000"/>

    <!-- Control strokes -->
    <!-- Control outlines. WinUI's light values (6% / 16% black) are deliberately faint because WinUI leans on SHADOWS and
         a layered surface stack to separate a control from what it sits on. This engine draws no shadows, so the stroke is
         the ONLY thing separating a near-white control from a near-white surface - at 6% it separates nothing, and the
         light theme reads as unfinished. Carry the contrast here instead. -->
    <SolidColorBrush x:Key="ControlStrokeColorDefault" Color="#33000000"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondary" Color="#52000000"/>

    <!-- Text (dark on light) -->
    <SolidColorBrush x:Key="TextFillColorPrimary" Color="#E4000000"/>
    <SolidColorBrush x:Key="TextFillColorSecondary" Color="#9E000000"/>
    <SolidColorBrush x:Key="TextFillColorTertiary" Color="#72000000"/>
    <SolidColorBrush x:Key="TextFillColorDisabled" Color="#5C000000"/>

    <!-- Semantic (success / caution / critical) -->
    <SolidColorBrush x:Key="SystemFillColorSuccess" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SystemFillColorCaution" Color="#9D5D00"/>
    <SolidColorBrush x:Key="SystemFillColorCritical" Color="#C42B1C"/>

    <!-- Loading skeleton fill (see the Dark palette for why it is ONE shared brush). Light inverts it: a dark wash over the
         light surface, at the same Opacity range the shared PulseAnimation breathes through. -->
    <SolidColorBrush x:Key="SkeletonPulseFill" Color="#000000" Opacity="0.05"/>

    <!-- Shimmer (see the Dark palette). Light INVERTS the peak: a white glare vanishes on a light surface, so the sweeping
         highlight is a translucent DARK band - a soft shadow gliding over a faint grey card, which reads clearly. -->
    <SolidColorBrush x:Key="ShimmerTrackFill" Color="#14000000"/>
    <math:Color x:Key="ShimmerPeakColor">#59000000</math:Color>

</ResourceDictionary>
