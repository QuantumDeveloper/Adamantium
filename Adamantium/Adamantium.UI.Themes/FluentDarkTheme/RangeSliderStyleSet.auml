<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- Two handles on one rail, with the SELECTED span painted between them. The RangeTrack owns the geometry (it sizes
         both thumbs' travel against the trough minus BOTH of them, so they can never overlap) and this style is the rail
         plus the parts it positions. Split per the small-styles convention: sizing, template, vertical. -->

    <Style Selector="RangeSlider">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style Selector="RangeSlider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RangeSlider">
                    <controls:Grid>
                        <controls:Border x:Name="Rail" Height="4" CornerRadius="2"
                                Background="{ResourceReference ControlFillColorTertiary}"
                                VerticalAlignment="Center"/>
                        <controls:RangeTrack x:Name="PART_Track"
                                Orientation="{TemplateBinding Orientation}"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                LowerValue="{TemplateBinding LowerValue}"
                                UpperValue="{TemplateBinding UpperValue}"
                                MinimumBandLength="{TemplateBinding MinimumRangeWidth}">
                            <!-- The accent band is a THUMB: it shows the selected span and drags the whole span at once.
                                 Unlike a Slider's fill it is not anchored to an end, so the track arranges it between
                                 the two handles rather than the control sizing it. -->
                            <controls:RangeTrack.CenterThumb>
                                <controls:Thumb x:Name="SelectedBand" Height="{TemplateBinding BandThickness}">
                                    <controls:Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- Square ends: the band butts up against a round handle at each side, and a
                                                 rounded end there reads as a gap rather than a join. -->
                                            <controls:Border Background="{ThemeResource AccentFillColorDefault}"/>
                                        </ControlTemplate>
                                    </controls:Thumb.Template>
                                </controls:Thumb>
                            </controls:RangeTrack.CenterThumb>
                            <controls:RangeTrack.LowerThumb>
                                <controls:Thumb Width="20" Height="20">
                                    <controls:Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <controls:Border CornerRadius="10"
                                                    Background="{ThemeResource AccentFillColorDefault}"/>
                                        </ControlTemplate>
                                    </controls:Thumb.Template>
                                </controls:Thumb>
                            </controls:RangeTrack.LowerThumb>
                            <controls:RangeTrack.UpperThumb>
                                <controls:Thumb Width="20" Height="20">
                                    <controls:Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <controls:Border CornerRadius="10"
                                                    Background="{ThemeResource AccentFillColorDefault}"/>
                                        </ControlTemplate>
                                    </controls:Thumb.Template>
                                </controls:Thumb>
                            </controls:RangeTrack.UpperThumb>
                        </controls:RangeTrack>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical: the rail and the band are laid out horizontally by the base template, so swap their axes. The track
         gets Orientation by TemplateBinding, so the thumbs already move the right way. -->
    <Style Selector="RangeSlider">
        <PropertyTrigger Property="Orientation" Value="Vertical">
            <!-- MinWidth is a horizontal min-LENGTH; on a vertical control it would force a 120px-wide dead hit area
                 beside a 4px rail (the same trap the Slider style documents). Move the minimum onto the other axis. -->
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter TargetName="Rail" Property="Width" Value="4"/>
            <Setter TargetName="Rail" Property="Height" Value="Auto"/>
            <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center"/>
            <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/>
            <Setter TargetName="SelectedBand" Property="Width" Value="{TemplateBinding BandThickness}"/>
            <Setter TargetName="SelectedBand" Property="Height" Value="Auto"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
