<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- DropDown: a header (PART_Header, shows DisplayContent = selected item or placeholder, plus a chevron) over a
         Popup list (PART_Popup -> Border -> ScrollViewer -> PART_ItemsPresenter). The control opens/closes and positions
         the popup in code; the popup is edge-aware (FlipToFit) and its width tracks the header. Per the small-styles
         convention: properties, then template, then triggers. -->

    <Style Selector="DropDown" BasedOn="ItemsControl">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference ControlFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="11 5 8 6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDown">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DropDown">
                    <Grid>
                        <Border x:Name="PART_Header"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter
                                        x:Name="PART_ContentPresenter"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Content="{TemplateBinding DisplayContent}"
                                        ContentTemplate="{TemplateBinding ItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <Path x:Name="Chevron" Grid.Column="1"
                                        Data="M0,0 L8,0 L4,5 Z"
                                        Fill="{ResourceReference TextFillColorSecondary}"
                                        Width="8" Height="5"
                                        Margin="8 0 0 0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                                Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                            <!-- The list card + scroll host + items presenter build LAZILY on first open (ChildTemplate),
                                 not eagerly in every DropDown's template - a closed list costs a card, two scrollbars and
                                 a container per item, and most lists are never opened. The popup's DataContext is set to
                                 the DropDown in code, so these plain {Binding}s reach it: {TemplateBinding} cannot, since
                                 a ChildTemplate is built against the POPUP, not the control that owns it. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="2"
                                            MinWidth="{Binding ActualWidth}">
                                        <ScrollViewer MaxHeight="{Binding MaxDropDownHeight}"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDown">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_Header" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
