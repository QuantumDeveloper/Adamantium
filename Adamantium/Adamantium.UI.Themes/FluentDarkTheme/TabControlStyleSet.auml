<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- TabControl: the strip (PART_TabStrip, which pans on the mouse wheel - no scrollbar) + the themed content area
         (PART_SelectedContentHost). Each TabStripPlacement is its OWN small style whose selector matches that value
         ("TabControl[TabStripPlacement=Left]"): its template applies while the placement holds and switches on change,
         so a side can fully restyle its strip (e.g. a docking-style Left/Right). Colours via {ResourceReference}. -->

    <!-- Shared chrome + the default (horizontal) header panel. The drag-reorder motion feel is declared here (the easing
         defaults to a decelerate cubic in code). -->
    <Style Selector="TabControl" BasedOn="ItemsControl">
        <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="ReorderAnimationDuration" Value="0:0:0.18"/>
        <!-- Selection indicator: accent bar that slides under the selected tab. {ThemeResource} so it follows an accent
             or theme swap live (the template paints PART_SelectionIndicator via TemplateBinding). -->
        <Setter Property="SelectionIndicatorBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="SelectionIndicatorThickness" Value="3"/>
        <Setter Property="SelectionAnimationDuration" Value="0:0:0.25"/>
        <!-- Default look of the per-tab close button (enable via TabControl.ShowCloseButton). A standalone ControlTemplate
             so a host swaps ONLY this to restyle the button; a click raises TabControl.TabCloseRequested. -->
        <Setter Property="CloseButtonTemplate">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 24 square, not 20: this is a target a finger has to hit, and a close button is the one place
                         where missing costs the most. The cross is DRAWN - a glyph is only as reliable as the font
                         underneath it. -->
                    <Border x:Name="CloseBg" Width="24" Height="24" CornerRadius="4" Background="Transparent">
                        <Path x:Name="CloseGlyph" Data="M0,0 L8,8 M8,0 L0,8"
                              Stroke="{ResourceReference TextFillColorSecondary}" StrokeThickness="1"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Highlight the button itself on hover so it clearly reacts. -->
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="CloseBg" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
                            <Setter TargetName="CloseGlyph" Property="Stroke" Value="{ResourceReference TextFillColorPrimary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Default look of the per-tab PIN button (enable via TabControl.ShowPinButton). Its own ControlTemplate for the
             same reason as the close button: a host restyles pinning by handing over this one template. The thumbtack is
             DRAWN - the same shape the docking caption uses - and fills in solid once the tab is pinned, which is how
             every editor shows the difference. -->
        <Setter Property="PinButtonTemplate">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="PinBg" Width="24" Height="24" CornerRadius="4" Background="Transparent">
                        <Path x:Name="PinGlyph" Data="M5,2 L9,2 L9,4 L11,6 L11,7 L8,7 L8,10 L7,12 L6,10 L6,7 L3,7 L3,6 L5,4 Z"
                              Stroke="{ResourceReference TextFillColorSecondary}" StrokeThickness="1"
                              Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="PinBg" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
                            <Setter TargetName="PinGlyph" Property="Stroke" Value="{ResourceReference TextFillColorPrimary}"/>
                        </PropertyTrigger>
                        <!-- PINNED: the tack fills in. Hollow against solid is how every editor tells the two apart, and
                             it is the button reporting its own state rather than a second thing to read elsewhere. -->
                        <PropertyTrigger Property="IsChecked" Value="true">
                            <Setter TargetName="PinGlyph" Property="Fill" Value="{ResourceReference TextFillColorPrimary}"/>
                            <Setter TargetName="PinGlyph" Property="Stroke" Value="{ResourceReference TextFillColorPrimary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <TabPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A strip's list is JUST its items - no chrome, and above all no scroller of its own. The ordinary row is already
         inside a TabStripScroller (that is what pans the strip on the wheel), and the ItemsControl default template wraps
         its items in a ScrollViewer, which swallowed the wheel and left the strip unable to pan. Matching is by exact
         type, so this states the whole template rather than leaning on the base one. -->
    <Style Selector="TabItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItemsControl">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The overflow flyout's list: a ScrollViewer capped by MaxHeight that scrolls the CONTENT, so the list virtualizes -
         it may hold every tab of a browser-sized session, and realizing them all would cost exactly what the strip already
         costs at startup. The scroll stays pixel-smooth either way (the panel lays its rows out at absolute slots and the
         presenter translates it). The bar is HIDDEN, not disabled - it overlays the rows' close button, and the wheel is
         how this list is scrolled anyway. Applied BY CLASS so this template lives ONCE for every placement's overflow list. -->
    <Style Selector="ListBox.TabOverflowList">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer MaxHeight="360"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of the flyout: icon, name, close. Its item is a TabOverflowItem - a VIEW of a tab, never the tab, which is
         a live control and cannot be in the strip and in here at once. Everything it shows is data plus the template that
         draws it, so both places build their own visual from the same tab. -->
    <Style Selector="ListBox.TabOverflowList">
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="160">
                        <ContentPresenter Grid.Column="0"
                                VerticalAlignment="Center" Margin="0 0 8 0"
                                Content="{Binding Icon}"
                                ContentTemplate="{Binding IconTemplate}"/>
                        <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{Binding Header}"
                                ContentTemplate="{Binding HeaderTemplate}"/>
                        <!-- Closes through the tab's own path, so a TabCloseRequested handler can veto it here too. -->
                        <Button Grid.Column="2"
                                Margin="8 0 0 0" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding Close}"
                                Visibility="{Binding CloseVisibility}">
                            <Path Data="M0,0 L8,8 M8,0 L0,8"
                                  Stroke="{ResourceReference TextFillColorSecondary}" StrokeThickness="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top (default): strip in the Auto row, content fills below. -->
    <Style Selector="TabControl[TabStripPlacement=Top]">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Strip row: the scroller (headers overflow + wheel-pan) in the * column, a ▾ overflow button in an
                             Auto column beside it - so the button RESERVES space (the last tab ends before it, never hidden
                             behind it). Its visibility is set POST-layout (TabControl.OnLayoutSettled), not mid-arrange, so the
                             * / Auto reflow actually re-runs - a mid-pass visibility flip loses its invalidation and the button
                             then sat off-screen until a resize. Shown only when the strip overflows + ShowTabOverflowMenu;
                             toggles PART_TabOverflowPopup - a ListBox of every tab; picking a row selects it + scrolls it in. -->
                        <!-- TWO lists, not one strip kept in sorted order: pinned tabs above, the ones that come and go
                             below. The pinned row is OUTSIDE the scroller on purpose - that is what makes a pinned tab
                             impossible to scroll out of sight - and it WRAPS, so many pinned tabs cost further lines
                             instead of squeezing the rest. Both are TabItemsControl, which asks the strip itself for
                             containers, so a data item still becomes a real TabItem.
                             The overflow button sits in the BOTTOM row's column, not beside both rows: it belongs to the
                             scrolling strip, and spanning the pinned row made it a tall bar next to tabs it has nothing
                             to do with. PinnedTabsPlacement=SameRow moves the pinned list down beside the others. -->
                        <Grid x:Name="StripRow" Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                <!-- The pinned row carries a bar of its own. Only ever ONE of the two is visible - the one
                                     in the row holding the selected tab - so on screen it reads as a single indicator
                                     that moves between the rows; a bar cannot point at a tab in another row. -->
                                <Grid x:Name="PinnedRow" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                      Visibility="Collapsed">
                                    <TabItemsControl x:Name="PART_PinnedTabs" ItemsSource="{TemplateBinding PinnedItems}">
                                        <TabItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </TabItemsControl.ItemsPanel>
                                    </TabItemsControl>
                                    <Rectangle x:Name="PART_PinnedSelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="1"
                                               Height="{TemplateBinding SelectionIndicatorThickness}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            <TabStripScroller x:Name="PART_TabStrip" Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <Grid>
                                        <TabItemsControl x:Name="PART_Tabs" ItemsSource="{TemplateBinding UnpinnedItems}">
                                            <TabItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <TabPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </TabItemsControl.ItemsPanel>
                                        </TabItemsControl>
                                        <Rectangle x:Name="PART_SelectionIndicator"
                                                   Fill="{TemplateBinding SelectionIndicatorBrush}"
                                                   Width="1"
                                                   Height="{TemplateBinding SelectionIndicatorThickness}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Bottom"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </TabStripScroller>
                            <!-- The strip has no arrows (it pans on the wheel), so the fade is the ONLY thing saying
                                 there are tabs past the edge. A SIBLING of the scroller, in its cell: inside it, it
                                 would pan away with the tabs it is meant to be dissolving. -->
                            <Border x:Name="BackFade" Grid.Row="1" Grid.Column="1"
                                    Width="39"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Row="1" Grid.Column="1"
                                    Width="39"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Focusable=False: chrome, not a keyboard destination. Clicking it used to give it focus,
                                 and the button template lights its focus ring on IsFocused - so a frame was left drawn
                                 around it after every use. Tab still reaches the tabs themselves, which is what matters. -->
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Row="1" Grid.Column="2" VerticalAlignment="Stretch"
                                          Focusable="False"
                                          MinWidth="28" Padding="4 0" Visibility="Collapsed" BorderThickness="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Path Data="M0,0 L8,0 L4,5 Z" Fill="{ResourceReference TextFillColorSecondary}"
                                      Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <!-- Flyout list of every tab (wired in code), opened below the ▾ (edge-aware via FlipToFit).
                                 The card + its ListBox build LAZILY on first open (ChildTemplate): a list carries a scroll
                                 host and two scrollbars, and most tab strips never overflow at all. The list is taken from
                                 the built content in code (Popup.ContentBuilt), since it is not in this template's namescope. -->
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Row="1" Grid.Column="2" Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="4" Padding="2">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList" MinWidth="160"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The WHOLE strip row, overflow button included: hiding only the scroller left a ▾ floating
                             over nothing. -->
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- One tab filling the strip wears the accent itself (see TabItemStyleSet), so the bar that
                             says which of several is current has nothing left to say. -->
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- The bar runs beside the CONTENT by default; Outer moves it to the strip's far edge - here,
                             above the tab rather than under it. Which alignment that is depends on the placement, which
                             is why each template says it for itself. -->
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="PART_PinnedSelectionIndicator" Property="VerticalAlignment" Value="Top"/>
                        </PropertyTrigger>
                        <!-- Each row exists only while it has something in it: an empty one still takes its padding, and
                             a band of blank strip reads as a bug. Pin every tab and the ordinary row goes; unpin them
                             all and the pinned row goes. -->
                        <PropertyTrigger Property="HasPinnedTabs" Value="true">
                            <Setter TargetName="PinnedRow" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="HasUnpinnedTabs" Value="false">
                            <Setter TargetName="PART_TabStrip" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- Shown only where something has actually gone past that edge. -->
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <!-- ONE row: the pinned list moves down beside the others, in the first column, and stops
                             spanning the width. The tabs themselves are unchanged - only where their list sits. -->
                        <PropertyTrigger Property="PinnedTabsPlacement" Value="SameRow">
                            <Setter TargetName="PinnedRow" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="PinnedRow" Property="Grid.ColumnSpan" Value="1"/>
                            <!-- Content-width, and no wider: in the shared row it stands in the Auto column beside the
                                 scrolling strip, and a row that stretches leaves the starred column nothing - the
                                 ordinary tabs then have no width at all and simply are not there. -->
                            <Setter TargetName="PinnedRow" Property="HorizontalAlignment" Value="Left"/>
                            <!-- And a WRAPPING panel is exactly what stretches: measured unbounded in the Auto column it
                                 answers with the whole width (measured: pinnedPanel=676 of 676, scroller=0). There is
                                 nothing to wrap onto in a shared row anyway, so it lays out as a plain strip. -->
                            <Setter TargetName="PART_PinnedTabs" Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <TabPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom: content above, strip in the Auto row below. -->
    <Style Selector="TabControl[TabStripPlacement=Bottom]">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid RowDefinitions="*,Auto">
                        <Border Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"/>
                        </Border>
                        <!-- Strip + ▾ overflow (Auto column beside the * scroller) - see the Top template for the rationale. -->
                        <Grid x:Name="StripRow" Grid.Row="1" ColumnDefinitions="*,Auto">
                            <TabStripScroller x:Name="PART_TabStrip" Grid.Column="0" Orientation="Horizontal">
                                <Grid>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                    <Rectangle x:Name="PART_SelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="1"
                                               Height="{TemplateBinding SelectionIndicatorThickness}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </TabStripScroller>
                            <!-- See the Top template: a sibling of the scroller, never inside it. -->
                            <Border x:Name="BackFade" Grid.Column="0"
                                    Width="39"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Column="0"
                                    Width="39"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Column="1" VerticalAlignment="Stretch"
                                          Focusable="False"
                                          MinWidth="28" Padding="4 0" Visibility="Collapsed" BorderThickness="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Path Data="M0,0 L8,0 L4,5 Z" Fill="{ResourceReference TextFillColorSecondary}"
                                      Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Row="1" Grid.Column="2" Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="4" Padding="2">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList" MinWidth="160"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- One tab filling the strip wears the accent itself (see TabItemStyleSet), so the bar that
                             says which of several is current has nothing left to say. -->
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="VerticalAlignment" Value="Bottom"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left: strip in the Auto column on the left, headers stacked vertically, content fills right. -->
    <Style Selector="TabControl[TabStripPlacement=Left]">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <TabPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Strip + ▾ overflow in an Auto ROW below the * scroller (the strip is vertical, so it overflows
                             DOWNWARD - the ▾ sits at the bottom and reserves a row). -->
                        <Grid x:Name="StripRow" Grid.Column="0" RowDefinitions="*,Auto">
                            <TabStripScroller x:Name="PART_TabStrip" Grid.Row="0" Orientation="Vertical">
                                <Grid>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                    <Rectangle x:Name="PART_SelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="{TemplateBinding SelectionIndicatorThickness}"
                                               Height="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </TabStripScroller>
                            <!-- Vertical strip: the fade runs top and bottom. Sibling of the scroller (see Top). -->
                            <Border x:Name="BackFade" Grid.Row="0"
                                    Height="39"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Row="0"
                                    Height="39"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Row="1" HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          MinHeight="24" Padding="0 4" Visibility="Collapsed" BorderThickness="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Path Data="M0,0 L8,0 L4,5 Z" Fill="{ResourceReference TextFillColorSecondary}"
                                      Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Row="1" Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="4" Padding="2">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList" MinWidth="160"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                        <Border Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- One tab filling the strip wears the accent itself (see TabItemStyleSet), so the bar that
                             says which of several is current has nothing left to say. -->
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="HorizontalAlignment" Value="Left"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right: content fills left, strip in the Auto column on the right, headers stacked vertically. -->
    <Style Selector="TabControl[TabStripPlacement=Right]">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <TabPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"/>
                        </Border>
                        <!-- Strip + ▾ overflow in an Auto ROW below the * scroller (vertical strip - see the Left template). -->
                        <Grid x:Name="StripRow" Grid.Column="1" RowDefinitions="*,Auto">
                            <TabStripScroller x:Name="PART_TabStrip" Grid.Row="0" Orientation="Vertical">
                                <Grid>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                    <Rectangle x:Name="PART_SelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="{TemplateBinding SelectionIndicatorThickness}"
                                               Height="1"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </TabStripScroller>
                            <!-- Vertical strip: the fade runs top and bottom. Sibling of the scroller (see Top). -->
                            <Border x:Name="BackFade" Grid.Row="0"
                                    Height="39"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Row="0"
                                    Height="39"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Row="1" HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          MinHeight="24" Padding="0 4" Visibility="Collapsed" BorderThickness="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Path Data="M0,0 L8,0 L4,5 Z" Fill="{ResourceReference TextFillColorSecondary}"
                                      Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Row="1" Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="4" Padding="2">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList" MinWidth="160"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- One tab filling the strip wears the accent itself (see TabItemStyleSet), so the bar that
                             says which of several is current has nothing left to say. -->
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="HorizontalAlignment" Value="Right"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
