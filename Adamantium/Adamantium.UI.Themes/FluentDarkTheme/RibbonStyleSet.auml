<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">

    <!-- The theme owns the band height, the metrics of the three command sizes, the group caption and rules, and the
         tab underline. Per convention: simple properties, then the template, then the triggers. -->

    <Style Selector="Ribbon">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="FontSize" Value="13"/>
        <!-- Three rows of small commands plus the caption. Constant, so switching tabs never reflows the window. -->
        <Setter Property="GroupsAreaHeight" Value="106"/>
    </Style>

    <!-- Headers in a row at their own widths - the same shape a tab strip has, until contextual ledges need their own panel. -->
    <Style Selector="Ribbon">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:TabPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Ribbon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Ribbon">
                    <!-- Clipped: an open tab's chrome is flush with the band's top edge, and the coverage fringe that
                         antialiases it reaches half a pixel past - onto the caption above. -->
                    <controls:Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <controls:Grid RowDefinitions="Auto,Auto">
                            <!-- The strip. Its containers are RibbonTabHeaders, generated by the ribbon itself. -->
                            <controls:ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"/>

                            <!-- Shows the SELECTED TAB ITSELF, which presents its own groups; the strip shows a header for it. -->
                            <controls:Border Grid.Row="1"
                                    Height="{TemplateBinding GroupsAreaHeight}"
                                    Background="{ResourceReference CardBackgroundFillColorDefault}"
                                    BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                    BorderThickness="0 1 0 0"
                                    ClipToBounds="True">
                                <!-- STRETCHED across, not left-aligned: the open tab has to be told how much room the
                                     band actually has, because that arrange width is what the groups choose their
                                     variants from. Sized to content instead, a tab would always be handed exactly what
                                     it asked for and would never learn that the window had narrowed. The groups still
                                     sit left - their panel lays them out from x=0 and reports only what it used. -->
                                <controls:ContentPresenter x:Name="PART_SelectedContentHost"
                                        Content="{TemplateBinding SelectedContent}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                            </controls:Border>
                        </controls:Grid>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The label in the strip. Its selected state is driven by the ribbon, so the look is a trigger on IsSelected. -->
    <Style Selector="RibbonTabHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorSecondary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="ForegroundSelected" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="Padding" Value="16 7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RibbonTabHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTabHeader">
                    <controls:Grid>
                        <controls:Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4 4 0 0"
                                Padding="{TemplateBinding Padding}">
                            <controls:ContentPresenter x:Name="PART_ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </controls:Border>
                        <!-- The accent rule under the open tab, inside the header - a ribbon's strip does not move. -->
                        <controls:Rectangle x:Name="Underline" Height="2" Opacity="0"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Fill="{ThemeResource AccentFillColorDefault}"
                                IsHitTestVisible="False"/>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonTabHeader">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
        </PropertyTrigger>
    </Style>

    <!-- A tab is JUST its groups in a row: no chrome of its own, and no scroller - a narrow window shrinks groups. -->
    <Style Selector="RibbonTab">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:RibbonGroupsPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTab">
                    <controls:ItemsPresenter x:Name="PART_ItemsPresenter"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group: its commands in columns, its caption underneath, a rule down its right edge. -->
    <Style Selector="RibbonGroup">
        <Setter Property="Padding" Value="6 6 6 3"/>
        <!-- The mark on the button a collapsed group becomes. Without it the icon - path data, like a command's - is
             handed to a presenter with nothing to draw it, and comes out as the path TEXT: a strip of dashes. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <controls:Grid Width="16" Height="16">
                        <controls:Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </controls:Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:RibbonGroupPanel RowsPerColumn="3"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <!-- ONE template for both presentations, never swapped. PART_Content is the group's commands and
                     caption as a SINGLE block, and the group MOVES it between PART_InlineHost and PART_PopupHost when it
                     collapses - the same arrangement WPF's RibbonGroup uses (PART_TemplateContentControl /
                     PART_PopupGrid). Swapping the template instead rebuilds the packing panel that the adaptive pass
                     measures through, and that panel is the one thing that must survive: it holds the variants, their
                     measured widths, and the sizes currently applied to the commands. -->
                <ControlTemplate TargetType="RibbonGroup">
                    <controls:Grid ColumnDefinitions="*,Auto">
                        <controls:Grid Grid.Column="0">
                            <controls:Border x:Name="PART_InlineHost">
                                <controls:Grid x:Name="PART_Content" RowDefinitions="*,Auto"
                                        Margin="{TemplateBinding Padding}">
                                    <controls:ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"
                                            VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <controls:ContentPresenter Grid.Row="1"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Margin="0 4 0 0" FontSize="11"
                                            Foreground="{ResourceReference TextFillColorSecondary}"/>
                                </controls:Grid>
                            </controls:Border>

                            <!-- Shown in place of the block above once the group has given up its layout. -->
                            <controls:ToggleButton x:Name="PART_CollapsedButton"
                                    Classes="CollapsedGroupButton"
                                    Visibility="Collapsed"
                                    Width="{TemplateBinding CollapsedWidth}"
                                    ToolTip="{TemplateBinding Header}">
                                <controls:Grid RowDefinitions="Auto,Auto,Auto" Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center">
                                    <controls:Viewbox Grid.Row="0" Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <controls:ContentPresenter x:Name="PART_Icon"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"
                                                Foreground="{ResourceReference TextFillColorPrimary}"/>
                                    </controls:Viewbox>
                                    <controls:ContentPresenter Grid.Row="1" Margin="0 4 0 0" FontSize="11"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{ResourceReference TextFillColorSecondary}"/>
                                    <controls:Path Grid.Row="2" Data="M0,0 L4,4 L8,0" StrokeThickness="1" Margin="0 3 0 0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Stroke="{ResourceReference TextFillColorSecondary}"/>
                                </controls:Grid>
                            </controls:ToggleButton>

                            <!-- NOT clipped: our ClipToBounds is rectangular and this card is rounded (open debt in
                                 TECH_DEBT.md). Its content is PART_Content, moved here by the group. -->
                            <controls:Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True">
                                <controls:Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                        BorderThickness="1" CornerRadius="6" Padding="6">
                                    <controls:Border x:Name="PART_PopupHost"/>
                                </controls:Border>
                            </controls:Popup>
                        </controls:Grid>

                        <controls:Rectangle x:Name="GroupRule" Grid.Column="1" Width="1" Margin="1 8 1 8"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Fill="{ResourceReference ControlStrokeColorDefault}"/>
                    </controls:Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGroup">
        <!-- The last group divides itself from nothing; the tab is what knows which one that is. -->
        <PropertyTrigger Property="ShowSeparator" Value="false">
            <Setter TargetName="GroupRule" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <!-- Collapsed: the button takes the block's place. Only VISIBILITY changes here - which of the two hosts holds the
         content is the group's own business, because moving it is not something a setter can express. -->
    <Style Selector="RibbonGroup">
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="PART_InlineHost" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_CollapsedButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.CollapsedGroupButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- ONE template covers all three sizes: the icon box and the label swap cells (and the label goes) via triggers on
         Ribbon.Size. One presenter for the label - content is a single element and can live in only one layout. -->
    <Style Selector="RibbonButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <!-- Large centres (nothing to line up with); the smaller sizes go LEFT - in a column they stand under one
             another, and a ragged left edge is the first thing the eye catches. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="ForegroundDisabled" Value="{ResourceReference TextFillColorDisabled}"/>
        <Setter Property="Padding" Value="8 6"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <!-- Default icon drawing: path data stroked in whatever colour the icon slot carries. `{Binding}` is the icon
             itself - a string converts to a Geometry on the way in, as it does when written as an attribute. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- The 16-unit box icons are authored on, stated. Without it a Shape is measured by its own tight
                         ink (origin -> painted edge), so the Viewbox scales every icon by a different factor and they
                         sit at different heights. -->
                    <controls:Grid Width="16" Height="16">
                        <controls:Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </controls:Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonButton">
                    <controls:Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Icon and label sit in different cells, so it is this block - not the label - that
                             HorizontalContentAlignment has to place. -->
                        <controls:Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The icon is DATA drawn by IconTemplate. Its colour travels through the presenter's
                                 Foreground, so states recolour it without reaching into that template. -->
                            <controls:Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </controls:Viewbox>
                            <controls:ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </controls:Grid>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <!-- The ICON greys out with the label - it is the part a person aims at. -->
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Medium: small icon, label beside it. The label moves CELL, so one presenter serves every size. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="IconBox" Property="Width" Value="16"/>
            <Setter TargetName="IconBox" Property="Height" Value="16"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Column" Value="1"/>
            <Setter TargetName="PART_ContentPresenter" Property="Margin" Value="6 0 0 0"/>
            <!-- The whole command goes left: in a column the icons must start at one x. On the CONTROL, so it flows
                 through the one template binding. -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
        <!-- Small: the icon alone. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="IconBox" Property="Width" Value="16"/>
            <Setter TargetName="IconBox" Property="Height" Value="16"/>
            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
    </Style>

    <!-- Non-large commands are three to a column, so they must be short and must not claim a large command's width. -->
    <Style Selector="RibbonButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4 2"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4 2"/>
        </PropertyTrigger>
    </Style>

    <!-- A ribbon command with a checked state on top: brushes, metrics, icon drawing and every state/size trigger come
         from RibbonButton. BasedOn crosses types - the two share no base class (Button vs ToggleButton). -->
    <Style Selector="RibbonToggleButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonToggleButton">
                    <controls:Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <controls:Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <controls:Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </controls:Viewbox>
                            <controls:ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </controls:Grid>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Only the checked look. The inherited triggers land because this template names its parts the same. -->
    <Style Selector="RibbonToggleButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
    </Style>

    <!-- A command that drops a menu. Same command layout with an arrow after it, and the arrow is the ONLY thing this
         template adds - the icon box, the label and all three size layouts come from RibbonButton through BasedOn,
         which lands because the parts are named the same. -->
    <Style Selector="RibbonDropDownButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonDropDownButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonDropDownButton">
                    <controls:Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <controls:Grid x:Name="Layout" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <controls:Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </controls:Viewbox>
                            <controls:ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            <!-- Large stacks the arrow UNDER the label, the smaller sizes put it after - and BOTH are
                                 here, chosen by visibility. Moving one glyph between cells with triggers is what left the
                                 split button in a mixed state when the sizes stepped through each other. -->
                            <controls:Path x:Name="DropDownGlyph" Grid.Row="2" Grid.Column="0"
                                    Data="M0,0 L4,4 L8,0" StrokeThickness="1" Margin="0 3 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stroke="{TemplateBinding Foreground}"/>
                        </controls:Grid>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonDropDownButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="2"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="5 0 0 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="1"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="3 0 0 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Checked IS "the menu is down" - the command stays lit for as long as its flyout is. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
    </Style>

    <!-- Two commands in one: the body runs the action, the arrow drops the menu. The halves therefore light SEPARATELY,
         and the root is deliberately NOT named Chrome - the whole-button hover inherited from RibbonButton would paint
         over the distinction, and a setter whose part is absent does nothing. -->
    <Style Selector="RibbonSplitButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonSplitButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonSplitButton">
                    <controls:Border x:Name="SplitChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Three cells in each direction: at Large the split is HORIZONTAL - action on top, arrow
                             underneath - and the triggers below move the rule and the arrow into the right-hand column
                             for the smaller sizes. A large command is a stack, so an arrow floating beside it reads as
                             something that fell off rather than as the button's other half. -->
                        <controls:Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The command's OWN padding, not a fixed one: the size triggers tighten Padding for Medium and Small, and a
                                 hardcoded value here kept the split button 56x30 where its neighbours were 24x22 - a
                                 column stretched to fit it, and the icons beside it floating in the slack. -->
                            <controls:Border x:Name="ActionArea" Grid.Row="0" Grid.Column="0"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4 4 0 0">
                                <controls:Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <controls:Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                            Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <controls:ContentPresenter x:Name="PART_Icon"
                                                Foreground="{TemplateBinding Foreground}"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"/>
                                    </controls:Viewbox>
                                    <controls:ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                            Margin="0 4 0 0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                                </controls:Grid>
                            </controls:Border>

                            <controls:Rectangle x:Name="SplitRule" Grid.Row="1" Grid.Column="0" Height="1" Margin="5 0"
                                    HorizontalAlignment="Stretch"
                                    Fill="{ResourceReference ControlStrokeColorDefault}"/>

                            <!-- A real element with a size, not a glyph in a corner: the control asks this part where the
                                 pointer is. -->
                            <controls:Border x:Name="PART_DropDownArea" Grid.Row="2" Grid.Column="0" Padding="5 3"
                                    CornerRadius="0 0 4 4">
                                <controls:Path x:Name="DropDownGlyph"
                                        Data="M0,0 L4,4 L8,0" StrokeThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Stroke="{TemplateBinding Foreground}"/>
                            </controls:Border>
                        </controls:Grid>
                    </controls:Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Medium and Small are a ROW, so the split turns: the arrangement below is hidden and the one beside it shown.
         Small drops the dividing rule as well - a 24px command cannot afford the furniture the large one wears. -->
    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="4 0 0 4"/>
            <Setter TargetName="SplitRule" Property="Grid.Row" Value="0"/>
            <Setter TargetName="SplitRule" Property="Grid.Column" Value="1"/>
            <Setter TargetName="SplitRule" Property="Width" Value="1"/>
            <Setter TargetName="SplitRule" Property="Height" Value="NaN"/>
            <Setter TargetName="SplitRule" Property="Margin" Value="0 5"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="3 2"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="0 4 4 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="4 0 0 4"/>
            <Setter TargetName="SplitRule" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="1 2"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="0 4 4 0"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="IsPointerOverDropDown" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="true"/>
                <Condition Property="IsPointerOverDropDown" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="ActionArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- A plain row of small buttons; no chrome of its own - it sits inside the caption's. -->
    <Style Selector="RibbonQuickAccess">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonQuickAccess">
                    <controls:ItemsPresenter x:Name="PART_ItemsPresenter"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A DATA item in the bar: icon, tooltip, command - the shape a caption command already has. An authored control
         is its own container and never reaches this template. -->
    <Style Selector="RibbonQuickAccess">
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <controls:Button Classes="QuickAccessButton"
                            ToolTip="{Binding ToolTip}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}">
                        <!-- The hosting TitleBar's LIVE foreground, so icons follow its active/inactive colour. -->
                        <controls:Path Data="{Binding Icon}"
                                Stroke="{Ancestor TitleBar, Foreground}" StrokeThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </controls:Button>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.QuickAccessButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</StyleSet>
