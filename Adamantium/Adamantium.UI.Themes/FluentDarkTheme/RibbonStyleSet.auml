<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The theme owns the band height, the metrics of the three command sizes, the group caption and rules, and the
         tab underline. Per convention: simple properties, then the template, then the triggers. -->

    <Style Selector="Ribbon">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <!-- How long the minimized band takes to slide out and back. -->
        <Setter Property="FlyoutTransitionDuration" Value="0:0:0.16"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="FontSize" Value="13"/>
        <!-- Three rows of small commands plus the caption. Constant, so switching tabs never reflows the window. -->
        <Setter Property="GroupsAreaHeight" Value="106"/>
    </Style>

    <!-- The right-click menu every command in a band is given, unless its author wrote one. A TEMPLATE, because each
         command needs its own menu - a menu points at ONE command - and a setter would hand them all the same object. -->
    <Style Selector="Ribbon">
        <Setter Property="Ribbon.CommandContextMenuTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContextMenu>
                        <RibbonQuickAccessMenuItem/>
                    </ContextMenu>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The strip's OWN panel, not a TabPanel: the ledge has to travel and be clipped with the tabs under it. -->
    <Style Selector="Ribbon">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonTabPanel LedgeHeight="18"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The ledge over a contextual run: the group's colour carrying its title (docs/RIBBON_PLAN.md §4). -->
    <Style Selector="RibbonContextualLedge">
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8 0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonContextualLedge">
                    <!-- Never clipped and never wider than its run: the PANEL widens the tabs until the title fits
                         (RibbonTabPanel.Widen). Flush and square, like the tabs under it. -->
                    <Border Background="{TemplateBinding Accent}"
                            UseAnalyticAA="False">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                Height="{TemplateBinding TitleHeight}"
                                VerticalAlignment="Top"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Ribbon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Ribbon">
                    <!-- Clipped: an open tab's chrome is flush with the band's top edge, and the coverage fringe that
                         antialiases it reaches half a pixel past - onto the caption above. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <!-- "File" stands at the HEAD of the strip, before the tabs. Named because the key-tip
                                     mode gathers its first level from named places, not from a common ancestor. -->
                                <ContentPresenter x:Name="PART_ApplicationMenuHost" Grid.Column="0"
                                        Content="{TemplateBinding ApplicationMenu}"/>

                                <!-- The strip. Its containers are RibbonTabHeaders, generated by the ribbon itself. -->
                                <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Column="1"/>

                                <ToggleButton x:Name="PART_MinimizeButton" Grid.Column="2"
                                        Classes="RibbonMinimizeButton"
                                        IsChecked="{TemplateBinding IsMinimized}"
                                        ToolTip="Collapse the ribbon"/>
                            </Grid>

                            <!-- Holds the SELECTED TAB ITSELF, which presents its own groups; the strip shows a header
                                 for it. Minimizing MOVES that presenter into the flyout below, so its groups keep the
                                 variants they worked out. -->
                            <Border x:Name="Band" Grid.Row="1"
                                    Height="{TemplateBinding GroupsAreaHeight}"
                                    Background="{ResourceReference CardBackgroundFillColorDefault}"
                                    BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                    BorderThickness="0 1 0 0"
                                    ClipToBounds="True">
                                <Border x:Name="PART_BandHost">
                                    <!-- STRETCHED across, not left-aligned: the open tab has to be told how much room the
                                         band actually has, because that arrange width is what the groups choose their
                                         variants from. Sized to content instead, a tab would always be handed exactly what
                                         it asked for and would never learn that the window had narrowed. The groups still
                                         sit left - their panel lays them out from x=0 and reports only what it used. -->
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                            Content="{TemplateBinding SelectedContent}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                                </Border>
                            </Border>

                            <!-- The band's own row: whatever the application puts under it. -->
                            <ContentPresenter Grid.Row="2" Content="{TemplateBinding FooterContent}"/>

                            <!-- The minimized band's groups, drawn OVER the content below. An overlay is not a choice:
                                 kept in a row of its own it would push the content down (which is the one thing a
                                 minimized ribbon must not do) and be clipped by the root border. But it must not READ as
                                 a flyout - it is the band itself, so it spans the ribbon's full width and wears the
                                 band's own chrome. The width also does the aligning: Bottom placement CENTRES on its
                                 target, so anything narrower than the ribbon drifts into the middle of the window. -->
                            <Popup x:Name="PART_Flyout" Grid.Row="1" Placement="Bottom">
                                <Border Width="{TemplateBinding ActualWidth}"
                                        Height="{TemplateBinding GroupsAreaHeight}"
                                        Background="{ResourceReference CardBackgroundFillColorDefault}"
                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                        BorderThickness="0 1 0 1"
                                        ClipToBounds="True">
                                    <!-- The band SLIDES out from under the strip: the frame above is a fixed-height
                                         window that clips, and this is what moves inside it. A transform, not a height:
                                         a growing height would re-run the whole adaptive pass (§3.3) every frame, while
                                         a transform is a compositor channel and costs nothing per frame. -->
                                    <Border x:Name="PART_FlyoutHost">
                                        <Border.RenderTransform>
                                            <Transform/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimized: the band's row goes away, leaving the strip and whatever the footer holds. -->
    <Style Selector="Ribbon">
        <PropertyTrigger Property="IsMinimized" Value="true">
            <Setter TargetName="Band" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Margin" Value="0 2 6 0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Chevron: points UP to put the band away, DOWN to bring it back. -->
                        <Path x:Name="Chevron" Data="M3,8 L7,4 L11,8"
                                Stroke="{ResourceReference TextFillColorSecondary}" StrokeThickness="1.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chevron" Property="Data" Value="M3,4 L7,8 L11,4"/>
        </PropertyTrigger>
    </Style>

    <!-- The label in the strip. Its selected state is driven by the ribbon, so the look is a trigger on IsSelected. -->
    <Style Selector="RibbonTabHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorSecondary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="ForegroundSelected" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="Padding" Value="16 7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RibbonTabHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTabHeader">
                    <Grid>
                        <!-- Square and un-antialiased: plates meeting edge to edge, and a soft edge leaves a hairline
                             down each join (see docs/RIBBON_PLAN.md §4.4). -->
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                UseAnalyticAA="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Border>
                        <!-- The accent rule under the open tab, inside the header - a ribbon's strip does not move. -->
                        <Rectangle x:Name="Underline" Height="2" Opacity="0"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Fill="{ThemeResource AccentFillColorDefault}"
                                IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonTabHeader">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
        </PropertyTrigger>
    </Style>

    <!-- AFTER the state triggers above, so the open contextual tab keeps its context. -->
    <Style Selector="RibbonTabHeader">
        <PropertyTrigger Property="IsContextual" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding Accent}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
            <Setter TargetName="Underline" Property="Fill" Value="{TemplateBinding Accent}"/>
        </PropertyTrigger>
    </Style>

    <!-- Open AND contextual: the ordinary open fill; what marks it is the rule under it, in the context's colour. -->
    <Style Selector="RibbonTabHeader">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsContextual" Value="true"/>
                <Condition Property="IsSelected" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </MultiTrigger>
    </Style>

    <!-- A tab is its groups in a row, plus the last-resort scroll: a full-height arrow at each edge with a fade BESIDE it
         (inward), so the row dissolves into the arrow instead of being cut by a hard line. No scrollbar - a bar would eat
         height from a strip that has none to spare. The arrows overlay the row instead of taking width from it:
         reserving space would make the width depend on the answer it produces, and every tab that never scrolls would
         pay for them. Each arrow therefore rides an OPAQUE plate - the row scrolls underneath it. -->
    <Style Selector="RibbonTab">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGroupsPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTab">
                    <Grid ClipToBounds="True">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>

                        <!-- The fade starts where the arrow ends (Margin = the plate's width) and runs inward. -->
                        <Border x:Name="BackFade"
                                Width="28"
                                Margin="18 0 0 0"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColor}"/>
                                    <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="BackPlate"
                                Width="18"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Background="{ResourceReference SolidBackgroundFillColorBase}">
                            <RepeatButton x:Name="PART_ScrollBack" Classes="RibbonScrollButton">
                                <Path Data="M5,1 L1,5 L5,9"
                                      Stroke="{ResourceReference TextFillColorSecondary}"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Border>

                        <Border x:Name="ForwardFade"
                                Width="28"
                                Margin="0 0 18 0"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ResourceReference EdgeFadeColorTransparent}"/>
                                    <GradientStop Offset="1" Color="{ResourceReference EdgeFadeColor}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="ForwardPlate"
                                Width="18"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                Background="{ResourceReference SolidBackgroundFillColorBase}">
                            <RepeatButton x:Name="PART_ScrollForward" Classes="RibbonScrollButton">
                                <Path Data="M1,1 L5,5 L1,9"
                                      Stroke="{ResourceReference TextFillColorSecondary}"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shown only while there is somewhere to go in that direction - an arrow over an edge with nothing behind it is a
         promise the row cannot keep. -->
    <Style Selector="RibbonTab">
        <PropertyTrigger Property="CanScrollBack" Value="true">
            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
            <Setter TargetName="BackPlate" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanScrollForward" Value="true">
            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
            <Setter TargetName="ForwardPlate" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- Full height of the band, no corners: the arrow is an EDGE of the row, not a control sitting on it. Its plate
         supplies the opacity, so the state brushes here are the usual translucent washes over it. -->
    <Style Selector="RepeatButton.RibbonScrollButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- A group: its commands in columns, its caption underneath, a rule down its right edge. -->
    <Style Selector="RibbonGroup">
        <Setter Property="Padding" Value="6 6 6 3"/>
        <!-- The mark on the button a collapsed group becomes. Without it the icon - path data, like a command's - is
             handed to a presenter with nothing to draw it, and comes out as the path TEXT: a strip of dashes. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="16" Height="16">
                        <Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGroupPanel RowsPerColumn="3"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <!-- ONE template for both presentations, never swapped. PART_Content is the group's commands and
                     caption as a SINGLE block, and the group MOVES it between PART_InlineHost and PART_PopupHost when it
                     collapses - the same arrangement WPF's RibbonGroup uses (PART_TemplateContentControl /
                     PART_PopupGrid). Swapping the template instead rebuilds the packing panel that the adaptive pass
                     measures through, and that panel is the one thing that must survive: it holds the variants, their
                     measured widths, and the sizes currently applied to the commands. -->
                <ControlTemplate TargetType="RibbonGroup">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid Grid.Column="0">
                            <Border x:Name="PART_InlineHost">
                                <Grid x:Name="PART_Content" RowDefinitions="*,Auto"
                                        Margin="{TemplateBinding Padding}">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"
                                            VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <ContentPresenter Grid.Row="1"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Margin="0 4 0 0" FontSize="11"
                                            Foreground="{ResourceReference TextFillColorSecondary}"/>
                                </Grid>
                            </Border>

                            <!-- Shown in place of the block above once the group has given up its layout. -->
                            <ToggleButton x:Name="PART_CollapsedButton"
                                    Classes="CollapsedGroupButton"
                                    Visibility="Collapsed"
                                    Width="{TemplateBinding CollapsedWidth}"
                                    ToolTip="{TemplateBinding Header}">
                                <Grid RowDefinitions="Auto,Auto,Auto" Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center">
                                    <Viewbox Grid.Row="0" Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="PART_Icon"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"
                                                Foreground="{ResourceReference TextFillColorPrimary}"/>
                                    </Viewbox>
                                    <ContentPresenter Grid.Row="1" Margin="0 4 0 0" FontSize="11"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{ResourceReference TextFillColorSecondary}"/>
                                    <Path Grid.Row="2" Data="M0,0 L4,4 L8,0" StrokeThickness="1" Margin="0 3 0 0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Stroke="{ResourceReference TextFillColorSecondary}"/>
                                </Grid>
                            </ToggleButton>

                            <!-- NOT clipped: our ClipToBounds is rectangular and this card is rounded (open debt in
                                 TECH_DEBT.md). Its content is PART_Content, moved here by the group. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True">
                                <!-- The card builds on FIRST OPEN, not with the group's template: a band carries a
                                     couple of dozen groups and hardly any of them are ever collapsed, let alone opened.
                                     The group hosts its content here through PART_PopupHost when the content arrives
                                     (Popup.ContentBuilt), which is why nothing here binds to the group directly. -->
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="6" Padding="6">
                                            <Border x:Name="PART_PopupHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>

                        <Rectangle x:Name="GroupRule" Grid.Column="1" Width="1" Margin="1 8 1 8"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Fill="{ResourceReference ControlStrokeColorDefault}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGroup">
        <!-- The last group divides itself from nothing; the tab is what knows which one that is. -->
        <PropertyTrigger Property="ShowSeparator" Value="false">
            <Setter TargetName="GroupRule" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <!-- Collapsed: the button takes the block's place. Only VISIBILITY changes here - which of the two hosts holds the
         content is the group's own business, because moving it is not something a setter can express. -->
    <Style Selector="RibbonGroup">
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="PART_InlineHost" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_CollapsedButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- ================= GALLERY ================= -->
    <!-- A grid of choices standing in the band itself, with its own rows scrolled by two arrows and the whole set one
         chevron away. It rides the SAME ladder as every other command: the group hands it a size, it answers in columns
         (EffectiveColumns), and at Small it becomes the chevron alone - three thumbnails in a strip say nothing. -->
    <Style Selector="RibbonGallery">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGalleryPanel Columns="{TemplateBinding EffectiveColumns}"
                                        Rows="{TemplateBinding Rows}"
                                        FirstRow="{TemplateBinding FirstRow}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGallery">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonGallery">
                    <Grid>
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- The scrolled-away rows are laid out and clipped, never measured to nothing: a zero
                                     always fits, and a row that fits is a row that never scrolls. -->
                                <Border x:Name="Viewport" ClipToBounds="True">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                </Border>
                                <Grid x:Name="Arrows" Grid.Column="1" RowDefinitions="*,*,*" Width="18">
                                    <RepeatButton x:Name="PART_ScrollUp" Classes="GalleryArrow"
                                                  IsEnabled="{TemplateBinding CanScrollUp}">
                                        <Path Data="M1,5 L5,1 L9,5"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="1.2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </RepeatButton>
                                    <RepeatButton x:Name="PART_ScrollDown" Grid.Row="1" Classes="GalleryArrow"
                                                  IsEnabled="{TemplateBinding CanScrollDown}">
                                        <Path Data="M1,1 L5,5 L9,1"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="1.2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </RepeatButton>
                                    <!-- Office's "more": a chevron over a rule, so it reads as "the whole set", not
                                         "one more row". -->
                                    <Button x:Name="PART_More" Grid.Row="2" Classes="GalleryArrow">
                                        <Path Data="M1,1 L9,1 M1,4 L5,8 L9,4"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="1.2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               FlipToFit="True"
                               VerticalOffset="2"
                               DismissOnEscape="True">
                            <!-- Built on first drop-down, like the cells inside it: a gallery that is never dropped down
                                 is a card and a panel nobody looks at. The gallery fills the panel when it arrives
                                 (Popup.ContentBuilt), which is the same moment it would have filled it anyway. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4">
                                        <RibbonGalleryPanel x:Name="PART_DropDownPanel"/>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsed: the grid goes, the chevron stays. Only VISIBILITY changes - the whole set is still one press away. -->
    <Style Selector="RibbonGallery">
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="Viewport" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_ScrollUp" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_ScrollDown" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RepeatButton.GalleryArrow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style Selector="Button.GalleryArrow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- One choice. No background at rest, like a list row: a gallery of forty cells would otherwise be forty fills. -->
    <Style Selector="RibbonGalleryItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="{ResourceReference ControlFillColorSecondary}"/>
        <Setter Property="BorderBrushSelected" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RibbonGalleryItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonGalleryItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGalleryItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{TemplateBinding BorderBrushSelected}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.CollapsedGroupButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- ONE template covers all three sizes: the icon box and the label swap cells (and the label goes) via triggers on
         Ribbon.Size. One presenter for the label - content is a single element and can live in only one layout. -->
    <Style Selector="RibbonButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <!-- Large centres (nothing to line up with); the smaller sizes go LEFT - in a column they stand under one
             another, and a ragged left edge is the first thing the eye catches. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="ForegroundDisabled" Value="{ResourceReference TextFillColorDisabled}"/>
        <Setter Property="Padding" Value="8 6"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <!-- Default icon drawing: path data stroked in whatever colour the icon slot carries. `{Binding}` is the icon
             itself - a string converts to a Geometry on the way in, as it does when written as an attribute. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- The 16-unit box icons are authored on, stated. Without it a Shape is measured by its own tight
                         ink (origin -> painted edge), so the Viewbox scales every icon by a different factor and they
                         sit at different heights. -->
                    <Grid Width="16" Height="16">
                        <Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Icon and label sit in different cells, so it is this block - not the label - that
                             HorizontalContentAlignment has to place. -->
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The icon is DATA drawn by IconTemplate. Its colour travels through the presenter's
                                 Foreground, so states recolour it without reaching into that template. -->
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <!-- The ICON greys out with the label - it is the part a person aims at. -->
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Medium: small icon, label beside it. The label moves CELL, so one presenter serves every size. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="IconBox" Property="Width" Value="16"/>
            <Setter TargetName="IconBox" Property="Height" Value="16"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Column" Value="1"/>
            <Setter TargetName="PART_ContentPresenter" Property="Margin" Value="6 0 0 0"/>
            <!-- The whole command goes left: in a column the icons must start at one x. On the CONTROL, so it flows
                 through the one template binding. -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
        <!-- Small: the icon alone. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="IconBox" Property="Width" Value="16"/>
            <Setter TargetName="IconBox" Property="Height" Value="16"/>
            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
    </Style>

    <!-- Non-large commands are three to a column, so they must be short and must not claim a large command's width. -->
    <Style Selector="RibbonButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4 2"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4 2"/>
        </PropertyTrigger>
    </Style>

    <!-- A ribbon command with a checked state on top: brushes, metrics, icon drawing and every state/size trigger come
         from RibbonButton. BasedOn crosses types - the two share no base class (Button vs ToggleButton). -->
    <Style Selector="RibbonToggleButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Only the checked look. The inherited triggers land because this template names its parts the same. -->
    <Style Selector="RibbonToggleButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
    </Style>

    <!-- A command that drops a menu. Same command layout with an arrow after it, and the arrow is the ONLY thing this
         template adds - the icon box, the label and all three size layouts come from RibbonButton through BasedOn,
         which lands because the parts are named the same. -->
    <!-- The FILE TAB and the backstage behind it. The tab stretches the full height of the strip and carries no margin:
         it is the head of the row of tabs, not a chip floating over it. -->
    <Style Selector="RibbonApplicationMenu">
        <Setter Property="RailWidth" Value="200"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonApplicationMenu">
                    <Grid>
                        <ToggleButton x:Name="PART_Button"
                                Classes="RibbonFileTab"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"/>

                        <!-- FillWindow: the backstage takes the window over. KeepOpen because there IS no outside to
                             press - Escape and the back arrow are the ways out. -->
                        <Popup x:Name="PART_Popup" FillWindow="True" KeepOpen="True">
                            <!-- The whole backstage builds on FIRST OPEN (ChildTemplate), not with the ribbon's template:
                                 it is a window-sized page plus a row per command, and an application that is never asked
                                 for its File page pays for none of it. {Ancestor} rather than {TemplateBinding}, because a
                                 ChildTemplate is built against the POPUP; and rather than a DataContext on the popup,
                                 because the rows' PAGES bind to the view model and a DataContext here would take it from
                                 them. The back button and the items host arrive with the content (Popup.ContentBuilt). -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                  <Grid RowDefinitions="Auto,*">
                                    <!-- The caption keeps its own strip: the window buttons stay reachable, and this spacer is
                                         see-through AND untouchable so presses land on the title bar underneath. -->
                                    <Border Grid.Row="0" Height="{Ancestor RibbonApplicationMenu, CaptionInset, Logical=True}"
                                            Background="Transparent" IsHitTestVisible="False"/>

                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*"
                                            Background="{ResourceReference SolidBackgroundFillColorBase}">
                                        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto"
                                                Width="{Ancestor RibbonApplicationMenu, RailWidth, Logical=True}"
                                                Background="{ThemeResource AccentFillColorDefault}">
                                            <Button x:Name="PART_BackButton" Grid.Row="0"
                                                    Classes="RibbonBackstageBack"
                                                    ToolTip="Back"/>

                                            <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="1"/>

                                            <ContentPresenter Grid.Row="2"
                                                    Content="{Ancestor RibbonApplicationMenu, FooterPaneContent, Logical=True}"
                                                    ContentTemplate="{Ancestor RibbonApplicationMenu, FooterPaneContentTemplate, Logical=True}"/>
                                        </Grid>

                                        <ContentPresenter Grid.Column="1" Margin="40 28"
                                                Content="{Ancestor RibbonApplicationMenu, SelectedPage, Logical=True}"
                                                ContentTemplate="{Ancestor RibbonApplicationMenu, SelectedPageTemplate, Logical=True}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                  </Grid>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The OTHER shape: the panel dropped under the button, as Office had it before 2013. Same rows, same pages -
         a card sized to its content instead of the whole window, and an outside press puts it away. -->
    <Style Selector="RibbonApplicationMenu">
        <PropertyTrigger Property="IsBackstage" Value="false">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RibbonApplicationMenu">
                        <Grid>
                            <ToggleButton x:Name="PART_Button"
                                    Classes="RibbonFileTab"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"/>

                            <!-- A menu, so a press outside puts it away. The backstage is the one with no outside, and
                                 IgnoreTargetPress so the press that OPENS it is not also the press that dismisses it. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True"
                                    KeepOpen="False" IgnoreTargetPress="True">
                                <!-- Deferred to first open, and bound through {Ancestor}, for the same reasons as the
                                     backstage above. -->
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="6">
                                            <!-- ONE card: the rail runs the full height with the footer at its foot, and the
                                                 pane is a lighter field beside it. Two stacked halves read as two panels. -->
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Grid Grid.Column="0" RowDefinitions="*,Auto"
                                                        Width="{Ancestor RibbonApplicationMenu, RailWidth, Logical=True}"
                                                        Background="{ThemeResource AccentFillColorDefault}">
                                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"
                                                            VerticalAlignment="Top"/>
                                                    <ContentPresenter Grid.Row="1"
                                                            Content="{Ancestor RibbonApplicationMenu, FooterPaneContent, Logical=True}"
                                                            ContentTemplate="{Ancestor RibbonApplicationMenu, FooterPaneContentTemplate, Logical=True}"/>
                                                </Grid>

                                                <Border Grid.Column="1" MinWidth="300" MinHeight="260"
                                                        Background="{ResourceReference SolidBackgroundFillColorBase}">
                                                    <ContentPresenter Margin="24 20"
                                                            Content="{Ancestor RibbonApplicationMenu, SelectedPage, Logical=True}"
                                                            ContentTemplate="{Ancestor RibbonApplicationMenu, SelectedPageTemplate, Logical=True}"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.RibbonFileTab">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
        <!-- Translucent whites LAID OVER the accent, the way a caption button on an accent header does it - a state
             brush that replaced the background would wash the accent away entirely. -->
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference OnAccentOverlayPointerOver}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference OnAccentOverlayPressed}"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16 7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- A DESTINATION, unlike the minimize chevron beside the strip: it opens the backstage, so the keyboard has to
             be able to stand on it. It heads the strip, so Left off the first tab reaches it. -->
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            UseAnalyticAA="False">
                        <Border x:Name="Overlay"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                UseAnalyticAA="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.RibbonFileTab">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Overlay" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Overlay" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <!-- The arrow out of the backstage, at the head of the rail. -->
    <Style Selector="Button.RibbonBackstageBack">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference OnAccentOverlayPointerOver}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference OnAccentOverlayPressed}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- A ROW of the rail, not a button sitting in one: the whole width answers to the pointer, as it does in Word.
             The glyph keeps the rows' own left offset so it lines up with their icons. -->
        <Setter Property="Padding" Value="20 0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid Width="28" Height="28"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center">
                            <Ellipse Width="28" Height="28"
                                    Stroke="{ThemeResource AccentForegroundColor}" StrokeThickness="1.2"/>
                            <Path Data="M16,8 L10,14 L16,20 M10,14 L20,14"
                                    Stroke="{ThemeResource AccentForegroundColor}" StrokeThickness="1.4"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.RibbonBackstageBack">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <!-- A rail row: icon, label, and the lit state marking whose page is showing. -->
    <Style Selector="RibbonApplicationMenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference OnAccentOverlayPointerOver}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference OnAccentOverlayPressed}"/>
        <Setter Property="BackgroundSelected" Value="{ResourceReference OnAccentOverlayPressed}"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="20 0"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Without this the icon is DATA with nothing to draw it, and the presenter shows the path text itself. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="16" Height="16">
                        <Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonApplicationMenuItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Icon and label travel as ONE block, so centring the row centres the pair rather than
                             leaving the icon pinned to the edge with the label adrift. -->
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter x:Name="PART_Icon" Width="16" Height="16"
                                    Margin="0 0 14 0"
                                    Content="{TemplateBinding Icon}"
                                    ContentTemplate="{TemplateBinding IconTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonApplicationMenuItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
        </PropertyTrigger>
    </Style>

    <!-- The words live here, not in the control: what the entry says is a matter of language, and it says the opposite
         thing once the command is already in the bar. -->
    <Style Selector="RibbonQuickAccessMenuItem" BasedOn="MenuItem"/>

    <Style Selector="RibbonQuickAccessMenuItem">
        <Setter Property="Header" Value="Add to quick access"/>
    </Style>

    <Style Selector="RibbonQuickAccessMenuItem">
        <PropertyTrigger Property="IsInQuickAccess" Value="true">
            <Setter Property="Header" Value="Remove from quick access"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RibbonDropDownButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonDropDownButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonDropDownButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            <!-- Large stacks the arrow UNDER the label, the smaller sizes put it after - and BOTH are
                                 here, chosen by visibility. Moving one glyph between cells with triggers is what left the
                                 split button in a mixed state when the sizes stepped through each other. -->
                            <Path x:Name="DropDownGlyph" Grid.Row="2" Grid.Column="0"
                                    Data="M0,0 L4,4 L8,0" StrokeThickness="1" Margin="0 3 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stroke="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonDropDownButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="2"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="5 0 0 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="1"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="3 0 0 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Checked IS "the menu is down" - the command stays lit for as long as its flyout is. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
    </Style>

    <!-- How a drop-down draws itself in the quick-access bar: the SAME control at its Small size, so the caption and the
         band speak one language, with the bar's own darkening hover. The menu is rebuilt from the rows the command
         handed over as data - the ribbon's own ContextMenu stays where it is. -->
    <Style Selector="RibbonDropDownButton">
        <Setter Property="Ribbon.QuickAccessTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RibbonDropDownButton Ribbon.Size="Small"
                            Ribbon.Icon="{Binding Icon}"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Foreground="{Ancestor RibbonQuickAccess, Foreground}"
                            Background="Transparent"
                            BackgroundPointerOver="{ResourceReference OnAccentShadePointerOver}"
                            BackgroundPressed="{ResourceReference OnAccentShadePressed}"
                            BorderThickness="0"
                            CornerRadius="4"
                            Padding="6 0"
                            Height="26">
                        <RibbonDropDownButton.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </RibbonDropDownButton.ContextMenu>
                        <RibbonDropDownButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}"
                                    ItemTemplate="{Binding DropDownItemTemplate}"/>
                        </RibbonDropDownButton.DropDownMenu>
                    </RibbonDropDownButton>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two commands in one: the body runs the action, the arrow drops the menu. The halves therefore light SEPARATELY,
         and the root is deliberately NOT named Chrome - the whole-button hover inherited from RibbonButton would paint
         over the distinction, and a setter whose part is absent does nothing. -->
    <Style Selector="RibbonSplitButton" BasedOn="RibbonButton"/>

    <!-- The split button keeps BOTH halves in the bar: the body still runs the action, the arrow still drops the rows.
         Its own setter, not the drop-down's - a style is matched to the nearest type, so the base one never reaches it. -->
    <Style Selector="RibbonSplitButton">
        <Setter Property="Ribbon.QuickAccessTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RibbonSplitButton Ribbon.Size="Small"
                            Ribbon.Icon="{Binding Icon}"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}"
                            Foreground="{Ancestor RibbonQuickAccess, Foreground}"
                            Background="Transparent"
                            BackgroundPointerOver="{ResourceReference OnAccentShadePointerOver}"
                            BackgroundPressed="{ResourceReference OnAccentShadePressed}"
                            BorderThickness="0"
                            CornerRadius="4"
                            Padding="6 0"
                            Height="26">
                        <RibbonSplitButton.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </RibbonSplitButton.ContextMenu>
                        <RibbonSplitButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}"
                                    ItemTemplate="{Binding DropDownItemTemplate}"/>
                        </RibbonSplitButton.DropDownMenu>
                    </RibbonSplitButton>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonSplitButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonSplitButton">
                    <Border x:Name="SplitChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Three cells in each direction: at Large the split is HORIZONTAL - action on top, arrow
                             underneath - and the triggers below move the rule and the arrow into the right-hand column
                             for the smaller sizes. A large command is a stack, so an arrow floating beside it reads as
                             something that fell off rather than as the button's other half. -->
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The command's OWN padding, not a fixed one: the size triggers tighten Padding for Medium and Small, and a
                                 hardcoded value here kept the split button 56x30 where its neighbours were 24x22 - a
                                 column stretched to fit it, and the icons beside it floating in the slack. -->
                            <Border x:Name="ActionArea" Grid.Row="0" Grid.Column="0"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4 4 0 0">
                                <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                            Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="PART_Icon"
                                                Foreground="{TemplateBinding Foreground}"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"/>
                                    </Viewbox>
                                    <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                            Margin="0 4 0 0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                                </Grid>
                            </Border>

                            <Rectangle x:Name="SplitRule" Grid.Row="1" Grid.Column="0" Height="1" Margin="5 0"
                                    HorizontalAlignment="Stretch"
                                    Fill="{ResourceReference ControlStrokeColorDefault}"/>

                            <!-- A real element with a size, not a glyph in a corner: the control asks this part where the
                                 pointer is. -->
                            <Border x:Name="PART_DropDownArea" Grid.Row="2" Grid.Column="0" Padding="5 3"
                                    CornerRadius="0 0 4 4">
                                <Path x:Name="DropDownGlyph"
                                        Data="M0,0 L4,4 L8,0" StrokeThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Stroke="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Medium and Small are a ROW, so the split turns: the arrangement below is hidden and the one beside it shown.
         Small drops the dividing rule as well - a 24px command cannot afford the furniture the large one wears. -->
    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="4 0 0 4"/>
            <Setter TargetName="SplitRule" Property="Grid.Row" Value="0"/>
            <Setter TargetName="SplitRule" Property="Grid.Column" Value="1"/>
            <Setter TargetName="SplitRule" Property="Width" Value="1"/>
            <Setter TargetName="SplitRule" Property="Height" Value="NaN"/>
            <Setter TargetName="SplitRule" Property="Margin" Value="0 5"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="3 2"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="0 4 4 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="4 0 0 4"/>
            <Setter TargetName="SplitRule" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="1 2"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="0 4 4 0"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="IsPointerOverDropDown" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="true"/>
                <Condition Property="IsPointerOverDropDown" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="ActionArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- A plain row of small buttons; no chrome of its own - it sits inside the caption's. -->
    <Style Selector="RibbonQuickAccess">
        <!-- Stretched, its row of buttons would sit against the TOP of the caption: the slot centres what it is given,
             and something that fills the slot has nothing left to centre. -->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- The caption is finite and shared with the window title, so the bar is given a budget rather than allowed to
             grow: what does not fit goes under the chevron instead of pushing the title off the edge. -->
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonQuickAccessPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonQuickAccess">
                    <!-- The chevron's column is the width the panel reserved for it - stated once, on the control. -->
                    <Grid ColumnDefinitions="Auto,{TemplateBinding OverflowButtonWidth}">
                        <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Column="0"/>

                        <!-- A Button, not a ToggleButton: the class style below names Button, and a ToggleButton is its
                             SIBLING (both ButtonBase), so it would silently fall back to the default toggle look. The
                             open state lives on the menu, which is the only thing that really knows it. -->
                        <Button x:Name="PART_OverflowButton" Grid.Column="1"
                                Classes="QuickAccessButton"
                                Visibility="Collapsed"
                                ToolTip="More commands">
                            <!-- The same chevron a drop-down command draws. -->
                            <Path Data="M0,0 L4,4 L8,0"
                                    Stroke="{Ancestor RibbonQuickAccess, Foreground}" StrokeThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Its own row template: the list holds the bar's DATA items, and a menu given no template
                             draws them by their type name. Icon in the row's gutter plus the label - a column of
                             unnamed glyphs reads worse here than in the bar, where at least the position is a hint. -->
                        <ContextMenu x:Name="PART_OverflowMenu"
                                ItemsSource="{TemplateBinding OverflowItems}">
                            <ContextMenu.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem Header="{Binding OverflowLabel}"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding CommandParameter}">
                                        <MenuItem.Icon>
                                            <!-- The ROW's foreground: a popup is a detached subtree, so {Ancestor} cannot
                                                 reach the bar from here. -->
                                            <Path Data="{Binding Icon}"
                                                    Stroke="{Ancestor MenuItem, Foreground}"
                                                    StrokeThickness="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </DataTemplate>
                            </ContextMenu.ItemTemplate>
                        </ContextMenu>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The chevron appears only when something actually did not fit. Its WIDTH is reserved either way (see
         RibbonQuickAccess.OverflowButtonWidth), so showing it never changes what fits. -->
    <Style Selector="RibbonQuickAccess">
        <PropertyTrigger Property="HasOverflowItems" Value="true">
            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- A DATA item in the bar. Most commands are an icon button; one that brought its OWN compact form (a slider, a
         drop-down) is drawn by that instead - the bar's selector owns the choice, because an ItemTemplate would win over
         it and it would never be asked. An authored control is its own container and reaches neither.
         The theme states the LOOK of the ordinary case only: an application that puts its own selector on the bar to add
         a case of its own keeps this button for everything else. -->
    <Style Selector="RibbonQuickAccess">
        <Setter Property="DefaultItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- Taking a command back out is done HERE, on the button itself, the way Office does it -
                         having to find the command again in the ribbon to undo a one-click addition is a poor
                         trade. -->
                    <Button Classes="QuickAccessButton"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <!-- The BAR's foreground, not the caption's: below the ribbon there is no TitleBar to
                             ask, and the icons would come out with no stroke at all. The caption instance takes
                             its colour from the title bar, so they still follow its active/inactive state. -->
                        <Path Data="{Binding Icon}"
                                Stroke="{Ancestor RibbonQuickAccess, Foreground}" StrokeThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A TOGGLE in the bar wears the same plate as a button, but needs its own checked look: the default one paints
         AccentFillColorDefault, which is the very colour the active caption is painted with - a checked command would
         disappear into it. Here checked is a standing darker plate, the hover shade one notch deeper. -->
    <Style Selector="ToggleButton.QuickAccessButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference OnAccentShadePointerOver}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference OnAccentShadePressed}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ToggleButton.QuickAccessButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{ResourceReference OnAccentShadePressed}"/>
            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="Transparent"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="Button.QuickAccessButton">
        <Setter Property="Background" Value="Transparent"/>
        <!-- DARKENS. These sit on the caption, which is the accent colour while the window is active, and a lightening
             overlay on it is all but invisible. -->
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference OnAccentShadePointerOver}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference OnAccentShadePressed}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <!-- The row it sits in claims the caption's FULL height, so centring the bar centres nothing - the button is what
             has to stand in the middle, level with the window title. -->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</StyleSet>
