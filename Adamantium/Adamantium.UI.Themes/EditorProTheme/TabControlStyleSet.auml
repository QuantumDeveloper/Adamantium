<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Editor Pro's tab control is a RAIL over a page, not a card with a row of cards on top of it.

         Two shape decisions run through the whole file, and both are why this could not be a handful of overrides on
         Fluent's set:

         1. THE STRIP IS ITS OWN GROUND, one step up from the content, closed by a hairline on the content-facing edge.
            An editor stacks these inside docked panes, and a card with four rounded borders sitting inside another
            pane's border is a box inside a box - by the third level nobody can tell which frame belongs to what. A
            rail plus a rule reads at any depth.
         2. THE CONTENT HAS NO FRAME OF ITS OWN. Its Border is still bound to BorderThickness, so an author who asks
            for one still gets one; the theme just does not ask. The separating rule belongs to the STRIP (it is the
            strip's underline) which is also what makes it vanish together with the strip when ShowTabStrip is off -
            a rule left hanging over content with no tabs above it is the classic leftover.

         Everything else - the part names, the triggers, the pinned row, the overflow flyout, the edge fades - is
         Fluent's structure on purpose. That is behaviour: which parts the control finds, when it shows the overflow
         button, how the indicator is driven. Copying the names keeps all of it working while this file states only
         the shape. -->

    <Style Selector="TabControl" BasedOn="ItemsControl">
        <!-- The page paints NOTHING: whatever hosts the tab control - a docked pane, a window - already owns that
             ground, and a second opaque layer over it is one more surface to keep in step through every variant and
             accent swap. The STRIP does paint, opaquely and in the base ground, because the scroll fades dissolve
             into EdgeFadeColor and a fade over a see-through rail leaves a visible seam at its edge. -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingContent}"/>
        <!-- Shorter than Fluent's. This is a working surface: a tab that takes a fifth of a second to settle is a
             fifth of a second before the next click lands where it is aimed. -->
        <Setter Property="ReorderAnimationDuration" Value="0:0:0.12"/>
        <Setter Property="SelectionAnimationDuration" Value="0:0:0.12"/>
        <!-- {ThemeResource} so the mark follows an accent or variant swap live - the template paints
             PART_SelectionIndicator through TemplateBinding. -->
        <Setter Property="SelectionIndicatorBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="SelectionIndicatorThickness" Value="{ResourceReference TabIndicatorThickness}"/>

        <!-- The close button. SQUARE and sized to this theme's strip rather than to a finger: this is a
             mouse-and-keyboard editor, and Fluent's 24 square beside a 26 strip leaves the label almost nothing.
             The cross is DRAWN - a glyph is only as reliable as the font underneath it. -->
        <Setter Property="CloseButtonTemplate">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseBg"
                            Width="{ResourceReference TabButtonSize}"
                            Height="{ResourceReference TabButtonSize}"
                            CornerRadius="0" Background="Transparent">
                        <Path x:Name="CloseGlyph" Data="M0,0 L7,7 M7,0 L0,7"
                              Stroke="{ResourceReference TextFillColorTertiary}"
                              StrokeThickness="{ResourceReference StrokeThinValue}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="CloseBg" Property="Background" Value="{ResourceReference SubtleFillColorSecondary}"/>
                            <Setter TargetName="CloseGlyph" Property="Stroke" Value="{ResourceReference TextFillColorPrimary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- The pin button, same square. The thumbtack fills in solid once pinned: hollow against solid is how every
             editor tells the two apart, and it is the button reporting its own state rather than a second thing to
             read elsewhere. -->
        <Setter Property="PinButtonTemplate">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="PinBg"
                            Width="{ResourceReference TabButtonSize}"
                            Height="{ResourceReference TabButtonSize}"
                            CornerRadius="0" Background="Transparent">
                        <Path x:Name="PinGlyph" Data="M4,1 L8,1 L8,3 L10,5 L10,6 L7,6 L7,9 L6,11 L5,9 L5,6 L2,6 L2,5 L4,3 Z"
                              Stroke="{ResourceReference TextFillColorTertiary}"
                              StrokeThickness="{ResourceReference StrokeThinValue}"
                              Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="PinBg" Property="Background" Value="{ResourceReference SubtleFillColorSecondary}"/>
                            <Setter TargetName="PinGlyph" Property="Stroke" Value="{ResourceReference TextFillColorPrimary}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsChecked" Value="true">
                            <Setter TargetName="PinGlyph" Property="Fill" Value="{ThemeResource AccentFillColorDefault}"/>
                            <Setter TargetName="PinGlyph" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <TabPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A strip's list is JUST its items - no chrome, and above all no scroller of its own. The ordinary row already
         sits inside a TabStripScroller (that is what pans the strip on the wheel), and the ItemsControl default
         template wraps its items in a ScrollViewer, which swallows the wheel and leaves the strip unable to pan.
         Matching is by exact type, so this states the whole template rather than leaning on the base one. -->
    <Style Selector="TabItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItemsControl">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The overflow flyout's list: a ScrollViewer capped by MaxHeight that scrolls the CONTENT, so the list
         virtualizes - it may hold every tab of a long session, and realizing them all would cost exactly what the
         strip already costs at startup. The bar is HIDDEN, not disabled: it would overlay the rows' close button, and
         the wheel is how this list is scrolled anyway. This theme's own ScrollViewer keeps its bars visible, which is
         precisely why the visibility has to be said here.
         Applied BY CLASS, so this template lives once for every placement's overflow list. -->
    <Style Selector="ListBox.TabOverflowList">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer MaxHeight="{ResourceReference TabOverflowListMaxHeight}"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of the flyout: icon, name, close. Its item is a TabOverflowItem - a VIEW of a tab, never the tab, which
         is a live control and cannot be in the strip and in here at once. Everything it shows is data plus the
         template that draws it, so both places build their own visual from the same tab. -->
    <Style Selector="ListBox.TabOverflowList">
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="{ResourceReference TabOverflowRowMinWidth}">
                        <ContentPresenter Grid.Column="0"
                                VerticalAlignment="Center"
                                MarginRight="{ResourceReference GapSmall}"
                                Content="{Binding Icon}"
                                ContentTemplate="{Binding IconTemplate}"/>
                        <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{Binding Header}"
                                ContentTemplate="{Binding HeaderTemplate}"/>
                        <!-- Closes through the tab's own path, so a TabCloseRequested handler can veto it here too. -->
                        <Button Grid.Column="2"
                                MarginLeft="{ResourceReference GapSmall}"
                                Width="{ResourceReference TabButtonSize}"
                                Height="{ResourceReference TabButtonSize}"
                                MinWidth="0" MinHeight="0" Padding="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0" CornerRadius="0"
                                Command="{Binding Close}"
                                Visibility="{Binding CloseVisibility}">
                            <Path Data="M0,0 L7,7 M7,0 L0,7"
                                  Stroke="{ResourceReference TextFillColorTertiary}"
                                  StrokeThickness="{ResourceReference StrokeThinValue}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TOP (the default): rail above, page below. -->
    <Style Selector="TabControl[TabStripPlacement=Top]">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Two rows and three columns: the pinned row on top, then the scrolling strip with the
                             overflow button in its own Auto column beside it. The button RESERVES its space rather
                             than floating over the tabs, so the last tab ends before it instead of hiding behind it.
                             Its visibility is set POST-layout by the control, not mid-arrange.
                             The pinned row is OUTSIDE the scroller on purpose - that is what makes a pinned tab
                             impossible to scroll out of sight - and it WRAPS, so many pinned tabs cost further lines
                             instead of squeezing the rest. -->
                        <Grid x:Name="StripRow" Grid.Row="0"
                              RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                              Background="{ResourceReference SolidBackgroundFillColorBase}">

                            <Grid x:Name="PinnedRow" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                  Visibility="Collapsed">
                                <TabItemsControl x:Name="PART_PinnedTabs" ItemsSource="{TemplateBinding PinnedItems}">
                                    <TabItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </TabItemsControl.ItemsPanel>
                                </TabItemsControl>
                                <!-- Only ONE of the two indicators is ever wide: the control gives width to the one in
                                     the row holding the selected tab, so on screen it reads as a single mark moving
                                     between the rows. A bar cannot point at a tab in another row. -->
                                <Rectangle x:Name="PART_PinnedSelectionIndicator"
                                           Fill="{TemplateBinding SelectionIndicatorBrush}"
                                           Width="1"
                                           Height="{TemplateBinding SelectionIndicatorThickness}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <TabStripScroller x:Name="PART_TabStrip" Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Grid>
                                    <TabItemsControl x:Name="PART_Tabs" ItemsSource="{TemplateBinding UnpinnedItems}">
                                        <TabItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <TabPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </TabItemsControl.ItemsPanel>
                                    </TabItemsControl>
                                    <Rectangle x:Name="PART_SelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="1"
                                               Height="{TemplateBinding SelectionIndicatorThickness}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </TabStripScroller>

                            <!-- The edge fades: they say there are tabs past the edge. SIBLINGS of the scroller in its
                                 cell - inside it they would pan away with the very tabs they are dissolving. -->
                            <Border x:Name="BackFade" Grid.Row="1" Grid.Column="1"
                                    Width="{ResourceReference TabEdgeFadeExtent}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Row="1" Grid.Column="1"
                                    Width="{ResourceReference TabEdgeFadeExtent}"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- NOT focusable: it is reached by clicking, keyboard focus belongs to the tabs. It is
                                 also toggled shut in code after a pick, and a focus ring left drawn around it after
                                 every use is exactly the kind of leftover this theme's rings are meant to avoid. -->
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Row="1" Grid.Column="2"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          MinWidth="{ResourceReference TabOverflowButtonExtent}"
                                          Padding="0" Visibility="Collapsed"
                                          BorderThickness="0" CornerRadius="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Image Source="{ResourceReference ChevronDownIcon}"
                                       Width="{ResourceReference DropDownIconSize}"
                                       Height="{ResourceReference DropDownIconSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- The card and its list build LAZILY on first open (ChildTemplate): a list carries a
                                 scroll host and two scrollbars, and most strips never overflow at all. The list is
                                 picked up from the built content in code, since it is not in this namescope. -->
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Row="1" Grid.Column="2"
                                   Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                                BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                                BorderThickness="{ResourceReference StrokeThin}"
                                                CornerRadius="0"
                                                Padding="{ResourceReference MenuCardPadding}">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList"
                                                     MinWidth="{ResourceReference TabOverflowRowMinWidth}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>

                            <!-- The rule that closes the rail, on the content-facing edge and spanning the whole
                                 strip. It lives INSIDE StripRow, not around it, so ShowTabStrip=false takes the rule
                                 away with the tabs; a rule left over a page with no tabs above it is a stray line. -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                    Height="{ResourceReference StrokeThinValue}"
                                    VerticalAlignment="Bottom"
                                    Background="{ResourceReference ControlStrokeColorDefault}"
                                    IsHitTestVisible="False"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"
                                              DeferContent="{TemplateBinding DeferContent}"
                                              LoadingTemplate="{TemplateBinding LoadingTemplate}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- One tab stretched across the strip: a mark that says which of several is current has
                             nothing left to say. -->
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <!-- Outer placement puts the mark on the far side of the tab from the content. Which side
                             that is depends on the placement, which is why each template says it for itself. -->
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="PART_PinnedSelectionIndicator" Property="VerticalAlignment" Value="Top"/>
                        </PropertyTrigger>
                        <!-- Each row exists only while it holds tabs: an empty band of strip reads as a bug. -->
                        <PropertyTrigger Property="HasPinnedTabs" Value="true">
                            <Setter TargetName="PinnedRow" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="HasUnpinnedTabs" Value="false">
                            <Setter TargetName="PART_TabStrip" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <!-- Pinned tabs beside the others instead of above them. The tabs are unchanged - only where
                             their list sits. -->
                        <PropertyTrigger Property="PinnedTabsPlacement" Value="SameRow">
                            <Setter TargetName="PinnedRow" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="PinnedRow" Property="Grid.ColumnSpan" Value="1"/>
                            <!-- Left, not stretched: a stretched row answers with the whole width and leaves the
                                 starred column nothing, so the ordinary tabs end up with no width at all. -->
                            <Setter TargetName="PinnedRow" Property="HorizontalAlignment" Value="Left"/>
                            <!-- Nothing to wrap onto in a shared row, so it lays out as a plain strip. -->
                            <Setter TargetName="PART_PinnedTabs" Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <TabPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BOTTOM: page above, rail below, and the rule moves to the rail's top edge. -->
    <Style Selector="TabControl[TabStripPlacement=Bottom]">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid RowDefinitions="*,Auto">
                        <Border Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"
                                              DeferContent="{TemplateBinding DeferContent}"
                                              LoadingTemplate="{TemplateBinding LoadingTemplate}"/>
                        </Border>
                        <Grid x:Name="StripRow" Grid.Row="1" ColumnDefinitions="*,Auto"
                              Background="{ResourceReference SolidBackgroundFillColorBase}">
                            <TabStripScroller x:Name="PART_TabStrip" Grid.Column="0" Orientation="Horizontal">
                                <Grid>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                    <Rectangle x:Name="PART_SelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="1"
                                               Height="{TemplateBinding SelectionIndicatorThickness}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </TabStripScroller>
                            <Border x:Name="BackFade" Grid.Column="0"
                                    Width="{ResourceReference TabEdgeFadeExtent}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Column="0"
                                    Width="{ResourceReference TabEdgeFadeExtent}"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Column="1" VerticalAlignment="Stretch"
                                          Focusable="False"
                                          MinWidth="{ResourceReference TabOverflowButtonExtent}"
                                          Padding="0" Visibility="Collapsed"
                                          BorderThickness="0" CornerRadius="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Image Source="{ResourceReference ChevronDownIcon}"
                                       Width="{ResourceReference DropDownIconSize}"
                                       Height="{ResourceReference DropDownIconSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <!-- Opens UPWARD: the rail is at the bottom of the control, so a list dropped below it
                                 would land off the window. FlipToFit alone only saves it when there happens to be no
                                 room, which is not the same as knowing where this strip lives. -->
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Column="1"
                                   Placement="Top" FlipToFit="True" VerticalOffset="-2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                                BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                                BorderThickness="{ResourceReference StrokeThin}"
                                                CornerRadius="0"
                                                Padding="{ResourceReference MenuCardPadding}">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList"
                                                     MinWidth="{ResourceReference TabOverflowRowMinWidth}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                            <Border Grid.Column="0" Grid.ColumnSpan="2"
                                    Height="{ResourceReference StrokeThinValue}"
                                    VerticalAlignment="Top"
                                    Background="{ResourceReference ControlStrokeColorDefault}"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="VerticalAlignment" Value="Bottom"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LEFT: a vertical rail. Same rail, same rule, turned a quarter - the rule is on its right edge. -->
    <Style Selector="TabControl[TabStripPlacement=Left]">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <TabPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- The overflow button takes the bottom row: a vertical strip runs out of room DOWNWARD, so
                             the chevron reserves a row at the end rather than a column beside it. -->
                        <Grid x:Name="StripRow" Grid.Column="0" RowDefinitions="*,Auto"
                              Background="{ResourceReference SolidBackgroundFillColorBase}">
                            <TabStripScroller x:Name="PART_TabStrip" Grid.Row="0" Orientation="Vertical">
                                <Grid>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                    <Rectangle x:Name="PART_SelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="{TemplateBinding SelectionIndicatorThickness}"
                                               Height="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </TabStripScroller>
                            <Border x:Name="BackFade" Grid.Row="0"
                                    Height="{ResourceReference TabEdgeFadeExtent}"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Row="0"
                                    Height="{ResourceReference TabEdgeFadeExtent}"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Row="1" HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          MinHeight="{ResourceReference TabOverflowButtonExtent}"
                                          Padding="0" Visibility="Collapsed"
                                          BorderThickness="0" CornerRadius="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Image Source="{ResourceReference ChevronDownIcon}"
                                       Width="{ResourceReference DropDownIconSize}"
                                       Height="{ResourceReference DropDownIconSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <!-- Opens to the RIGHT, over the page: the button sits at the foot of the rail, and a list
                                 dropped below it would run off the bottom of the window. -->
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Row="1"
                                   Placement="Right" FlipToFit="True" HorizontalOffset="2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                                BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                                BorderThickness="{ResourceReference StrokeThin}"
                                                CornerRadius="0"
                                                Padding="{ResourceReference MenuCardPadding}">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList"
                                                     MinWidth="{ResourceReference TabOverflowRowMinWidth}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Width="{ResourceReference StrokeThinValue}"
                                    HorizontalAlignment="Right"
                                    Background="{ResourceReference ControlStrokeColorDefault}"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <Border Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"
                                              DeferContent="{TemplateBinding DeferContent}"
                                              LoadingTemplate="{TemplateBinding LoadingTemplate}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="HorizontalAlignment" Value="Left"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RIGHT: the mirror of Left - rail on the far side, rule on its left edge. -->
    <Style Selector="TabControl[TabStripPlacement=Right]">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <TabPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              ContentTransition="{TemplateBinding ContentTransition}"
                                              TransitionDuration="{TemplateBinding ContentTransitionDuration}"
                                              DeferContent="{TemplateBinding DeferContent}"
                                              LoadingTemplate="{TemplateBinding LoadingTemplate}"/>
                        </Border>
                        <Grid x:Name="StripRow" Grid.Column="1" RowDefinitions="*,Auto"
                              Background="{ResourceReference SolidBackgroundFillColorBase}">
                            <TabStripScroller x:Name="PART_TabStrip" Grid.Row="0" Orientation="Vertical">
                                <Grid>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                    <Rectangle x:Name="PART_SelectionIndicator"
                                               Fill="{TemplateBinding SelectionIndicatorBrush}"
                                               Width="{TemplateBinding SelectionIndicatorThickness}"
                                               Height="1"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </TabStripScroller>
                            <Border x:Name="BackFade" Grid.Row="0"
                                    Height="{ResourceReference TabEdgeFadeExtent}"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColor}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ForwardFade" Grid.Row="0"
                                    Height="{ResourceReference TabEdgeFadeExtent}"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{ObservableResource EdgeFadeColorTransparent}"/>
                                        <GradientStop Offset="1" Color="{ObservableResource EdgeFadeColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ToggleButton x:Name="PART_TabOverflow" Grid.Row="1" HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          MinHeight="{ResourceReference TabOverflowButtonExtent}"
                                          Padding="0" Visibility="Collapsed"
                                          BorderThickness="0" CornerRadius="0"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Background="{ResourceReference SolidBackgroundFillColorBase}">
                                <Image Source="{ResourceReference ChevronDownIcon}"
                                       Width="{ResourceReference DropDownIconSize}"
                                       Height="{ResourceReference DropDownIconSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <!-- To the LEFT, over the page, for the same reason as Left's opens right: this rail is
                                 against the far edge of the window. -->
                            <Popup x:Name="PART_TabOverflowPopup" Grid.Row="1"
                                   Placement="Left" FlipToFit="True" HorizontalOffset="-2">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                                BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                                BorderThickness="{ResourceReference StrokeThin}"
                                                CornerRadius="0"
                                                Padding="{ResourceReference MenuCardPadding}">
                                            <ListBox x:Name="PART_TabOverflowList" Classes="TabOverflowList"
                                                     MinWidth="{ResourceReference TabOverflowRowMinWidth}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Width="{ResourceReference StrokeThinValue}"
                                    HorizontalAlignment="Left"
                                    Background="{ResourceReference ControlStrokeColorDefault}"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowTabStrip" Value="false">
                            <Setter TargetName="StripRow" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="HasStretchedTab" Value="true">
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SelectionIndicatorPlacement" Value="Outer">
                            <Setter TargetName="PART_SelectionIndicator" Property="HorizontalAlignment" Value="Right"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsBack" Value="true">
                            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanScrollTabsForward" Value="true">
                            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
