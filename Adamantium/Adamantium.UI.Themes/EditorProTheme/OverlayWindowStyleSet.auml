<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A draggable window INSIDE the window. The overlay, the scrim, the cascade, the z-order and dismissal are the
         manager's; the chrome is here.

         Its caption is NOT accent-filled, for the third time in this theme and the same reason each time: an editor
         stacks these - a find, a rename, a settings sheet - and an accent bar on every one of them makes the loudest
         colour on screen mean nothing. Which one is in FRONT is said by its caption's text coming up to full strength
         while the others' step back, exactly as the main window says it.
         Square and hairline, on the panel ground rather than the card one: this is a window, and windows in this theme
         look like the one it sits in. -->

    <Style Selector="OverlayWindow">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingPanel}"/>
        <Setter Property="OverlayBrush" Value="{ResourceReference SmokeFillColorDefault}"/>
        <Setter Property="TitleBarBackground" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
        <Setter Property="TitleForeground" Value="{ResourceReference TextFillColorPrimary}"/>
        <!-- Sized to content and centred on the overlay; the manager then offsets and drags it. -->
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="OverlayWindow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="OverlayWindow">
                    <Border x:Name="PART_Window"
                            MinWidth="{ResourceReference OverlayMinWidth}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                            <!-- The caption. PART_TitleThumb is transparent and hit-testable, so the whole strip drags;
                                 pin and close sit in their own columns and stay clickable. Closed with a hairline, the
                                 same way the main window's caption is - it is a band, not a fill. -->
                            <Border x:Name="PART_TitleBar" Grid.Row="0"
                                    Background="{TemplateBinding TitleBarBackground}"
                                    BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                    BorderThickness="{ResourceReference TitleBarUnderline}"
                                    Height="{ResourceReference TitleBarHeight}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Grid x:Name="PART_TitleThumb" Grid.Column="0" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="{ResourceReference TitleBarTitleInset}">
                                            <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}"
                                                    Foreground="{TemplateBinding TitleForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="{ResourceReference TitleBarIconGap}"/>
                                            <ContentPresenter x:Name="PART_Title" Content="{TemplateBinding Title}"
                                                    Foreground="{TemplateBinding TitleForeground}"
                                                    FontSize="{ResourceReference FontSizeChrome}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- FULL HEIGHT of the caption, as a window's buttons are: given a size of its own the
                                         plate was a small square floating in the strip, and the hover read as landing
                                         beside the glyph rather than on the button. -->
                                    <Button x:Name="PART_PinButton" Grid.Column="1" Visibility="Collapsed"
                                            Classes="CaptionButton"
                                            Width="{ResourceReference DockHeaderButtonSize}"
                                            MinWidth="0" MinHeight="0" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            VerticalAlignment="Stretch">
                                        <!-- Drawn FROM THE ORIGIN: a Path is measured from 0,0 to the edge of its ink, so a
                                             glyph starting at x=3 sits in the right half of its own box and looks
                                             shoved over. Same tack as the docking caption. -->
                                        <Path x:Name="PinGlyph"
                                                Data="M2,0 L6,0 L6,2 L8,4 L8,5 L5,5 L5,8 L4,10 L3,8 L3,5 L0,5 L0,4 L2,2 Z"
                                                Stroke="{TemplateBinding TitleForeground}"
                                                StrokeThickness="{ResourceReference StrokeThinValue}"
                                                Fill="Transparent"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="PART_CloseButton" Grid.Column="2"
                                            Classes="CaptionButton CloseButton"
                                            Width="{ResourceReference DockHeaderButtonSize}"
                                            MinWidth="0" MinHeight="0" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            VerticalAlignment="Stretch">
                                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                                                Stroke="{TemplateBinding TitleForeground}"
                                                StrokeThickness="{ResourceReference StrokeThinValue}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    Margin="{TemplateBinding Padding}"/>

                            <!-- PublishToWindow=False: this is an in-window card, not the OS window, so it must NOT
                                 drive the native resize - it resizes itself with a managed drag. -->
                            <ResizeGripper x:Name="PART_ResizeGrip" Grid.Row="1" Visibility="Collapsed"
                                    PublishToWindow="False"
                                    Width="{ResourceReference OverlayGripSize}"
                                    Height="{ResourceReference OverlayGripSize}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="OverlayWindow">
        <PropertyTrigger Property="CanClose" Value="false">
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanPin" Value="true">
            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanResize" Value="true">
            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- Pinned: the tack fills in. The same filled/hollow pair the docking caption uses for auto-hide, so the two
             mean the same thing in both places. -->
        <PropertyTrigger Property="IsPinned" Value="true">
            <Setter TargetName="PinGlyph" Property="Fill" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowTitleBar" Value="false">
            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Not the front-most one: the caption's TEXT steps back. The ground does not move - see the note at the top -
             so a stack of these reads as one in front and the rest behind, without a second colour on screen. -->
        <PropertyTrigger Property="IsActive" Value="false">
            <Setter Property="TitleForeground" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
