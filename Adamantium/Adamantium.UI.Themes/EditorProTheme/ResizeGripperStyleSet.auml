<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The bottom-right corner grip of a grip-only-resize window. The whole control box is the hit region (it publishes
         ResizeGripRect, which the platform hit-test turns into HTBOTTOMRIGHT); the Transparent background keeps it
         present, and the OS hands back the NWSE cursor because the hit-test reports a sizing corner.

         THREE DIAGONAL RULES rather than Fluent's triangle of dots - the same decision as the drag handle, for the same
         reason. Dots are a touch-sized affordance; a hairline mark reads at this theme's density and states the AXIS it
         resizes along, which a dot cluster cannot. Tertiary, because a grip that is always in the corner of every
         window should be findable without being noticed. -->

    <Style Selector="ResizeGripper">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ResizeGripper">
                    <Border Background="Transparent">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="{ResourceReference ResizeGripInset}"
                              Stroke="{ResourceReference TextFillColorTertiary}"
                              StrokeThickness="{ResourceReference StrokeThinValue}"
                              Data="M14,4 L4,14 M14,9 L9,14 M14,14 L13,15"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
