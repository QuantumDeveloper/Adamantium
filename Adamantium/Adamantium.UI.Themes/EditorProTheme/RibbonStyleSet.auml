<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Editor Pro's ribbon. An editor does not LEAD with a ribbon - it is a toolbar here, not the way anything is
         really done - and two things follow from that, which are what this whole file is about:

         1. NO ACCENT WALLS. Fluent paints the File tab and the entire backstage rail in the accent colour: a 180-wide
            column of the loudest colour in the palette, standing next to the work. This theme's whole premise is that
            the WORK is the bright thing on screen and the furniture is not, so the rail is an ordinary raised panel
            and the row whose page is open is marked by an accent RULE down its leading edge - the same mark the tabs
            use, at a hundredth of the area.
            This is not only taste. The quick-access bar sits on the caption, and Fluent's version darkens on hover
            (OnAccentShade*) precisely because it assumes an accent caption underneath. Editor Pro's caption is a plain
            dark plate, so those brushes would be all but invisible on it: the bar has to lighten here, not darken. A
            borrowed ribbon could not have got that right.

         2. SQUARE, AND THIS THEME'S DENSITY. Plates meet edge to edge; the band is three of this theme's rows plus a
            caption rather than Fluent's 106.

         The PART NAMES, the panels and every trigger are Fluent's on purpose - that is behaviour, and a great deal of
         it: which host holds a collapsed group's content, how the adaptive pass reaches the sizes, when the scroll
         arrows appear. Copying the names keeps all of it working while this file states the shape.

         Per convention: simple properties, then the template, then the triggers. -->

    <Style Selector="Ribbon">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <!-- How long the minimized band takes to slide out and back. Short: it is a panel appearing, not a reveal. -->
        <Setter Property="FlyoutTransitionDuration" Value="0:0:0.12"/>
        <Setter Property="BorderThickness" Value="{ResourceReference RibbonRule}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <!-- Constant, so switching tabs never reflows the window. -->
        <Setter Property="GroupsAreaHeight" Value="{ResourceReference RibbonBandHeight}"/>
    </Style>

    <!-- The right-click menu every command in a band is given, unless its author wrote one. A TEMPLATE, because each
         command needs its own menu - a menu points at ONE command - and a setter would hand them all the same object. -->
    <Style Selector="Ribbon">
        <Setter Property="Ribbon.CommandContextMenuTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContextMenu>
                        <RibbonQuickAccessMenuItem/>
                    </ContextMenu>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The strip's OWN panel, not a TabPanel: the ledge has to travel and be clipped with the tabs under it. -->
    <Style Selector="Ribbon">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonTabPanel LedgeHeight="{ResourceReference RibbonLedgeHeight}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The ledge over a contextual run: the group's own colour carrying its title. This is the ONE place the ribbon
         is allowed a coloured plate, and it earns it - the colour is what ties a run of tabs to the object that
         summoned them, and there is no smaller mark that can say "these three tabs belong to that selection". -->
    <Style Selector="RibbonContextualLedge">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeMicro}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonLedgePadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonContextualLedge">
                    <!-- Never clipped and never wider than its run: the PANEL widens the tabs until the title fits.
                         UseAnalyticAA off because this plate meets the tabs below it edge to edge, and a soft edge
                         leaves a hairline along the join. -->
                    <Border Background="{TemplateBinding Accent}"
                            UseAnalyticAA="False">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                Height="{TemplateBinding TitleHeight}"
                                VerticalAlignment="Top"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Ribbon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Ribbon">
                    <!-- Clipped: an open tab's chrome is flush with the band's top edge, and the coverage fringe that
                         antialiases it reaches half a pixel past - onto the caption above. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <!-- "File" stands at the HEAD of the strip, before the tabs. Named because the key-tip
                                     mode gathers its first level from named places, not from a common ancestor. -->
                                <ContentPresenter x:Name="PART_ApplicationMenuHost" Grid.Column="0"
                                        Content="{TemplateBinding ApplicationMenu}"/>

                                <!-- The strip. Its containers are RibbonTabHeaders, generated by the ribbon itself. -->
                                <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Column="1"/>

                                <ToggleButton x:Name="PART_MinimizeButton" Grid.Column="2"
                                        Classes="RibbonMinimizeButton"
                                        IsChecked="{TemplateBinding IsMinimized}"
                                        ToolTip="Collapse the ribbon"/>
                            </Grid>

                            <!-- Holds the SELECTED TAB ITSELF, which presents its own groups; the strip shows a header
                                 for it. Minimizing MOVES that presenter into the flyout below, so its groups keep the
                                 variants they worked out.
                                 One step up from the strip and closed by a rule, exactly as this theme's tab rail: the
                                 open tab header shares this ground, so the two read as one plate with the accent line
                                 saying which tab it belongs to. -->
                            <Border x:Name="Band" Grid.Row="1"
                                    Height="{TemplateBinding GroupsAreaHeight}"
                                    Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                    BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                    BorderThickness="0 1 0 0"
                                    ClipToBounds="True">
                                <Border x:Name="PART_BandHost">
                                    <!-- STRETCHED across, not sized to content: the open tab has to be told how much
                                         room the band actually has, because that arrange width is what the groups
                                         choose their variants from. Sized to content, a tab would always be handed
                                         exactly what it asked for and would never learn the window had narrowed. The
                                         groups still sit left - their panel lays out from x=0 and reports what it
                                         used. -->
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                            Content="{TemplateBinding SelectedContent}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                                </Border>
                            </Border>

                            <!-- The band's own row: whatever the application puts under it. -->
                            <ContentPresenter Grid.Row="2" Content="{TemplateBinding FooterContent}"/>

                            <!-- The minimized band's groups, drawn OVER the content below. An overlay is not a choice:
                                 kept in a row of its own it would push the content down - the one thing a minimized
                                 ribbon must not do - and be clipped by the root border. But it must not READ as a
                                 flyout: it is the band itself, so it spans the ribbon's full width and wears the
                                 band's own chrome. The width also does the aligning - Bottom placement CENTRES on its
                                 target, so anything narrower than the ribbon drifts into the middle of the window. -->
                            <Popup x:Name="PART_Flyout" Grid.Row="1" Placement="Bottom">
                                <Border Width="{TemplateBinding ActualWidth}"
                                        Height="{TemplateBinding GroupsAreaHeight}"
                                        Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                        BorderThickness="0 1 0 1"
                                        ClipToBounds="True">
                                    <!-- The band SLIDES out from under the strip: the frame above is a fixed-height
                                         window that clips, and this is what moves inside it. A transform, not a
                                         height: a growing height would re-run the whole adaptive pass every frame,
                                         while a transform is a compositor channel and costs nothing per frame. -->
                                    <Border x:Name="PART_FlyoutHost">
                                        <Border.RenderTransform>
                                            <Transform/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimized: the band's row goes away, leaving the strip and whatever the footer holds. -->
    <Style Selector="Ribbon">
        <PropertyTrigger Property="IsMinimized" Value="true">
            <Setter TargetName="Band" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Width" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonChipHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MarginRight" Value="{ResourceReference GapSmall}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Chevron: points UP to put the band away, DOWN to bring it back. -->
                        <Path x:Name="Chevron" Data="M3,7 L7,3 L11,7"
                                Stroke="{ResourceReference TextFillColorSecondary}"
                                StrokeThickness="{ResourceReference StrokeThinValue}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chevron" Property="Data" Value="M3,3 L7,7 L11,3"/>
        </PropertyTrigger>
    </Style>

    <!-- The label in the strip. Its selected state is driven by the ribbon, so the look is a trigger on IsSelected. -->
    <Style Selector="RibbonTabHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorTertiary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <!-- The band's ground, so the open tab and the band under it are one plate. -->
        <Setter Property="BackgroundSelected" Value="{ResourceReference SolidBackgroundFillColorTertiary}"/>
        <Setter Property="ForegroundSelected" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonTabPadding}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RibbonTabHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTabHeader">
                    <Grid>
                        <!-- Square and un-antialiased: plates meeting edge to edge, and a soft edge leaves a hairline
                             down each join. -->
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                UseAnalyticAA="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Border>
                        <!-- The accent rule under the open tab, INSIDE the header - a ribbon's strip does not move, so
                             unlike the tab control there is nothing to slide and each header carries its own. -->
                        <Rectangle x:Name="Underline"
                                Height="{ResourceReference TabIndicatorThickness}" Opacity="0"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Fill="{ThemeResource AccentFillColorDefault}"
                                IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonTabHeader">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
        </PropertyTrigger>
    </Style>

    <!-- AFTER the state triggers above, so the open contextual tab keeps its context. -->
    <Style Selector="RibbonTabHeader">
        <PropertyTrigger Property="IsContextual" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding Accent}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
            <Setter TargetName="Underline" Property="Fill" Value="{TemplateBinding Accent}"/>
        </PropertyTrigger>
    </Style>

    <!-- Open AND contextual: the ordinary open fill; what marks it is the rule under it, in the context's colour. -->
    <Style Selector="RibbonTabHeader">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsContextual" Value="true"/>
                <Condition Property="IsSelected" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </MultiTrigger>
    </Style>

    <!-- A tab is its groups in a row, plus the last-resort scroll: a full-height arrow at each edge with a fade BESIDE
         it (inward), so the row dissolves into the arrow instead of being cut by a hard line. No scrollbar - a bar
         would eat height from a band that has none to spare. The arrows overlay the row rather than taking width from
         it: reserving space would make the width depend on the answer it produces, and every tab that never scrolls
         would pay for them. Each arrow therefore rides an OPAQUE plate, and the row scrolls underneath it.
         The plate is painted in the BAND's ground here, not the strip's: this row lives in the band. -->
    <Style Selector="RibbonTab">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGroupsPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTab">
                    <Grid ClipToBounds="True">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>

                        <!-- The fade starts where the arrow ends (MarginLeft = the plate's width) and runs inward. -->
                        <Border x:Name="BackFade"
                                Width="{ResourceReference RibbonScrollFadeWidth}"
                                MarginLeft="{ResourceReference RibbonScrollPlateWidth}"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ObservableResource BandFadeColor}"/>
                                    <GradientStop Offset="1" Color="{ObservableResource BandFadeColorTransparent}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="BackPlate"
                                Width="{ResourceReference RibbonScrollPlateWidth}"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Background="{ResourceReference SolidBackgroundFillColorTertiary}">
                            <RepeatButton x:Name="PART_ScrollBack" Classes="RibbonScrollButton">
                                <Path Data="M5,1 L1,5 L5,9"
                                      Stroke="{ResourceReference TextFillColorSecondary}"
                                      StrokeThickness="{ResourceReference StrokeThinValue}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Border>

                        <Border x:Name="ForwardFade"
                                Width="{ResourceReference RibbonScrollFadeWidth}"
                                MarginRight="{ResourceReference RibbonScrollPlateWidth}"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ObservableResource BandFadeColorTransparent}"/>
                                    <GradientStop Offset="1" Color="{ObservableResource BandFadeColor}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="ForwardPlate"
                                Width="{ResourceReference RibbonScrollPlateWidth}"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                Background="{ResourceReference SolidBackgroundFillColorTertiary}">
                            <RepeatButton x:Name="PART_ScrollForward" Classes="RibbonScrollButton">
                                <Path Data="M1,1 L5,5 L1,9"
                                      Stroke="{ResourceReference TextFillColorSecondary}"
                                      StrokeThickness="{ResourceReference StrokeThinValue}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shown only while there is somewhere to go in that direction - an arrow over an edge with nothing behind it is
         a promise the row cannot keep. -->
    <Style Selector="RibbonTab">
        <PropertyTrigger Property="CanScrollBack" Value="true">
            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
            <Setter TargetName="BackPlate" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanScrollForward" Value="true">
            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
            <Setter TargetName="ForwardPlate" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- Full height of the band, no corners: the arrow is an EDGE of the row, not a control sitting on it. Its plate
         supplies the opacity, so the state brushes here are the usual translucent washes over it. -->
    <Style Selector="RepeatButton.RibbonScrollButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- A group: its commands in columns, its caption underneath, a rule down its right edge. -->
    <Style Selector="RibbonGroup">
        <Setter Property="Padding" Value="{ResourceReference RibbonGroupPadding}"/>
        <!-- The mark on the button a collapsed group becomes. Without it the icon - path data, like a command's - is
             handed to a presenter with nothing to draw it, and comes out as the path TEXT: a strip of dashes. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="{ResourceReference IconSize}" Height="{ResourceReference IconSize}">
                        <Path Data="{Binding}" StrokeThickness="{ResourceReference StrokeThinValue}" Fill="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGroupPanel RowsPerColumn="3"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <!-- ONE template for both presentations, never swapped. PART_Content is the group's commands and
                     caption as a SINGLE block, and the group MOVES it between PART_InlineHost and PART_PopupHost when
                     it collapses. Swapping the template instead rebuilds the packing panel the adaptive pass measures
                     through, and that panel is the one thing that must survive: it holds the variants, their measured
                     widths, and the sizes currently applied to the commands. -->
                <ControlTemplate TargetType="RibbonGroup">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid Grid.Column="0">
                            <Border x:Name="PART_InlineHost">
                                <Grid x:Name="PART_Content" RowDefinitions="*,Auto"
                                        Margin="{TemplateBinding Padding}">
                                    <!-- CLIPPED to its row. The caption is drawn in the row BELOW, so commands taller
                                         than the band have to be cut rather than allowed to paint over it - a group
                                         whose name cannot be read is worse off than one whose last row is trimmed, and
                                         the band already clips at its own edge for the same reason. -->
                                    <!-- STRETCHED, not sized to its content: top-aligned it shrinks to the commands,
                                         so a gallery told to Stretch had nothing to stretch into. The commands still
                                         sit at the top - their panel puts them there. -->
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"
                                            ClipToBounds="True"
                                            VerticalAlignment="Stretch" HorizontalAlignment="Left"/>
                                    <ContentPresenter Grid.Row="1"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Margin="{ResourceReference RibbonCaptionMargin}"
                                            FontSize="{ResourceReference FontSizeMicro}"
                                            Foreground="{ObservableResource TextFillColorTertiary}"/>
                                </Grid>
                            </Border>

                            <!-- Shown in place of the block above once the group has given up its layout. -->
                            <ToggleButton x:Name="PART_CollapsedButton"
                                    Classes="CollapsedGroupButton"
                                    Visibility="Collapsed"
                                    Width="{TemplateBinding CollapsedWidth}"
                                    ToolTip="{TemplateBinding Header}">
                                <Grid RowDefinitions="Auto,Auto,Auto" Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center">
                                    <Viewbox Grid.Row="0"
                                            Width="{ResourceReference RibbonIconBoxLarge}"
                                            Height="{ResourceReference RibbonIconBoxLarge}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="PART_Icon"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"
                                                Foreground="{ObservableResource TextFillColorPrimary}"/>
                                    </Viewbox>
                                    <ContentPresenter Grid.Row="1"
                                            Margin="{ResourceReference RibbonCaptionMargin}"
                                            FontSize="{ResourceReference FontSizeMicro}"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{ObservableResource TextFillColorTertiary}"/>
                                    <Path Grid.Row="2" Data="M0,0 L4,4 L8,0"
                                            StrokeThickness="{ResourceReference StrokeThinValue}"
                                            Margin="{ResourceReference RibbonCaptionMargin}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Stroke="{ResourceReference TextFillColorSecondary}"/>
                                </Grid>
                            </ToggleButton>

                            <!-- Its content is PART_Content, moved here by the group. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True">
                                <!-- The card builds on FIRST OPEN, not with the group's template: a band carries a
                                     couple of dozen groups and hardly any of them are ever collapsed, let alone
                                     opened. The group hosts its content here through PART_PopupHost when the content
                                     arrives, which is why nothing here binds to the group directly. -->
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                                BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                                BorderThickness="{ResourceReference StrokeThin}"
                                                CornerRadius="0"
                                                Padding="{ResourceReference RibbonCardPadding}">
                                            <Border x:Name="PART_PopupHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>

                        <Rectangle x:Name="GroupRule" Grid.Column="1"
                                Width="{ResourceReference StrokeThinValue}"
                                Margin="{ResourceReference RibbonGroupRuleMargin}"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Fill="{ResourceReference ControlStrokeColorDefault}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGroup">
        <!-- The last group divides itself from nothing; the tab is what knows which one that is. -->
        <PropertyTrigger Property="ShowSeparator" Value="false">
            <Setter TargetName="GroupRule" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <!-- Collapsed: the button takes the block's place. Only VISIBILITY changes here - which of the two hosts holds the
         content is the group's own business, because moving it is not something a setter can express. -->
    <Style Selector="RibbonGroup">
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="PART_InlineHost" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_CollapsedButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- ================= GALLERY ================= -->
    <!-- A grid of choices standing in the band itself, with its own rows scrolled by two arrows and the whole set one
         chevron away. It rides the SAME ladder as every other command: the group hands it a size, it answers in
         columns, and at Small it becomes the chevron alone - three thumbnails in a strip say nothing. -->
    <Style Selector="RibbonGallery">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="1"/>
        <!-- STRETCH, not Center: sized to its rows the gallery hangs out of the band, and its arrows column - which
             divides that height - put the chevron below the clip. The rows that do not fit are what the arrows are for. -->
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGalleryPanel Columns="{TemplateBinding EffectiveColumns}"
                                        Rows="{TemplateBinding Rows}"
                                        FirstRow="{TemplateBinding FirstRow}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGallery">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonGallery">
                    <Grid>
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- The scrolled-away rows are laid out and clipped, never measured to nothing: a zero
                                     always fits, and a row that fits is a row that never scrolls. -->
                                <Border x:Name="Viewport" ClipToBounds="True">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                </Border>
                                <Grid x:Name="Arrows" Grid.Column="1" RowDefinitions="*,*,*"
                                        Width="{ResourceReference RibbonGalleryArrowWidth}">
                                    <RepeatButton x:Name="PART_ScrollUp" Classes="GalleryArrow"
                                                  IsEnabled="{TemplateBinding CanScrollUp}">
                                        <Path Data="M1,5 L5,1 L9,5"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="{ResourceReference StrokeThinValue}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </RepeatButton>
                                    <RepeatButton x:Name="PART_ScrollDown" Grid.Row="1" Classes="GalleryArrow"
                                                  IsEnabled="{TemplateBinding CanScrollDown}">
                                        <Path Data="M1,1 L5,5 L9,1"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="{ResourceReference StrokeThinValue}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </RepeatButton>
                                    <!-- "More": a chevron under a rule, so it reads as "the whole set", not "one more
                                         row". -->
                                    <Button x:Name="PART_More" Grid.Row="2" Classes="GalleryArrow">
                                        <Path Data="M1,1 L9,1 M1,4 L5,8 L9,4"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="{ResourceReference StrokeThinValue}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- OVER the gallery, not under it: dropped below, the card repeats the cells still visible
                             above it. FlipToFit off - flipping would move it off the row it exists to cover. -->
                        <Popup x:Name="PART_Popup"
                               Placement="Relative"
                               FlipToFit="False"
                               DismissOnEscape="True">
                            <!-- Built on first drop-down, like the cells inside it: a gallery that is never dropped
                                 down is a card and a panel nobody looks at. The gallery fills the panel when it
                                 arrives, which is the same moment it would have filled it anyway. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <!-- NO padding: the card lands on the gallery's top-left, so its width must be the
                                         CELLS and nothing more, or it reaches across the arrows beside them. -->
                                    <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                            BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                            BorderThickness="{ResourceReference StrokeThin}"
                                            CornerRadius="0"
                                            Padding="0">
                                        <RibbonGalleryPanel x:Name="PART_DropDownPanel"/>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsed: the grid goes, the chevron stays. Only VISIBILITY changes - the whole set is still one press away. -->
    <Style Selector="RibbonGallery">
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="Viewport" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_ScrollUp" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_ScrollDown" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RepeatButton.GalleryArrow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style Selector="Button.GalleryArrow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- One choice. No background at rest, like a list row: a gallery of forty cells would otherwise be forty fills.
         The chosen one is marked by an accent OUTLINE rather than a fill, so the swatch inside still shows its own
         colour truthfully - which in a gallery of colours or styles is the entire point of the cell. -->
    <Style Selector="RibbonGalleryItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="Transparent"/>
        <Setter Property="BorderBrushSelected" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{ResourceReference RibbonGalleryItemRadius}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonGalleryItemPadding}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RibbonGalleryItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonGalleryItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGalleryItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{TemplateBinding BorderBrushSelected}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.CollapsedGroupButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- ONE template covers all three sizes: the icon box and the label swap cells (and the label goes) via triggers
         on Ribbon.Size. One presenter for the label - content is a single element and can live in only one layout. -->
    <Style Selector="RibbonButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <!-- Large centres (nothing to line up with); the smaller sizes go LEFT - in a column they stand under one
             another, and a ragged left edge is the first thing the eye catches. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="ForegroundDisabled" Value="{ResourceReference TextFillColorDisabled}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonButtonPadding}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="MinWidth" Value="{ResourceReference RibbonButtonMinWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <!-- Default icon drawing: path data stroked in whatever colour the icon slot carries. `{Binding}` is the icon
             itself - a string converts to a Geometry on the way in, as it does when written as an attribute. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- The 16-unit box icons are authored on, STATED. Without it a Shape is measured by its own tight
                         ink (origin -> painted edge), so the Viewbox scales every icon by a different factor and they
                         sit at different heights. -->
                    <Grid Width="{ResourceReference IconSize}" Height="{ResourceReference IconSize}">
                        <Path Data="{Binding}" StrokeThickness="{ResourceReference StrokeThinValue}" Fill="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Icon and label sit in different cells, so it is this block - not the label - that
                             HorizontalContentAlignment has to place. -->
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The icon is DATA drawn by IconTemplate. Its colour travels through the presenter's
                                 Foreground, so states recolour it without reaching into that template. -->
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="{ResourceReference RibbonIconBoxLarge}"
                                    Height="{ResourceReference RibbonIconBoxLarge}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="{ResourceReference RibbonCaptionMargin}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <!-- The ICON greys out with the label - it is the part a person aims at. -->
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Medium: small icon, label beside it. The label moves CELL, so one presenter serves every size. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="IconBox" Property="Width" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="IconBox" Property="Height" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Column" Value="1"/>
            <Setter TargetName="PART_ContentPresenter" Property="Margin" Value="{ResourceReference RibbonIconLabelGap}"/>
            <!-- The whole command goes left: in a column the icons must start at one x. On the CONTROL, so it flows
                 through the one template binding. -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
        <!-- Small: the icon alone. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="IconBox" Property="Width" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="IconBox" Property="Height" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
    </Style>

    <!-- Non-large commands are three to a column, so they must be short and must not claim a large command's width. -->
    <Style Selector="RibbonButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="{ResourceReference RibbonButtonPaddingSmall}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="{ResourceReference RibbonButtonPaddingSmall}"/>
        </PropertyTrigger>
    </Style>

    <!-- A ribbon command with a checked state on top: brushes, metrics, icon drawing and every state/size trigger come
         from RibbonButton. BasedOn crosses types - the two share no base class (Button vs ToggleButton). -->
    <Style Selector="RibbonToggleButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="{ResourceReference RibbonIconBoxLarge}"
                                    Height="{ResourceReference RibbonIconBoxLarge}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="{ResourceReference RibbonCaptionMargin}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checked is a standing PLATE, not the accent fill: a band can have half a dozen toggles on at once (bold,
         italic, gridlines, snapping), and six accent slabs in one row is a wall. The plate is one step brighter than
         the hover wash, which is the difference between "the pointer is here" and "this is on". -->
    <Style Selector="RibbonToggleButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
    </Style>

    <!-- ================= THE FILE TAB AND THE BACKSTAGE ================= -->
    <!-- The tab stretches the full height of the strip and carries no margin: it is the head of the row of tabs, not a
         chip floating over it. -->
    <Style Selector="RibbonApplicationMenu">
        <Setter Property="RailWidth" Value="{ResourceReference RibbonRailWidth}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonApplicationMenu">
                    <Grid>
                        <ToggleButton x:Name="PART_Button"
                                Classes="RibbonFileTab"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"/>

                        <!-- FillWindow: the backstage takes the window over. KeepOpen because there IS no outside to
                             press - Escape and the back arrow are the ways out. -->
                        <Popup x:Name="PART_Popup" FillWindow="True" KeepOpen="True">
                            <!-- The whole backstage builds on FIRST OPEN (ChildTemplate), not with the ribbon's
                                 template: it is a window-sized page plus a row per command, and an application never
                                 asked for its File page pays for none of it. {Ancestor} rather than {TemplateBinding},
                                 because a ChildTemplate is built against the POPUP; and rather than a DataContext on
                                 the popup, because the rows' PAGES bind to the view model and a DataContext here would
                                 take it from them. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                  <Grid RowDefinitions="Auto,*">
                                    <!-- The caption keeps its own strip: the window buttons stay reachable, and this
                                         spacer is see-through AND untouchable so presses land on the title bar
                                         underneath. -->
                                    <Border Grid.Row="0"
                                            Height="{Ancestor RibbonApplicationMenu, CaptionInset, Logical=True}"
                                            Background="Transparent" IsHitTestVisible="False"/>

                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*"
                                            Background="{ResourceReference SolidBackgroundFillColorSecondary}">
                                        <!-- A PANEL, not an accent wall. Fluent paints this whole column in the accent
                                             colour, which in a 1080-tall window is a two-hundred-pixel band of the
                                             loudest colour the theme owns. Here it is the raised panel ground with a
                                             rule down its edge, and the row whose page is open is marked by an accent
                                             line - the same mark every other selected thing in this theme wears. -->
                                        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto"
                                                Width="{Ancestor RibbonApplicationMenu, RailWidth, Logical=True}"
                                                Background="{ResourceReference SolidBackgroundFillColorTertiary}">
                                            <Button x:Name="PART_BackButton" Grid.Row="0"
                                                    Classes="RibbonBackstageBack"
                                                    ToolTip="Back"/>

                                            <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="1"/>

                                            <ContentPresenter Grid.Row="2"
                                                    Content="{Ancestor RibbonApplicationMenu, FooterPaneContent, Logical=True}"
                                                    ContentTemplate="{Ancestor RibbonApplicationMenu, FooterPaneContentTemplate, Logical=True}"/>
                                        </Grid>

                                        <Border Grid.Column="0" Width="{ResourceReference StrokeThinValue}"
                                                HorizontalAlignment="Right"
                                                Background="{ResourceReference ControlStrokeColorDefault}"
                                                IsHitTestVisible="False"/>

                                        <ContentPresenter Grid.Column="1"
                                                Margin="{ResourceReference RibbonBackstageContentMargin}"
                                                Content="{Ancestor RibbonApplicationMenu, SelectedPage, Logical=True}"
                                                ContentTemplate="{Ancestor RibbonApplicationMenu, SelectedPageTemplate, Logical=True}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                  </Grid>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The OTHER shape: the panel dropped under the button, as Office had it before the backstage. Same rows, same
         pages - a card sized to its content instead of the whole window, and an outside press puts it away. -->
    <Style Selector="RibbonApplicationMenu">
        <PropertyTrigger Property="IsBackstage" Value="false">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RibbonApplicationMenu">
                        <Grid>
                            <ToggleButton x:Name="PART_Button"
                                    Classes="RibbonFileTab"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"/>

                            <!-- A menu, so a press outside puts it away. The backstage is the one with no outside, and
                                 IgnoreTargetPress so the press that OPENS it is not also the press that dismisses. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True"
                                    KeepOpen="False" IgnoreTargetPress="True">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                                BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                                BorderThickness="{ResourceReference StrokeThin}"
                                                CornerRadius="0">
                                            <!-- ONE card: the rail runs the full height with the footer at its foot,
                                                 and the pane is a lighter field beside it. Two stacked halves read as
                                                 two panels. -->
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Grid Grid.Column="0" RowDefinitions="*,Auto"
                                                        Width="{Ancestor RibbonApplicationMenu, RailWidth, Logical=True}">
                                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"
                                                            VerticalAlignment="Top"/>
                                                    <ContentPresenter Grid.Row="1"
                                                            Content="{Ancestor RibbonApplicationMenu, FooterPaneContent, Logical=True}"
                                                            ContentTemplate="{Ancestor RibbonApplicationMenu, FooterPaneContentTemplate, Logical=True}"/>
                                                </Grid>

                                                <Border Grid.Column="0" Width="{ResourceReference StrokeThinValue}"
                                                        HorizontalAlignment="Right"
                                                        Background="{ResourceReference ControlStrokeColorDefault}"
                                                        IsHitTestVisible="False"/>

                                                <Border Grid.Column="1"
                                                        MinWidth="{ResourceReference RibbonBackstagePaneMinWidth}"
                                                        MinHeight="{ResourceReference RibbonBackstagePaneMinHeight}"
                                                        Background="{ResourceReference SolidBackgroundFillColorSecondary}">
                                                    <ContentPresenter Margin="{ResourceReference RibbonMenuPaneMargin}"
                                                            Content="{Ancestor RibbonApplicationMenu, SelectedPage, Logical=True}"
                                                            ContentTemplate="{Ancestor RibbonApplicationMenu, SelectedPageTemplate, Logical=True}"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </PropertyTrigger>
    </Style>

    <!-- The File tab is a TAB, not a coloured slab at the head of the strip. It carries the same accent underline as
         its neighbours while the backstage is open, so "which of these is showing" is answered by one mark everywhere
         in the strip rather than by a colour here and a line there. -->
    <Style Selector="ToggleButton.RibbonFileTab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonTabPadding}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- A DESTINATION, unlike the minimize chevron beside the strip: it opens the backstage, so the keyboard has to
             be able to stand on it. It heads the strip, so Left off the first tab reaches it. -->
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                UseAnalyticAA="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Rectangle x:Name="Underline"
                                Height="{ResourceReference TabIndicatorThickness}" Opacity="0"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Fill="{ThemeResource AccentFillColorDefault}"
                                IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.RibbonFileTab">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <!-- Checked IS "the backstage is open". -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference SolidBackgroundFillColorTertiary}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
        </PropertyTrigger>
    </Style>

    <!-- The arrow out of the backstage, at the head of the rail. No ring around it: the rail is a panel here, and a
         circled arrow on a plain panel reads as a badge that fell off a coloured header. -->
    <Style Selector="Button.RibbonBackstageBack">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Height" Value="{ResourceReference RibbonMenuItemHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- A ROW of the rail, not a button sitting in one: the whole width answers to the pointer. The glyph keeps the
             rows' own left offset so it lines up with their icons. -->
        <Setter Property="Padding" Value="{ResourceReference RibbonBackstagePadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid Width="{ResourceReference RibbonBackButtonSize}"
                                Height="{ResourceReference RibbonBackButtonSize}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center">
                            <Path Data="M9,4 L4,9 L9,14 M4,9 L16,9"
                                    Stroke="{ObservableResource TextFillColorPrimary}"
                                    StrokeThickness="{ResourceReference StrokeThinValue}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.RibbonBackstageBack">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <!-- A rail row: icon, label, and an accent rule down the leading edge marking whose page is showing. -->
    <Style Selector="RibbonApplicationMenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BackgroundSelected" Value="{ResourceReference ControlFillColorSecondary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonBackstagePadding}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonMenuItemHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Without this the icon is DATA with nothing to draw it, and the presenter shows the path text itself. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="{ResourceReference IconSize}" Height="{ResourceReference IconSize}">
                        <Path Data="{Binding}" StrokeThickness="{ResourceReference StrokeThinValue}" Fill="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonApplicationMenuItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <!-- Icon and label travel as ONE block, so aligning the row moves the pair rather than
                                 leaving the icon pinned to the edge with the label adrift. -->
                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter x:Name="PART_Icon"
                                        Width="{ResourceReference IconSize}" Height="{ResourceReference IconSize}"
                                        Margin="{ResourceReference RibbonMenuIconGap}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="Marker" Opacity="0"
                                Width="{ResourceReference TabIndicatorThickness}"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Fill="{ThemeResource AccentFillColorDefault}"
                                IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonApplicationMenuItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
            <Setter TargetName="Marker" Property="Opacity" Value="1"/>
        </PropertyTrigger>
    </Style>

    <!-- The words live here, not in the control: what the entry says is a matter of language, and it says the opposite
         thing once the command is already in the bar. -->
    <Style Selector="RibbonQuickAccessMenuItem" BasedOn="MenuItem"/>

    <Style Selector="RibbonQuickAccessMenuItem">
        <Setter Property="Header" Value="Add to quick access"/>
    </Style>

    <Style Selector="RibbonQuickAccessMenuItem">
        <PropertyTrigger Property="IsInQuickAccess" Value="true">
            <Setter Property="Header" Value="Remove from quick access"/>
        </PropertyTrigger>
    </Style>

    <!-- A command that drops a menu. Same command layout with an arrow after it, and the arrow is the ONLY thing this
         template adds - the icon box, the label and all three size layouts come from RibbonButton through BasedOn,
         which lands because the parts are named the same. -->
    <Style Selector="RibbonDropDownButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonDropDownButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonDropDownButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="{ResourceReference RibbonIconBoxLarge}"
                                    Height="{ResourceReference RibbonIconBoxLarge}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="{ResourceReference RibbonCaptionMargin}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            <!-- Large stacks the arrow UNDER the label, the smaller sizes put it after - and the glyph
                                 MOVES CELL rather than there being two of them, which is what kept the split button
                                 next door in a mixed state when the sizes stepped through each other. -->
                            <Path x:Name="DropDownGlyph" Grid.Row="2" Grid.Column="0"
                                    Data="M0,0 L4,4 L8,0"
                                    StrokeThickness="{ResourceReference StrokeThinValue}"
                                    Margin="{ResourceReference RibbonCaptionMargin}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stroke="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonDropDownButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="2"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="{ResourceReference RibbonIconLabelGap}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="1"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="{ResourceReference RibbonIconLabelGap}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Checked IS "the menu is down" - the command stays lit for as long as its flyout is. Same standing plate as
             the toggle, for the same reason. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
    </Style>

    <!-- How a drop-down draws itself in the quick-access bar: the SAME control at its Small size, so the caption and
         the band speak one language. The bar's own hover LIGHTENS - this theme's caption is a dark plate, and Fluent's
         darkening overlay was made for an accent one, where it would be invisible here. -->
    <Style Selector="RibbonDropDownButton">
        <Setter Property="Ribbon.QuickAccessTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RibbonDropDownButton Ribbon.Size="Small"
                            Ribbon.Icon="{Binding Icon}"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Foreground="{Ancestor RibbonQuickAccess, Foreground}"
                            Background="Transparent"
                            BackgroundPointerOver="{ResourceReference SubtleFillColorSecondary}"
                            BackgroundPressed="{ResourceReference SubtleFillColorTertiary}"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="{ResourceReference RibbonQuickAccessItemPadding}"
                            Height="{ResourceReference RibbonQuickAccessItemHeight}">
                        <RibbonDropDownButton.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </RibbonDropDownButton.ContextMenu>
                        <RibbonDropDownButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}"
                                    ItemTemplate="{Binding DropDownItemTemplate}"/>
                        </RibbonDropDownButton.DropDownMenu>
                    </RibbonDropDownButton>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two commands in one: the body runs the action, the arrow drops the menu. The halves therefore light
         SEPARATELY, and the root is deliberately NOT named Chrome - the whole-button hover inherited from RibbonButton
         would paint over the distinction, and a setter whose part is absent does nothing. -->
    <Style Selector="RibbonSplitButton" BasedOn="RibbonButton"/>

    <!-- The split button keeps BOTH halves in the bar: the body still runs the action, the arrow still drops the rows.
         Its own setter, not the drop-down's - a style is matched to the nearest type, so the base one never reaches
         it. -->
    <Style Selector="RibbonSplitButton">
        <Setter Property="Ribbon.QuickAccessTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RibbonSplitButton Ribbon.Size="Small"
                            Ribbon.Icon="{Binding Icon}"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}"
                            Foreground="{Ancestor RibbonQuickAccess, Foreground}"
                            Background="Transparent"
                            BackgroundPointerOver="{ResourceReference SubtleFillColorSecondary}"
                            BackgroundPressed="{ResourceReference SubtleFillColorTertiary}"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="{ResourceReference RibbonQuickAccessItemPadding}"
                            Height="{ResourceReference RibbonQuickAccessItemHeight}">
                        <RibbonSplitButton.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </RibbonSplitButton.ContextMenu>
                        <RibbonSplitButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}"
                                    ItemTemplate="{Binding DropDownItemTemplate}"/>
                        </RibbonSplitButton.DropDownMenu>
                    </RibbonSplitButton>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonSplitButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonSplitButton">
                    <Border x:Name="SplitChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Three cells in each direction: at Large the split is HORIZONTAL - action on top, arrow
                             underneath - and the triggers below move the rule and the arrow into the right-hand column
                             for the smaller sizes. A large command is a stack, so an arrow floating beside it reads as
                             something that fell off rather than as the button's other half. -->
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The command's OWN padding, not a fixed one: the size triggers tighten Padding for
                                 Medium and Small, and a hardcoded value here made the split button far bigger than its
                                 neighbours - the column stretched to fit it, and the icons beside it floated in the
                                 slack. -->
                            <Border x:Name="ActionArea" Grid.Row="0" Grid.Column="0"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="0">
                                <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                            Width="{ResourceReference RibbonIconBoxLarge}"
                                            Height="{ResourceReference RibbonIconBoxLarge}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="PART_Icon"
                                                Foreground="{TemplateBinding Foreground}"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"/>
                                    </Viewbox>
                                    <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                            Margin="{ResourceReference RibbonCaptionMargin}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                                </Grid>
                            </Border>

                            <Rectangle x:Name="SplitRule" Grid.Row="1" Grid.Column="0"
                                    Height="{ResourceReference StrokeThinValue}"
                                    Margin="{ResourceReference RibbonQuickAccessItemPadding}"
                                    HorizontalAlignment="Stretch"
                                    Fill="{ResourceReference ControlStrokeColorDefault}"/>

                            <!-- A real element with a size, not a glyph in a corner: the control asks this part where
                                 the pointer is. -->
                            <Border x:Name="PART_DropDownArea" Grid.Row="2" Grid.Column="0"
                                    Padding="{ResourceReference RibbonSplitDropDownPadding}"
                                    CornerRadius="0">
                                <Path x:Name="DropDownGlyph"
                                        Data="M0,0 L4,4 L8,0"
                                        StrokeThickness="{ResourceReference StrokeThinValue}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Stroke="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Medium and Small are a ROW, so the split turns: the arrangement below is hidden and the one beside it shown.
         Small drops the dividing rule as well - a command this small cannot afford the furniture the large one wears. -->
    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitLeadingRadius}"/>
            <Setter TargetName="SplitRule" Property="Grid.Row" Value="0"/>
            <Setter TargetName="SplitRule" Property="Grid.Column" Value="1"/>
            <Setter TargetName="SplitRule" Property="Width" Value="{ResourceReference StrokeThinValue}"/>
            <!-- NaN, not 0: the rule has to go back to being sized by its row. A zero would be obeyed. -->
            <Setter TargetName="SplitRule" Property="Height" Value="NaN"/>
            <Setter TargetName="SplitRule" Property="Margin" Value="0 4"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="{ResourceReference RibbonSplitDropDownPadding}"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitTrailingRadius}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitLeadingRadius}"/>
            <Setter TargetName="SplitRule" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="{ResourceReference RibbonSplitDropDownPaddingSmall}"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitTrailingRadius}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="IsPointerOverDropDown" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="true"/>
                <Condition Property="IsPointerOverDropDown" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="ActionArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- A plain row of small buttons; no chrome of its own - it sits inside the caption's. -->
    <Style Selector="RibbonQuickAccess">
        <!-- Stretched, its row of buttons would sit against the TOP of the caption: the slot centres what it is given,
             and something that fills the slot has nothing left to centre. -->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- The caption is finite and shared with the window title, so the bar is given a budget rather than allowed
             to grow: what does not fit goes under the chevron instead of pushing the title off the edge. -->
        <Setter Property="MaxWidth" Value="{ResourceReference RibbonQuickAccessMaxWidth}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonQuickAccessPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonQuickAccess">
                    <!-- The chevron's column is the width the panel reserved for it - stated once, on the control. -->
                    <Grid ColumnDefinitions="Auto,{TemplateBinding OverflowButtonWidth}">
                        <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Column="0"/>

                        <!-- A Button, not a ToggleButton: the class style below names Button, and a ToggleButton is its
                             SIBLING (both ButtonBase), so it would silently fall back to the default toggle look. The
                             open state lives on the menu, which is the only thing that really knows it. -->
                        <Button x:Name="PART_OverflowButton" Grid.Column="1"
                                Classes="QuickAccessButton"
                                Visibility="Collapsed"
                                ToolTip="More commands">
                            <!-- The same chevron a drop-down command draws. -->
                            <Path Data="M0,0 L4,4 L8,0"
                                    Stroke="{Ancestor RibbonQuickAccess, Foreground}"
                                    StrokeThickness="{ResourceReference StrokeThinValue}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Its own row template: the list holds the bar's DATA items, and a menu given no template
                             draws them by their type name. Icon in the row's gutter plus the label - a column of
                             unnamed glyphs reads worse here than in the bar, where at least the position is a hint. -->
                        <ContextMenu x:Name="PART_OverflowMenu"
                                ItemsSource="{TemplateBinding OverflowItems}">
                            <ContextMenu.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem Header="{Binding OverflowLabel}"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding CommandParameter}">
                                        <MenuItem.Icon>
                                            <!-- The ROW's foreground: a popup is a detached subtree, so {Ancestor}
                                                 cannot reach the bar from here. -->
                                            <Path Data="{Binding Icon}"
                                                    Stroke="{Ancestor MenuItem, Foreground}"
                                                    StrokeThickness="{ResourceReference StrokeThinValue}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </DataTemplate>
                            </ContextMenu.ItemTemplate>
                        </ContextMenu>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The chevron appears only when something actually did not fit. Its WIDTH is reserved either way, so showing it
         never changes what fits. -->
    <Style Selector="RibbonQuickAccess">
        <PropertyTrigger Property="HasOverflowItems" Value="true">
            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- A DATA item in the bar. Most commands are an icon button; one that brought its OWN compact form (a slider, a
         drop-down) is drawn by that instead - the bar's selector owns the choice, because an ItemTemplate would win
         over it and it would never be asked. An authored control is its own container and reaches neither.
         The theme states the LOOK of the ordinary case only: an application that puts its own selector on the bar to
         add a case of its own keeps this button for everything else. -->
    <Style Selector="RibbonQuickAccess">
        <Setter Property="DefaultItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- Taking a command back out is done HERE, on the button itself: having to find the command again
                         in the ribbon to undo a one-click addition is a poor trade. -->
                    <Button Classes="QuickAccessButton"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <!-- The BAR's foreground, not the caption's: below the ribbon there is no TitleBar to ask, and
                             the icons would come out with no stroke at all. The caption instance takes its colour from
                             the title bar, so they still follow its active/inactive state. -->
                        <Path Data="{Binding Icon}"
                                Stroke="{Ancestor RibbonQuickAccess, Foreground}"
                                StrokeThickness="{ResourceReference StrokeThinValue}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- These sit on the caption, which in THIS theme is a plain dark plate rather than an accent one. So they LIGHTEN
         on hover: Fluent's darkening overlays were chosen for an accent caption, and over a dark ground they are all
         but invisible - the bar would look dead to the pointer. Checked is the standing plate the band's toggles use,
         so a command reads the same in both places. -->
    <Style Selector="ToggleButton.QuickAccessButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonChipHeight}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ToggleButton.QuickAccessButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="Transparent"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="Button.QuickAccessButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonChipHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <!-- The row it sits in claims the caption's FULL height, so centring the bar centres nothing - the button is
             what has to stand in the middle, level with the window title. -->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</StyleSet>
