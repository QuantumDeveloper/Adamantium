<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- An editor's canvas: a darker ground than the panels around it, so the drawing surface reads as the thing being
         worked on. No template - the control draws its own ground, grid and axes; see Fluent's set. -->
    <Style Selector="InfiniteCanvas">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="GridBrush" Value="{ObservableResource CanvasGridColor}"/>
        <Setter Property="AxisBrush" Value="{ObservableResource CanvasAxisColor}"/>
        <Setter Property="GridThickness" Value="1"/>
        <Setter Property="GridDotSize" Value="2"/>
        <Setter Property="SnapMarkBrush" Value="{ThemeResource AccentFillColorDefault}"/>

        <!-- Selection and page - see Fluent's set. Smaller grips, like everything in this theme. -->
        <Setter Property="SelectionBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="HandleBrush" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="RubberBandBrush" Value="{ObservableResource CanvasBandColor}"/>
        <Setter Property="HandleSize" Value="8"/>

        <!-- The overlay layer and its grip - see Fluent's set. Tighter margin, like everything in this theme. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="InfiniteCanvas">
                    <Grid>
                        <!-- The controls on the plane, under the panel - see Fluent's set. -->
                        <CanvasElementLayer x:Name="PART_Elements"/>

                        <!-- The items drawn IN FRONT of those controls - see Fluent's set for why it takes a layer. -->
                        <CanvasFrontLayer x:Name="PART_Front"/>

                        <StackPanel x:Name="PART_OverlayRoot" Orientation="Vertical" Margin="8">
                            <Button x:Name="PART_OverlayGrip" Width="28" Height="22"
                                    MinWidth="0" MinHeight="0" Padding="0"
                                    HorizontalAlignment="Left" MarginBottom="5"
                                    ToolTip="Drag to move the panel, click to fold it away">
                                <Image Source="{ObservableResource GripIcon}" Width="11" Height="11"/>
                            </Button>
                            <ContentPresenter x:Name="PART_Overlay"/>
                        </StackPanel>

                        <!-- The panes, above everything - see Fluent's set. Tighter inset, like everything here. -->
                        <CanvasChromeLayer x:Name="PART_Chrome" PaneInset="8" PaneGap="6"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
