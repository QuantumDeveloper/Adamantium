<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Editor Pro's spin box, built to match this theme's FIELD: a rule under the value, not a box around it. A
         properties panel puts a spin box directly under a text field, and two different frames for the same job -
         "type a value here" - is what makes a panel look assembled rather than designed. Whatever the field is, this
         follows it.

         The PART NAMES and the five-seat grid are Fluent's on purpose. Its six placement multi-triggers decide which
         seat each button takes for every combination of ButtonsPlacement and AreButtonsSwapped - pure behaviour with
         nothing to do with the look - and keeping the names means all of it keeps working while this file states only
         the shape. Its style set stays included for exactly that reason. -->

    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingFieldFlat}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NumericUpDown">
                    <!-- Two rows, as the field: the rule thickens on focus without moving the value above it. -->
                    <Grid RowDefinitions="*,Auto">
                        <Border x:Name="PART_Border" Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                ClipToBounds="True">
                            <!-- Seats 0 and 1 are the left pair, 3 and 4 the right pair; the default is the two
                                 outermost. The columns are Fluent's, because its placement triggers address them. -->
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                <RepeatButton x:Name="PART_Decrease" Grid.Column="0"
                                        Width="{TemplateBinding ButtonsWidth}"
                                        Content="{TemplateBinding DecreaseButtonContent}"
                                        Delay="{TemplateBinding Delay}"
                                        Interval="{TemplateBinding RepeatInterval}"
                                        Focusable="{TemplateBinding AreButtonsFocusable}"
                                        FontSize="{TemplateBinding FontSize}"
                                        BorderThickness="0" CornerRadius="0" Padding="0"
                                        MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Stretch"/>
                                <TextBox x:Name="PART_TextBox" Grid.Column="2"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Margin="{TemplateBinding Padding}"
                                        MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Center">
                                    <!-- The editor is EMBEDDED and must bring no chrome of its own - the rule below is
                                         already this control's. Stripping its properties is not enough: the TextBox
                                         theme's state triggers write to ITS parts, and a trigger outranks what a
                                         template sets. A template with none of those parts leaves those setters with
                                         nothing to find, and a setter whose target is missing does nothing. -->
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                                <TextPresenter x:Name="PART_TextPresenter"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <RepeatButton x:Name="PART_Increase" Grid.Column="4"
                                        Width="{TemplateBinding ButtonsWidth}"
                                        Content="{TemplateBinding IncreaseButtonContent}"
                                        Delay="{TemplateBinding Delay}"
                                        Interval="{TemplateBinding RepeatInterval}"
                                        Focusable="{TemplateBinding AreButtonsFocusable}"
                                        FontSize="{TemplateBinding FontSize}"
                                        BorderThickness="0" CornerRadius="0" Padding="0"
                                        MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Stretch"/>
                            </Grid>
                        </Border>

                        <Border x:Name="Rule" Grid.Row="1"
                                Height="{ResourceReference StrokeThinValue}"
                                Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WHERE the two buttons sit, for every combination of ButtonsPlacement and AreButtonsSwapped. Pure behaviour -
         nothing here is about how anything looks - and the seats are the five columns the template above lays out:
         0 and 1 are the left pair, 3 and 4 the right one. The DEFAULT (Split, not swapped) is stated by the template
         itself, so only the other five combinations need saying.
         These live in this theme now rather than being borrowed: a theme that owns a control's template owns the rules
         that address ITS parts, and leaving them in another theme's file meant this one only worked while that file
         was also loaded. -->
    <Style Selector="NumericUpDown">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Split"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="4"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Left"/>
                <Condition Property="AreButtonsSwapped" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="1"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Left"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="1"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Right"/>
                <Condition Property="AreButtonsSwapped" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="3"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="4"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Right"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="3"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="4"/>
        </MultiTrigger>
    </Style>

    <Style Selector="NumericUpDown">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <!-- Focus WITHIN, not IsFocused: clicking a spin box puts the caret in its EMBEDDED editor, so the control
             itself never becomes the focused element and a rule watching its own IsFocused would never light. -->
        <PropertyTrigger Property="IsKeyboardFocusWithin" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Rule" Property="Height" Value="{ResourceReference StrokeAccentValue}"/>
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        </PropertyTrigger>
    </Style>

    <!-- The states that are not about the pointer. These are the control ANSWERING FOR ITSELF - whether it has its
         buttons, whether it can be typed into, whether it is enabled at all - and they were being borrowed from
         Fluent's set along with the part names. When that include was dropped they left with it, silently: the spin
         box kept its shape and stopped reacting, so AreButtonsVisible="false" did nothing and a disabled one looked
         exactly like a live one. -->
    <Style Selector="NumericUpDown">
        <PropertyTrigger Property="AreButtonsVisible" Value="false">
            <Setter TargetName="PART_Decrease" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_Increase" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Both roads to "you may not type here" end at the embedded editor: the control being read-only, and manual
             entry being turned off while the buttons still work. -->
        <PropertyTrigger Property="IsReadOnly" Value="true">
            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="true"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsManualEntryEnabled" Value="false">
            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="true"/>
        </PropertyTrigger>
        <!-- Disabled dims the VALUE and greys the rule. In this theme the rule is the whole frame, so it is the rule
             that has to say it - there is no box to grey out. -->
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_TextBox" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
            <Setter TargetName="Rule" Property="Background" Value="{ResourceReference ControlStrokeColorDefault}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
