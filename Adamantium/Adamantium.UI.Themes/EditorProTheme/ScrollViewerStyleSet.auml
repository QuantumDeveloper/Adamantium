<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A content host with two overlay scrollbars - and here they are ALWAYS THERE.
         Fluent fades them in on hover, and says in its own note that another theme is free to choose otherwise. An
         editor is that other theme: a scrollbar is read far more often than it is grabbed. Its length says how much
         file there is and its position says where in it you are, and both answers have to be available at a GLANCE -
         while looking somewhere else entirely. A bar that only exists once the pointer is over the panel cannot answer
         a question the pointer is not asking.
         It costs nothing here because this theme's bar is a thin channel rather than Fluent's pill (see
         ScrollBarStyleSet), so leaving it on does not put a heavy rail down the side of every panel. -->

    <Style Selector="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter
                                x:Name="PART_ScrollContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <!-- Each bar owns its WHOLE edge and steps back only when the other one is actually showing -
                             see the trigger below. The inset used to be written here, unconditionally, so a panel with
                             only a horizontal bar stopped it short of the right to clear a vertical bar that was not
                             there. Always-on bars make that gap permanent rather than momentary, which is why it shows
                             up in an editor before it shows up anywhere else. -->
                        <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"/>
                        <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"/>
                        <!-- The square where they cross. A part of its own rather than one bar being let run over it:
                             the vertical bar covering the corner also let its THUMB travel into it, so the thumb could
                             come to rest beside the horizontal bar instead of stopping above it. These bars are always
                             on, so the square simply follows them. -->
                        <Border
                                x:Name="ScrollBarCorner"
                                Width="{ResourceReference ScrollBarThickness}"
                                Height="{ResourceReference ScrollBarThickness}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ResourceReference ControlFillColorDefault}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The corner, and it is CONDITIONAL: only while both bars are showing does the square where they meet belong to
         neither of them. The control answers that question (ScrollViewer.IsScrollBarCornerOccupied) because a style
         trigger cannot ask a sibling part what its Visibility came out as. -->
    <Style Selector="ScrollViewer">
        <PropertyTrigger Property="IsScrollBarCornerOccupied" Value="true">
            <Setter TargetName="PART_VerticalScrollBar" Property="MarginBottom" Value="{ResourceReference ScrollBarThickness}"/>
            <Setter TargetName="PART_HorizontalScrollBar" Property="MarginRight" Value="{ResourceReference ScrollBarThickness}"/>
            <Setter TargetName="ScrollBarCorner" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
