<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Editor Pro's menu rows: the theme's row height, square, with a narrower icon gutter to match the smaller glyph.

         This one had to be a full template rather than a set of overrides, and the reason is worth stating: Fluent's
         menu template writes its numbers INSIDE itself (MinHeight, Padding and CornerRadius sit on the Root part, not
         on the MenuItem), so there is no property for a theme to set. That is the duplication the coming sweep of
         Fluent's inline numbers into its own Metrics is meant to end - a template whose sizes come through
         {TemplateBinding} can be re-densified by a second theme without being copied at all, which is how the button,
         the field and the row already work here.

         Everything this file states comes from Metrics. -->

    <Style Selector="MenuItem" BasedOn="ItemsControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- Not virtualized: a small mixed-height host, so a separator takes its own height instead of a
                         full row cell. -->
                    <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <!-- The height is on Root, a PART, not on the MenuItem: a separator collapses Root, and it has
                             to shrink to its rule rather than hold a full-height empty band. -->
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="{ResourceReference CornerRadiusSmall}"
                                Padding="{ResourceReference PaddingRow}"
                                MinHeight="{ResourceReference RowHeight}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- The gutter is always reserved, with or without an icon, so every label in the menu
                                     starts on the same vertical line. -->
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}"
                                        Width="{ResourceReference MenuIconGutter}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <!-- The shortcut, a step down in size and colour: it is a reminder, not a label. -->
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                        Foreground="{ObservableResource TextFillColorTertiary}"
                                        FontSize="{ResourceReference FontSizeCaption}"
                                        VerticalAlignment="Center"
                                        Margin="{ResourceReference MenuGestureInset}"/>
                                <!-- A vector chevron rather than a font glyph: it draws whatever the UI font covers. -->
                                <Image x:Name="Chevron" Grid.Column="3"
                                        Source="{ResourceReference ChevronRightIcon}"
                                        Width="{ResourceReference DropDownIconSize}"
                                        Height="{ResourceReference DropDownIconSize}"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        Margin="{ResourceReference MenuChevronInset}"/>
                            </Grid>
                        </Border>
                        <!-- No PlacementTarget: the popup falls back to its visual parent - this template's root grid,
                             which overlaps the row - so Placement=Right opens just past the row's right edge. -->
                        <Popup x:Name="PART_SubmenuPopup" Placement="Right" FlipToFit="True"
                                IsOpen="{TemplateBinding IsSubmenuOpen}">
                            <!-- Built LAZILY on first open, so a leaf that never opens a submenu never pays to build
                                 and theme one. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="{ResourceReference StrokeThin}"
                                            CornerRadius="{ResourceReference CornerRadiusDefault}"
                                            Padding="{ResourceReference MenuCardPadding}"
                                            MinWidth="{ResourceReference MenuMinWidth}">
                                        <MenuScrollViewer x:Name="PART_MenuScroll">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </MenuScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="MenuItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Root" Property="Background" Value="{ResourceReference SubtleFillColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                    Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="HasItems" Value="true">
            <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- The rule between groups of commands. A hairline inset from both ends, so it separates without cutting the card
         in two - a full-width rule reads as the end of the menu rather than a break inside it. -->
    <Style Selector="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="{ResourceReference StrokeThinValue}"
                            Margin="{ResourceReference MenuSeparatorMargin}"
                            Background="{ResourceReference ControlStrokeColorDefault}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A menu taller than the window scrolls by ARROWS rather than a scrollbar: the card is a list of commands, and a
         bar down its side turns it into a panel. The arrows are RepeatButtons in their own rows (not floating over the
         content), so a click steps and a hold repeats; the Auto rows cost nothing while they are collapsed. -->
    <Style Selector="MenuScrollViewer" BasedOn="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuScrollViewer">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <RepeatButton x:Name="PART_ScrollUp" Grid.Row="0"
                                Height="{ResourceReference MenuScrollArrowHeight}"
                                Visibility="Collapsed" Delay="300" Interval="40">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}">
                                        <Path Data="M0,4 L4,0 L8,4 Z"
                                                Fill="{ResourceReference TextFillColorSecondary}"
                                                Width="{ResourceReference MenuArrowWidth}"
                                                Height="{ResourceReference MenuArrowHeight}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                Content="{TemplateBinding Content}"/>
                        <RepeatButton x:Name="PART_ScrollDown" Grid.Row="2"
                                Height="{ResourceReference MenuScrollArrowHeight}"
                                Visibility="Collapsed" Delay="300" Interval="40">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="{ResourceReference SolidBackgroundFillColorTertiary}">
                                        <Path Data="M0,0 L8,0 L4,4 Z"
                                                Fill="{ResourceReference TextFillColorSecondary}"
                                                Width="{ResourceReference MenuArrowWidth}"
                                                Height="{ResourceReference MenuArrowHeight}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="MenuScrollViewer">
        <PropertyTrigger Property="CanScrollUp" Value="true">
            <Setter TargetName="PART_ScrollUp" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanScrollDown" Value="true">
            <Setter TargetName="PART_ScrollDown" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ContextMenu" BasedOn="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- A small host of mixed heights: NOT virtualized, so a separator takes its own few pixels instead
                         of a whole row's cell. -->
                    <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The card itself: square, hairline, on the raised panel ground rather than a card one. A context menu in an
         editor appears over dense content, and a rounded floating card reads as a different application arriving; a
         plate with a crisp edge reads as part of this one. -->
    <Style Selector="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                            <!-- Built on FIRST OPEN, not with the menu. This is the one deferral that pays across the
                                 whole application rather than in one control: any element may carry a context menu, and
                                 most of them never show it. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border x:Name="PART_MenuRoot"
                                            Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                                            BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                                            BorderThickness="{ResourceReference StrokeThin}"
                                            CornerRadius="0"
                                            Padding="{ResourceReference MenuCardPadding}"
                                            MinWidth="{ResourceReference MenuMinWidth}">
                                        <MenuScrollViewer x:Name="PART_MenuScroll">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </MenuScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
