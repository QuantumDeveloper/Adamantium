<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- TilesHost: a 3D flip-tile board. As an ItemsControl subclass it needs its OWN template (selectors match the
         exact type, not the base), so it gets the same Border>ScrollViewer>ItemsPresenter host as ItemsControl -
         CanContentScroll=true lets a virtualizing items panel drive it when the board is big. The default ItemsPanel
         (a vertical virtualizing StackPanel) is usually replaced with a WrapPanel for the tiled layout. -->
    <Style Selector="TilesHost" BasedOn="ItemsControl">
        <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <!-- The board's own panel, so a board is authored as a board - a shape and a photo - and nobody has to declare a
             panel and then repeat the shape inside it. The counts come from the CONTROL: a UniformGrid divides whatever
             space it is given between them, so the composition survives anything that takes a pixel off the board. -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{TemplateBinding Columns}" Rows="{TemplateBinding Rows}"
                                 ColumnSpacing="{TemplateBinding Spacing}" RowSpacing="{TemplateBinding Spacing}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TilesHost">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TilesHost">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
