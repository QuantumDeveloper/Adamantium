<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A NODE of a graph, in the shape every graph editor has settled on - Unreal, Blender, Substance, n8n all draw
         the same thing, because it is the shape that works: a coloured strip across the top saying WHAT the node is,
         a body under it, and sockets down the sides.

         The palette is the THEME's and not the editor's. A blueprint editor inside an application should look like the
         application, so the body is the same surface a panel is, the border is the same stroke every control wears,
         and the strip takes the accent - which is also what makes a node in the light theme readable, something a
         hard-coded dark grey would not be. -->
    <Style Selector="CanvasNode">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="Accent" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="PinColor" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasNode">
                    <!-- The sockets sit ON the edge, half outside, so the node needs room round the body to draw them
                         in. A margin on the body rather than padding on the sockets: the body is what a person reads as
                         "the node", and it should be exactly as wide as it looks. -->
                    <Border x:Name="PART_Body" Margin="6,0,6,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <StackPanel Orientation="Vertical">
                                <!-- The strip, and the two stubs a FOLDED node's wires come to, laid OVER it rather
                                     than in it: nothing may take width from this row, or the switch that opens the
                                     node again slides out from under the click that closed it. -->
                                <Grid>
                                    <Border x:Name="PART_Header"
                                            Background="{TemplateBinding Accent}"
                                            CornerRadius="5,5,0,0"
                                            Padding="10,5">
                                        <!-- The FOLD sits in the strip, because the strip is all that is left when the
                                             node is folded - a switch anywhere else would be one you cannot reach to
                                             undo. A toggle and not a button: it shows the state as well as changing it. -->
                                        <DockPanel LastChildFill="True">
                                            <ToggleButton x:Name="PART_Fold" DockPanel.Dock="Right"
                                                          Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0"
                                                          MarginLeft="8" VerticalAlignment="Center"
                                                          Background="Transparent" BorderThickness="0"
                                                          ToolTip="Fold the node down to its title"
                                                          IsChecked="{TemplateBinding IsCollapsed, Mode=TwoWay}"
                                                          BackgroundChecked="Transparent"
                                                          BorderBrushChecked="Transparent"
                                                          BackgroundCheckedPointerOver="Transparent"
                                                          BackgroundCheckedPressed="Transparent"
                                                          ForegroundChecked="{ThemeResource AccentForegroundColor}">
                                                <!-- Drawn HERE and not taken from the icon set: it sits on the accent
                                                     strip and so must wear the accent's own foreground, which is a
                                                     ThemeResource - and a DrawingImage cannot carry one. -->
                                                <Path Data="M0,0 L3.5,3.5 L7,0"
                                                      Stroke="{ThemeResource AccentForegroundColor}"
                                                      StrokeThickness="1.4" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>

                                            <ContentPresenter Content="{TemplateBinding Title}"
                                                              FontSize="{TemplateBinding FontSize}"
                                                              Foreground="{ThemeResource AccentForegroundColor}"
                                                              VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- ONE STUB A SIDE, and every wire of that side comes to it. A folded node is a
                                         summary: twenty-eight discs in a row say no more than two do and stop it being
                                         a title strip at all. The node shows and hides these itself - which of them
                                         belongs depends on whether there are sockets on that side, and a trigger
                                         cannot ask that. -->
                                    <CanvasNodeSocket x:Name="PART_FoldedIn" Width="12" Height="12" CornerRadius="6"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      MarginLeft="-6" Visibility="Collapsed"
                                                      Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                      BorderBrush="{TemplateBinding PinColor}"
                                                      BorderThickness="2"/>

                                    <CanvasNodeSocket x:Name="PART_FoldedOut" Width="12" Height="12" CornerRadius="6"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      MarginRight="-6" Visibility="Collapsed"
                                                      Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                      BorderBrush="{TemplateBinding PinColor}"
                                                      BorderThickness="2"/>
                                </Grid>

                                <!-- Inputs down the left and outputs down the right, each column as wide as it needs to
                                     be. A Grid of two star columns would centre two short lists in the middle of a wide
                                     node, which reads as one list of six rather than two of three. -->
                                <Grid x:Name="PART_Rows" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,10" MinWidth="120">
                                    <!-- WHAT IS IN THE NODE, between the two columns of sockets - where Unreal, Blender
                                         and Substance all put it, because that is the only place a body can go without
                                         standing between a socket and the wire reaching for it. Empty by default and
                                         then costing nothing: a presenter with no content measures to nothing, and the
                                         node is as wide as its sockets, exactly as it was. -->
                                    <ContentPresenter Grid.Column="1" x:Name="PART_ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      Margin="10,0,10,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                    <ItemsControl Grid.Column="0" ItemsSource="{TemplateBinding InputPins}">
                                        <!-- Its OWN template: the stock one wraps the items in a ScrollViewer, and a scroller takes every pixel it is
                                             offered - which made a node as tall as whatever it was measured against instead of as tall as its pins. -->
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" MarginBottom="4">
                                                    <!-- HALF OUTSIDE: a socket drawn inside the body reads as a bullet
                                                         point, and a connection would have to stop short of it.

                                                         TWO rings, not one shape with a colour decided somewhere else:
                                                         the outer one is the socket and always wears the pin's colour,
                                                         the inner one is what a connection puts there and is simply not
                                                         painted while the socket is empty. So hollow-when-loose and
                                                         solid-when-taken falls out of one binding to a brush that is
                                                         null, with no trigger and no converter in three themes.

                                                         The hole takes the BODY's colour rather than nothing at all:
                                                         the socket straddles the edge, so a see-through middle would
                                                         show the body on one side, the plane on the other, and the
                                                         body's own edge running between them. -->
                                                    <CanvasNodeSocket Width="12" Height="12" CornerRadius="6" MarginLeft="-6"
                                                            VerticalAlignment="Center"
                                                            Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                            BorderBrush="{Binding Color}"
                                                            BorderThickness="2">
                                                        <!-- TUCKED HALF A PIXEL UNDER THE RING. The middle exactly
                                                             fills the hole, and two rounded edges that meet exactly
                                                             leave the body showing between them wherever the device
                                                             grid falls between the two - a hair of a ring, and the
                                                             finer the screen the more of them land there. -->
                                                        <Border CornerRadius="4.5" Margin="-0.5"
                                                                Background="{Binding Fill}"/>
                                                    </CanvasNodeSocket>
                                                    <TextBlock Text="{Binding Name}" MarginLeft="7"
                                                               VerticalAlignment="Center"
                                                               VerticalTextAlignment="Center"
                                                               Foreground="{ObservableResource TextFillColorSecondary}"/>

                                                    <!-- THE GRIP, and only the grip, moves a socket: the pin itself is
                                                         where a wire is pulled from, and one target cannot mean two
                                                         things. It stands after the name, out of the way of both.

                                                         A marked element rather than a control of its own: the node
                                                         asks nothing of it but the mark, so the dots are dots, and the
                                                         transparent box round them is what makes the gaps between them
                                                         press too. -->
                                                    <Border CanvasNode.IsSocketGrip="True" Background="Transparent"
                                                            Width="12" Height="14" MinWidth="0" MinHeight="0"
                                                            MarginLeft="6" VerticalAlignment="Center" Cursor="SizeAll"
                                                            ToolTipService.ToolTip="Drag to move this socket">
                                                        <Path Fill="{ObservableResource TextFillColorTertiary}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M0,0 L2,0 L2,2 L0,2 Z M4,0 L6,0 L6,2 L4,2 Z M0,4 L2,4 L2,6 L0,6 Z M4,4 L6,4 L6,6 L4,6 Z M0,8 L2,8 L2,10 L0,10 Z M4,8 L6,8 L6,10 L4,10 Z"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="2" ItemsSource="{TemplateBinding OutputPins}">
                                        <!-- Its OWN template: the stock one wraps the items in a ScrollViewer, and a scroller takes every pixel it is
                                             offered - which made a node as tall as whatever it was measured against instead of as tall as its pins. -->
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" MarginBottom="4"
                                                            HorizontalAlignment="Right">
                                                    <!-- On THIS side the grip stands first, for the same reason the pin
                                                         stands last: each is nearest the edge it belongs to. -->
                                                    <Border CanvasNode.IsSocketGrip="True" Background="Transparent"
                                                            Width="12" Height="14" MinWidth="0" MinHeight="0"
                                                            MarginRight="6" VerticalAlignment="Center" Cursor="SizeAll"
                                                            ToolTipService.ToolTip="Drag to move this socket">
                                                        <Path Fill="{ObservableResource TextFillColorTertiary}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M0,0 L2,0 L2,2 L0,2 Z M4,0 L6,0 L6,2 L4,2 Z M0,4 L2,4 L2,6 L0,6 Z M4,4 L6,4 L6,6 L4,6 Z M0,8 L2,8 L2,10 L0,10 Z M4,8 L6,8 L6,10 L4,10 Z"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" MarginRight="7"
                                                               VerticalAlignment="Center"
                                                               VerticalTextAlignment="Center"
                                                               Foreground="{ObservableResource TextFillColorSecondary}"/>
                                                    <CanvasNodeSocket Width="12" Height="12" CornerRadius="6" MarginRight="-6"
                                                            VerticalAlignment="Center"
                                                            Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                            BorderBrush="{Binding Color}"
                                                            BorderThickness="2">
                                                        <!-- TUCKED HALF A PIXEL UNDER THE RING. The middle exactly
                                                             fills the hole, and two rounded edges that meet exactly
                                                             leave the body showing between them wherever the device
                                                             grid falls between the two - a hair of a ring, and the
                                                             finer the screen the more of them land there. -->
                                                        <Border CornerRadius="4.5" Margin="-0.5"
                                                                Background="{Binding Fill}"/>
                                                    </CanvasNodeSocket>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>

                    <ControlTemplate.Triggers>
                        <!-- FOLDED: the strip is the whole node. Collapsed and not hidden - hidden, the rows would still
                             be measured and a folded node would be exactly as tall as an open one, which is the one
                             thing folding is for. The strip's own corners round on all four sides, because it is no
                             longer sitting on anything.
                             Where the sockets go is worked out by the node itself - see CanvasNode.Fold. -->
                        <PropertyTrigger Property="IsCollapsed" Value="true">
                            <Setter TargetName="PART_Rows" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Header" Property="CornerRadius" Value="5"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
