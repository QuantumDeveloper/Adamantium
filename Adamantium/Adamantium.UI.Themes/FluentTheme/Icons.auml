<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns="http://adamantium/ui">

    <!-- Close: two crossing strokes. Stroked, not filled - it IS a stroke, and saying so keeps it honest at any size. -->
    <DrawingImage x:Key="CloseIcon">
        <GeometryDrawing Geometry="M0,0 L10,10 M10,0 L0,10"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Chevrons: a filled triangle, one shape rotated by where it points. Kept as geometry rather than the SDF
         RegularPolygon they used to be, so the whole set is one kind of thing. -->
    <DrawingImage x:Key="ChevronDownIcon">
        <GeometryDrawing Geometry="M0,3 L10,3 L5,9 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ChevronUpIcon">
        <GeometryDrawing Geometry="M0,7 L5,1 L10,7 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ChevronRightIcon">
        <GeometryDrawing Geometry="M3,0 L9,5 L3,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ChevronLeftIcon">
        <GeometryDrawing Geometry="M7,0 L1,5 L7,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <!-- The chevron ending against a WALL: "as far as this goes", which is a different statement from "one more step"
         and has to look different at a glance, or a pager's four arrows read as two pairs of the same button. Both
         shapes in one geometry rather than a bar drawn beside an icon - the pair is one glyph, and splitting it would
         let the two halves drift apart in every template that used them. -->
    <DrawingImage x:Key="FirstPageIcon">
        <GeometryDrawing Geometry="M0,0 L1.5,0 L1.5,10 L0,10 Z M9.5,0 L3.5,5 L9.5,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="LastPageIcon">
        <GeometryDrawing Geometry="M8.5,0 L10,0 L10,10 L8.5,10 Z M0.5,0 L6.5,5 L0.5,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <!-- The funnel: a table's filter, drawn as the thing a filter IS. Filled, like the chevrons, so the header strip
         reads as one family of small solid marks rather than a mix of outlines and fills.
         ONE funnel, not two: an "active" variant tinted with the accent would have to name it here, and the accent is a
         THEME PROPERTY rather than a keyed resource - the lookup resolves to nothing and the icon simply disappears,
         which is exactly what a filtered column did. A filtered column is marked by its BUTTON, in the style set. -->
    <DrawingImage x:Key="FilterIcon">
        <GeometryDrawing Geometry="M0,0 L10,0 L6,4.5 L6,10 L4,8.5 L4,4.5 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <!-- Put it back: an arrow going BACK around, not a return key. Segments rather than an arc - the path parser reads
         lines - and the head at the left end, pointing the way it travels. Stroked, like the close glyph. -->
    <DrawingImage x:Key="RevertIcon">
        <GeometryDrawing Geometry="M8.6,6.4 L8.4,4.4 L7.3,2.8 L5.4,2 L3.5,2.4 L2.2,3.7 L1.7,5.4 M0.2,4.4 L1.7,6.3 L3.4,4.7"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Which columns are shown: three bars of a table, the middle one dropped out - the whole of what the chooser
         does, said in the shape rather than in a word that would need translating. -->
    <DrawingImage x:Key="ColumnsIcon">
        <GeometryDrawing Geometry="M0,0 L2.5,0 L2.5,10 L0,10 Z M7.5,0 L10,0 L10,10 L7.5,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <!-- Something to take hold of: the ridged grip every movable panel has had since toolbars had them. Bars rather
         than an arrow because it says "pick this up", not "this way". -->
    <DrawingImage x:Key="GripIcon">
        <GeometryDrawing Geometry="M0,1.5 L10,1.5 M0,5 L10,5 M0,8.5 L10,8.5"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

    <!-- The tools, each drawn as the thing it makes rather than as a picture of an instrument: what a tool button has to
         answer is "what will appear when I drag", and the shape is the shortest way to say it. -->
    <DrawingImage x:Key="ToolSelectIcon">
        <GeometryDrawing Geometry="M1,0.5 L1,9 L3.2,7 L4.6,9.8 L6.1,9.1 L4.7,6.5 L7.6,6.3 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ToolPenIcon">
        <GeometryDrawing Geometry="M0.6,9.4 L2,6.6 L7.4,1.2 L8.8,2.6 L3.4,8 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ToolRectangleIcon">
        <GeometryDrawing Geometry="M0.8,2 L9.2,2 L9.2,8 L0.8,8 Z"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

    <!-- A ring drawn as a twelve-sided polygon: the path parser reads LINE segments, so a circle here is the polygon
         that is indistinguishable from one at the size an icon is seen. -->
    <DrawingImage x:Key="ToolEllipseIcon">
        <GeometryDrawing Geometry="M9,5 L8.46,7 L7,8.46 L5,9 L3,8.46 L1.54,7 L1,5 L1.54,3 L3,1.54 L5,1 L7,1.54 L8.46,3 Z"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

    <!-- The two erasers. Both are the rubber on its slant; what tells them apart is what is left UNDER it - which is
         exactly the difference the two modes make, so the icons differ by the same thing the tools do.
         By point: the line continues either side with a HOLE rubbed through the middle. -->
    <DrawingImage x:Key="ToolEraseIcon">
        <GeometryDrawing Geometry="M1.2,6.6 L5.4,0.8 L8.8,3.2 L4.6,9 L1.2,6.6 Z M0.2,9.8 L2.4,9.8 M7.6,9.8 L9.8,9.8"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

    <!-- By stroke: the same rubber, and a CROSS where the line was - the mark for "this one goes", not "this much of
         it". A whole line drawn under it would read as a line being left alone. -->
    <DrawingImage x:Key="ToolEraseStrokeIcon">
        <GeometryDrawing Geometry="M1.2,6.2 L5.4,0.4 L8.8,2.8 L4.6,8.6 L1.2,6.2 Z M5.6,7.4 L9.6,10 M9.6,7.4 L5.6,10"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

    <!-- Take it ALL: a bin, which is a different statement from rubbing something out and has to look it. -->
    <DrawingImage x:Key="ClearAllIcon">
        <GeometryDrawing Geometry="M1.6,2.6 L2.4,9.6 L7.6,9.6 L8.4,2.6 M0.6,2.6 L9.4,2.6 M3.6,2.6 L3.6,1 L6.4,1 L6.4,2.6"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

    <!-- Text: the serif A every tool bar uses, drawn as the letter rather than as a picture of a cursor - what the tool
         makes is the shortest way to say what it does. -->
    <DrawingImage x:Key="ToolTextIcon">
        <GeometryDrawing Geometry="M0.8,9.4 L5,0.8 L9.2,9.4 M2.6,6.6 L7.4,6.6"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

    <DrawingImage x:Key="ToolLineIcon">
        <GeometryDrawing Geometry="M0.8,9 L9.2,1"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1.2"/>
    </DrawingImage>

</ResourceDictionary>
