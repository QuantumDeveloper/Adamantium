<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A pill track with a thumb that slides from the off (left) to the on (right) position. The IsChecked trigger
         paints the accent and re-anchors the thumb (HorizontalAlignment Left->Right inside the track's Grid). Per the
         small-styles convention each concern is its own <Style Selector="ToggleSwitch">. -->

    <!-- Base brushes on the control, bound onto the track with {TemplateBinding} so the IsChecked trigger can repaint it
         (a {ResourceReference} straight on the part would bake at Local priority and block the trigger). -->
    <Style Selector="ToggleSwitch" BasedOn="ToggleButton">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SwitchTrack"
                                         Width="40"
                                         Height="20"
                                         CornerRadius="10"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="1"
                                         VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Ellipse x:Name="SwitchThumb"
                                                  Width="12" Height="12"
                                                  Fill="{ResourceReference TextFillColorPrimary}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="4 0 0 0"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   VerticalAlignment="Center"
                                                   Margin="14 0 0 0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleSwitch">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="SwitchTrack" Property="Background"
                    Value="{ResourceReference ControlFillColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="SwitchTrack" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="SwitchThumb" Property="Fill" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
            <Setter TargetName="SwitchThumb" Property="Margin" Value="0 0 4 0"/>
            <!-- Un-inherit the ToggleButton accent-label; a switch label sits on the normal background. -->
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="SwitchTrack" Property="Background"
                    Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                    Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
