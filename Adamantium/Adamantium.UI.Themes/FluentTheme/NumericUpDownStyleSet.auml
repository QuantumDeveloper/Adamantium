<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- NumericUpDown: one framed row holding an editor and two stepper buttons. The frame belongs to THIS control, so
         the inner TextBox is stripped of its own chrome - two nested borders would draw a box inside a box.
         The five-column grid is what lets the buttons move: the number always sits in the starred middle, and the two
         Auto columns on each side are the four seats a button can take. An Auto column with nothing in it costs nothing,
         so the unused seats do not show. Per the small-styles convention: properties, template, placement, states. -->

    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8 0 8 0"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NumericUpDown">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                            <!-- Seats 0 and 1 are the left pair, 3 and 4 the right pair. The default is Split: the two
                                 outermost. -->
                            <RepeatButton x:Name="PART_Decrease" Grid.Column="0"
                                    Width="{TemplateBinding ButtonsWidth}"
                                    Content="{TemplateBinding DecreaseButtonContent}"
                                    Delay="{TemplateBinding Delay}"
                                    Interval="{TemplateBinding RepeatInterval}"
                                    Focusable="{TemplateBinding AreButtonsFocusable}"
                                    FontSize="{TemplateBinding FontSize}"
                                    BorderThickness="0" CornerRadius="0" Padding="0"
                                    MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Stretch"/>
                            <TextBox x:Name="PART_TextBox" Grid.Column="2"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Margin="{TemplateBinding Padding}"
                                    MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Center">
                                <!-- The editor is EMBEDDED, so it must bring no chrome of its own: the frame around it
                                     is already this control's. Stripping the properties is not enough - the TextBox
                                     theme's state triggers write to its PART_Border, and a trigger outranks a value a
                                     template sets, so a focused editor painted its own lighter fill INSIDE our box, over
                                     the text only. A template with no such part leaves those setters with nothing to
                                     find, and a setter whose target is missing does nothing. -->
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                            <TextPresenter x:Name="PART_TextPresenter"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <RepeatButton x:Name="PART_Increase" Grid.Column="4"
                                    Width="{TemplateBinding ButtonsWidth}"
                                    Content="{TemplateBinding IncreaseButtonContent}"
                                    Delay="{TemplateBinding Delay}"
                                    Interval="{TemplateBinding RepeatInterval}"
                                    Focusable="{TemplateBinding AreButtonsFocusable}"
                                    FontSize="{TemplateBinding FontSize}"
                                    BorderThickness="0" CornerRadius="0" Padding="0"
                                    MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Placement: which seat each button takes. Split-unswapped is the template's own arrangement, so only the other
         five combinations are stated. Swapping is a separate condition rather than five more placements, which is what
         keeps this to one row per case instead of one per product. -->
    <Style Selector="NumericUpDown">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Split"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="4"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Left"/>
                <Condition Property="AreButtonsSwapped" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="1"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Left"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="1"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Right"/>
                <Condition Property="AreButtonsSwapped" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="3"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="4"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Right"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="3"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="4"/>
        </MultiTrigger>
    </Style>

    <!-- States. Read-only and "no typing allowed" both mean the same thing to the editor - it must not accept a
         keystroke - so both project onto its IsReadOnly rather than the control policing every input path itself. -->
    <Style Selector="NumericUpDown">
        <PropertyTrigger Property="AreButtonsVisible" Value="false">
            <Setter TargetName="PART_Decrease" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_Increase" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsReadOnly" Value="true">
            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="true"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsManualEntryEnabled" Value="false">
            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="true"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_TextBox" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
