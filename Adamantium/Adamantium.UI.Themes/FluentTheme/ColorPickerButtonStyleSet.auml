<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ColorPickerButton: a swatch (its fill = SelectedBrush, which tracks SelectedColor) that opens a ColorPicker in a
         floating popup. The control toggles/positions the popup and light-dismisses in code; the picker's SelectedColor is
         {Ancestor}-bound two-way (the Ancestor binding walks the logical tree, which stays intact for popup content). -->

    <Style Selector="ColorPickerButton">
        <!-- The inset the swatch sits in. STATED here and read by the template below, so that a swatch put somewhere
             tight can ask for less - written into the template as a literal, the control's own Padding was a property
             that quietly did nothing. -->
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorPickerButton">
                    <Grid>
                        <Border x:Name="PART_Header"
                                CornerRadius="6"
                                Background="{ResourceReference ControlFillColorDefault}"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="PART_Swatch" Background="{TemplateBinding SelectedBrush}"
                                        CornerRadius="6"/>
                                <!-- No one colour to show: a swatch painted anyway would be one none of them has. -->
                                <TextBlock x:Name="PART_Mixed" Text="—" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                                Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                            <!-- The picker is built LAZILY on first open (ChildTemplate), not eagerly in every swatch's
                                 template - a whole ColorPicker per swatch is far too much to build for a flyout most of
                                 them never open. DataContext is set to the ColorPickerButton in code (Popup.Open
                                 propagates it to the child), so this plain {Binding} resolves to our SelectedColor two-way. -->
                            <!-- ACRYLIC here, solid where the picker stands on a page: what decides it is not the
                                 control but where it is, and this is the one place that knows. A panel that appears
                                 over the document for the length of a choice is a flyout like a menu is, and every
                                 other transient surface in this theme is already FlyoutSurfaceFill. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <ColorPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                                                 Background="{ResourceReference FlyoutSurfaceFill}"/>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ColorPickerButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_Header" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsIndeterminate" Value="true">
            <Setter TargetName="PART_Swatch" Property="Background" Value="Transparent"/>
            <Setter TargetName="PART_Mixed" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
