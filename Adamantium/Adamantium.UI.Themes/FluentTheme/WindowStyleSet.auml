<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Caption/border colours: theme defaults the user can override on the window (accent when focused, neutral when not). -->
    <Style Selector="Window">
        <!-- Default window background so any window (incl. a code-created custom shell) is themed, not the black clear
             colour. An explicit Background on the window instance (e.g. MainWindow) overrides this. -->
        <!-- COLOURS live, metrics one-shot: a resource swapped for a NEW brush (what a colour picker does) is re-resolved
             by {ObservableResource} and ignored by {ResourceReference}. -->
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <!-- Default TEXT colour for the whole window: content inherits it, so plain text is theme-correct without a
             per-TextBlock style (which would sit at Style priority and MASK a control's selection/state Foreground from
             reaching its content). A control that recolours its content on a state - e.g. a selected ListBoxItem pushing
             AccentForegroundColor onto its ContentPresenter - now overrides this inherited default for its subtree. -->
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="TitleBarBackground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="InactiveTitleBarBackground" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <!-- Caption foreground: active = the theme's on-accent contrast colour (so title text + button glyphs read on the
             accent-painted bar), inactive = neutral primary text. Both overridable on the window. -->
        <Setter Property="TitleBarForeground" Value="{ThemeResource AccentForegroundColor}"/>
        <Setter Property="InactiveTitleBarForeground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="LoadingIndicatorText" Value="Switching theme…"/>
    </Style>

    <Style Selector="Window">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="PART_WindowBorder" Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="{ObservableResource ControlStrokeColorDefault}">
                        <Grid RowDefinitions="Auto,*">
                            <!-- The caption's height comes from the WINDOW (Window.TitleBarHeight), so code that needs
                                 it reads one property instead of measuring a template part. -->
                            <TitleBar x:Name="PART_TitleBar" Grid.Row="0"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="{TemplateBinding InactiveTitleBarBackground}"
                                    Foreground="{TemplateBinding InactiveTitleBarForeground}"
                                    Title="{TemplateBinding Title}"
                                    Icon="{TemplateBinding Icon}"
                                    LeadingContent="{TemplateBinding TitleBarLeadingContent}"
                                    LeftWindowCommands="{TemplateBinding LeftWindowCommands}"
                                    RightWindowCommands="{TemplateBinding RightWindowCommands}"
                                    CaptionButtonPlacement="{TemplateBinding CaptionButtonPlacement}"/>
                            <!-- The SELECTOR travels too, not just the single template: a window given only a selector
                                 (one template per content type - the usual shape for a view-model host) had nothing to
                                 build with and fell back to showing Content.ToString(). -->
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            <ResizeGripper x:Name="PART_ResizeGripper" Grid.Row="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Width="26" Height="26" Visibility="Collapsed"/>
                            <!-- Theme-swap busy overlay. The ENGINE owns the state (Window.IsThemeChanging, mirrored from the
                                 ThemeManager); the THEME decides what to show. A translucent SCRIM (not opaque) - the tree
                                 re-styling underneath shows through dimmed, so the swap reads as "working" rather than a
                                 frozen blank; the spinner keeps its own full alpha (the scrim is a translucent BACKGROUND,
                                 not element Opacity, so it does not fade the child). On top (drawn last). The Ring spinner
                                 animates a RenderTransform, which the compositor plays on the RENDER thread - so it keeps
                                 turning even while the loop thread is in the cascade. Collapsed by default; the trigger raises it. -->
                            <Border x:Name="PART_ThemeOverlay" Grid.Row="1"
                                    Background="{ObservableResource SmokeFillColorDefault}"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Template set INLINE (Local), so the theme's BusyIndicator Template setter can't
                                         re-template it during the swap it covers. A re-templated spinner gets a brand-new
                                         RingSpin owner the busy loop can't re-record while the cascade runs, so the
                                         compositor has nothing to drive and it freezes. Fixed template = a stable, recorded
                                         owner the render thread keeps spinning; the ring color stays live via {ThemeResource}. -->
                                    <BusyIndicator x:Name="PART_ThemeSpinner" IsActive="False"
                                            Width="48" Height="48" HorizontalAlignment="Center">
                                        <BusyIndicator.Template>
                                            <ControlTemplate TargetType="BusyIndicator">
                                                <Grid>
                                                    <Ellipse Stroke="{ObservableResource ControlFillColorTertiary}"
                                                                      StrokeThickness="4" Fill="Transparent" EllipseType="EdgeToEdge"/>
                                                    <Ellipse Stroke="{ThemeResource AccentFillColorDefault}"
                                                                      StrokeThickness="4" Fill="Transparent" EllipseType="EdgeToEdge"
                                                                      StartAngle="0" StopAngle="90" RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <Transform x:Name="RingSpin"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </BusyIndicator.Template>
                                    </BusyIndicator>
                                    <TextBlock Text="{TemplateBinding LoadingIndicatorText}" HorizontalAlignment="Center"
                                            Margin="0,18,0,0" Foreground="{ObservableResource TextFillColorSecondary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Window">
        <!-- Native frame (custom chrome off): hide the custom caption; the OS draws its own title bar. -->
        <PropertyTrigger Property="UseCustomChrome" Value="false">
            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Grip-only resize mode: show the corner grip (the only sizing affordance; edge borders are off in this mode). -->
        <PropertyTrigger Property="ResizeMode" Value="CanResizeWithGrip">
            <Setter TargetName="PART_ResizeGripper" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- Active (focused) window: paint the caption + outline with the accent (like a native title-bar focus highlight).
             Inactive keeps the neutral base caption + subtle stroke (the template/setter defaults). -->
        <PropertyTrigger Property="IsActive" Value="true">
            <Setter TargetName="PART_TitleBar" Property="Background" Value="{TemplateBinding TitleBarBackground}"/>
            <Setter TargetName="PART_TitleBar" Property="Foreground" Value="{TemplateBinding TitleBarForeground}"/>
            <Setter TargetName="PART_WindowBorder" Property="BorderBrush" Value="{TemplateBinding TitleBarBackground}"/>
        </PropertyTrigger>
        <!-- A theme swap is in flight: raise the busy overlay and start its spinner (see the template). -->
        <PropertyTrigger Property="IsThemeChanging" Value="true">
            <Setter TargetName="PART_ThemeOverlay" Property="Visibility" Value="Visible"/>
            <Setter TargetName="PART_ThemeSpinner" Property="IsActive" Value="true"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
