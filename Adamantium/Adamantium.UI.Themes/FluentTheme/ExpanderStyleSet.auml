<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Expander: a header you press to fold the content under it.

         THE WHOLE HEADER IS THE BUTTON, not the chevron - the control hooks PART_Header, so the area that reacts is the
         area that is drawn. A chevron-sized target is a target people miss.

         COLLAPSED = the content host is COLLAPSED, not hidden: a hidden element is still measured, and a page of thirty
         folded sections would build thirty pages' worth of rows for nothing.

         The chevron turns rather than being swapped for another glyph, so the four directions need one icon and not
         four. -->

    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="12 8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Border Grid.Row="0" x:Name="PART_Header"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Image Grid.Column="0" x:Name="Glyph"
                                           Source="{ResourceReference ChevronRightIcon}"
                                           Width="10" Height="10" Margin="0 0 8 0"
                                           VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                            x:Name="PART_HeaderPresenter"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharEllipses"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" x:Name="PART_Content"
                                    Visibility="Collapsed"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0 1 0 0">
                                <ContentPresenter
                                        x:Name="PART_ContentPresenter"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsExpanded" Value="true">
                            <Setter TargetName="PART_Content" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glyph" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_Header" Property="Background"
                                    Value="{ResourceReference SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsEnabled" Value="false">
                            <Setter TargetName="PART_HeaderPresenter" Property="Foreground"
                                    Value="{ObservableResource TextFillColorDisabled}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
