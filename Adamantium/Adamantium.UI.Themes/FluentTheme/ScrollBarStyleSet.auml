<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A clean thumb+trough scrollbar (no arrow buttons), one template for BOTH orientations: the Track flips via its
         Orientation, and it creates the thumb + the two (invisible, hit-testable) page repeat-buttons itself. Per the
         small-styles convention each concern is its own <Style Selector="ScrollBar">. -->

    <!-- Simple properties: a subtle trough. -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorTertiary}"/>
    </Style>

    <!-- Template (its own style). -->
    <Style Selector="ScrollBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- Square trough: it sits over the scrolled CONTENT, and a rounded corner leaves the bounding-box
                         corner triangle (outside the arc) transparent, so bright content shows through there as a stray
                         "dead pixel". Square fills its box -> no corner show-through. The thumb (inside, over the trough)
                         stays rounded. -->
                    <Border Background="{TemplateBinding Background}"
                                     CornerRadius="0">
                        <!-- The Track is pure layout now; the template supplies its parts (a grey thumb + two invisible,
                             hit-testable page areas). -->
                        <Track x:Name="PART_Track"
                                Orientation="{TemplateBinding Orientation}"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value}"
                                ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <ScrollBarPageButton Focusable="false"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <ScrollBarPageButton Focusable="false"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
