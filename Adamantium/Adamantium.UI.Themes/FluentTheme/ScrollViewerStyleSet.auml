<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ScrollViewer: a content host with two OVERLAY scrollbars (Fluent-style, no arrow buttons). The content
         presenter fills the whole area and scrolls UNDER the bars; the bars float on the right / bottom edges and the
         control shows/Collapses each one by overflow (Auto). The THEME owns the hide/reveal feel: here the bars start
         invisible AND non-interactive (Opacity=0 + IsHitTestVisible=False), and fade in + become grabbable only while
         the pointer is over the viewer - so a different theme could choose always-on bars instead. The control just
         exposes IsMouseOver + the named parts. Split per the small-styles convention: template, then triggers. -->

    <!-- Template (its own style). Bars start hidden: Opacity 0 so they're invisible, and IsHitTestVisible False so an
         invisible bar can't be grabbed by accident at the edge (Opacity alone stays hit-testable). The trigger reveals
         and arms them on hover. -->
    <Style Selector="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <!-- Each bar runs its WHOLE edge, and is shortened only when the other one is actually there -
                             see the IsScrollBarCornerOccupied trigger below. The inset used to be written here, on the
                             horizontal bar, unconditionally: a viewer with only a horizontal bar then stopped it short
                             of the right edge to clear a vertical bar that was not showing. -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                        <!-- The square where they cross, and it is a PART rather than one bar being allowed to run over
                             it: letting the vertical bar own the corner also let its THUMB travel into it, so the thumb
                             could sit beside the horizontal bar instead of stopping above it. Hidden unless both bars
                             are showing, and it fades with them - a square left standing while the bars are hidden
                             would be a stray mark on the content. -->
                        <Border
                            x:Name="ScrollBarCorner"
                            Width="12" Height="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{ResourceReference SolidBackgroundFillColorTertiary}"
                            Visibility="Collapsed"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The corner (its own style). Only while BOTH bars are showing does the square where they meet belong to neither
         of them: each one then gives up a bar's width at its far end, and the square is filled instead. The control
         works this out - a style trigger cannot ask a sibling part what its Visibility came out as. -->
    <Style Selector="ScrollViewer">
        <PropertyTrigger Property="IsScrollBarCornerOccupied" Value="true">
            <Setter TargetName="PART_VerticalScrollBar" Property="MarginBottom" Value="12"/>
            <Setter TargetName="PART_HorizontalScrollBar" Property="MarginRight" Value="12"/>
            <Setter TargetName="ScrollBarCorner" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- Auto-hide (its own style). Pointer over the viewer -> fade both bars in and arm them (IsHitTestVisible); pointer
         leaves -> disarm instantly and fade them out. The hide/reveal lives here in the theme, not in the control, so a
         different theme is free to do something else. Setters + the animation reach the parts via TargetName (a style
         trigger resolves named parts against the host's template). -->
    <Style Selector="ScrollViewer">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True"/>
            <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True"/>
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="PART_VerticalScrollBar">
                    <Animation Duration="0:0:0.15" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="PART_HorizontalScrollBar">
                    <Animation Duration="0:0:0.15" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <!-- The corner fades with them. It is Collapsed unless both bars are showing, so animating it when only
                     one is costs nothing and keeps the three in step when both are. -->
                <RunAnimationAction TargetName="ScrollBarCorner">
                    <Animation Duration="0:0:0.15" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <!-- Fluent-style DELAYED hide: hold for ~0.7s after the pointer leaves, then fade out over ~0.3s (one
                     1s animation: opacity 1 held to 70% of the timeline, then 1->0). The pointer is already off the
                     viewer during the hold, so the bar lingering non-grabbable is harmless. Fade-IN stays immediate. -->
                <RunAnimationAction TargetName="PART_VerticalScrollBar">
                    <Animation Duration="0:0:1.0" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="70%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="PART_HorizontalScrollBar">
                    <Animation Duration="0:0:1.0" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="70%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="ScrollBarCorner">
                    <Animation Duration="0:0:1.0" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="70%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

</StyleSet>
