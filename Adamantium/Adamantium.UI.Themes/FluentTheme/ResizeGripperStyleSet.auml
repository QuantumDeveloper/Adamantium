<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ResizeGripper: the bottom-right corner grip for a grip-only-resize window (WindowResizeMode.CanResizeWithGrip).
         The classic triangular cluster of dots. The whole control box is the hit region (it publishes ResizeGripRect,
         which the platform hit-test turns into HTBOTTOMRIGHT); the Transparent background keeps it present, and the OS
         hands back the NWSE resize cursor because the hit-test reports a sizing corner. -->

    <Style Selector="ResizeGripper">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ResizeGripper">
                    <Border Background="Transparent">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                Fill="{ResourceReference TextFillColorPrimary}"
                                Data="M13,13 L16,13 L16,16 L13,16 Z M8,13 L11,13 L11,16 L8,16 Z M3,13 L6,13 L6,16 L3,16 Z M13,8 L16,8 L16,11 L13,11 Z M8,8 L11,8 L11,11 L8,11 Z M13,3 L16,3 L16,6 L13,6 Z"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
