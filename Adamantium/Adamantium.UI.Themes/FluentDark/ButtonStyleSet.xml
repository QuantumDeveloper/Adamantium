<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui/resources"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:controls="http://adamantium/ui">
    <Style Selector="Button">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Background" Value="DarkGrey"/>
        <Setter Property="BorderBrush" Value="Red" />
    </Style>   
    
    <Style Selector="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <controls:Grid>
                        <controls:Border x:Name="InnerBorder" 
                                CornerRadius="2" 
                                Background="DarkGrey"
                                BorderBrush="{ResourceReference ApproveBrush}"
                                BorderThickness="2"
                        />                            
                    </controls:Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="InnerBorder" Property="Background" Value="Red"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</StyleSet>