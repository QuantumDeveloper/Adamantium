<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ColorPickerButton: a colour WELL - a framed swatch that opens the picker in a floating panel. The control
         toggles and positions the popup and light-dismisses in code; the picker inside is {Binding}-bound two-way.

         The hover says its piece with the FRAME, not with a fill behind it. This is a bordered control, and on this
         platform a bordered control does not light up under the pointer - what it does is sharpen its edge, which is
         also the only thing that can be seen here: the middle of a colour well is the colour, and washing anything over
         it would be a lie about the value being picked. -->

    <Style Selector="ColorPickerButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorPickerButton">
                    <Grid>
                        <Border x:Name="PART_Header"
                                CornerRadius="{ResourceReference CornerRadiusDefault}"
                                Background="{ResourceReference ControlFillColorDefault}"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                BorderThickness="{ResourceReference StrokeControl}"
                                Padding="3">
                            <Border Background="{TemplateBinding SelectedBrush}"
                                    CornerRadius="4"/>
                        </Border>

                        <Popup x:Name="PART_Popup"
                                Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                            <!-- The picker is built LAZILY on first open, not eagerly in every swatch's template - a
                                 whole ColorPicker per swatch is far too much to build for a flyout most of them never
                                 open. DataContext is set to the ColorPickerButton in code, so this plain {Binding}
                                 resolves to our SelectedColor two-way.
                                 THE SURFACE IS GLASS HERE and solid where the picker stands on a page: what decides it
                                 is not the control but where it is, and this is the one place that knows - a panel that
                                 appears over the document for the length of a choice is a flyout like a menu is. Every
                                 other transient surface in this theme is FlyoutSurfaceFill; this one was the last that
                                 was not. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <ColorPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                                            Background="{ResourceReference FlyoutSurfaceFill}"/>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ColorPickerButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_Header" Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
