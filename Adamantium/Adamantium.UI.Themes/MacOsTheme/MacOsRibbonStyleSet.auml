<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- THE ACCENT IS A STATE, NOT CHROME: kept for a checked toggle and the open rail row, nothing else.
         Structure is untouched - every part name, trigger and panel is the one the controls drive by name. -->

    <Style Selector="Ribbon">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="FlyoutTransitionDuration" Value="0:0:0.16"/>
        <Setter Property="BorderThickness" Value="{ResourceReference RibbonRule}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <!-- Three rows of small commands plus the caption. Constant, so switching tabs never reflows the window. -->
        <Setter Property="GroupsAreaHeight" Value="106"/>
    </Style>

    <!-- The right-click menu every command is given unless its author wrote one. A TEMPLATE, because a menu points at
         ONE command and a setter would hand them all the same object. -->
    <Style Selector="Ribbon">
        <Setter Property="Ribbon.CommandContextMenuTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContextMenu>
                        <RibbonQuickAccessMenuItem/>
                    </ContextMenu>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The strip's OWN panel, not a TabPanel: the ledge has to travel and be clipped with the tabs under it. -->
    <Style Selector="Ribbon">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonTabPanel LedgeHeight="18"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The ledge over a contextual run. Its colour is the GROUP's, and that stays: it is data - which run a tab
         belongs to - and not the theme's accent. -->
    <Style Selector="RibbonContextualLedge">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeMicro}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonLedgePadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonContextualLedge">
                    <!-- Never clipped and never wider than its run: the PANEL widens the tabs until the title fits.
                         Flush and square, like the tabs under it. -->
                    <Border Background="{TemplateBinding Accent}"
                            UseAnalyticAA="False">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                Height="{TemplateBinding TitleHeight}"
                                VerticalAlignment="Top"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Ribbon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Ribbon">
                    <!-- Clipped: an open tab's chrome is flush with the band's top edge, and the coverage fringe that
                         antialiases it reaches half a pixel past - onto the caption above. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <!-- "File" stands at the HEAD of the strip. Named because key-tip mode gathers its
                                     first level from named places, not from a common ancestor. -->
                                <ContentPresenter x:Name="PART_ApplicationMenuHost" Grid.Column="0"
                                        Content="{TemplateBinding ApplicationMenu}"/>

                                <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Column="1"/>

                                <ToggleButton x:Name="PART_MinimizeButton" Grid.Column="2"
                                        Classes="RibbonMinimizeButton"
                                        IsChecked="{TemplateBinding IsMinimized}"
                                        ToolTip="Collapse the ribbon"/>
                            </Grid>

                            <!-- Holds the SELECTED TAB ITSELF, which presents its own groups. Minimizing MOVES that
                                 presenter into the flyout below, so its groups keep the variants they worked out.
                                 The band is the WELL under the strip - paper on the window's surface, which is this
                                 palette's premise - so the open tab above it can read as continuous with it. -->
                            <Border x:Name="Band" Grid.Row="1"
                                    Height="{TemplateBinding GroupsAreaHeight}"
                                    Background="{ResourceReference SolidBackgroundFillColorSecondary}"
                                    BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                    BorderThickness="0 1 0 0"
                                    ClipToBounds="True">
                                <Border x:Name="PART_BandHost">
                                    <!-- STRETCHED across, not left-aligned: the open tab has to be told how much room
                                         the band actually has, because that arrange width is what the groups choose
                                         their variants from. The groups still sit left - their panel lays them out
                                         from x=0 and reports only what it used. -->
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                            Content="{TemplateBinding SelectedContent}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                                </Border>
                            </Border>

                            <ContentPresenter Grid.Row="2" Content="{TemplateBinding FooterContent}"/>

                            <!-- An OVERLAY, not a row: a row would push the content down. The width also aligns it -
                                 Bottom placement centres on its target. -->
                            <Popup x:Name="PART_Flyout" Grid.Row="1" Placement="Bottom">
                                <Border Width="{TemplateBinding ActualWidth}"
                                        Height="{TemplateBinding GroupsAreaHeight}"
                                        Background="{ResourceReference FlyoutSurfaceFill}"
                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                        BorderThickness="0 1 0 1"
                                        ClipToBounds="True">
                                    <!-- The band SLIDES out from under the strip: the frame above is a fixed-height
                                         window that clips, and this is what moves inside it. A transform, not a
                                         height: a growing height re-runs the whole adaptive pass every frame, while a
                                         transform is a compositor channel and costs nothing. -->
                                    <Border x:Name="PART_FlyoutHost">
                                        <Border.RenderTransform>
                                            <Transform/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Ribbon">
        <PropertyTrigger Property="IsMinimized" Value="true">
            <Setter TargetName="Band" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference ControlFillColorTertiary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Width" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonChipHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Margin" Value="0 2 6 0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Chevron: points UP to put the band away, DOWN to bring it back. -->
                        <Path x:Name="Chevron" Data="M3,8 L7,4 L11,8"
                                Stroke="{ResourceReference TextFillColorSecondary}" StrokeThickness="1.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.RibbonMinimizeButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chevron" Property="Data" Value="M3,4 L7,8 L11,4"/>
        </PropertyTrigger>
    </Style>

    <!-- The label in the strip. The open one takes the BAND's own colour, so tab and band read as one surface with the
         closed tabs on the window behind it - which is what a paper tab is, and it needs no rule under it to say so.
         Fluent draws an accent underline there; here the accent would be the loudest thing in the whole window and
         would be saying only "this tab is open", which the surface has already said. -->
    <Style Selector="RibbonTabHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
        <Setter Property="ForegroundSelected" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonTabPadding}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RibbonTabHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTabHeader">
                    <Grid>
                        <!-- Square and un-antialiased: plates meeting edge to edge, and a soft edge leaves a hairline
                             down each join. -->
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                UseAnalyticAA="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonTabHeader">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </PropertyTrigger>
    </Style>

    <!-- A CONTEXTUAL tab wears its run's colour, ledge AND tabs. The colour is the only thing tying a tab to the set
         that appeared with it, and a run whose ledge alone is coloured leaves its tabs indistinguishable from the
         permanent ones the moment the eye drops a row.
         AFTER the state triggers above, so the open contextual tab keeps its context. -->
    <Style Selector="RibbonTabHeader">
        <PropertyTrigger Property="IsContextual" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding Accent}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
        </PropertyTrigger>
    </Style>

    <!-- Open AND contextual: the band's own surface, like any open tab. What still says which run it belongs to is the
         ledge directly above it and its coloured neighbours on either side - so no accent rule is added underneath,
         which is the one Windows mark this theme does without. -->
    <Style Selector="RibbonTabHeader">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsContextual" Value="true"/>
                <Condition Property="IsSelected" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </MultiTrigger>
    </Style>

    <!-- The scroll arrows OVERLAY the row rather than taking width from it: reserving space would make the width
         depend on the answer it produces. Each rides an opaque plate in the band's colour. -->
    <Style Selector="RibbonTab">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGroupsPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonTab">
                    <Grid ClipToBounds="True">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>

                        <Border x:Name="BackFade"
                                Width="28"
                                Margin="18 0 0 0"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ObservableResource BandFadeColor}"/>
                                    <GradientStop Offset="1" Color="{ObservableResource BandFadeColorTransparent}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="BackPlate"
                                Width="18"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Background="{ResourceReference SolidBackgroundFillColorSecondary}">
                            <RepeatButton x:Name="PART_ScrollBack" Classes="RibbonScrollButton">
                                <Path Data="M5,1 L1,5 L5,9"
                                      Stroke="{ResourceReference TextFillColorSecondary}"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Border>

                        <Border x:Name="ForwardFade"
                                Width="28"
                                Margin="0 0 18 0"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ObservableResource BandFadeColorTransparent}"/>
                                    <GradientStop Offset="1" Color="{ObservableResource BandFadeColor}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="ForwardPlate"
                                Width="18"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                Background="{ResourceReference SolidBackgroundFillColorSecondary}">
                            <RepeatButton x:Name="PART_ScrollForward" Classes="RibbonScrollButton">
                                <Path Data="M1,1 L5,5 L1,9"
                                      Stroke="{ResourceReference TextFillColorSecondary}"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shown only while there is somewhere to go in that direction - an arrow over an edge with nothing behind it is a
         promise the row cannot keep. -->
    <Style Selector="RibbonTab">
        <PropertyTrigger Property="CanScrollBack" Value="true">
            <Setter TargetName="BackFade" Property="Visibility" Value="Visible"/>
            <Setter TargetName="BackPlate" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanScrollForward" Value="true">
            <Setter TargetName="ForwardFade" Property="Visibility" Value="Visible"/>
            <Setter TargetName="ForwardPlate" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- Full height of the band, no corners: the arrow is an EDGE of the row, not a control sitting on it. -->
    <Style Selector="RepeatButton.RibbonScrollButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- Hover is opt-in per class here: the plain repeat button states its absence as a decision (a bordered control is
         already visibly a control). A FLAT GLYPH has no border to say that with, so it has to answer the pointer, or it
         reads as an ornament painted on the strip. -->
    <Style Selector="RepeatButton.RibbonScrollButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

    <!-- A group: its commands in columns, its caption underneath, a hairline down its right edge. -->
    <Style Selector="RibbonGroup">
        <Setter Property="Padding" Value="{ResourceReference RibbonGroupPadding}"/>
        <!-- Without this the icon - path data, like a command's - is handed to a presenter with nothing to draw it and
             comes out as the path TEXT: a strip of dashes. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="16" Height="16">
                        <Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGroupPanel RowsPerColumn="3"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <!-- ONE template for both presentations: the group MOVES PART_Content between PART_InlineHost and
                     PART_PopupHost. Swapping templates instead rebuilds the packing panel the adaptive pass measures
                     through, and that panel holds the variants and their measured widths. -->
                <ControlTemplate TargetType="RibbonGroup">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid Grid.Column="0">
                            <Border x:Name="PART_InlineHost">
                                <Grid x:Name="PART_Content" RowDefinitions="*,Auto"
                                        Margin="{TemplateBinding Padding}">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"
                                            VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <ContentPresenter Grid.Row="1"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Margin="0 4 0 0" FontSize="{ResourceReference FontSizeMicro}"
                                            Foreground="{ObservableResource TextFillColorSecondary}"/>
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="PART_CollapsedButton"
                                    Classes="CollapsedGroupButton"
                                    Visibility="Collapsed"
                                    Width="{TemplateBinding CollapsedWidth}"
                                    ToolTip="{TemplateBinding Header}">
                                <Grid RowDefinitions="Auto,Auto,Auto" Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center">
                                    <Viewbox Grid.Row="0" Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="PART_Icon"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"
                                                Foreground="{ObservableResource TextFillColorPrimary}"/>
                                    </Viewbox>
                                    <ContentPresenter Grid.Row="1" Margin="0 4 0 0" FontSize="{ResourceReference FontSizeMicro}"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{ObservableResource TextFillColorSecondary}"/>
                                    <Path Grid.Row="2" Data="M0,0 L4,4 L8,0" StrokeThickness="1" Margin="0 3 0 0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Stroke="{ResourceReference TextFillColorSecondary}"/>
                                </Grid>
                            </ToggleButton>

                            <!-- The card builds on FIRST OPEN, not with the group's template: a band carries a couple
                                 of dozen groups and hardly any are ever collapsed, let alone opened. It is a TRANSIENT
                                 surface, so it wears the flyout material like every other one in this theme. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{ResourceReference CornerRadiusDefault}" Padding="6">
                                            <Border x:Name="PART_PopupHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>

                        <Rectangle x:Name="GroupRule" Grid.Column="1" Width="1" Margin="1 8 1 8"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Fill="{ResourceReference ControlStrokeColorDefault}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGroup">
        <!-- The last group divides itself from nothing; the tab is what knows which one that is. -->
        <PropertyTrigger Property="ShowSeparator" Value="false">
            <Setter TargetName="GroupRule" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <!-- Collapsed: the button takes the block's place. Only VISIBILITY changes here - which host holds the content is
         the group's own business, because moving it is not something a setter can express. -->
    <Style Selector="RibbonGroup">
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="PART_InlineHost" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_CollapsedButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- ================= GALLERY ================= -->
    <!-- A grid of choices standing in the band, with its own rows scrolled by two arrows and the whole set one chevron
         away. It rides the SAME ladder as every other command: the group hands it a size, it answers in columns, and
         at Small it becomes the chevron alone. -->
    <Style Selector="RibbonGallery">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonGalleryPanel Columns="{TemplateBinding EffectiveColumns}"
                                        Rows="{TemplateBinding Rows}"
                                        FirstRow="{TemplateBinding FirstRow}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGallery">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonGallery">
                    <Grid>
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- The scrolled-away rows are laid out and clipped, never measured to nothing: a zero
                                     always fits, and a row that fits is a row that never scrolls. -->
                                <Border x:Name="Viewport" ClipToBounds="True">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                </Border>
                                <Grid x:Name="Arrows" Grid.Column="1" RowDefinitions="*,*,*" Width="18">
                                    <RepeatButton x:Name="PART_ScrollUp" Classes="GalleryArrow"
                                                  IsEnabled="{TemplateBinding CanScrollUp}">
                                        <Path Data="M1,5 L5,1 L9,5"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="1.2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </RepeatButton>
                                    <RepeatButton x:Name="PART_ScrollDown" Grid.Row="1" Classes="GalleryArrow"
                                                  IsEnabled="{TemplateBinding CanScrollDown}">
                                        <Path Data="M1,1 L5,5 L9,1"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="1.2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </RepeatButton>
                                    <!-- A chevron over a rule, so it reads as "the whole set", not "one more row". -->
                                    <Button x:Name="PART_More" Grid.Row="2" Classes="GalleryArrow">
                                        <Path Data="M1,1 L9,1 M1,4 L5,8 L9,4"
                                              Stroke="{ResourceReference TextFillColorSecondary}"
                                              StrokeThickness="1.2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- OVER the gallery, not under it: dropped below, the card repeats the cells still visible
                             above it. FlipToFit off - flipping would move it off the row it exists to cover. -->
                        <Popup x:Name="PART_Popup"
                               Placement="Relative"
                               FlipToFit="False"
                               DismissOnEscape="True">
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <!-- NO padding: its width must be the CELLS and nothing more, or it reaches across
                                         the arrows beside them. -->
                                    <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="{ResourceReference CornerRadiusDefault}"
                                            Padding="0">
                                        <RibbonGalleryPanel x:Name="PART_DropDownPanel"/>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsed: the grid goes, the chevron stays - the whole set is still one press away. -->
    <Style Selector="RibbonGallery">
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="Viewport" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_ScrollUp" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_ScrollDown" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RepeatButton.GalleryArrow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style Selector="Button.GalleryArrow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- The gallery's own arrows, both kinds - the repeating pair that walks the rows and the chevron that drops the
         whole set. Same rule as every flat glyph in this theme: no border to say it is a control, so the pointer has
         to be answered. -->
    <Style Selector="RepeatButton.GalleryArrow">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="Button.GalleryArrow">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

    <!-- One choice. No background at rest, like a list row: a gallery of forty cells would otherwise be forty fills.
         The CHOSEN one is accent-filled rather than merely outlined - a chosen thing is exactly what the accent is for
         on this platform, and it is the same mark a list row and a menu row already use. -->
    <Style Selector="RibbonGalleryItem">
        <Setter Property="Background" Value="Transparent"/>
        <!-- STATED, not left to inheritance. A ContentPresenter STAMPS its Foreground onto the content it builds, so a
             cell with none stamps nothing onto every label inside it - and a gallery whose cells are a swatch over a
             name then shows the swatches and no names at all. -->
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderBrushSelected" Value="Transparent"/>
        <!-- NO border, and that is a size decision rather than a taste one. The chosen cell is said with a FILL here,
             so the border would draw nothing at all - while still taking its thickness out of every cell on all four
             sides. Measured against Fluent's: 62x46 per cell instead of 54x38, and two rows of that no longer fit the
             band, so each cell lost the label under its swatch. -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{ResourceReference RibbonGalleryItemRadius}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonGalleryItemPadding}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RibbonGalleryItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonGalleryItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonGalleryItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{TemplateBinding BorderBrushSelected}"/>
            <!-- The label turns with the fill: primary ink on the accent is the one pair this palette does not read. -->
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.CollapsedGroupButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- A group that gave up its layout stands as one flat chip; the same rule applies to it. Checked is its own
         question and stays where it is. -->
    <Style Selector="ToggleButton.CollapsedGroupButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

    <!-- ONE template covers all three sizes: the icon box and the label swap cells (and the label goes) via triggers on
         Ribbon.Size. One presenter for the label - content is a single element and can live in only one layout. -->
    <Style Selector="RibbonButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <!-- Large centres (nothing to line up with); the smaller sizes go LEFT - in a column they stand under one
             another, and a ragged left edge is the first thing the eye catches. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="ForegroundDisabled" Value="{ResourceReference TextFillColorDisabled}"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonButtonPadding}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="MinWidth" Value="{ResourceReference RibbonButtonMinWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- The 16-unit box icons are authored on, stated. Without it a Shape is measured by its own tight
                         ink, so the Viewbox scales every icon by a different factor and they sit at different heights. -->
                    <Grid Width="16" Height="16">
                        <Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Icon and label sit in different cells, so it is this block - not the label - that
                             HorizontalContentAlignment has to place. -->
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The icon is DATA drawn by IconTemplate. Its colour travels through the presenter's
                                 Foreground, so states recolour it without reaching into that template. -->
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <!-- The ICON greys out with the label - it is the part a person aims at. -->
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Medium: small icon, label beside it. The label moves CELL, so one presenter serves every size. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="IconBox" Property="Width" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="IconBox" Property="Height" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_ContentPresenter" Property="Grid.Column" Value="1"/>
            <Setter TargetName="PART_ContentPresenter" Property="Margin" Value="6 0 0 0"/>
            <!-- The whole command goes left: in a column the icons must start at one x. -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
        <!-- Small: the icon alone. -->
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="IconBox" Property="Width" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="IconBox" Property="Height" Value="{ResourceReference IconSize}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </PropertyTrigger>
    </Style>

    <!-- Non-large commands are three to a column, so they must be short and must not claim a large command's width. -->
    <Style Selector="RibbonButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="{ResourceReference RibbonButtonPaddingSmall}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="{ResourceReference RibbonButtonPaddingSmall}"/>
        </PropertyTrigger>
    </Style>

    <!-- A ribbon command with a checked state on top: brushes, metrics, icon drawing and every state/size trigger come
         from RibbonButton. BasedOn crosses types - the two share no base class. -->
    <Style Selector="RibbonToggleButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ON. This is the accent's own job on this platform - a control that is switched on - so it stays exactly as it
         was. The inherited triggers land because this template names its parts the same. -->
    <Style Selector="RibbonToggleButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
    </Style>

    <!-- The FILE TAB and the backstage behind it. QUIET, not accent-filled: it is the head of the row of tabs, and on
         this platform a piece of chrome does not announce itself in the application's colour. -->
    <Style Selector="RibbonApplicationMenu">
        <Setter Property="RailWidth" Value="200"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonApplicationMenu">
                    <Grid>
                        <ToggleButton x:Name="PART_Button"
                                Classes="RibbonFileTab"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"/>

                        <!-- FillWindow: the backstage takes the window over. KeepOpen because there IS no outside to
                             press - Escape and the back arrow are the ways out. -->
                        <Popup x:Name="PART_Popup" FillWindow="True" KeepOpen="True">
                            <!-- Builds on FIRST OPEN. {Ancestor}, not {TemplateBinding}: a ChildTemplate is built
                                 against the POPUP. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                  <Grid RowDefinitions="Auto,*">
                                    <!-- The caption keeps its own strip: the window buttons stay reachable, and this
                                         spacer is see-through AND untouchable so presses land on the title bar. -->
                                    <Border Grid.Row="0" Height="{Ancestor RibbonApplicationMenu, CaptionInset, Logical=True}"
                                            Background="Transparent" IsHitTestVisible="False"/>

                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*"
                                            Background="{ResourceReference SolidBackgroundFillColorSecondary}">
                                        <!-- The rail is a SOURCE LIST - the sidebar this platform puts beside a page -
                                             so it takes the window's own surface with a hairline dividing it from the
                                             page, and its rows carry the selection. Filled with the accent it would be
                                             a 200px slab of colour down the side of every File page. -->
                                        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto"
                                                Width="{Ancestor RibbonApplicationMenu, RailWidth, Logical=True}"
                                                Background="{ResourceReference SolidBackgroundFillColorBase}">
                                            <Button x:Name="PART_BackButton" Grid.Row="0"
                                                    Classes="RibbonBackstageBack"
                                                    ToolTip="Back"/>

                                            <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="1"/>

                                            <ContentPresenter Grid.Row="2"
                                                    Content="{Ancestor RibbonApplicationMenu, FooterPaneContent, Logical=True}"
                                                    ContentTemplate="{Ancestor RibbonApplicationMenu, FooterPaneContentTemplate, Logical=True}"/>
                                        </Grid>

                                        <ContentPresenter Grid.Column="1" Margin="40 28"
                                                Content="{Ancestor RibbonApplicationMenu, SelectedPage, Logical=True}"
                                                ContentTemplate="{Ancestor RibbonApplicationMenu, SelectedPageTemplate, Logical=True}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                  </Grid>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The OTHER shape: the panel dropped under the button. Same rows, same pages - a card sized to its content
         instead of the whole window, and an outside press puts it away. -->
    <Style Selector="RibbonApplicationMenu">
        <PropertyTrigger Property="IsBackstage" Value="false">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RibbonApplicationMenu">
                        <Grid>
                            <ToggleButton x:Name="PART_Button"
                                    Classes="RibbonFileTab"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"/>

                            <!-- A menu, so a press outside puts it away. IgnoreTargetPress so the press that OPENS it
                                 is not also the press that dismisses it. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True"
                                    KeepOpen="False" IgnoreTargetPress="True">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{ResourceReference CornerRadiusDefault}">
                                            <!-- ONE card: the rail runs the full height with the footer at its foot,
                                                 and the pane is a lighter field beside it. Two stacked halves read as
                                                 two panels. -->
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Grid Grid.Column="0" RowDefinitions="*,Auto"
                                                        Width="{Ancestor RibbonApplicationMenu, RailWidth, Logical=True}">
                                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Row="0"
                                                            VerticalAlignment="Top"/>
                                                    <ContentPresenter Grid.Row="1"
                                                            Content="{Ancestor RibbonApplicationMenu, FooterPaneContent, Logical=True}"
                                                            ContentTemplate="{Ancestor RibbonApplicationMenu, FooterPaneContentTemplate, Logical=True}"/>
                                                </Grid>

                                                <Border Grid.Column="1" MinWidth="300" MinHeight="260"
                                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                        BorderThickness="1 0 0 0"
                                                        Background="{ResourceReference SolidBackgroundFillColorSecondary}">
                                                    <ContentPresenter Margin="24 20"
                                                            Content="{Ancestor RibbonApplicationMenu, SelectedPage, Logical=True}"
                                                            ContentTemplate="{Ancestor RibbonApplicationMenu, SelectedPageTemplate, Logical=True}"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </PropertyTrigger>
    </Style>

    <!-- The head of the strip, dressed like the tabs beside it rather than as a coloured slab. -->
    <Style Selector="ToggleButton.RibbonFileTab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonTabPadding}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- A DESTINATION, unlike the minimize chevron: it opens the backstage, so the keyboard has to be able to stand
             on it. It heads the strip, so Left off the first tab reaches it. -->
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            UseAnalyticAA="False">
                        <Border x:Name="Overlay"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                UseAnalyticAA="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.RibbonFileTab">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Overlay" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Overlay" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <!-- The arrow out of the backstage, at the head of the rail. Its ring and glyph take the ordinary text colours now
         that the rail is no longer accent-filled. -->
    <Style Selector="Button.RibbonBackstageBack">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Height" Value="{ResourceReference RibbonButtonLargeHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- A ROW of the rail, not a button sitting in one: the whole width answers to the pointer. The glyph keeps the
             rows' own left offset so it lines up with their icons. -->
        <Setter Property="Padding" Value="{ResourceReference RibbonBackstagePadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid Width="28" Height="28"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center">
                            <Ellipse Width="28" Height="28"
                                    Stroke="{ResourceReference TextFillColorSecondary}" StrokeThickness="1.2"/>
                            <Path Data="M16,8 L10,14 L16,20 M10,14 L20,14"
                                    Stroke="{ResourceReference TextFillColorPrimary}" StrokeThickness="1.4"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.RibbonBackstageBack">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

    <!-- A rail row: icon, label, and the lit state marking whose page is showing. THAT is a selection, so it is the one
         thing in the backstage that wears the accent. -->
    <Style Selector="RibbonApplicationMenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BackgroundSelected" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="ForegroundSelected" Value="{ThemeResource AccentForegroundColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="{ResourceReference RibbonBackstagePadding}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonMenuItemHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Without this the icon is DATA with nothing to draw it, and the presenter shows the path text itself. -->
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="16" Height="16">
                        <Path Data="{Binding}" StrokeThickness="1" Fill="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Stroke="{Ancestor ContentPresenter, Foreground}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonApplicationMenuItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Icon and label travel as ONE block, so centring the row centres the pair rather than
                             leaving the icon pinned to the edge with the label adrift. -->
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter x:Name="PART_Icon" Width="16" Height="16"
                                    Margin="0 0 14 0"
                                    Content="{TemplateBinding Icon}"
                                    ContentTemplate="{TemplateBinding IconTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonApplicationMenuItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <!-- LAST, so the chosen row keeps its accent while the pointer is over it - and its text and icon turn with the
             fill, or they would be primary ink on the accent. -->
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
            <Setter TargetName="PART_Icon" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </PropertyTrigger>
    </Style>

    <!-- The words live here, not in the control: what the entry says is a matter of language, and it says the opposite
         thing once the command is already in the bar. -->
    <Style Selector="RibbonQuickAccessMenuItem" BasedOn="MenuItem"/>

    <Style Selector="RibbonQuickAccessMenuItem">
        <Setter Property="Header" Value="Add to quick access"/>
    </Style>

    <Style Selector="RibbonQuickAccessMenuItem">
        <PropertyTrigger Property="IsInQuickAccess" Value="true">
            <Setter Property="Header" Value="Remove from quick access"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RibbonDropDownButton" BasedOn="RibbonButton"/>

    <Style Selector="RibbonDropDownButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonDropDownButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="Layout" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                            </Viewbox>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                    Margin="0 4 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            <!-- Large stacks the arrow UNDER the label, the smaller sizes put it after - and the
                                 triggers below move this one glyph rather than hiding a second copy. -->
                            <Path x:Name="DropDownGlyph" Grid.Row="2" Grid.Column="0"
                                    Data="M0,0 L4,4 L8,0" StrokeThickness="1" Margin="0 3 0 0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stroke="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonDropDownButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="2"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="5 0 0 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="DropDownGlyph" Property="Grid.Row" Value="0"/>
            <Setter TargetName="DropDownGlyph" Property="Grid.Column" Value="1"/>
            <Setter TargetName="DropDownGlyph" Property="Margin" Value="3 0 0 0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <!-- Checked here is "the menu is down" - a command HELD open, not a command switched on. So it takes the
             pressed plate rather than the accent: the accent would say this command is now in effect. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference ControlFillColorTertiary}"/>
        </PropertyTrigger>
    </Style>

    <!-- How a drop-down draws itself in the quick-access bar: the SAME control at its Small size, so the caption and
         the band speak one language. The bar sits on the WINDOW's caption here, not on an accent one, so its states
         are the ordinary washes rather than the on-accent shades. -->
    <Style Selector="RibbonDropDownButton">
        <Setter Property="Ribbon.QuickAccessTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RibbonDropDownButton Ribbon.Size="Small"
                            Ribbon.Icon="{Binding Icon}"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Foreground="{Ancestor RibbonQuickAccess, Foreground}"
                            Background="Transparent"
                            BackgroundPointerOver="{ResourceReference SubtleFillColorSecondary}"
                            BackgroundPressed="{ResourceReference SubtleFillColorTertiary}"
                            BorderThickness="0"
                            CornerRadius="{ResourceReference CornerRadiusDefault}"
                            Padding="6 0"
                            Height="22">
                        <RibbonDropDownButton.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </RibbonDropDownButton.ContextMenu>
                        <RibbonDropDownButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}"
                                    ItemTemplate="{Binding DropDownItemTemplate}"/>
                        </RibbonDropDownButton.DropDownMenu>
                    </RibbonDropDownButton>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two commands in one: the body runs the action, the arrow drops the menu. The halves therefore light SEPARATELY,
         and the root is deliberately NOT named Chrome - the whole-button hover inherited from RibbonButton would paint
         over the distinction, and a setter whose part is absent does nothing. -->
    <Style Selector="RibbonSplitButton" BasedOn="RibbonButton"/>

    <!-- The split button keeps BOTH halves in the bar. Its own setter, not the drop-down's - a style is matched to the
         nearest type, so the base one never reaches it. -->
    <Style Selector="RibbonSplitButton">
        <Setter Property="Ribbon.QuickAccessTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RibbonSplitButton Ribbon.Size="Small"
                            Ribbon.Icon="{Binding Icon}"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}"
                            Foreground="{Ancestor RibbonQuickAccess, Foreground}"
                            Background="Transparent"
                            BackgroundPointerOver="{ResourceReference SubtleFillColorSecondary}"
                            BackgroundPressed="{ResourceReference SubtleFillColorTertiary}"
                            BorderThickness="0"
                            CornerRadius="{ResourceReference CornerRadiusDefault}"
                            Padding="6 0"
                            Height="22">
                        <RibbonSplitButton.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </RibbonSplitButton.ContextMenu>
                        <RibbonSplitButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}"
                                    ItemTemplate="{Binding DropDownItemTemplate}"/>
                        </RibbonSplitButton.DropDownMenu>
                    </RibbonSplitButton>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RibbonSplitButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonSplitButton">
                    <Border x:Name="SplitChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Three cells in each direction: at Large the split is HORIZONTAL - action on top, arrow
                             underneath - and the triggers below move the rule and the arrow into the right-hand column
                             for the smaller sizes. A large command is a stack, so an arrow floating beside it reads as
                             something that fell off rather than as the button's other half. -->
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- The command's OWN padding, not a fixed one: the size triggers tighten Padding for
                                 Medium and Small, and a hardcoded value here made the split button far taller than its
                                 neighbours - a column stretched to fit it, and the icons beside it floated in the
                                 slack. -->
                            <Border x:Name="ActionArea" Grid.Row="0" Grid.Column="0"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4 4 0 0">
                                <Grid x:Name="Layout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Viewbox x:Name="IconBox" Grid.Row="0" Grid.Column="0"
                                            Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="PART_Icon"
                                                Foreground="{TemplateBinding Foreground}"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"/>
                                    </Viewbox>
                                    <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0"
                                            Margin="0 4 0 0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                                </Grid>
                            </Border>

                            <Rectangle x:Name="SplitRule" Grid.Row="1" Grid.Column="0" Height="1" Margin="5 0"
                                    HorizontalAlignment="Stretch"
                                    Fill="{ResourceReference ControlStrokeColorDefault}"/>

                            <!-- A real element with a size, not a glyph in a corner: the control asks this part where
                                 the pointer is. -->
                            <Border x:Name="PART_DropDownArea" Grid.Row="2" Grid.Column="0" Padding="5 3"
                                    CornerRadius="0 0 4 4">
                                <Path x:Name="DropDownGlyph"
                                        Data="M0,0 L4,4 L8,0" StrokeThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Stroke="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Medium and Small are a ROW, so the split turns: the arrangement below is hidden and the one beside it shown.
         Small drops the dividing rule as well - a 24px command cannot afford the furniture the large one wears. -->
    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="Ribbon.Size" Value="Medium">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitLeadingRadius}"/>
            <Setter TargetName="SplitRule" Property="Grid.Row" Value="0"/>
            <Setter TargetName="SplitRule" Property="Grid.Column" Value="1"/>
            <Setter TargetName="SplitRule" Property="Width" Value="{ResourceReference StrokeThinValue}"/>
            <Setter TargetName="SplitRule" Property="Height" Value="NaN"/>
            <Setter TargetName="SplitRule" Property="Margin" Value="0 5"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="{ResourceReference RibbonSplitDropDownPadding}"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitTrailingRadius}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Ribbon.Size" Value="Small">
            <Setter TargetName="ActionArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitLeadingRadius}"/>
            <Setter TargetName="SplitRule" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_DropDownArea" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_DropDownArea" Property="Padding" Value="{ResourceReference RibbonSplitDropDownPaddingSmall}"/>
            <Setter TargetName="PART_DropDownArea" Property="CornerRadius" Value="{ResourceReference RibbonSplitTrailingRadius}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="RibbonSplitButton">
        <PropertyTrigger Property="IsPointerOverDropDown" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="true"/>
                <Condition Property="IsPointerOverDropDown" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="ActionArea" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </MultiTrigger>
        <!-- Held open, not switched on - the same distinction the drop-down button makes above. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{ResourceReference ControlFillColorTertiary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="DropDownGlyph" Property="Stroke" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- A plain row of small buttons; no chrome of its own - it sits inside the caption's. -->
    <Style Selector="RibbonQuickAccess">
        <!-- STATED: every command strokes itself with {Ancestor RibbonQuickAccess, Foreground}, and the instance under
             the ribbon has no title bar to inherit from - without this it draws a row of invisible buttons. -->
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- Stretched, its row would sit against the TOP of the caption: the slot centres what it is given, and
             something that fills the slot has nothing left to centre. -->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- The caption is finite and shared with the window title, so the bar is given a budget rather than allowed to
             grow: what does not fit goes under the chevron instead of pushing the title off the edge. -->
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <RibbonQuickAccessPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RibbonQuickAccess">
                    <!-- The chevron's column is the width the panel reserved for it - stated once, on the control. -->
                    <Grid ColumnDefinitions="Auto,{TemplateBinding OverflowButtonWidth}">
                        <ItemsPresenter x:Name="PART_ItemsPresenter" Grid.Column="0"/>

                        <!-- A Button, not a ToggleButton: the class style below names Button, and a ToggleButton is its
                             SIBLING, so it would silently fall back to the default toggle look. The open state lives on
                             the menu, which is the only thing that really knows it. -->
                        <Button x:Name="PART_OverflowButton" Grid.Column="1"
                                Classes="QuickAccessButton"
                                Visibility="Collapsed"
                                ToolTip="More commands">
                            <Path Data="M0,0 L4,4 L8,0"
                                    Stroke="{Ancestor RibbonQuickAccess, Foreground}" StrokeThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Its own row template: the list holds the bar's DATA items, and a menu given no template
                             draws them by their type name. -->
                        <ContextMenu x:Name="PART_OverflowMenu"
                                ItemsSource="{TemplateBinding OverflowItems}">
                            <ContextMenu.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem Header="{Binding OverflowLabel}"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding CommandParameter}">
                                        <MenuItem.Icon>
                                            <!-- The ROW's foreground: a popup is a detached subtree, so {Ancestor}
                                                 cannot reach the bar from here. -->
                                            <Path Data="{Binding Icon}"
                                                    Stroke="{Ancestor MenuItem, Foreground}"
                                                    StrokeThickness="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </DataTemplate>
                            </ContextMenu.ItemTemplate>
                        </ContextMenu>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The chevron appears only when something actually did not fit. Its WIDTH is reserved either way, so showing it
         never changes what fits. -->
    <Style Selector="RibbonQuickAccess">
        <PropertyTrigger Property="HasOverflowItems" Value="true">
            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- A DATA item in the bar. Most commands are an icon button; one that brought its OWN compact form is drawn by
         that instead - the bar's selector owns the choice, because an ItemTemplate would win over it and it would never
         be asked. -->
    <Style Selector="RibbonQuickAccess">
        <Setter Property="DefaultItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- Taking a command back out is done HERE, on the button itself: having to find the command again
                         in the ribbon to undo a one-click addition is a poor trade. -->
                    <Button Classes="QuickAccessButton"
                            Ribbon.IsInQuickAccess="True"
                            ToolTip="{Binding ToolTip}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <RibbonQuickAccessMenuItem/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <!-- The BAR's foreground, not the caption's: below the ribbon there is no TitleBar to ask, and
                             the icons would come out with no stroke at all. -->
                        <Path Data="{Binding Icon}"
                                Stroke="{Ancestor RibbonQuickAccess, Foreground}" StrokeThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The bar's buttons. Fluent darkens them, because there they stand on an ACCENT caption; this theme's caption is
         the window's own surface, so they take the ordinary washes every other piece of chrome here uses. A TOGGLE
         still needs its own checked plate rather than the default accent one: at the size of a caption chip an accent
         fill is a coloured dot with no room to say what it means. -->
    <Style Selector="ToggleButton.QuickAccessButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="MinWidth" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonChipHeight}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Hover in this theme is OPT-IN per class: the plain button and the plain toggle both state its absence as a
         decision (see MacOsButtonStyleSet), so a chip that names a hover brush and no trigger names a colour nothing
         ever reads. Checked stays in its own style below - the two states are separate questions. -->
    <Style Selector="ToggleButton.QuickAccessButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleButton.QuickAccessButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{ResourceReference ControlFillColorTertiary}"/>
            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="Transparent"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="Button.QuickAccessButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="MinWidth" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="{ResourceReference RibbonChipWidth}"/>
        <Setter Property="Height" Value="{ResourceReference RibbonChipHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <!-- The row it sits in claims the caption's FULL height, so centring the bar centres nothing - the button is
             what has to stand in the middle, level with the window title. -->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.QuickAccessButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
