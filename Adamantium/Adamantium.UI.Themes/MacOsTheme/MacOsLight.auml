<?xml version="1.0" encoding="utf-8" ?>

<!-- The LIGHT variant of the macOS theme. See MacOsDark for what separates these palettes from Fluent's; the same
     three things hold here, upside down.

     One difference is specific to light appearance and worth naming: a Mac's light window is NOT white. The body sits
     near #ECECEC and the content areas within it are white, so a window reads as paper laid on a surface. Fluent does
     the opposite - white window, grey cards - and getting this the wrong way round is what makes a light macOS skin
     look like a washed-out Windows one. -->

<ThemeVariantDefinition xmlns="http://adamantium/ui"
                        Key="Light">

  <ThemeVariantDefinition.Values>
    <ThemeValue Property="AccentColor" Value="#007AFF"/>
    <ThemeValue Property="AccentFillColorDisabled" Value="#D1D1D6"/>
    <ThemeValue Property="FocusStrokeColorOuter" Value="#007AFF"/>
    <ThemeValue Property="FocusStrokeColorInner" Value="#00000000"/>
  </ThemeVariantDefinition.Values>

  <ThemeVariantDefinition.Colors>
    <!-- The window is the SURFACE and the content is the paper on it - the opposite way round from Fluent. -->
    <PaletteColor Key="SolidBackgroundFillColorBase" Color="#ECECEC"/>
    <!-- The WELL - a list, a field, an editor - and it is WHITE, which is the sentence above taken literally. The dark
         variant sinks its wells BELOW the window (#1E1E1E under #323232); the mirror of that is not "darker again" but
         AWAY from the body, and away from #ECECEC is up. A grey well made the paper the same material as the surface it
         lay on, which is the one thing this pair of variants exists to avoid. -->
    <PaletteColor Key="SolidBackgroundFillColorSecondary" Color="#FFFFFF"/>
    <PaletteColor Key="SolidBackgroundFillColorTertiary" Color="#F5F5F5"/>
    <PaletteColor Key="SmokeFillColorDefault" Color="#59000000"/>
    <PaletteColor Key="CardBackgroundFillColorDefault" Color="#FFFFFF"/>
    <PaletteColor Key="LayerFillColorDefault" Color="#F6F6F6"/>
    <PaletteColor Key="TileFillColorDefault" Color="#0A000000"/>

    <!-- Controls - see MacOsDark for the reasoning; the light side was already right, because white on #ECECEC is a
         step whether you meant it or not. Tertiary is the PRESSED value and so is the darkest of the three. -->
    <PaletteColor Key="ControlFillColorDefault" Color="#FFFFFF"/>
    <PaletteColor Key="ControlFillColorSecondary" Color="#F5F5F5"/>
    <PaletteColor Key="ControlFillColorTertiary" Color="#E2E2E4"/>
    <!-- Solid rather than a black wash: a translucent disabled fill over a white control gave a grey that changed with
         whatever the control happened to be standing on. -->
    <PaletteColor Key="ControlFillColorDisabled" Color="#E6E6E8"/>
    <PaletteColor Key="SubtleFillColorSecondary" Color="#0F000000"/>
    <PaletteColor Key="SubtleFillColorTertiary" Color="#08000000"/>
    <PaletteColor Key="ControlStrokeColorDefault" Color="#1F000000"/>
    <PaletteColor Key="ControlStrokeColorSecondary" Color="#2E000000"/>

    <!-- The UNSET surface of a selection control - see MacOsDark for why it is one key and its own. The light side had
         the same problem in the other direction: #E8E8E8 on an #ECECEC window is four levels apart. -->
    <PaletteColor Key="SelectionControlFillColorOff" Color="#D2D2D6"/>

    <!-- The GROOVE a segmented control's tabs sit in. Its own key rather than a reused control fill: the track is the
         one surface that must read as RECESSED, and every existing fill in this palette is a raised one. The selected
         segment then rises out of it wearing ControlFillColorDefault - which is white here, so the pair reads exactly
         as a Mac's tab strip does: a sunk grey rail with one raised capsule on it. -->
    <PaletteColor Key="SegmentedTrackColor" Color="#E1E1E3"/>

    <!-- The same groove again, as a COLOUR, for the fade that dissolves tabs at the ends of a scrolling strip. Its own
         pair rather than the one key twice: a palette key is served as a BRUSH by default, and a brush handed to
         GradientStop.Color is an InvalidCastException on every recorded frame - the scene then records nothing at all
         and the window comes up empty. A slot decides the serving, so a key used in both slots is two keys. -->
    <PaletteColor Key="SegmentedTrackFadeColor" Color="#E6E1E1E3" As="Color"/>
    <PaletteColor Key="SegmentedTrackFadeColorTransparent" Color="#00E1E1E3" As="Color"/>

    <!-- The overlay scroller's thumb - see MacOsDark for why it is translucent. -->
    <PaletteColor Key="ScrollThumbFillColor" Color="#66000000"/>

    <!-- A slider knob is white in both appearances, so what separates it from its background is NOT its own colour -
        which means the separation has to vary by variant even though the knob does not. Here it is a shadow: white on
        a white content well is otherwise held up by a hairline alone. Served As="Color" because Shadow.Color is a
        colour, not a brush.

        KEPT DELIBERATELY FAINT (20%, down from 30%). A shadow is translucent, so it composites with WHATEVER it falls
        on - and a slider knob always straddles two things at once: the accent-filled side of the rail and the empty
        side. The stronger it is, the more plainly the same ring reads as two different rings, one over blue and one
        over grey. No amount of moving the rail hides that, because it is not geometry: it is the shadow doing exactly
        what a shadow does. Strength is the only lever, and the hairline is what keeps the knob findable once the
        shadow stops shouting. -->
    <PaletteColor Key="SliderKnobShadowColor" Color="#33000000" As="Color"/>
    <!-- The glow while the knob is HELD. Same blue as the focus stroke: both mean "this is the thing you are working
         with right now", and answering that with two different blues would be two answers to one question. -->
    <PaletteColor Key="SliderKnobAuraColor" Color="#007AFF" As="Color"/>
    <!-- The knob while it is HELD. A glow alone cannot carry this: the aura is the accent, and half the time the knob
         is standing on the accent-filled part of the rail, where an accent glow is the same colour as its background
         to the byte. The knob's own fill is behind nothing and always reads. -->
    <PaletteColor Key="SliderKnobFillPressed" Color="#E6E6E8"/>
    <PaletteColor Key="SliderKnobRimColor" Color="#C7C7CC"/>
    <PaletteColor Key="PinLightColor" Color="#B4B4B8"/>

    <PaletteColor Key="OnAccentOverlayPointerOver" Color="#1AFFFFFF"/>
    <PaletteColor Key="OnAccentOverlayPressed" Color="#00000000"/>
    <PaletteColor Key="OnAccentShadePointerOver" Color="#1A000000"/>
    <PaletteColor Key="OnAccentShadePressed" Color="#40000000"/>

    <PaletteColor Key="DockFoldedStripFill" Color="#12000000"/>
    <PaletteColor Key="DockCompassFillColor" Color="#E6F2F2F2"/>
    <PaletteColor Key="DockCompassStrokeColor" Color="#4D000000"/>
    <PaletteColor Key="DockCompassPreviewColor" Color="#59007AFF"/>

    <!-- The same fixed alphas macOS uses for secondary and tertiary text, over black this time. -->
    <PaletteColor Key="TextFillColorPrimary" Color="#000000"/>
    <PaletteColor Key="TextFillColorSecondary" Color="#8C000000"/>
    <PaletteColor Key="TextFillColorTertiary" Color="#40000000"/>
    <PaletteColor Key="TextFillColorDisabled" Color="#40000000"/>

    <PaletteColor Key="SystemFillColorSuccess" Color="#28CD41"/>
    <PaletteColor Key="SystemFillColorCaution" Color="#FFCC00"/>
    <PaletteColor Key="SystemFillColorCritical" Color="#FF3B30"/>

    <PaletteColor Key="SkeletonPulseFill" Color="#000000"/>
    <PaletteColor Key="ShimmerTrackFill" Color="#14000000"/>

    <PaletteColor Key="KeyTipPlateFill" Color="#2C2C2E"/>
    <PaletteColor Key="KeyTipPlateStroke" Color="#8E8E93"/>
    <PaletteColor Key="KeyTipForeground" Color="#F2F2F7"/>

    <PaletteColor Key="ShimmerPeakColor" Color="#59000000" As="Color"/>
    <PaletteColor Key="ShimmerTrackColor" Color="#14000000" As="Color"/>
    <PaletteColor Key="EdgeFadeColor" Color="#E6ECECEC" As="Color"/>
    <PaletteColor Key="EdgeFadeColorTransparent" Color="#00ECECEC" As="Color"/>
    <PaletteColor Key="AcrylicFillColorDefault" Color="#F2F2F2" As="Color"/>
  </ThemeVariantDefinition.Colors>

</ThemeVariantDefinition>
