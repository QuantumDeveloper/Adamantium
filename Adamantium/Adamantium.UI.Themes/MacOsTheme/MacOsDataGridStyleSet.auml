<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS table: a well, like the list and the text field, so the two sit at one depth. The header is a quiet
         BAND with hairline separators, not a row of buttons - the arrow is what says a column can be sorted. Rows are
         striped by AlternationIndex, a Finder habit and the reason AlternationCount exists. -->

    <Style Selector="TreeDataGrid">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="RowHeight" Value="24"/>
        <!-- Where a dragged column would land - see Fluent's set. -->
        <Setter Property="DropIndicatorBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeDataGrid">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                            <!-- The search strip, at the very top: it speaks about the WHOLE table, grouping and all. -->
                            <DataGridSearchPanel x:Name="PART_SearchPanel" Grid.Row="0" Visibility="Collapsed"/>

                            <!-- The grouping strip, ABOVE the headers: a header is carried up out of the band and put
                                 down here, so the place it lands has to be where the gesture is going. Off unless the
                                 table asks for it - a table nobody groups should not spend a strip saying so. -->
                            <DataGridGroupPanel x:Name="PART_GroupPanel" Grid.Row="1" Visibility="Collapsed"/>

                            <!-- The header band, and under it the rows. The header is OUTSIDE the vertical scroller on
                                 purpose: it stays put while the rows move under it, which is the whole of what a header
                                 is for. -->
                            <Border Grid.Row="2"
                                    Background="{ObservableResource SolidBackgroundFillColorTertiary}"
                                    BorderBrush="{ObservableResource DataGridLineColor}"
                                    BorderThickness="0 0 0 1">
                                <DataGridHeadersPresenter x:Name="PART_Headers" Height="26"/>
                            </Border>

                            <!-- NAMED: the grid follows this scroller sideways - the header strip lives outside it and
                                 has to be moved by hand, and the column window is taken from the same offset. -->
                            <ScrollViewer Grid.Row="3" x:Name="PART_ScrollHost"
                                          CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                            </ScrollViewer>

                            <!-- The totals. Outside the vertical scroller for the same reason the header is: a total
                                 belongs to the whole table, so it must not scroll away from it. It DOES follow the
                                 columns sideways, which the strip does for itself. -->
                            <Border x:Name="PART_FooterBand" Grid.Row="4" Visibility="Collapsed"
                                    Background="{ObservableResource SolidBackgroundFillColorTertiary}"
                                    BorderBrush="{ObservableResource DataGridLineColor}"
                                    BorderThickness="0 1 0 0">
                                <DataGridFooterPresenter x:Name="PART_Footer" Height="24"/>
                            </Border>

                            <!-- Where a dragged column would land - see Fluent's set. -->
                            <Border x:Name="PART_DropIndicator" Grid.Row="2" Grid.RowSpan="2"
                                    Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="{TemplateBinding DropIndicatorBrush}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowSearchPanel" Value="true">
                            <Setter TargetName="PART_SearchPanel" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowGroupPanel" Value="true">
                            <Setter TargetName="PART_GroupPanel" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <!-- The band exists exactly while some column asks for a total - see TreeDataGrid.HasTotals. -->
                        <PropertyTrigger Property="HasTotals" Value="true">
                            <Setter TargetName="PART_FooterBand" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- Not a plain StackPanel: this one also reports the COLUMNS' width to the scroller, which a row
                         cannot (its desired size is clamped to the viewport it was measured in). -->
                    <DataGridRowsPresenter Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="Padding" Value="8 0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="GridLineBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <!-- A hairline on the RIGHT only: shared edges, so the strip reads as one band divided rather than
                         as a row of separate cells. The same line is what the pointer grabs to resize, and the same
                         setting the body's column rules come from. It rides on the header's OWN border - see
                         DataGridCell for what an element of its own costs a table. -->
                    <Border x:Name="HeaderBg" Background="Transparent"
                            BorderBrush="{TemplateBinding GridLineBrush}"
                            BorderThickness="{TemplateBinding GridLineThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <ContentPresenter Grid.Column="0"
                                    x:Name="PART_ContentPresenter"
                                    TextTrimming="CharEllipses"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <Image Grid.Column="1" x:Name="SortGlyph"
                                   Source="{ResourceReference ChevronUpIcon}"
                                   Width="10" Height="10" Margin="6 0 0 0"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>

                            <!-- The funnel answers for its own press (DataGridColumnHeader hooks it), so the area that
                                 reacts is the area that is drawn - the same rule the tree expander follows. -->
                            <Border Grid.Column="2" x:Name="PART_FilterButton"
                                    Width="18" Margin="4 0 0 0" Background="Transparent" CornerRadius="4"
                                    Cursor="Hand" Visibility="Collapsed" ToolTipService.ToolTip="Filter">
                                <Image x:Name="FilterGlyph"
                                       Source="{ResourceReference FilterIcon}"
                                       Width="9" Height="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Popup Grid.Column="2" x:Name="PART_FilterPopup"
                                   Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="6" Padding="8">
                                            <DataGridFilterView x:Name="PART_FilterView"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- PINNED: the strip scrolls under it - see Fluent's set. -->
                        <PropertyTrigger Property="IsFrozen" Value="true">
                            <Setter TargetName="HeaderBg" Property="Background"
                                    Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
                        </PropertyTrigger>
                        <!-- Picked up - see Fluent's set. -->
                        <PropertyTrigger Property="IsDragging" Value="true">
                            <Setter TargetName="HeaderBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                            <Setter TargetName="HeaderBg" Property="Opacity" Value="0.6"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortGlyph" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanFilter" Value="true">
                            <Setter TargetName="PART_FilterButton" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <!-- A filtered column says so in the strip: without it the only way to find out why rows are
                             missing is to open every funnel in turn. The BUTTON is what lights up - the accent is a
                             theme property, so it can be read here but not from inside an icon's dictionary. -->
                        <PropertyTrigger Property="IsFiltered" Value="true">
                            <Setter TargetName="PART_FilterButton" Property="Background"
                                    Value="{ThemeResource AccentFillColorDefault}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- The zebra. Band 1 is tinted, band 0 left alone, so a table with AlternationCount unset looks exactly as it did. -->
    <Style Selector="DataGridRow[AlternationIndex=1]">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
    </Style>

    <!-- A group row takes the BAND's colour, not a stripe of the zebra: it is a header for the rows under it, and the
         stripes count the data. The colour is set on the ROW, so the pinned zone - which paints itself from the row's
         own background - follows it without knowing what a group is. -->
    <Style Selector="DataGridRow[IsGroup=true]">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
    </Style>

    <!-- The filter flyout: the values to tick, then the conditions, then the two buttons that actually change the
         table. Nothing applies while it is being filled in - a filter is composed and then run. -->
    <Style Selector="DataGridFilterView">
        <Setter Property="Width" Value="240"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridFilterView">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="PART_SelectAll" Content="Select All" Margin="0 0 0 6"/>

                        <!-- The list CLIPS: a virtualized list arranges a row or two beyond its viewport, and in a
                             flyout there is nothing behind them - a stray value would be drawn over the form. -->
                        <Border BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                                BorderThickness="1" CornerRadius="6" Padding="2" ClipToBounds="True">
                            <ListBox x:Name="PART_Values" MaxHeight="180" ClipToBounds="True"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Content="{Binding Text}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="Show rows with value that" Margin="0 10 0 4"
                                   Foreground="{ObservableResource TextFillColorSecondary}"/>

                        <DropDown x:Name="PART_FirstOperator" Margin="0 0 0 4"/>
                        <!-- aA = match case, beside the field it applies to. Without it the condition is always
                             case-insensitive, which is a guess the user cannot correct. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 4">
                            <TextBox Grid.Column="0" x:Name="PART_FirstValue"/>
                            <ToggleButton Grid.Column="1" x:Name="PART_FirstMatchCase" Content="aA"
                                          Margin="4 0 0 0" MinWidth="32" ToolTipService.ToolTip="Match case"/>
                        </Grid>
                        <DropDown x:Name="PART_Logic" Margin="0 0 0 4"/>
                        <DropDown x:Name="PART_SecondOperator" Margin="0 0 0 4"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                            <TextBox Grid.Column="0" x:Name="PART_SecondValue"/>
                            <ToggleButton Grid.Column="1" x:Name="PART_SecondMatchCase" Content="aA"
                                          Margin="4 0 0 0" MinWidth="32" ToolTipService.ToolTip="Match case"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0" x:Name="PART_Apply" Content="Filter" Margin="0 0 4 0"/>
                            <Button Grid.Column="1" x:Name="PART_Clear" Content="Clear Filter" Margin="4 0 0 0"/>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The number strip and its corner - see Fluent's set for why it is opaque. -->
    <Style Selector="DataGridRowHeader">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="Padding" Value="6 0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowHeader">
                    <Border x:Name="StripBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ObservableResource DataGridLineColor}"
                            BorderThickness="0 0 1 1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                TextTrimming="CharEllipses"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsSelected" Value="true">
                            <Setter TargetName="StripBg" Property="Background"
                                    Value="{ThemeResource AccentFillColorDefault}"/>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ThemeResource AccentForegroundColor}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="StripBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The handle that opens a record's long form - see the Fluent set for why the sign is a PART. -->
    <Style Selector="DataGridRowDetailsToggle">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowDetailsToggle">
                    <Border x:Name="ToggleBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ObservableResource DataGridLineColor}"
                            BorderThickness="0 0 1 1">
                        <TextBlock x:Name="Sign" Text="+"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsOpen" Value="true">
                            <Setter TargetName="Sign" Property="Text" Value="−"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsBlank" Value="true">
                            <Setter TargetName="Sign" Property="Text" Value=""/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ToggleBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="8 0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- The theme's own rules. A grid that names its brushes overrides these; one that says nothing keeps them. -->
        <Setter Property="GridLineBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="SearchMatchBrush" Value="{ObservableResource DataGridSearchMatchColor}"/>
        <Setter Property="ValidationErrorBrush" Value="{ObservableResource DataGridValidationErrorColor}"/>
        <Setter Property="SearchCurrentBrush" Value="{ObservableResource DataGridSearchCurrentColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <!-- The rules ride on the cell's OWN border (GridLineThickness): they were two elements of their
                         own, which cost a third of everything the table drew for two hairlines this border already
                         paints. The active cell's outline simply overrides them - there is only ever one of it. -->
                        <Border x:Name="CellBorder"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding GridLineBrush}"
                            BorderThickness="{TemplateBinding GridLineThickness}"
                            Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="Auto,*">
                            <!-- The expander's STRIP, on the carrier column only: a fixed 16 wide, which is exactly the
                                 area the grid hit-tests (DataGridCell.ExpanderRect). Reserved even when the row has no
                                 children, so the rows of one level line up; only the triangle inside comes and goes. -->
                                <Border Grid.Column="0" x:Name="PART_Expander"
                                    Width="16" Background="Transparent" Visibility="Collapsed">
                                <!-- The theme's own chevrons, from the icon dictionary - the same ones the menu and the
                                     pager use. Drawn inline it would have been a fourth arrow nobody could restyle. -->
                                    <Image x:Name="Expander"
                                       Source="{ResourceReference ChevronRightIcon}"
                                       Width="10" Height="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                    x:Name="PART_ContentPresenter"
                                    TextTrimming="CharEllipses"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A cell nobody can edit says so the way every table says it: a faint wash behind it AND
                             disabled-weight text. Dimmer text alone is not a cue among data that is dim anyway.
                             Declared first, so a selection, an error or an edit still wins over it. The cell knows this
                             whether the whole COLUMN is read-only or the view-model refused this one cell. -->
                        <PropertyTrigger Property="IsReadOnly" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ObservableResource TextFillColorDisabled}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsExpander" Value="true">
                            <Setter TargetName="PART_Expander" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <!-- The triangle appears only where there is something to open. The strip stays either way. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowsExpander" Value="true"/>
                                <Condition Property="HasChildren" Value="true"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <!-- Open is the chevron turned down - the dictionary's own, not a second drawing. -->
                        <PropertyTrigger Property="IsExpanded" Value="true">
                            <Setter TargetName="Expander" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                        <!-- The accent the list uses for a selected row, so a selected cell and a selected row are the
                             same colour. Keys are taken from the palette by NAME and an invented one resolves to
                             nothing, silently - which is how a selection can end up drawing no selection at all. -->
                        <!-- The selection is a WASH of the accent, not a plate: a cell holds controls and meanings - a
                             check box, a state painted red - and a solid accent swallows both. -->
                        <!-- FOUND by the search. A wash of its own, so a hit reads as a hit and not as a selection,
                             and the cell the search is ON takes the solid colour - the way a browser marks the hit you
                             are standing on apart from the rest it found. Declared BEFORE the selection so a cell that
                             is both still reads as selected. -->
                        <PropertyTrigger Property="IsSearchMatch" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{TemplateBinding SearchMatchBrush}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsSelected" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{ThemeResource AccentFillColorSelection}"/>
                        </PropertyTrigger>

                        <!-- ...and the one the search is ON wins even over that: stepping to a match SELECTS it - that
                             is what takes the keyboard there and scrolls it into view - so a current match is always
                             selected, and behind the selection its own colour would never once be seen. -->
                        <PropertyTrigger Property="IsCurrentSearchMatch" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{TemplateBinding SearchCurrentBrush}"/>
                        </PropertyTrigger>

                        <!-- A value the column will not accept wins over all of them - see the Fluent set. -->
                        <PropertyTrigger Property="HasValidationError" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{TemplateBinding ValidationErrorBrush}"/>
                        </PropertyTrigger>
                        <!-- The ACTIVE cell is outlined, not filled: in a spreadsheet it sits inside the selection and
                             has to be told apart from it. -->
                        <PropertyTrigger Property="IsActive" Value="true">
                            <Setter TargetName="CellBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="CellBorder" Property="BorderBrush"
                                    Value="{ObservableResource AccentFillColorDefault}"/>
                        </PropertyTrigger>
                        <!-- An editor takes the WHOLE cell: the padding that keeps text off the column edge would
                             otherwise squeeze the field, and a drop-down loses more of its width than it can spare. -->
                        <PropertyTrigger Property="IsEditing" Value="true">
                            <Setter TargetName="CellBorder" Property="Padding" Value="0"/>
                        </PropertyTrigger>
                        <!-- What the view-model called an error. A MEANING from the model, a colour from here. -->
                        <PropertyTrigger Property="State" Value="Error">
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ObservableResource SystemFillColorCritical}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The strip that searches the table. Enter runs the search and walks it; the two arrows step through what it
         found, and the count says where in it you stand. -->
    <Style Selector="DataGridSearchPanel">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Padding" Value="8 5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridSearchPanel">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                            <TextBox Grid.Column="0" x:Name="PART_Text" MinWidth="140"/>
                            <ContentControl Grid.Column="1" x:Name="PART_Count"
                                            VerticalAlignment="Center" Margin="8 0"
                                            FontSize="{ResourceReference FontSizeChrome}"
                                            Foreground="{ObservableResource TextFillColorTertiary}"/>
                            <Button Grid.Column="2" x:Name="PART_Previous" Content="↑" MinWidth="28"
                                    ToolTipService.ToolTip="Previous match"/>
                            <Button Grid.Column="3" x:Name="PART_Next" Content="↓" MinWidth="28" Margin="4 0 0 0"
                                    ToolTipService.ToolTip="Next match"/>
                            <Button Grid.Column="4" x:Name="PART_Find" Content="Find" Margin="6 0 0 0"/>
                            <!-- Closed from INSIDE the strip: the switch that opened it may be anywhere. The glyph is the
                                 multiplication sign the grouping chip's remove already uses - the heavier ✕ (U+2715) is
                                 not in the shipped face and the button rendered EMPTY on the stand. -->
                            <Button Grid.Column="5" x:Name="PART_Close" Content="×" MinWidth="26" Margin="6 0 0 0"
                                    ToolTipService.ToolTip="Close the search"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The grouping strip. A well of its own above the band, with the instruction written in it while it is empty -
         a drop target nobody can see is a feature nobody finds. -->
    <Style Selector="DataGridGroupPanel">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Padding" Value="8 5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridGroupPanel">
                    <Border x:Name="PanelBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" x:Name="PART_Hint"
                                       Text="Drag a column header here to group by it"
                                       VerticalAlignment="Center"
                                       FontSize="{ResourceReference FontSizeChrome}"
                                       Foreground="{ObservableResource TextFillColorTertiary}"/>
                            <StackPanel Grid.Column="0" x:Name="PART_Chips"
                                        Orientation="Horizontal" VerticalAlignment="Center"/>

                            <!-- Folding the WHOLE table lives beside the chips: nothing else in the window has anything
                                 to say about a table's groups, and two columns deep there are hundreds of them. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PART_ExpandAll" Content="Expand all" Visibility="Collapsed"
                                        FontSize="{ResourceReference FontSizeChrome}" Padding="8 1" Margin="6 0 0 0"/>
                                <Button x:Name="PART_CollapseAll" Content="Collapse all" Visibility="Collapsed"
                                        FontSize="{ResourceReference FontSizeChrome}" Padding="8 1" Margin="6 0 0 0"/>
                            </StackPanel>

                            <!-- Where a carried chip would land. Spans the strip and is moved by its left margin, the
                                 same way the table's own drop mark is. -->
                            <Border Grid.Column="0" x:Name="PART_DropMark"
                                    Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="{ThemeResource AccentFillColorDefault}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- The strip ANSWERS the carried header before it is let go, the way the drop line answers a
                             reorder: the accent says the drop is available here. -->
                        <PropertyTrigger Property="IsDropTarget" Value="true">
                            <Setter TargetName="PanelBg" Property="Background"
                                    Value="{ThemeResource AccentFillColorSelection}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One column standing in the strip. Reads as a token rather than a button because it is a STATEMENT of what the
         table is grouped by, and the × says the whole chip is the way to take it back off. -->
    <Style Selector="DataGridGroupChip">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="Margin" Value="0 0 6 0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridGroupChip">
                    <Border x:Name="ChipBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                            BorderThickness="1" CornerRadius="4" Padding="8 2"
                            ToolTipService.ToolTip="Drag to change the nesting">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"/>
                            <!-- The × is the way OUT of the grouping, so it is a PART the chip hit-tests for: what is
                                 drawn as the way out has to be the thing that answers. -->
                            <Border x:Name="PART_Remove" Margin="4 0 0 0" Padding="3 0" CornerRadius="3"
                                    Background="Transparent" ToolTipService.ToolTip="Remove from the grouping">
                                <TextBlock x:Name="RemoveGlyph" Text="×" VerticalAlignment="Center"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ChipBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                        <!-- Picked up: the chip itself says so, so the gesture is answered where it started and not
                             only at the place it would land - the header band does the same. -->
                        <PropertyTrigger Property="IsDragging" Value="true">
                            <Setter TargetName="ChipBg" Property="Opacity" Value="0.6"/>
                        </PropertyTrigger>
                        <!-- The × lights up under the pointer, or nothing says it is a button rather than a mark. -->
                        <PropertyTrigger SourceName="PART_Remove" Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_Remove" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                            <Setter TargetName="RemoveGlyph" Property="Foreground"
                                    Value="{ObservableResource TextFillColorPrimary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The row that stands for a group. NOT tinted: the pinned zone is painted from the ROW's own colour, and a
         caption with a plate of its own would break in two at the zone's edge. Weight and the glyph carry it instead. -->
    <Style Selector="DataGridGroupHeader">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="8 0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridGroupHeader">
                    <!-- The nesting step is NOT set here: the ROW arranges the caption, and a level that showed as a
                         margin would be one description of the indent too many. -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <!-- A GRID, not a StackPanel: a stack hands its children all the room they ask for along its
                             own direction, so the caption never trimmed and drew straight over whatever stood to the
                             right of it. The star column is what gives the text an edge to trim against. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Grid.Column="0" x:Name="Expander"
                                   Source="{ResourceReference ChevronRightIcon}"
                                   Width="10" Height="10" Margin="0 0 6 0"
                                   VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"
                                    x:Name="PART_ContentPresenter"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharEllipses"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsExpanded" Value="true">
                            <Setter TargetName="Expander" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A total, in the strip under the table and in a group's header. Right-aligned and set apart from a cell by
         COLOUR: it is a conclusion about the column, not one more of its values, and this engine has no font weight to
         say so with. -->
    <Style Selector="DataGridFooterCell">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
        <Setter Property="Padding" Value="8 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridFooterCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                TextTrimming="CharEllipses"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
