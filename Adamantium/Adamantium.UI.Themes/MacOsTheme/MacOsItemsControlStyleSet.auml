<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- CanContentScroll=true so the ScrollViewer delegates to the virtualizing panel (item scrolling). -->
    <Style Selector="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The hole a drag opens: an outline, never a filled card - a filled plate is what "still loading" looks like. -->
    <Style Selector="ItemsControl">
        <Setter Property="DropPlaceholderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- A Shape, not a Border: the dashes live on Shape.StrokeDashArray. -->
                    <Rectangle IsHitTestVisible="False" Fill="Transparent" StrokeThickness="2"
                            StrokeDashArray="4,3"
                            Stroke="{ThemeResource AccentFillColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ItemsControl">
        <Setter Property="ItemSkeletonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- No margin: the panel insets the card by the real item's. The fill is the SHARED brush, so the
                         breathe below is one animation and not one per card (a screenful can be 4000+). -->
                    <Border CornerRadius="{ResourceReference CornerRadiusDefault}" BorderThickness="1"
                            IsHitTestVisible="False"
                            Background="{ObservableResource SkeletonPulseFill}"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TargetName here resolves a keyed RESOURCE, not a template part - that is how a trigger reaches a shared brush. -->
    <Style Selector="ItemsControl">
        <PropertyTrigger Property="IsLoadingItems" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="SkeletonPulseFill">
                    <PulseAnimation Property="Opacity" Min="0.05" Max="0.15" Duration="0:0:1.2" Easing="CubicInOut"/>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="SkeletonPulseFill"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

</StyleSet>
