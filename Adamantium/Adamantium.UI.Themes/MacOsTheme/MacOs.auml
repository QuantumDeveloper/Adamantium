<?xml version="1.0" encoding="utf-8" ?>
<Theme xmlns="http://adamantium/ui"
       xmlns:x="http://adamantium/ui/xaml/extensions"
       xmlns:fluent="clr-namespace:Adamantium.UI.Themes.FluentTheme"
       xmlns:mac="clr-namespace:Adamantium.UI.Themes.MacOsTheme"
       Name="macOS"
       SystemLightVariant="Light"
       SystemDarkVariant="Dark"
       ResourceContext.Scope="Theme">

  <!-- The macOS theme: so far a WINDOW, a CAPTION, and the controls that carry a STATE - the push button, the switch,
       the checkbox and the radio button. Those four were taken first on purpose: state is what a platform's controls
       are recognised by, long before its lists or its fields are.

       SCAFFOLDING, SAID OUT LOUD: the STYLE SETS below, bar the macOS ones, are still Fluent's. That is not the
       finished shape - a theme owns its own sets, as Editor Pro does - it is what lets the chrome be looked at today
       instead of after fifty files. Each gets replaced by a macOS one as the work goes on, and this comment shrinks
       with the list.

       The PALETTE is no longer borrowed: MacOsLight and MacOsDark answer every key themselves.

       Borrowing works at all because the KEYS are a contract between themes: a template asks for
       SolidBackgroundFillColorBase or FontSizeChrome and every theme answers it. macOS's own metrics are linked after
       Fluent's - the later link answers first - so the handful of numbers that actually differ (caption height, corner
       radius, the lights) override while everything else still resolves. -->

  <ResourceContext.Resources>
    <ResourceLink Source="{x:Type fluent:Icons}"/>
    <ResourceLink Source="{x:Type fluent:Metrics}"/>
    <ResourceLink Source="{x:Type fluent:Materials}"/>
    <ResourceLink Source="{x:Type mac:MacOsMetrics}"/>
  </ResourceContext.Resources>

  <Theme.Variants>
    <mac:MacOsDark/>
    <mac:MacOsLight/>
  </Theme.Variants>

  <Theme.StyleIncludes>
        <!-- Borrowed from Fluent until each has a macOS counterpart, and the borrowed one is then DELETED here rather
             than left to lose: a Template setter is the only thing the winning set wins outright. Every OTHER style in
             the losing set is still live, and its triggers address parts BY NAME - so Fluent's IsChecked trigger went
             on writing SwitchTrack's border brush and SwitchThumb's margin into the macOS switch's identically-named
             parts, which is what put 2 at one end of the track and 4 at the other. A part name is not private to a
             template; two sets for one control are two sets, not an override. -->
        <!-- FIRST, because macOS's own come after and the later set wins a tie: the traffic lights are Buttons, and
             Fluent's plain Button style would otherwise paint over the class style that makes them coloured circles. -->
        <StyleInclude Source="{x:Type fluent:TextBlockStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:BorderStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ContentControlStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:RepeatButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ThumbStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ZoomBoxStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ToggleButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:NumericUpDownStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ProgressBarStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:RingProgressBarStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:BusyIndicatorStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ItemsControlStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ListBoxStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ListBoxItemStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:DropInsertionIndicatorStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:DragHandleStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:SelectionAdornerStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:HoverAdornerStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:FocusAdornerStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:KeyTipAdornerStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:TilesHostStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:FlipTileStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:DropDownItemStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ToolTipStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:TabControlStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:TabItemStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:RibbonStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:SlidePanelStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:OverlayWindowStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ResizeGripperStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:MenuStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:TreeViewStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:GridSplitterStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:DockingStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ColorPickerStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ColorPickerButtonStyleSet}"/>
        <StyleInclude Source="{x:Type fluent:ColorWheelStyleSet}"/>

        <!-- macOS's own. The ORDER of these is deliberately the one that used to break: the plain Button style set is
             LAST, after the caption that specialises Button into traffic lights. It stays that way as a standing check
             that specificity is decided by the SELECTORS and not by this list - see Style.StyleBandOfSelector. -->
        <StyleInclude Source="{x:Type mac:MacOsWindowStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsTitleBarStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsButtonStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsToggleSwitchStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsCheckBoxStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsRadioButtonStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsTextBoxStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsScrollBarStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsScrollViewerStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsDropDownStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsSliderStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsRangeSliderStyleSet}"/>
        <StyleInclude Source="{x:Type mac:MacOsSliderKnobStyleSet}"/>
  </Theme.StyleIncludes>

</Theme>
