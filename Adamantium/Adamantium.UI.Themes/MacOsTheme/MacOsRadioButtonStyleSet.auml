<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS radio button, and it is the checkbox's twin on purpose: same 14, same hairline, same no-hover, same
         darkening press. A platform's selection controls are one family, and the giveaway when they are not is that the
         box and the circle in one dialog turn out to be different sizes.

         What is its own: the SELECTED marker is a small white dot on the accent, not a ring with a hole. AppKit fills
         the circle and puts a dot in it, which at this size is the only way the state survives.

         ON THE SIZE, because 14 was tried first and was wrong here: AppKit's regular radio IS 14 points, but a Mac has
         drawn it on a 2x screen since Retina, so those 14 points are 28 device pixels and the hairline and the dot keep
         their shape. At 1x, 14 points are 14 pixels: a 1px ring round a 4px dot stops being a control and becomes a
         smudge. 16 is the smallest that survives being drawn one pixel to the point. -->

    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- Same material as the unset CheckBox, and for the same reason - see MacOsCheckBoxStyleSet. The two are one
             family and must not drift apart. -->
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="OuterRing"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"/>
                            <!-- A third of the diameter. Bigger and it stops being a dot on a filled disc and starts
                                 being a ring, which is the Windows marker; smaller and it disappears at 1x. -->
                            <Ellipse x:Name="Dot"
                                     Width="6" Height="6"
                                     Fill="{ThemeResource AccentForegroundColor}"
                                     Opacity="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton">
        <!-- No IsMouseOver trigger, deliberately - see MacOsButtonStyleSet. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="OuterRing" Property="Fill" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="OuterRing" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
            <!-- Un-inherit the ToggleButton accent-label - see the note in MacOsCheckBoxStyleSet. -->
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="OuterRing" Property="Fill" Value="{ResourceReference ControlFillColorTertiary}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="true"/>
                <Condition Property="IsPressed" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="OuterRing" Property="Fill" Value="{ThemeResource AccentFillColorTertiary}"/>
            <Setter TargetName="OuterRing" Property="Stroke" Value="{ThemeResource AccentFillColorTertiary}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="OuterRing" Property="Fill" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- The same control wearing the toggle button's clothes: `<RadioButton Classes="Toggle"/>`. For a row that is
         really ONE choice - a family selector, a view switch - where the circle and dot would be wrong beside their
         neighbours but the exclusivity is exactly what is wanted. Written with ToggleButtons such a row needs the bound
         property to clear the others, and a click on the one already down turns it off: the choice disappears while
         what it chose stays on screen.
         BasedOn rather than a copied template - a type style is a boundary here, so this pulls the toggle look in whole
         and the two cannot drift. Last in the file on purpose: at equal type specificity document order decides, so it
         has to be declared after the plain RadioButton styles it replaces. -->
    <Style Selector="RadioButton.Toggle" BasedOn="ToggleButton"/>

    <!-- A PAGE NUMBER in a pager's row: the toggle look, plus the one thing a toggle in this theme does not do. Same
         reasoning as RepeatButton.PagerArrow - a row of numbers is read as a row of destinations, and the pointer has
         to say which one it is on before the click, because unlike a lone toggle there are five of them side by side.

         The hover is a MULTITRIGGER rather than a plain one so the CURRENT page keeps its accent while the pointer is
         over it. A bare IsMouseOver trigger sits above the inherited IsChecked one and would swap the accent for the
         subtle fill - the page you are on would go grey exactly when you pointed at it. -->
    <Style Selector="RadioButton.PagerPage" BasedOn="ToggleButton"/>

    <!-- NO PADDING, A FLOOR INSTEAD. The control padding is a text inset - it is 12 to the left and 12 to the right of
         a word, and vertically 4 above and 5 below, which is right for a caption sitting on a baseline and wrong for a
         number centred in a square. Worse, it made the button's width a function of its LABEL: "1" and "146" came out
         different widths, so every button beside them shifted as the reader paged, and the ellipsis - a narrow glyph
         with the same 24 points of inset - set its own width too. Zero inset plus a minimum leaves the number centred
         in a square that only grows once a number is genuinely wider than the square. -->
    <Style Selector="RadioButton.PagerPage">
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="Padding" Value="0"/>

        <!-- The same two keys the arrows take, so the row lines up by construction rather than by two numbers that
             happen to be equal today. Height FIXED, width a floor - a height that followed its content would step up
             and down as the digits changed. -->
        <Setter Property="MinWidth" Value="{ResourceReference PagerButtonMinWidth}"/>
        <Setter Property="Height" Value="{ResourceReference PagerButtonHeight}"/>

        <!-- Said outright, not inherited. The plain RadioButton states only its VERTICAL content alignment - a radio is
             a dot with a label beside it, so its content is left-aligned by default - and the centring these need
             arrives only through the toggle look this class is based on. Once the padding is gone and the width is a
             floor, an uncentred number sits against the left wall of a 30-point box, which is what "off" looks like.
             The button itself is centred in the row for the same reason: its height is fixed, so anything that stretched
             or topped it would put it at a different level from its neighbours. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The hover is gated on NOT being the current page. A trigger setter carries the BAND of the style that declared
         it and a class style outranks a type style, so an unguarded IsMouseOver here would sit above the inherited
         IsChecked trigger and the page you are on would go grey the moment you pointed at it. Pressed is left to the
         toggle's own triggers, which this does not contradict. -->
    <Style Selector="RadioButton.PagerPage">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="true"/>
                <Condition Property="IsChecked" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </MultiTrigger>
    </Style>

</StyleSet>
