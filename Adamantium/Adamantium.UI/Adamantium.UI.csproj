<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>x64</Platforms>
		<AssemblyName>Adamantium.UI</AssemblyName>
		<RootNamespace>Adamantium.UI</RootNamespace>
		<PackageId>Adamantium.UI</PackageId>
		<Authors>Adamantium.UI</Authors>
		<Company>Adamantium Studio</Company>
		<Product>Adamantium.UI</Product>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.ECS\Adamantium.ECS.csproj" />
		<ProjectReference Include="..\Adamantium.ProceduralGeometry\Adamantium.ProceduralGeometry.csproj" />
		<ProjectReference Include="..\Adamantium.MacOS\Adamantium.MacOS.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Controls\Adamantium.UI.Controls.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Core\Adamantium.UI.Core.csproj" />
		<!-- The UI's SHADERS, in their own project (the same shape Adamantium.FX has): the .fx/.fxh files and the effect
		     classes the generator makes from them. Split out so they can be referenced on their own, and so a shader
		     edit rebuilds this one project rather than the whole of Adamantium.UI. -->
		<ProjectReference Include="..\Adamantium.UI.FX\Adamantium.UI.FX.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Themes\Adamantium.UI.Themes.csproj" />
		<ProjectReference Include="..\Adamantium.Win32\Adamantium.Win32.csproj" />
		<ProjectReference Include="..\..\..\AdamantiumVulkan\Adamantium.Vulkan.Loader\Adamantium.Vulkan.Loader.csproj" />
		<ProjectReference Include="..\..\..\AdamantiumVulkan\Adamantium.Vulkan\Adamantium.Vulkan.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj"/>
		<ProjectReference Include="..\Adamantium.Graphics.Core\Adamantium.Graphics.Core.csproj"/>
		<ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj"/>
		<ProjectReference Include="..\Adamantium.EffectsCompiler\Adamantium.EffectsCompiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
		<ProjectReference Include="..\Adamantium.Engine.Generators\Adamantium.Engine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0"/>
		<!-- netstandard2.0 analyzer deps for the source generators above (Roslyn analyzers must be netstandard2.0).
		     Analyzer-ONLY so the netstandard2.0 build isn't copied into this net10.0 output - runtime/compile
		     Core+Mathematics come from the normal net10.0 refs above. -->
		<ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0"/>
		<ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.ObjectModel" Version="4.0.12" />
	</ItemGroup>

	<ItemGroup>
		<!-- Lets the render-cache test harness construct the internal DrawingContext directly. -->
		<InternalsVisibleTo Include="Adamantium.UITests" />
	</ItemGroup>

	<ItemGroup>
		<!-- No .fx/.fxh here any more - they live in Adamantium.UI.FX, which generates the effect classes this project
		     draws through. The generator options stay because other generators in this project read them. -->
		<CompilerVisibleProperty Include="RootNamespace" />
		<AdditionalFiles Remove="obj\**" />
		<!-- IDE up-to-date check: rebuild when generator inputs (AdditionalFiles) change. -->
		<UpToDateCheckInput Include="@(AdditionalFiles)" Visible="false" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="obj\**" />
	</ItemGroup>
</Project>
