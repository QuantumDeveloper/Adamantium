<Window x:Namespace="Adamantium.Game.Sandbox"
        xmlns="http://adamantium/ui"
		xmlns:x="http://adamantium/ui/xaml/extensions"
		xmlns:local="clr-namespace:Adamantium.Game.Sandbox"
		xmlns:vm="clr-namespace:Adamantium.Game.Sandbox.ViewModels"
        x:ViewModel="{x:Type vm:MainViewModel}"
        x:CreateInDesignTime="False"
        Title="Adamantium Window"
        ContentTransition="SlideLeft"
        Width="1280"
        Height="720">
    <Grid>
        <Button Width="150"
                Height="150"
                Background="Yellow"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        </Button>
    <RenderTargetPanel x:Name="TestGrid1"
                       Opacity="0.95"
                       Background="{ResourceReference ApproveBrush}">
        <RenderTargetPanel.Behaviors>
            <local:GameHostBehavior/>
        </RenderTargetPanel.Behaviors>
		<!-- Closed-contour GPU stroke demo with ROUND joins: this star is one closed contour, its outline built by the
		     compute expander (wrap-around miter ribbon + a round disc fan at each star tip = round joins). -->
		<Path StrokeThickness="5"
              Stroke="Cyan"
              Fill="Magenta"
              StrokeLineJoin="Round"
              Name="Path1"
              Data="F0 M110,10 L168.78,190.9 L14.89,79.1 L205.11,79.1 L51.22,190.9 Z"
		      HorizontalAlignment="Left"/>
   
        <Path Name="Path2"
              Fill="Orange"
              StrokeThickness="5"
              Stroke="Cyan"
              
              StrokeDashArray="200 40"
              StrokeLineJoin="Round"
		      HorizontalAlignment="Right"
              Data="M184,110 L209.14,123.05 L206.59,135.88 L178.37,138.32 L174.09,147 L189.34,170.88 L180.71,180.71 L155.05,168.71 L147,174.09 L148.27,202.39 L135.88,206.59 L119.66,183.37 L110,184 L96.95,209.14 L84.12,206.59 L81.68,178.37 L73,174.09 L49.12,189.34 L39.29,180.71 L51.29,155.05 L45.91,147 L17.61,148.27 L13.41,135.88 L36.63,119.66 L36,110 L10.86,96.95 L13.41,84.12 L41.63,81.68 L45.91,73 L30.66,49.12 L39.29,39.29 L64.95,51.29 L73,45.91 L71.73,17.61 L84.12,13.41 L100.34,36.63 L110,36 L123.05,10.86 L135.88,13.41 L138.32,41.63 L147,45.91 L170.88,30.66 L180.71,39.29 L168.71,64.95 L174.09,73 L202.39,71.73 L206.59,84.12 L183.37,100.34 Z">
            <Path.Triggers>
                <PropertyTrigger Property="IsMouseOver" Value="true">
                    <PropertyTrigger.EnterActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:2.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="550"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.EnterActions>
                    <PropertyTrigger.ExitActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:2.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="550"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.ExitActions>
                </PropertyTrigger>
            </Path.Triggers>
        </Path>

		<Path Name="Path3"
              Fill="Red"
              StrokeThickness="5"
              Stroke="Blue"
              HorizontalAlignment="Center"
			  VerticalAlignment="Center">
            <Path.Data>
                <GeometryGroup>
                    <CombinedGeometry GeometryCombineMode="Xor">
                        <CombinedGeometry.Geometry1>
                            <EllipseGeometry RadiusX="40" RadiusY="40" Center="75,75"/>
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <EllipseGeometry RadiusX="40" RadiusY="40" Center="125,75" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                    <CombinedGeometry GeometryCombineMode="Intersect">
                        <CombinedGeometry.Geometry1>
                            <EllipseGeometry RadiusX="40" RadiusY="40" Center="175,75"/>
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <EllipseGeometry RadiusX="40" RadiusY="40" Center="225,75" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </GeometryGroup>
            </Path.Data>
        </Path>
		
<!--		<Border Width="200"-->
<!--                Height="50"-->
<!--				Background="Red"-->
<!--				HorizontalAlignment="Center"-->
<!--				VerticalAlignment="Center"-->
<!--				CornerRadius="10"-->
<!--				/>-->
<!--		-->
<!--		<Button Width="100"-->
<!--                Height="40"-->
<!--                HorizontalAlignment="Center"-->
<!--                VerticalAlignment="Bottom"-->
<!--                Content="Проверка контента">-->
<!--            -->
<!--        </Button>-->

<!--        <ContentControl Background="Red"                        -->
<!--                        Width="550"-->
<!--                        Height="50"-->
<!--                        HorizontalContentAlignment="Right"-->
<!--                        HorizontalAlignment="Center"-->
<!--        >-->
<!--            -->
<!--        </ContentControl>-->
        <TextBlock Text="Крупный текст1! - Проверка!?!"
                   FontSize="24"
                   VerticalAlignment="Bottom"
        Background="Transparent"/>

        <Button Width="150"
                Height="130"
                Background="Yellow"
                Command="{Binding ShowMessageCommand, FallbackValue=50, Mode=OneWay}"
                HorizontalAlignment="Left"
                Opacity="0.8"
                VerticalAlignment="Bottom">
            <Button.Transitions>
                <!-- CSS-style implicit transition: any change to Opacity (code/binding/state) eases over 0.4s. -->
                <DoubleTransition Property="Width" Duration="0:0:0.6"/>
            </Button.Transitions>
        </Button>
        
        <Button Width="120"
            Height="80"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">
            <!-- Logical (control-level) trigger: dim on hover, restore on exit - keyframe animations via Enter/Exit actions. -->
            <Button.Triggers>
                <PropertyTrigger Property="IsMouseOver" Value="true">
                    <PropertyTrigger.EnterActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:0.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="Width" Value="120"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="Width" Value="150"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.EnterActions>
                    <PropertyTrigger.ExitActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:0.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="Width" Value="150"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="Width" Value="120"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.ExitActions>
                </PropertyTrigger>
            </Button.Triggers>
        </Button>
        
<Image Grid.Column="0"
       Width="200"
       Height="200"
       HorizontalAlignment="Left"
       VerticalAlignment="Top"
       CornerRadius="0"
       MipLevel="3"
       Opacity="0.8"
       Source="Textures/APNG-cube.png"/>
<!--        <Image Grid.Column="0" -->
<!--			   HorizontalAlignment="Center"-->
<!--               VerticalAlignment="Top"-->
<!--               CornerRadius="6"-->
<!--               Source="Textures\luxfon.tga"-->
<!--        />-->
<!--		<Image Grid.Column="1" -->
<!--			   HorizontalAlignment="Center"-->
<!--               VerticalAlignment="Bottom"-->
<!--               CornerRadius="6"-->
<!--			   Delay="25"-->
<!--               Source="Textures\infinity.gif"-->
<!--        />-->
