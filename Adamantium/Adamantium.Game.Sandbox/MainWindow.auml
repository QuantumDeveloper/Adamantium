<!--			   HorizontalAlignment="Center"-->
<!--               VerticalAlignment="Center"-->
<!--               CornerRadius="6"-->
<!--			   Delay="25"-->
<!--               Source="Textures\APNG-cube.png"-->
<!--        />-->
