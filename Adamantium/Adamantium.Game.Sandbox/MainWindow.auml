<!--			   VerticalAlignment="Center"-->
<!--			   HorizontalAlignment="Center"/>-->

<!--        <TextBlock Text="Тестовый текст"-->
<!--                   Grid.ColumnSpan="3"-->
<!--                   Background="White"-->
<!--                   Foreground="Black"-->
<!--                   Stroke="Transparent"-->
<!--                   TextWrapping="WrapByWords"-->
<!--                   TextTrimming="CharEllipses"-->
<!--                   HorizontalAlignment="Center"-->
<!--                   VerticalAlignment="Center"-->
<!--                   HorizontalTextAlignment="Left"-->
<!--                   FontSize="16"/>-->
    </RenderTargetPanel>

        <!-- GPU stroke smoke test: this line's ribbon is built by the compute expander (StrokeExpand) and drawn by
             StrokeDraw, NOT the CPU StrokeGeometry. An open, single-segment, solid stroke routes to
             GpuStrokeRenderComponent (RenderUnit.UseGpuStroke). Drawn last in the Grid, so it sits on top. -->
        <!-- One-pass GPU cut demo: dashes (StrokeDashArray) AND trim (StrokeTrimStart/End) both done by the single
             DashCut compute kernel + DrawIndirect - zero per-frame CPU. Shows the middle 10%..70% of the dashed line. -->
        <Line X1="200" 
              Y1="200" 
              X2="500" 
              Y2="520"
              StrokeDashSymbols="Dash Dot Dot Dash Dot"
              StrokeDashGlyphs="Dash=18, Dot=3, Gap=16"
              StrokeDashArray="36 25"
              StrokeDashCap="ConvexRound"
              Stroke="Lime"
              StrokeThickness="12"              
              StartLineCap="ConvexRound"
              EndLineCap="ConvexRound"
              StrokeTrimStart="0"
              StrokeTrimEnd="1"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
            <Line.Triggers>
                <PropertyTrigger Property="IsMouseOver" Value="true">
                    <PropertyTrigger.EnterActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:2.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="550"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.EnterActions>
                    <PropertyTrigger.ExitActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:2.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="550"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.ExitActions>
                </PropertyTrigger>
            </Line.Triggers>
        </Line>
    </Grid>
</Window>