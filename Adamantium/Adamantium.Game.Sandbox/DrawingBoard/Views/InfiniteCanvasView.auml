<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:models="clr-namespace:Adamantium.Game.Sandbox.DrawingBoard.Models">

    <!-- WHAT IS INSIDE A NODE, written HERE because it is a picture. The page's table of kinds hands each node a plain
         state object and nothing else; which of these draws it is decided by the type of that object. A view-model that
         built these controls itself would be a view-model drawing, and the value a person set would then have to be dug
         back out of the visual tree to save it. -->
    <ResourceContext.Resources>
        <models:NodeBodySelector x:Key="NodeBodies">
            <models:NodeBodySelector.Number>
                <DataTemplate>
                    <!-- THOUSANDTHS, and no more. A number here is something a hand dragged to, and the hand cannot
                         mean the seventeen digits that come out of adding a twentieth to itself - "1,0125000000000002"
                         is the arithmetic showing through. -->
                    <NumericUpDown Value="{Binding Value, Mode=TwoWay}"
                                   Minimum="0" Maximum="4" SmallChange="0.05" StringFormat="0.###"
                                   AreButtonsVisible="False" IsDragScrubEnabled="True"/>
                </DataTemplate>
            </models:NodeBodySelector.Number>

            <models:NodeBodySelector.Color>
                <DataTemplate>
                    <ColorPickerButton SelectedColor="{Binding Color, Mode=TwoWay}"
                                       Height="26" MinWidth="0" Padding="2"/>
                </DataTemplate>
            </models:NodeBodySelector.Color>

            <!-- WHAT CAME OUT, live: the color the whole graph works out, drawn as itself. This is the node that makes
                 the difference between a graph and a picture of one - change a number anywhere upstream and this
                 swatch follows. -->
            <models:NodeBodySelector.Result>
                <DataTemplate>
                    <Border Height="40" CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                            Background="{Binding Result, Converter={ColorToBrushConverter}}"/>
                </DataTemplate>
            </models:NodeBodySelector.Result>

            <!-- A node that is ALL SOCKETS shows nothing between them. -->
            <models:NodeBodySelector.None>
                <DataTemplate>
                    <Grid/>
                </DataTemplate>
            </models:NodeBodySelector.None>

        </models:NodeBodySelector>

        <!-- ...and the same on the DRAWING side: the page says a button is at such a place, and this says what a button
             looks like. A shape needs nothing here - the canvas draws one from its description - so only what is not a
             shape comes past. -->
        <models:PlacedThingSelector x:Key="PlacedThings">
            <models:PlacedThingSelector.Button>
                <DataTemplate>
                    <Button Content="{Binding Text}"/>
                </DataTemplate>
            </models:PlacedThingSelector.Button>

            <models:PlacedThingSelector.Switch>
                <DataTemplate>
                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                </DataTemplate>
            </models:PlacedThingSelector.Switch>

            <models:PlacedThingSelector.Field>
                <DataTemplate>
                    <TextBox Text="{Binding Text, Mode=TwoWay}"/>
                </DataTemplate>
            </models:PlacedThingSelector.Field>
        </models:PlacedThingSelector>
    </ResourceContext.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">


        <TextBlock Grid.Row="0" Text="InfiniteCanvas" FontSize="18"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,12" TextWrapping="WrapByWords"
                   Text="A plane with no edges: the wheel zooms toward the cursor, the middle button or space pans, and Home - or a double click of the middle button - returns to the origin. What the plain left button does belongs to the TOOL - select, pen, or a shape. What is selected gets a frame with grips, in screen pixels; dragging those moves and resizes the whole selection at once. Delete removes it, Escape lets go."/>

        <!-- EVERYTHING that steers the canvas is in the canvas's own panel, with no exceptions out here: a tool panel
             belongs ON the surface it works, and a row of switches above the frame is a second place to look.
             The two that stood here are gone rather than moved. One of them was the whiteboard, which is the Grid row
             of the inspector saying Transparent and was never anything else. The other hid the tool panel, and that one
             could NOT come inside: a switch that takes away the panel it lives in can be used exactly once. The panel
             folds by its own grip, which is the same thing and comes back.  -->

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="0"
                BorderBrush="{ObservableResource ControlStrokeColorDefault}">
            <!-- Square corners on purpose: the clip here is a rectangular scissor, and a rounded frame would let the
                 canvas's own square corners poke out from under it. -->
            <Grid>
            <!-- UNDER the canvas: an ordinary page of controls, so the whiteboard mode has something to be a whiteboard
                 OVER. In the other three modes it is hidden behind the ground and never seen. -->
            <StackPanel Orientation="Vertical" Margin="40,30,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Width="320">
                <TextBlock Text="Somebody else's screen" FontSize="16"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="WrapByWords"
                           Text="An ordinary page of controls. Turn Whiteboard on and the canvas above becomes glass: this stays live underneath while the pen draws over it."
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <Button Content="A button" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                <CheckBox Content="A checkbox" Margin="0,10,0,0"/>
                <TextBox Text="A field" Margin="0,10,0,0" Width="200" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- The SCENE comes from the page. The canvas asks it what falls inside the piece of world it can see and
                 puts finished items into it; everything a drawing is for - undo, saving - stays with whoever owns
                 the drawing.
                 WHAT PAINTS A PIN is said by the TABLE above it (SocketKinds): the page says which word means which
                 colour, and the canvas does the rest. There is nothing to hand over but the table - which is what makes
                 it impossible to paint the graph wrong. -->
            <InfiniteCanvas x:Name="Canvas"
                            GridStyle="{Binding GridStyle}"
                            Mode="{Binding Mode, Mode=TwoWay}"
                            Scene="{Binding Scene}"
                            History="{Binding History}"
                            Tools="{Binding Tools}"
                            Selection="{Binding Selection, Mode=TwoWay}"
                            Tool="{Binding Tool}"
                            DefaultTool="{Binding SelectTool}"
                            Ink="{Binding Ink}"
                            ShapeFill="{Binding ShapeFillOrNothing}"
                            InkThickness="{Binding InkThickness}"
                            TextSize="{Binding TextSize}"
                            EraserSize="{Binding EraserSize}"
                            IsDesignMode="{Binding DesignMode}"
                            SnapToGrid="{Binding SnapToGrid}"
                            ShowsPointerReadout="{Binding ShowReadout}"
                            MaxScale="{Binding MaxZoom}"
                            SnapMarkBrush="{Binding SnapMark}"
                            SnapMarkSize="{Binding SnapMarkSize}"
                            OverlayPlacement="TopLeft"
                            Scale="{Binding Scale, Mode=TwoWay}"
                            Offset="{Binding Offset, Mode=TwoWay}"
                            Objects="{Binding Objects}"
                            ObjectTemplateSelector="{ResourceReference PlacedThings}"
                            Nodes="{Binding Nodes}"
                            NodeKinds="{Binding NodeKinds}"
                            SocketKinds="{Binding SocketKinds}"
                            NodeContentSelector="{ResourceReference NodeBodies}"
                            ConfirmsDelete="{Binding AsksBeforeDelete}">
                <!-- The OVERLAY: on the glass, not on the plane. It neither moves nor scales with the camera, and the
                     canvas carries the LAYER while this content is the page's - which is how somebody who wants
                     different tools puts their own here instead of building a panel around the canvas. The grip above
                     it belongs to the canvas: it drags the panel and folds it away. -->
                <!-- The CHROME: several panels rather than one, each placed by the canvas against the edge it asks
                     for. The panels are on the glass - they neither move nor scale with the camera - and what is in
                     them is this page's, which is how somebody who wants different tools puts their own here. -->
                <InfiniteCanvas.Chrome>
                    <!-- The RAIL. No content and no buttons written here: the canvas builds one per tool out of its own
                         Tools list, takes the picture and the tip off each tool, and marks the one in hand. Adding a
                         tool is a line in the view model and nothing at all here. -->
                    <!-- FROM THE TOP, not centred down the edge: a rail centred on a short window reaches the bottom
                         corner, which is where the map is - and two panels over one another is a panel you cannot
                         press. From the top it grows downwards and meets nothing. -->
                    <CanvasPane Placement="TopLeft" Kind="Rail" CanDrag="True"/>

                    <!-- THE INSPECTOR, and it has two faces in one place. With nothing selected it shows what you are
                         working WITH - the tool and its settings; with something selected, what you are working ON.
                         That is why the grid settings and the pen's thickness live here and not in some other panel:
                         they are the SELECT and PEN tools' own settings, and a tool's settings belong with the tool. -->
                    <!-- The panel NAMES itself with whatever it is about - the tool in hand, or what is selected. That
                         caption is what makes the change of contents read as one panel following you rather than two
                         panels taking turns. -->
                    <!-- Width is the PANE's and not the rows': a node's sockets carry names, and a name column fixed
                         at whatever fitted the pen settings is a column that truncates every one of them. The edge is
                         draggable, and what is inside stretches to what the edge is set to. -->
                    <CanvasPane Placement="TopRight" Kind="Sheet" Header="{Binding Face}"
                                CanResize="True" Width="340" MinResizeWidth="200">
                        <DockPanel LastChildFill="True">

                        <!-- WHICH FACE, and it is the only thing in the panel the user chooses outright - properties
                             follow what is selected, the list does not follow anything. RADIOS and not two toggles:
                             one of them is always on, and a radio is the control that cannot be clicked into a state
                             where neither is. -->
                        <!-- TWO CHOICES IN ONE ROW, told apart by a rule rather than by a line break: what the canvas
                             is being used AS - a drawing or a graph - and which face of the panel is showing. Four
                             buttons with words on them took two rows of a panel whose whole job is the rows below
                             them; a pictogram says the same thing in a quarter of the width, and the tip says it in
                             words for whoever wants them. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" MarginBottom="8">
                            <RadioButton Classes="Toggle" GroupName="CanvasMode"
                                         Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                         ToolTip="Drawing - ink, shapes and text"
                                         IsChecked="{Binding IsDrawing, Mode=TwoWay}">
                                <Image Source="{ObservableResource ToolPenIcon}" Width="13" Height="13"/>
                            </RadioButton>
                            <RadioButton Classes="Toggle" GroupName="CanvasMode" MarginLeft="4"
                                         Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                         ToolTip="Graph - nodes and the wires between them"
                                         IsChecked="{Binding IsGraph, Mode=TwoWay}">
                                <Image Source="{ObservableResource ToolNodeIcon}" Width="13" Height="13"/>
                            </RadioButton>

                            <Separator Orientation="Vertical" MarginLeft="6" MarginRight="6"/>

                            <RadioButton Classes="Toggle" GroupName="CanvasInspectorFace"
                                         Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                         ToolTip="Properties of what is selected"
                                         IsChecked="{Binding ShowsProperties, Mode=TwoWay}">
                                <Image Source="{ObservableResource FaceInspectorIcon}" Width="13" Height="13"/>
                            </RadioButton>
                            <RadioButton Classes="Toggle" GroupName="CanvasInspectorFace" MarginLeft="4"
                                         Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                         ToolTip="Everything on the plane, topmost first"
                                         IsChecked="{Binding ShowsStructure, Mode=TwoWay}">
                                <Image Source="{ObservableResource FaceStructureIcon}" Width="13" Height="13"/>
                            </RadioButton>
                        </StackPanel>

                        <!-- ONE ROW of actions on the whole canvas, and it is the last thing in the panel because that
                             is what it is about: not what is selected and not what the tool will do next, but the work
                             as a whole. What belongs to a GRAPH is hidden in a drawing; the bin belongs to both and
                             comes last, where a destructive button is furthest from the ones next to it.
                             PICTOGRAMS: ten of these in words took three rows of a panel whose whole job is the rows
                             above them, and the words that told two of them apart - "Rows" against "Columns" - said
                             the opposite of what the buttons did. A picture of equal gaps running down cannot. -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" MarginTop="8">
                            <!-- WRAPPED, not one hand-made row: how many of these fit depends on how wide the panel has
                                 been dragged, and a row that cannot fit them all simply cuts the last ones off. -->
                            <WrapPanel Orientation="Horizontal">
                                <!-- The gaps are TRAILING, not leading: a wrapped row starts a new line with whatever
                                     margin the first button on it carries, and a leading one indents that line by
                                     itself. A trailing margin at the end of a line is invisible. -->
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Save the graph to a file"
                                        Command="{Binding SaveGraphCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource SaveIcon}" Width="13" Height="13"/>
                                </Button>
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Open a graph from a file"
                                        Command="{Binding LoadGraphCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource OpenIcon}" Width="13" Height="13"/>
                                </Button>
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Draw a comment frame round what is selected"
                                        Command="{Binding FrameSelectionCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource FrameIcon}" Width="13" Height="13"/>
                                </Button>

                                <!-- PUTTING THE WORK IN ORDER. A plane has no grid to snap a row against, so lining up
                                     and spreading out are the only way a graph ever looks tidy. -->
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Line the left edges up"
                                        Command="{Binding AlignLeftCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource AlignLeftIcon}" Width="13" Height="13"/>
                                </Button>
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Line the middles up"
                                        Command="{Binding AlignMiddleCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource AlignMiddleIcon}" Width="13" Height="13"/>
                                </Button>
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Line the right edges up"
                                        Command="{Binding AlignRightCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource AlignRightIcon}" Width="13" Height="13"/>
                                </Button>
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Line the top edges up"
                                        Command="{Binding AlignTopCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource AlignTopIcon}" Width="13" Height="13"/>
                                </Button>

                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Equal gaps down a column"
                                        Command="{Binding SpreadRowsCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource SpreadRowsIcon}" Width="13" Height="13"/>
                                </Button>
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Equal gaps across a row"
                                        Command="{Binding SpreadColumnsCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource SpreadColumnsIcon}" Width="13" Height="13"/>
                                </Button>

                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                        Visibility="{Binding GraphFace}"
                                        ToolTip="Bring the work into view - the F key does this too"
                                        Command="{Binding FitViewCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}">
                                    <Image Source="{ObservableResource FitIcon}" Width="13" Height="13"/>
                                </Button>

                                <!-- THE BIN, last and on its own: it is the one button here that takes something away,
                                     and it is about the whole canvas rather than the graph, so it stays in a drawing
                                     too. It asks before it does anything - see Erase. -->
                                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                        ToolTip="Clear the canvas"
                                        Command="{Binding EraseCommand}">
                                    <Image Source="{ObservableResource BinIcon}" Width="13" Height="13"/>
                                </Button>
                            </WrapPanel>

                            <TextBlock Text="{Binding GraphStatus}" FontSize="11" MarginTop="6"
                                       Visibility="{Binding GraphFace}"
                                       TextTrimming="CharEllipses"/>
                        </StackPanel>

                        <Grid>
                        <!-- The panel holds more than a small viewport has room for, and a tool panel that runs off the
                             bottom is one whose last button cannot be pressed. It SCROLLS rather than being trimmed or
                             emptied out into the page: what is in it is what the canvas can do, and all of it belongs
                             on the canvas.
                             HIDDEN and not Auto: the bar is drawn over the right-hand column and covers the very
                             steppers it sits on, and a panel this small is scrolled with the wheel anyway. Hidden still
                             scrolls - it is Disabled that would stop it. -->
                        <!-- MAX height, not height. A stated height is claimed whether or not there is anything to put
                             in it, so a short face left a tall empty strip under the last row - the panel looked like
                             it had lost something. A ceiling shrinks to the content and still scrolls past it. -->
                        <!-- The rows SCROLL and the bin does NOT. -->
                        <Grid RowDefinitions="*,Auto" Visibility="{Binding ToolFace}">
                        <ScrollViewer Grid.Row="0" MaxHeight="300"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Vertical">

                            <!-- THE SAME INSPECTOR as the second face, pointed at the page instead of at a selection.
                                 That is what makes the change seamless: one name column, one row height, one kind of
                                 section - only the contents differ. Two hand-built panels taking turns would read as
                                 two panels however carefully they were matched. -->
                            <PropertyGrid SelectedObject="{Binding}" NameColumnWidth="92" ShowSearch="False">
                                <PropertySection Header="Pen" IsExpanded="True"
                                                 Visibility="{Binding PenSettings}">
                                    <ColorProperty Header="Color" Binding="{Binding InkColor}"/>
                                    <NumericProperty Header="Thickness" Binding="{Binding InkThickness}"
                                                     Minimum="0.5" Maximum="24" Step="0.5" ShowButtons="False"/>
                                </PropertySection>

                                <PropertySection Header="Eraser" IsExpanded="True"
                                                 Visibility="{Binding EraserSettings}">
                                    <NumericProperty Header="Diameter" Binding="{Binding EraserSize}"
                                                     Minimum="2" Maximum="240" Step="2" ShowButtons="False"/>
                                </PropertySection>

                                <PropertySection Header="Text" IsExpanded="True"
                                                 Visibility="{Binding TextSettings}">
                                    <NumericProperty Header="Size" Binding="{Binding TextSize}"
                                                     Minimum="6" Maximum="96" Step="1" ShowButtons="False"/>
                                    <ColorProperty Header="Color" Binding="{Binding InkColor}"/>
                                </PropertySection>

                                <PropertySection Header="Shape" IsExpanded="True"
                                                 Visibility="{Binding ShapeSettings}">
                                    <BooleanProperty Header="Fill" Binding="{Binding Filled}"/>
                                    <ColorProperty Header="Fill color" Binding="{Binding FillColor}"/>
                                    <ColorProperty Header="Stroke" Binding="{Binding InkColor}"/>
                                    <NumericProperty Header="Thickness" Binding="{Binding InkThickness}"
                                                     Minimum="0.5" Maximum="24" Step="0.5" ShowButtons="False"/>
                                </PropertySection>

                                <!-- The SURFACE: what the plane looks like and what it pulls to. Shown under every
                                     tool, because it is about the paper rather than the pen. -->
                                <PropertySection Header="Canvas" IsExpanded="True">
                                    <ChoiceProperty Header="Grid" Binding="{Binding GridStyle}"
                                                    ItemsSource="{Binding GridStyles}"/>
                                    <!-- A graph snaps to nothing, so the switch does not belong there: one that changes
                                         nothing is worse than one that is not offered. -->
                                    <BooleanProperty Header="Snap" Binding="{Binding SnapToGrid}"
                                                     IsVisible="{Binding IsDrawing}"/>
                                    <BooleanProperty Header="Readout" Binding="{Binding ShowReadout}"/>
                                    <!-- Only for ONE object. Clearing the whole scene always asks, and that is not a
                                         setting: nothing does it by accident, so the question is never a surprise. -->
                                    <BooleanProperty Header="Confirm" Binding="{Binding AsksBeforeDelete}"
                                                     Description="Ask before removing what is selected. Clearing the whole canvas always asks."/>
                                    <ColorProperty Header="Snap mark" Binding="{Binding SnapColor}"/>
                                    <NumericProperty Header="Mark size" Binding="{Binding SnapMarkSize}"
                                                     Minimum="3" Maximum="24" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Max zoom" Binding="{Binding MaxZoom}"
                                                     Minimum="2" Maximum="8192" Step="16" ShowButtons="False"/>
                                    <BooleanProperty Header="Design" Binding="{Binding DesignMode}"/>
                                </PropertySection>
                            </PropertyGrid>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- The BIN is NOT here any more: clearing the canvas is one action on the whole of it, like
                             saving it is, and it stands in the row of those at the foot of the panel - where it is
                             also reachable with something selected, which is when a person usually wants it. -->
                        </Grid>

                        <!-- The SECOND face. Several objects at once are not a special case here - the grid shows the
                             value they share and says "different" when they do not, and writes to every one of them.
                             A section per KIND, shown when the selection holds one; a mixed selection honestly shows
                             several. -->
                        <!-- ONE BINDING, and the grid does the rest: a line written here becomes a step in the canvas's
                             memory by itself, and the canvas - which listens to that memory - draws the plane again.
                             Items on a canvas are DATA and say nothing when they are written to, which is what lets a
                             drawing hold tens of thousands of them; this is what closes that gap without the page
                             keeping any bookkeeping of its own. -->
                        <PropertyGrid Visibility="{Binding SelectionFace}"
                                      SelectedObjects="{Binding Selection}"
                                      History="{Binding ElementName=Canvas, Path=History}"
                                      NameColumnWidth="92" ShowSearch="False">

                            <!-- No steppers on the numbers here. They cost width, and in a panel this narrow that
                                 width comes straight out of the field the number is read in - the figure ends up in a
                                 box narrower than the buttons beside it. The field still takes the wheel and a typed
                                 value, which is how a number in an inspector is actually changed. -->
                            <!-- WHERE and HOW BIG on every kind, because that is true of everything on a plane. The
                                 four numbers are said in terms of Bounds, Move and Resize, so they mean the same on a
                                 stroke, a shape and a piece of text - and a new kind of item gets them by copying four
                                 lines. -->
                            <PropertySection Header="Stroke" IsExpanded="True"
                                             Visibility="{Binding StrokeSection}">
                                <SolidColorBrushProperty Header="Color" Binding="{Binding Brush}"/>
                                <NumericProperty Header="Thickness" Binding="{Binding Thickness}"
                                                 Minimum="0.1" Maximum="400" Step="1" ShowButtons="False"/>
                                <CompositeProperty Header="Position">
                                    <NumericProperty Header="X" Binding="{Binding X}" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Y" Binding="{Binding Y}" Step="1" ShowButtons="False"/>
                                </CompositeProperty>
                                <CompositeProperty Header="Size">
                                    <NumericProperty Header="Width" Binding="{Binding Width}" Step="1"
                                                     Minimum="0.01" ShowButtons="False"/>
                                    <NumericProperty Header="Height" Binding="{Binding Height}" Step="1"
                                                     Minimum="0.01" ShowButtons="False"/>
                                </CompositeProperty>
                            </PropertySection>

                            <PropertySection Header="Shape" IsExpanded="True"
                                             Visibility="{Binding ShapeSection}">
                                <SolidColorBrushProperty Header="Fill" Binding="{Binding Fill}"/>
                                <SolidColorBrushProperty Header="Stroke" Binding="{Binding Stroke}"/>
                                <!-- Down to ZERO, unlike a stroke's: a filled shape with no edge at all is a perfectly
                                     ordinary thing to want, while a line of no thickness is nothing. -->
                                <NumericProperty Header="Thickness" Binding="{Binding Thickness}"
                                                 Minimum="0" Maximum="400" Step="1" ShowButtons="False"/>
                                <!-- One section for every shape - they are the same KIND of item, and a section per
                                     shape would be three headers where one is honest - but the lines inside it come
                                     and go with what is selected: rounding is a rectangle's and sides are a polygon's,
                                     and an ellipse has neither. All FOUR corners, because a card with two rounded
                                     corners and two square ones is an ordinary shape. -->
                                <CompositeProperty Header="Corner" IsVisible="{Binding HasCorners}">
                                    <NumericProperty Header="Top left" Binding="{Binding CornerTopLeft}"
                                                     Minimum="0" Maximum="2000" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Top right" Binding="{Binding CornerTopRight}"
                                                     Minimum="0" Maximum="2000" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Bottom right" Binding="{Binding CornerBottomRight}"
                                                     Minimum="0" Maximum="2000" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Bottom left" Binding="{Binding CornerBottomLeft}"
                                                     Minimum="0" Maximum="2000" Step="1" ShowButtons="False"/>
                                </CompositeProperty>
                                <NumericProperty Header="Sides" Binding="{Binding Sides}"
                                                 Minimum="3" Maximum="64" Step="1" Decimals="0"
                                                 ShowButtons="False" IsVisible="{Binding HasSides}"/>
                                <!-- The head is measured in LINE THICKNESSES, so it stays part of its own line however
                                     thick the line is made. -->
                                <CompositeProperty Header="Head" IsVisible="{Binding HasHeads}">
                                    <ChoiceProperty Header="Start" Binding="{Binding StartHead}"
                                                    ItemsSource="{Binding ArrowHeads}"/>
                                    <ChoiceProperty Header="End" Binding="{Binding EndHead}"
                                                    ItemsSource="{Binding ArrowHeads}"/>
                                    <!-- A head is measured in LINE THICKNESSES, so a long thin arrow needs a lot of
                                         them before its head is something you can see: twenty of a two-unit line is
                                         forty units of head on an arrow that may be a thousand long. The ceiling is
                                         the room the head has, not a round number. -->
                                    <NumericProperty Header="Length" Binding="{Binding HeadLength}"
                                                     Minimum="0.5" Maximum="200" Step="0.5"                                                     Description="How long the head is, measured in line thicknesses"/>
                                    <NumericProperty Header="Width" Binding="{Binding HeadWidth}"
                                                     Minimum="0.5" Maximum="200" Step="0.5"                                                     Description="How wide the head is across its base, in line thicknesses"/>
                                </CompositeProperty>
                                <CompositeProperty Header="Position">
                                    <NumericProperty Header="X" Binding="{Binding X}" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Y" Binding="{Binding Y}" Step="1" ShowButtons="False"/>
                                </CompositeProperty>
                                <CompositeProperty Header="Size">
                                    <NumericProperty Header="Width" Binding="{Binding Width}" Step="1"
                                                     Minimum="0.01" ShowButtons="False"/>
                                    <NumericProperty Header="Height" Binding="{Binding Height}" Step="1"
                                                     Minimum="0.01" ShowButtons="False"/>
                                </CompositeProperty>
                                <!-- ONE transform, not two tools: a turn and a lean are the same kind of statement
                                     about a shape, and kept apart they would be two coordinate systems in one item.
                                     About the MIDDLE of its own box, which is what turning means to a hand. -->
                                <CompositeProperty Header="Transform">
                                    <NumericProperty Header="Angle" Binding="{Binding Angle}"
                                                     Minimum="-360" Maximum="360" Step="5"                                                     Description="Degrees clockwise, about the middle of the shape"/>
                                    <NumericProperty Header="Skew X" Binding="{Binding SkewX}"
                                                     Minimum="-89" Maximum="89" Step="5" ShowButtons="False"/>
                                    <NumericProperty Header="Skew Y" Binding="{Binding SkewY}"
                                                     Minimum="-89" Maximum="89" Step="5" ShowButtons="False"/>
                                </CompositeProperty>
                            </PropertySection>

                            <PropertySection Header="Text" IsExpanded="True"
                                             Visibility="{Binding TextSection}">
                                <StringProperty Header="Text" Binding="{Binding Text}"/>
                                <NumericProperty Header="Size" Binding="{Binding FontSize}"
                                                 Minimum="4" Maximum="400" Step="1" ShowButtons="False"/>
                                <SolidColorBrushProperty Header="Color" Binding="{Binding Brush}"/>
                                <CompositeProperty Header="Position">
                                    <NumericProperty Header="X" Binding="{Binding X}" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Y" Binding="{Binding Y}" Step="1" ShowButtons="False"/>
                                </CompositeProperty>
                            </PropertySection>

                            <!-- A CONTROL on the plane. Its label first, because that is the thing a person wants to
                                 change about a button they have just put down and the one thing there was no way to
                                 change at all; then where it is and how big, one number at a time. -->
                            <!-- A CURVE is one item for three kinds, and the kind is CHANGED here: which curve suits a
                                 line is decided by looking at it, not before drawing it. Degree and evenness belong to
                                 a NURBS alone. -->
                            <!-- A COMMENT FRAME. Its title is the whole point of it, so that is the first row: a frame
                                 with nothing written on it documents nothing. -->
                            <PropertySection Header="Frame" IsExpanded="True"
                                             Visibility="{Binding FrameSection}">
                                <StringProperty Header="Title" Binding="{Binding Title}"/>
                                <SolidColorBrushProperty Header="Outline" Binding="{Binding Stroke}"/>
                                <SolidColorBrushProperty Header="Wash" Binding="{Binding Fill}"
                                                         Description="Behind the nodes, so keep it faint - it must not change how they read"/>
                                <NumericProperty Header="Thickness" Binding="{Binding Thickness}"
                                                 Minimum="0" Maximum="20" Step="0.5" ShowButtons="False"/>
                                <NumericProperty Header="Title bar" Binding="{Binding TitleHeight}"
                                                 Minimum="8" Maximum="120" Step="1"                                                 Description="How tall the strip is - and that strip is what the frame is dragged by"/>
                            </PropertySection>

                            <PropertySection Header="Curve" IsExpanded="True"
                                             Visibility="{Binding CurveSection}">
                                <ChoiceProperty Header="Kind" Binding="{Binding Kind}"
                                                ItemsSource="{Binding Curves}"/>
                                <SolidColorBrushProperty Header="Stroke" Binding="{Binding Stroke}"/>
                                <NumericProperty Header="Thickness" Binding="{Binding Thickness}"
                                                 Minimum="0.1" Maximum="400" Step="1" ShowButtons="False"/>
                                <NumericProperty Header="Points" Binding="{Binding Count}" IsReadOnly="True"
                                                 Decimals="0" ShowButtons="False"/>
                                <!-- READ ONLY, and that is the honest answer: a Bezier through N+1 points is of degree
                                     N and can be nothing else. The way to ask for a quadratic is to draw it with three
                                     points. -->
                                <NumericProperty Header="Order" Binding="{Binding Degree}" IsReadOnly="True"
                                                 Decimals="0"                                                 IsVisible="{Binding IsBezier}"
                                                 Description="A Bezier through N+1 points is of degree N - add or remove a point to change it"/>
                                <NumericProperty Header="Degree" Binding="{Binding Degree}"
                                                 Minimum="0" Maximum="16" Step="1" Decimals="0"                                                 IsVisible="{Binding IsNurbs}"
                                                 Description="Zero lets the degree follow the number of points"/>
                                <BooleanProperty Header="Even" Binding="{Binding IsUniform}"
                                                 IsVisible="{Binding IsNurbs}"
                                                 Description="Whether the knots are evenly spaced"/>
                                <CompositeProperty Header="Position">
                                    <NumericProperty Header="X" Binding="{Binding Bounds.X}" IsReadOnly="True"
                                                     ShowButtons="False"/>
                                    <NumericProperty Header="Y" Binding="{Binding Bounds.Y}" IsReadOnly="True"
                                                     ShowButtons="False"/>
                                </CompositeProperty>
                            </PropertySection>

                            <!-- A GROUP has no color and no thickness of its own - what it has is a place, a size and
                                 a count. Without this section the panel went blank the moment anything was grouped,
                                 which reads as something broken rather than as "nothing to set here". -->
                            <PropertySection Header="Group" IsExpanded="True"
                                             Visibility="{Binding GroupSection}">
                                <NumericProperty Header="Holds" Binding="{Binding Count}" IsReadOnly="True"
                                                 Decimals="0" ShowButtons="False"/>
                                <CompositeProperty Header="Position">
                                    <NumericProperty Header="X" Binding="{Binding X}" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Y" Binding="{Binding Y}" Step="1" ShowButtons="False"/>
                                </CompositeProperty>
                                <CompositeProperty Header="Size">
                                    <NumericProperty Header="Width" Binding="{Binding Width}" Step="1"
                                                     Minimum="0.01" ShowButtons="False"/>
                                    <NumericProperty Header="Height" Binding="{Binding Height}" Step="1"
                                                     Minimum="0.01" ShowButtons="False"/>
                                </CompositeProperty>
                            </PropertySection>

                            <PropertySection Header="Control" IsExpanded="True"
                                             Visibility="{Binding ElementSection}">
                                <!-- Hidden for a NODE, which has a Title line of its own: the two wrote the same name,
                                     and two lines writing one thing disagree the moment one of them is used. -->
                                <StringProperty Header="Label" Binding="{Binding Label}"
                                                IsVisible="{Binding HasPlainLabel}"/>
                                <CompositeProperty Header="Position">
                                    <NumericProperty Header="X" Binding="{Binding X}" Step="1"
                                                     ShowButtons="False"/>
                                    <NumericProperty Header="Y" Binding="{Binding Y}" Step="1"
                                                     ShowButtons="False"/>
                                </CompositeProperty>
                                <CompositeProperty Header="Size">
                                    <NumericProperty Header="Width" Binding="{Binding Width}"
                                                     Minimum="1" Maximum="4000" Step="1" ShowButtons="False"/>
                                    <NumericProperty Header="Height" Binding="{Binding Height}"
                                                     Minimum="1" Maximum="4000" Step="1" ShowButtons="False"/>
                                </CompositeProperty>

                                <!-- THROUGH to the control itself. The thing selected on the plane is the item, so the
                                     lines that are about the control reach it by name rather than the inspector being
                                     pointed somewhere else - the same row list then holds both. -->
                                <CompositeProperty Header="Look">
                                    <SolidColorBrushProperty Header="Background"
                                                             Binding="{Binding Element.Background}"/>
                                    <SolidColorBrushProperty Header="Foreground"
                                                             Binding="{Binding Element.Foreground}"/>
                                    <SolidColorBrushProperty Header="Border"
                                                             Binding="{Binding Element.BorderBrush}"/>
                                    <NumericProperty Header="Opacity" Binding="{Binding Element.Opacity}"
                                                     Minimum="0" Maximum="1" Step="0.05" ShowButtons="False"/>
                                    <NumericProperty Header="Z" Binding="{Binding Element.ZIndex}"
                                                     Minimum="-1000" Maximum="1000" Step="1" ShowButtons="False"/>
                                    <!-- Every corner on its own, folded away behind one header - and ONE number for the
                                         border, which a struct forces to be a line of its own but which nobody sets
                                         per side on a plane. -->
                                    <CompositeProperty Header="Corner">
                                        <NumericProperty Header="Top left" Binding="{Binding CornerTopLeft}"
                                                         Minimum="0" Maximum="200" Step="1" ShowButtons="False"/>
                                        <NumericProperty Header="Top right" Binding="{Binding CornerTopRight}"
                                                         Minimum="0" Maximum="200" Step="1" ShowButtons="False"/>
                                        <NumericProperty Header="Bottom right" Binding="{Binding CornerBottomRight}"
                                                         Minimum="0" Maximum="200" Step="1" ShowButtons="False"/>
                                        <NumericProperty Header="Bottom left" Binding="{Binding CornerBottomLeft}"
                                                         Minimum="0" Maximum="200" Step="1" ShowButtons="False"/>
                                    </CompositeProperty>
                                    <NumericProperty Header="Border" Binding="{Binding BorderWidth}"
                                                     Minimum="0" Maximum="40" Step="1" ShowButtons="False"/>
                                </CompositeProperty>
                            </PropertySection>

                            <!-- THE NODE's own lines, under the ones every control has - a node is an ElementItem like
                                 a button is, so its place and size are already stated above and only what makes it a
                                 node is here. Straight THROUGH to the control, the same way the Look lines above reach
                                 it: what is selected on the plane is the item, so the path starts at Element. -->
                            <PropertySection Header="Node" IsExpanded="True"
                                             Visibility="{Binding NodeSection}">
                                <!-- WHAT THE NODE IS, picked from the list the page keeps rather than typed. A kind is
                                     a key the loader looks up, so a typo in it is a node that comes back as a plain
                                     shape with its behaviour gone - and a typo is exactly what typing produces. The
                                     list is the same one the palette offers, so the two cannot drift apart. -->
                                <!-- Bound to the node's own OBJECT and not to the control drawn for it: the control is
                                     a picture of the node, and editing a picture changes nothing. -->
                                <ChoiceProperty Header="Kind" Binding="{Binding Model.Kind}"
                                                ItemsSource="{Binding NodeKinds}" ValuePath="Kind"
                                                Description="What sort of node this is - what the application looks up to know what it does"/>

                                <!-- ...and what it is CALLED, which is a label a person writes for themselves. The two
                                     are separate on purpose: renaming a node must not change what it is. -->
                                <StringProperty Header="Title" Binding="{Binding Model.Title}"/>

                                <!-- The strip's color: what a graph editor says the KIND of a node with, and the reason
                                     a screenful of them can be read at a glance. -->
                                <!-- A COLOUR, not a brush: what a person picks is a value the node keeps and the file
                                     saves, and the brush that paints the strip with it is made by the binding. -->
                                <ColorProperty Header="Accent" Binding="{Binding Model.Accent}"/>

                                <!-- The same fold the chevron in the strip does. Here as well, because a selection of
                                     twenty nodes is folded from the panel and one at a time from the strip. -->
                                <BooleanProperty Header="Folded" Binding="{Binding Model.IsCollapsed}"
                                                 Description="Fold the node down to its title strip; its sockets move to the edges"/>

                                <!-- Where it sits and how wide it is are the lines above, under Control: the node's own
                                     Left and Top ARE the item's rectangle, not a second copy of it, so writing them out
                                     again here would be the same two numbers twice. -->

                                <!-- THE SOCKETS THEMSELVES, one group of lines each. A count can say how many there are
                                     and nothing else - what each one is CALLED and what color it wears are the things
                                     a graph is actually read by, and they are per socket. The button beside a socket's
                                     name drops THAT one: asked through the count, "drop the second of three" takes the
                                     third away and leaves the second sitting there. -->
                                <!-- HOW MANY, which is the line for "one more" - a number is one drag or one keystroke,
                                     where a button per socket is a click per socket. Dropping a PARTICULAR one is the
                                     bin beside its name below: a count can only take them off the end. -->
                                <!-- ADDING A SOCKET is the plus on the side it goes on, and dropping one is the bin
                                     beside its name: both are about a place in the list. A count says how many, which
                                     is a different question and one nobody asks about sockets - and asked through a
                                     count, "drop the second of three" takes the third away. -->
                                <ItemsProperty Header="In" IsExpanded="True"
                                               Binding="{Binding Model.Inputs}"
                                               ItemHeader="{Binding Name}"
                                               ItemAction="{Binding RemoveSocketCommand}"
                                               ItemActionIcon="BinIcon"
                                               ItemActionTip="Remove this socket"
                                               ShowActionButton="True"
                                               ActionCommand="{Binding AddSocketCommand}"
                                               ActionCommandParameter="In"
                                               ActionIcon="ToolAddIcon"
                                               ActionTip="Add an input">
                                    <StringProperty Header="Name" Binding="{Binding Name}"/>
                                    <ChoiceProperty Header="Kind" Binding="{Binding Kind}"
                                                    ItemsSource="{Binding SocketKinds}" ValuePath="Kind"
                                                    Description="What flows through it - two sockets are joined when they agree, and one saying nothing takes anything"/>
                                    <NumericProperty Header="Takes" Binding="{Binding Capacity}"
                                                     Minimum="0" Maximum="32" Step="1"
                                                     Description="How many wires may sit here - zero means as many as come; a full socket loses its oldest"/>
                                </ItemsProperty>

                                <ItemsProperty Header="Out" IsExpanded="True"
                                               Binding="{Binding Model.Outputs}"
                                               ItemHeader="{Binding Name}"
                                               ItemAction="{Binding RemoveSocketCommand}"
                                               ItemActionIcon="BinIcon"
                                               ItemActionTip="Remove this socket"
                                               ShowActionButton="True"
                                               ActionCommand="{Binding AddSocketCommand}"
                                               ActionCommandParameter="Out"
                                               ActionIcon="ToolAddIcon"
                                               ActionTip="Add an output">
                                    <StringProperty Header="Name" Binding="{Binding Name}"/>
                                    <ChoiceProperty Header="Kind" Binding="{Binding Kind}"
                                                    ItemsSource="{Binding SocketKinds}" ValuePath="Kind"
                                                    Description="What flows through it - two sockets are joined when they agree, and one saying nothing takes anything"/>
                                    <NumericProperty Header="Takes" Binding="{Binding Capacity}"
                                                     Minimum="0" Maximum="32" Step="1"
                                                     Description="How many wires may sit here - zero means as many as come; a full socket loses its oldest"/>
                                </ItemsProperty>
                            </PropertySection>
                        </PropertyGrid>

                        <!-- The THIRD face: what is on the plane, topmost first - the same order the drawing is
                             stacked in, so "bring to front" needs no explaining. Clicking a row selects it on the
                             plane, because there is one selection and not two; a DOUBLE click takes the camera to it,
                             which is the only way to find something left far outside the viewport. -->
                        <ListBox MaxHeight="300" MinWidth="0" Visibility="{Binding StructureFace}"
                                 ItemsSource="{Binding Structure}"
                                 SelectedItem="{Binding Listed, Mode=TwoWay}"
                                 ItemActivatedCommand="{Binding ElementName=Canvas, Path=ZoomToCommand}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharEllipses"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                        </DockPanel>
                    </CanvasPane>

                    <!-- A SECOND pane, and the point of the collection: the view controls belong along the bottom, not
                         in the tool panel, and neither one has to know the other exists. Docked, so the canvas stops
                         counting that strip as usable and "home" centers on what is left. -->
                    <!-- The room to spare is given to the PLATE and not to the number, which is what centers the
                         words in it. Held inside the number's own slot instead, the slack sat half between the label
                         and the figure and half against the right edge, so the whole line read as pushed left. The
                         stated width is what keeps the plate from breathing as the zoom changes. -->
                    <!-- THE CONTEXT BAR. It follows the selection frame rather than an edge of the viewport, and it is
                         shown only while something is selected - the canvas places and hides it, the page says what is
                         in it. ACTIONS and not properties: what a thing looks like is the inspector's business, and
                         saying it in two places is two places to keep in step. The color is the exception, because it
                         is the one thing changed often enough to be worth reaching for without crossing the screen. -->
                    <!-- THE MAP. A plane with no edges has no scrollbars, and a scrollbar is what normally says both
                         how much there is and where in it you are - the two questions a big graph raises constantly.
                         Only in the graph mode: a drawing is looked at, a graph is navigated. -->
                    <!-- BOTTOM LEFT, which is the corner nothing else wants: the rail is up the left side, the
                         inspector down the right, the view bar along the bottom middle. -->
                    <CanvasPane Placement="BottomLeft" Kind="Sheet" Header="Map" CanDrag="True"
                                Visibility="{Binding GraphFace}">
                        <CanvasMiniMap Width="190" Height="120" MinWidth="0"
                                       Canvas="{Binding ElementName=Canvas}"
                                       ItemBrush="{ObservableResource TextFillColorSecondary}"
                                       ViewBrush="{ThemeResource AccentFillColorDefault}"/>
                    </CanvasPane>

                    <!-- THE LIST OF NODES, where the wire was let go. A FREE pane placed at the drop point rather than
                         a popup: a pane already knows how to sit on the glass at a given offset and to stay inside the
                         viewport, and a second machinery for the same job would be a second machinery. -->
                    <CanvasPane Placement="Free" Kind="Sheet" Header="Add a node"
                                CanDrag="False" Width="200"
                                Offset="{Binding ElementName=Canvas, Path=PaletteAt}"
                                Visibility="{Binding ElementName=Canvas, Path=PaletteFace}">
                        <StackPanel Orientation="Vertical">
                            <!-- The cross sits ON the field rather than beside it - beside it, the field would end short
                                 of the pane and read as two controls. Hence the field's right padding: what is typed
                                 must not run under it. -->
                            <Grid MarginBottom="6">
                                <TextBox Text="{Binding NodeSearch, Mode=TwoWay}"
                                         Padding="6 0 24 0"
                                         ToolTip="Narrow the list"/>
                                <Button Width="18" Height="18" MinWidth="0" MinHeight="0"
                                        Padding="0" MarginRight="5"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding SearchFace}"
                                        Command="{Binding ClearNodeSearchCommand}"
                                        ToolTip="Clear the search">
                                    <Image Source="{ResourceReference CloseIcon}" Width="8" Height="8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <!-- WHEN it is open and WHAT was picked are the canvas's: it is the canvas that knows a wire
                                 was let go over nothing. The narrowing is the page's, because only the page knows what
                                 the words mean. -->
                            <!-- SECTIONS with their kinds under them: what a person looks for is "something that mixes",
                                 and a family is the answer to that. One template draws both levels - a section and a
                                 kind are both a name - and a section has children while a kind has none, which is what
                                 makes one a branch and the other a leaf.
                                 Picking a KIND answers the canvas; a section is only a section, and choosing one
                                 carries no kind, so nothing is put on the plane. -->
                            <TreeView MaxHeight="180" MinWidth="0" ItemsSource="{Binding FoundGroups}"
                                      SelectedItem="{Binding ElementName=Canvas, Path=PickedKind, Mode=TwoWay}">
                                <TreeView.ItemContainerStyle>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Kinds}">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <StackPanel Orientation="Horizontal" MarginTop="6" HorizontalAlignment="Right">
                                <Button Content="Cancel" Height="26" MinWidth="0" Padding="10,0"
                                        Command="{Binding CloseNodesCommand}"
                                        CommandParameter="{Binding ElementName=Canvas}"/>
                            </StackPanel>
                        </StackPanel>
                    </CanvasPane>

                    <CanvasPane Placement="Selection" Kind="Bar">
                        <StackPanel Orientation="Horizontal">
                            <!-- STRETCHED to the row's height and given a thinner inset than the template's own: this
                                 swatch is the only thing in the bar that IS its color, so the color should be most of
                                 it rather than a stripe inside a frame. -->
                            <!-- Everything here EXCEPT the bin belongs to a DRAWING. In a graph a node's color is its
                                 accent and lives in the inspector; paint order between nodes is not something anybody
                                 reasons about, since they are all in one band; and what groups a graph is a comment
                                 frame, not a group. What is left in the graph is the one thing that still means
                                 something: take it away. -->
                            <!-- The gap is on the RIGHT of each button and not on the left of the next one, so that it
                                 goes away with the button it belongs to: in a graph everything before the bin is
                                 collapsed, and a leading gap would have left the bin off-center in its own bar. -->
                            <ColorPickerButton Width="46" MinWidth="0" Padding="2" MarginRight="4"
                                               VerticalAlignment="Stretch"
                                               Visibility="{Binding DrawingFace}"
                                               ToolTip="Color of what is selected"
                                               SelectedColor="{Binding SelectionColor, Mode=TwoWay}"/>
                            <!-- PICTURES, not words. The bar stands over the drawing and follows what is selected, so
                                 every pixel of it covers something worth seeing; and the rest of the chrome is already
                                 on pictures, so three words in the middle of it read as a different control. What each
                                 one does is said by its tooltip, which is where a word belongs. -->
                            <Button Width="26" Height="24" MinWidth="0" MinHeight="0" MarginRight="4" Padding="0"
                                    Visibility="{Binding DrawingFace}"
                                    ToolTip="Bring to the front of paint order"
                                    Command="{Binding BringToFrontCommand}">
                                <Image Source="{ObservableResource BringToFrontIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="26" Height="24" MinWidth="0" MinHeight="0" MarginRight="4" Padding="0"
                                    Visibility="{Binding DrawingFace}"
                                    ToolTip="Send to the back"
                                    Command="{Binding SendToBackCommand}">
                                <Image Source="{ObservableResource SendToBackIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="26" Height="24" MinWidth="0" MinHeight="0" MarginRight="4" Padding="0"
                                    Visibility="{Binding DrawingFace}"
                                    Command="{Binding ElementName=Canvas, Path=GroupCommand}"
                                    ToolTip="Make one thing of it (Ctrl+G)">
                                <Image Source="{ObservableResource GroupIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="26" Height="24" MinWidth="0" MinHeight="0" MarginRight="4" Padding="0"
                                    Visibility="{Binding DrawingFace}"
                                    Command="{Binding ElementName=Canvas, Path=UngroupCommand}"
                                    ToolTip="Break it open again (Ctrl+Shift+G)">
                                <Image Source="{ObservableResource UngroupIcon}" Width="13" Height="13"/>
                            </Button>

                            <!-- THE CANVAS'S OWN COMMAND, which is also what the Delete key goes through - so the
                                 button meets the same question the key does, and the page writes nothing to make that
                                 so. -->
                            <Button Width="26" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                    Command="{Binding ElementName=Canvas, Path=DeleteCommand}"
                                    ToolTip="Take it away">
                                <Image Source="{ObservableResource BinIcon}" Width="13" Height="13"/>
                            </Button>
                        </StackPanel>
                    </CanvasPane>

                    <!-- The VIEW BAR. Every button here is one of the CANVAS'S OWN commands: steering the camera is
                         the canvas's business - zooming about the middle of what can be seen needs to know where that
                         middle is once a docked panel has taken part of the edge - and each command says when it can be
                         pressed, so undo with nothing behind it switches its button off by itself. -->
                    <CanvasPane Placement="BottomCenter" Kind="Bar" IsDocked="True" MinWidth="248">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Undo and redo live BESIDE the view controls, not in the selection bar: they are about
                                 the drawing as a whole, and the selection bar is not there when there is nothing
                                 selected - which is exactly when the last thing done often needs taking back. -->
                            <Button Width="28" Height="26" MinWidth="0" Padding="0" MarginRight="6"
                                    Command="{Binding ElementName=Canvas, Path=UndoCommand}"
                                    ToolTip="Undo (Ctrl+Z)">
                                <Image Source="{ObservableResource UndoIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="28" Height="26" MinWidth="0" Padding="0" MarginRight="10"
                                    Command="{Binding ElementName=Canvas, Path=RedoCommand}"
                                    ToolTip="Redo (Ctrl+Y)">
                                <Image Source="{ObservableResource RedoIcon}" Width="13" Height="13"/>
                            </Button>

                            <Button Content="-" Width="28" Height="26" MinWidth="0" Padding="0"
                                    Command="{Binding ElementName=Canvas, Path=ZoomOutCommand}"
                                    ToolTip="Zoom out"/>
                            <!-- Centered vertically: a text block draws on its BASELINE by default, which in a one-line
                                 plate looks like the text has sunk. A stated width, so the bar does not breathe as the
                                 digits change. -->
                            <TextBlock Text="{Binding ZoomText}" MinWidth="54" MarginLeft="6" MarginRight="6"
                                       VerticalAlignment="Center"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            <Button Content="+" Width="28" Height="26" MinWidth="0" Padding="0"
                                    Command="{Binding ElementName=Canvas, Path=ZoomInCommand}"
                                    ToolTip="Zoom in"/>
                            <Button Content="Home" Height="26" MinWidth="0" MarginLeft="8" Padding="8,0"
                                    Command="{Binding ElementName=Canvas, Path=HomeCommand}"
                                    ToolTip="Back to the origin at one to one"/>
                        </StackPanel>
                    </CanvasPane>
                </InfiniteCanvas.Chrome>
            </InfiniteCanvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{Binding Camera}" Foreground="{ObservableResource TextFillColorSecondary}"/>
            <TextBlock Text="{Binding Drawn}" Margin="24,0,0,0"
                       Foreground="{ObservableResource TextFillColorSecondary}"/>
            <!-- WHAT is selected. A straight ink stroke and a line are the same picture on screen and are reshaped in
                 different ways, so which one is in front of you has to be readable rather than guessed at. -->
            <TextBlock Text="{Binding Chosen}" Margin="24,0,0,0"
                       Foreground="{ObservableResource TextFillColorPrimary}"/>
        </StackPanel>
    </Grid>
</View>
