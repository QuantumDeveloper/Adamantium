<Window x:Namespace="Adamantium.Game.Sandbox"
        xmlns="http://adamantium/ui"
        xmlns:x="http://adamantium/ui/xaml/extensions"
        x:CreateInDesignTime="False"
        Title="Ribbon"
        PresentPolicy="{Binding PresentPolicy, Mode=TwoWay}"
        TitleBarHeight="38"
        Width="1180"
        Height="720"
        xmlns:behaviors="clr-namespace:Adamantium.Game.Sandbox.Behaviors">
    <!-- The quick-access bar lives in the CAPTION, through the title bar's neutral content slot - no RibbonWindow type
         needed, the caption is already our own control rather than the OS's. -->
    <!-- The compact forms this shell draws its commands with. Declared once, referenced by key: a template nested
         inside a selector inside a property element is unreadable, and these are the shell's vocabulary, not one
         control's detail. -->
    <ResourceContext.Resources>
        <DataTemplate x:Key="QuickAccessToggleTemplate">
            <ToggleButton Classes="QuickAccessButton"
                          Ribbon.IsInQuickAccess="True"
                          ToolTip="{Binding ToolTip}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}">
                <!-- Taking it back out is done here too - the same row the ordinary button offers. -->
                <ToggleButton.ContextMenu>
                    <ContextMenu>
                        <RibbonQuickAccessMenuItem/>
                    </ContextMenu>
                </ToggleButton.ContextMenu>
                <Path Data="{Binding Icon}"
                      Stroke="{Ancestor RibbonQuickAccess, Foreground}"
                      StrokeThickness="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </ToggleButton>
        </DataTemplate>
    </ResourceContext.Resources>

    <Window.TitleBarLeadingContent>
        <!-- The bar lives in the CAPTION, outside the ribbon, so nothing inherits down to it - the command that takes a
             button back out is bound here, on the bar itself. -->
        <RibbonQuickAccess ItemsSource="{Binding QuickAccess}" Margin="6 0 4 0"
                           Placement="{Binding QuickAccessPlacement}"
                           Ribbon.RemoveFromQuickAccessCommand="{Binding RemoveFromQuickAccessCommand}"
                           Foreground="{Ancestor TitleBar, Foreground}">
            <!-- WHICH visual a command gets is decided HERE, by the shell, because the items are the shell's own type.
                 The engine's default selector only knows "did the command bring a form of its own"; it has no business
                 knowing that this application's commands can be ON or OFF. -->
            <RibbonQuickAccess.ItemTemplateSelector>
                <ShellQuickAccessTemplateSelector Toggle="{ResourceReference QuickAccessToggleTemplate}"/>
            </RibbonQuickAccess.ItemTemplateSelector>
        </RibbonQuickAccess>
    </Window.TitleBarLeadingContent>

    <!-- The SAME diagnostics plate the main window carries, so the two shells can be compared side by side under one
             setting: this window has its own swapchain, so its presentation is its own too. Spans the content row and is
             pinned top-right, out of the band's way. -->
    <Border Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,120,16,0"
            Width="280"
            Padding="10"
            IsHitTestVisible="False"
            Background="#CC202020">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Presentation" Margin="0,0,0,4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <DropDown ItemsSource="{Binding PresentPolicies}"
                      SelectedItem="{Binding PresentPolicy, Mode=TwoWay}"
                      Margin="0,0,0,10"/>
            <TextBlock FontSize="13" Foreground="LightGreen" TextWrapping="WrapBySymbols" Text="diagnostics…">
                <TextBlock.Behaviors>
                    <behaviors:DiagnosticsOverlayBehavior/>
                </TextBlock.Behaviors>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
