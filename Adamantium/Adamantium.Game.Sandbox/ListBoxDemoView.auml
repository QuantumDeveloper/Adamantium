<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:vm="clr-namespace:Adamantium.Game.Sandbox.ViewModels"
      x:ViewModel="{x:Type vm:ListBoxDemoViewModel}">

    <!-- Same collection in two ListBoxes: a default vertical-stack list and a wrap-panel (tiled) list. Click an item to
         select it (accent highlight), hover/press show the subtle/pressed fills. Both are bounded so the ScrollViewer +
         virtualizing panel realize only the visible rows. -->
    <StackPanel Orientation="Horizontal">
        <!-- Extended multi-select (plain click = one, Ctrl+click = toggle, Shift+click = range). SelectedItems is bound
             two-way to the view-model's own collection - the control keeps it in sync. -->
        <ListBox Width="180"
                 Height="240"
                 Margin="8"
                 SelectionMode="Extended"
                 ToolTip="Extended selection: click, Ctrl+click, Shift+click"
                 ItemsSource="{Binding Fruits}"
                 SelectedItems="{Binding SelectedFruits}"/>

        <ListBox Width="350"
                 Height="240"
                 Margin="8"
                 SelectionMode="Multiple"
                 ToolTip="Wrap-panel list, Multiple selection"
                 ItemsSource="{Binding Fruits}">
            <ListBox.ItemsPanel>
                <!-- A virtualizing wrap works off a uniform cell: pin ItemWidth/ItemHeight for a stable grid (no reflow
                     while scrolling). Without them the panel falls back to probing one item and growing to fit. -->
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemWidth="100" ItemHeight="32"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Live proof of the two-way SelectedItems: bound to the SAME view-model collection, so multi-selecting on the
             left makes the picks appear here (no code-behind, no behaviour). -->
        <StackPanel Orientation="Vertical" Margin="8">
            <TextBlock Text="Selected:"/>
            <ListBox Width="160" Height="214" ItemsSource="{Binding SelectedFruits}"/>
        </StackPanel>
    </StackPanel>
</View>
