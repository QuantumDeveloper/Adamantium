<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:vm="clr-namespace:Adamantium.Game.Sandbox.ViewModels"
      x:ViewModel="{x:Type vm:ItemsDemoViewModel}">

    <!-- ItemsControl bound to the view-model's collection, with an item template binding to each item's Name.
         The sized Border gives the list a bounded viewport, so the (themed) ScrollViewer + virtualizing StackPanel
         realize only the visible rows of the 50 items. -->
    <Border Width="220" Height="160">
        <ItemsControl ItemsSource="{Binding People}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Height="28">
                        <TextBlock Text="{Binding Name}" Foreground="White" Margin="6,4,0,0"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</View>
