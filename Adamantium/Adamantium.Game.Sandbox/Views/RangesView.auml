<View xmlns="http://adamantium/ui">
    <!-- DataContext is the RangesViewModel. One shared Value binds a horizontal + vertical Slider and a ProgressBar. -->
    <StackPanel Orientation="Vertical" Margin="24">

        <TextBlock Text="One value, many controls" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Slider Width="300"
                    Value="{Binding Value, Mode=TwoWay}"
                    Maximum="{Binding Maximum}"
                    IsValueToolTipEnabled="true"
                    IsMoveToPointEnabled="true"/>
            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
        </StackPanel>

        <TextBlock Text="Progress (bound to the same value):" Margin="0,20,0,6"/>
        <ProgressBar Width="300" Height="12" Value="{Binding Value}" Maximum="{Binding Maximum}" HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <Slider Orientation="Vertical" Height="170" Value="{Binding Value, Mode=TwoWay}" Maximum="{Binding Maximum}"/>
            <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                <TextBlock Text="Maximum (rescales all of the above):"/>
                <Slider Width="240" Value="{Binding Maximum, Mode=TwoWay}" Minimum="10" Maximum="200"/>
                <Button Content="Reset value" Command="{Binding ResetCommand}" Width="130" Height="34"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</View>
