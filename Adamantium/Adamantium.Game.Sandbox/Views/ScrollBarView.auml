<View xmlns="http://adamantium/ui">
    <!-- DataContext is the ScrollBarViewModel. Both bars are bound to one Offset. -->
    <StackPanel Orientation="Vertical" Margin="24">
        <TextBlock Text="Horizontal + vertical ScrollBar bound to one value" FontSize="18" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal">
            <ScrollBar Orientation="Vertical"
                       Height="200"
                       Minimum="0" Maximum="100" ViewportSize="10"
                       Value="{Binding Offset, Mode=TwoWay}"/>
            <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                <ScrollBar Orientation="Horizontal"
                           Width="320"
                           Minimum="0" Maximum="100" ViewportSize="10"
                           Value="{Binding Offset, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Offset:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Offset}" VerticalAlignment="Center" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</View>
