<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.Game.Sandbox.Converters"
      xmlns:nav="clr-namespace:Adamantium.UI.Controls.Navigation;assembly=Adamantium.UI.Controls">
    <!-- DataContext is the BrushesViewModel. Every gradient below is authored in AUML (element syntax:
         <Shape.Fill><LinearGradientBrush><GradientStop/>...) - proving gradients are fully markup-authorable, on any
         element, and batched by the SDF gradient batches. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="24">

            <!-- ONE LIVE STAND, and a selector that swaps which brush is in it. The tab used to run a section per family
                 down one page: fourteen stands, each with its own copy of the same figure picker, so comparing two of
                 them meant scrolling past everything in between and re-picking the figure when you got there. Now the
                 figure is chosen ONCE, here, and every family paints on it in turn. -->
            <TextBlock Text="Brushes — live" FontSize="20" MarginBottom="10"/>

            <!-- BUTTONS, not a dropdown: every family is on screen at once, so what the tab covers is readable without
                 opening anything, and swapping between two of them is one click each way rather than four. They all bind
                 the SAME property and name their own value - see EnumToBoolConverter. -->
            <WrapPanel Orientation="Horizontal" MarginBottom="10">
                <ToggleButton Content="Gradients" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Gradients, Mode=TwoWay}"/>
                <ToggleButton Content="Mesh gradient" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Mesh, Mode=TwoWay}"/>
                <ToggleButton Content="Pattern" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Pattern, Mode=TwoWay}"/>
                <ToggleButton Content="Noise" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Noise, Mode=TwoWay}"/>
                <ToggleButton Content="Fractal" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Fractal, Mode=TwoWay}"/>
                <ToggleButton Content="Image" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Image, Mode=TwoWay}"/>
                <ToggleButton Content="Nine-slice" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=NineSlice, Mode=TwoWay}"/>
                <ToggleButton Content="Drawing" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Drawing, Mode=TwoWay}"/>
                <ToggleButton Content="Visual" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Visual, Mode=TwoWay}"/>
                <ToggleButton Content="Material" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Material, Mode=TwoWay}"/>
                <ToggleButton Content="Aura / Shadow" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Aura, Mode=TwoWay}"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" MarginBottom="4">
                <StackPanel Orientation="Vertical" Width="300">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding PreviewShape, Mode=TwoWay}" Width="280"/>
                </StackPanel>
            </StackPanel>

            <!-- THE STAND ITSELF. Each one is its own view over this same view-model, navigated in by key - so leaving a
                 stand drops its markup instead of leaving it built and hidden, and the shared figure and slot survive
                 the switch because the object behind them never changed. -->
            <ContentControl nav:Region.Source="{Binding Region}" ContentTransition="SlideLeft"/>

            <!-- BACKDROP MATERIALS, live. Unlike every other brush here, these have nothing of their own to show: they
                 are made of what is BEHIND them. So the stand is built the other way round from the rest - the controls
                 change not only the material but WHAT IT SITS OVER, because a backdrop over a flat colour proves
                 nothing at all.
                 The three kinds are one dropdown apart on purpose. Acrylic and liquid glass take exactly the same
                 capture and differ only in the treatment - one scatters it, the other bends it - and switching between
                 them in place, over the same field, is the only way to see that. Mica differs in the third way: same
                 treatment, different SOURCE - the desktop wallpaper rather than this frame, so scrolling the page
                 leaves it still while moving the window changes it. -->
            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Material}">
            <TextBlock Text="Material brush — the fill is what is behind it" FontSize="18" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" MarginBottom="24">
                <!-- BIG on purpose. The drag wobble is a shift of a pixel or two, and on a small pane there is not
                     enough backdrop on screen to see it against - the whole point of this stand is that the fault is
                     visible in it. -->
                <Grid Width="660" Height="440">
                    <!-- WHAT IT SITS OVER. All four are here and one is revealed, the same way every other stand on
                         this tab reveals the selected figure. -->
                    <Rectangle CornerRadius="12"
                               Visibility="{Binding MaterialUnderlay, Converter={conv:MaterialUnderlayVisibilityConverter}, ConverterParameter=LivingNoise}">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Worley" Scale="46" Octaves="2" Animate="true" FlowSpeed="0.5"
                                        Color1="#0B1220" Color2="#F0ABFC"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle CornerRadius="12"
                               Visibility="{Binding MaterialUnderlay, Converter={conv:MaterialUnderlayVisibilityConverter}, ConverterParameter=Checkerboard}">
                        <Rectangle.Fill>
                            <PatternBrush Pattern="Checkerboard" CellSize="26"
                                          Color1="#0B1220" Color2="#E9D5FF"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle CornerRadius="12"
                               Visibility="{Binding MaterialUnderlay, Converter={conv:MaterialUnderlayVisibilityConverter}, ConverterParameter=Gradient}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#0B1220"/>
                                <GradientStop Offset="1" Color="#7DD3FC"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle CornerRadius="12" Fill="{Binding MaterialPicture}"
                               Visibility="{Binding MaterialUnderlay, Converter={conv:MaterialUnderlayVisibilityConverter}, ConverterParameter=Picture}"/>

                    <!-- THE MATERIAL, on whichever figure is selected. One live brush drives all of them. -->
                    <!-- The pen rides the same pass as the fill (CompositeFillStroke), so a framed material is still
                         one draw. Solid and whole only - dashes and trims go to the per-unit path. -->
                    <Rectangle Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Fill="{Binding LiveMaterial}"
                               Stroke="#66FFFFFF" StrokeThickness="{Binding MaterialStroke}" Opacity="{Binding MaterialOpacity}"
                               CornerRadius="{Binding MaterialRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                    <Ellipse Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Fill="{Binding LiveMaterial}"
                             Stroke="#66FFFFFF" StrokeThickness="{Binding MaterialStroke}" Opacity="{Binding MaterialOpacity}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                    <RegularPolygon Width="{Binding PreviewSquare}" Height="{Binding PreviewSquare}" Corners="{Binding ShapeCornerCount}"
                                    StartAngle="{Binding ShapeStartAngle}" Fill="{Binding LiveMaterial}"
                                    Stroke="#66FFFFFF" StrokeThickness="{Binding MaterialStroke}" Opacity="{Binding MaterialOpacity}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}"/>
                    <Polygon Points="{Binding FixedStar}" Fill="{Binding LiveMaterial}"
                             Stroke="#66FFFFFF" StrokeThickness="{Binding MaterialStroke}" Opacity="{Binding MaterialOpacity}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                </Grid>

                <StackPanel Orientation="Vertical" Width="320" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Material — acrylic and glass share a capture and differ in treatment; mica differs in source"
                               Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                    <DropDown ItemsSource="{Binding MaterialTypes}" SelectedItem="{Binding MaterialKind, Mode=TwoWay}"
                              Width="300" MarginBottom="10"/>

                    <TextBlock Text="Sitting over" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding MaterialUnderlays}" SelectedItem="{Binding MaterialUnderlay, Mode=TwoWay}"
                              Width="300" MarginBottom="10"/>

                    <!-- MICA ONLY. Acrylic and glass ARE what is directly beneath them - that is the whole of what
                         they are - so they have no source to choose. Mica is the one reading a picture from elsewhere,
                         and the choice here is whose picture. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Source}">
                        <TextBlock Text="Source — the desktop's own wallpaper, or one of ours. They differ in DETAIL: the tile hides the drag wobble, texture.jpg shows it at its worst"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <DropDown ItemsSource="{Binding MaterialSources}" SelectedItem="{Binding MaterialSource, Mode=TwoWay}"
                                  Width="300" MarginBottom="10"/>
                    </StackPanel>

                    <!-- Only with a picture of one's own - the real wallpaper is pinned to the desktop by nature. Drag
                         the window to tell them apart: Desktop stays put while the window moves over it, Window travels
                         with it, Element travels AND turns with the shape. -->
                    <StackPanel Orientation="Vertical" Visibility="{Binding HasOwnSource, Converter={conv:BoolToVisibilityConverter}}">
                        <TextBlock Text="Anchor — what the picture is pinned to"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <DropDown ItemsSource="{Binding MaterialAnchors}" SelectedItem="{Binding MaterialAnchor, Mode=TwoWay}"
                                  Width="300" MarginBottom="10"/>
                    </StackPanel>

                    <TextBlock Text="Shape" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding PreviewShape, Mode=TwoWay}"
                              Width="300" MarginBottom="10"/>

                    <!-- Every knob below appears only where it CHANGES something - the shape decides the first two, the
                         material the next two. A slider that moves and does nothing is worse than one that is not
                         there: it teaches the wrong thing about the feature. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}">
                        <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="75" Value="{Binding MaterialRadius, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialRadius}" MarginLeft="8" Width="48"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The polygon's two numbers, shared by every stand on this tab: change them here and all of them
                         follow. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}">
                        <TextBlock Text="Corners — 3 is a triangle, enough of them a circle" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="6">
                            <Slider Value="{Binding ShapeCorners, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="3" Maximum="24"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="200"/>
                            <NumericUpDown Width="88" Minimum="3" Maximum="24" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeCorners, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                        <TextBlock Text="Start angle — where corner 0 sits" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Value="{Binding ShapeStartAngle, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="200"/>
                            <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeStartAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Element opacity — the whole thing fades, tint and pen together"
                               Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Minimum="0" Maximum="1" Value="{Binding MaterialOpacity, Mode=TwoWay}" Width="240"/>
                        <TextBlock Text="{Binding MaterialOpacity}" MarginLeft="8" Width="48"/>
                    </StackPanel>

                    <TextBlock Text="Stroke — the pen rides the SAME pass as the fill, so a framed material is one draw"
                               Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Minimum="0" Maximum="20" Value="{Binding MaterialStroke, Mode=TwoWay}" Width="240"/>
                        <TextBlock Text="{Binding MaterialStroke}" MarginLeft="8" Width="48"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Tint}">
                        <TextBlock Text="Tint strength — glass takes its colour from behind, so keep it low there"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="1" Value="{Binding MaterialTintOpacity, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialTintOpacity}" MarginLeft="8" Width="48"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- THE SURFACE BRANCH. Velvet and metal share the grain and the light - they describe one lit
                         surface and differ only in the BRDF that reads it - so those knobs are shown for both. The
                         light ones are what the branch is proved on: a flat rectangle has one normal, so if the relief
                         is not really there, turning the light changes nothing. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Surface}">
                        <TextBlock Text="Grain scale — px per fibre clump, per scratch of the grinding, or per annual ring"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="1" Maximum="40" Value="{Binding MaterialGrainScale, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialGrainScale}" MarginLeft="8" Width="48"/>
                        </StackPanel>

                        <TextBlock Text="Grain direction — which way the pile is combed, the grinding runs, or the trunk lay"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="360" Value="{Binding MaterialGrainDirection, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialGrainDirection}" MarginLeft="8" Width="48"/>
                        </StackPanel>

                        <TextBlock Text="Roughness — 0 is a mirror; on cloth how far the sheen spreads, on wood the varnish"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="1" Value="{Binding MaterialRoughness, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialRoughness}" MarginLeft="8" Width="48"/>
                        </StackPanel>

                        <TextBlock Text="Light angle — where the light comes from"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="360" Value="{Binding MaterialLightAngle, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialLightAngle}" MarginLeft="8" Width="48"/>
                        </StackPanel>

                        <TextBlock Text="Light elevation — 0 grazes the nap, 1 flattens it"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="1" Value="{Binding MaterialLightElevation, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialLightElevation}" MarginLeft="8" Width="48"/>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Nap}">
                        <TextBlock Text="Cloth colour" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MaterialNapColor, Mode=TwoWay}" MarginBottom="10"/>

                        <TextBlock Text="Sheen colour — the light caught on the tips of the fibres"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MaterialSheenColor, Mode=TwoWay}" MarginBottom="10"/>
                    </StackPanel>

                    <!-- METAL. Steel, gold and chrome are THIS material with other numbers - that is what separates
                         them, so they are knobs rather than six entries in the dropdown. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Metal}">
                        <TextBlock Text="Metal — a starting point; every knob below stays free"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <DropDown ItemsSource="{Binding MetalPresets}" SelectedItem="{Binding MetalPreset, Mode=TwoWay}"
                                  Width="270" MarginBottom="10"/>

                        <TextBlock Text="Metal colour — grey is steel, yellow is gold, pink is copper"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MaterialMetalColor, Mode=TwoWay}" MarginBottom="10"/>

                        <TextBlock Text="Environment — what it reflects. Procedural: behind a UI there is no room"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MaterialEnvironmentColor, Mode=TwoWay}" MarginBottom="10"/>
                    </StackPanel>

                    <!-- WOOD. Two colours rather than one: a ring is a broad pale band closed by a narrow dark one, and
                         the contrast between them is what tells oak from walnut. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Wood}">
                        <TextBlock Text="Timber — a starting point; every knob above stays free"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <DropDown ItemsSource="{Binding WoodPresets}" SelectedItem="{Binding WoodPreset, Mode=TwoWay}"
                                  Width="270" MarginBottom="10"/>

                        <TextBlock Text="Cut — where the saw crossed the rings. Same tree, four figures"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <DropDown ItemsSource="{Binding WoodCuts}" SelectedItem="{Binding MaterialWoodCut, Mode=TwoWay}"
                                  Width="270" MarginBottom="10"/>

                        <CheckBox Content="Varnished — a clear coat that shows the room and glares along the edge"
                                  IsChecked="{Binding MaterialVarnished, Mode=TwoWay}" MarginBottom="10"/>

                        <TextBlock Text="Early wood — the broad pale band grown in spring"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MaterialEarlyWoodColor, Mode=TwoWay}" MarginBottom="10"/>

                        <TextBlock Text="Late wood — the narrow dark band that closes each ring"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MaterialLateWoodColor, Mode=TwoWay}" MarginBottom="10"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Blur}">
                        <TextBlock Text="Blur — how wide the frosting scatters" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="40" Value="{Binding MaterialBlur, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialBlur}" MarginLeft="8" Width="48"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=Refraction}">
                        <TextBlock Text="Refraction — how hard the rim bends what is behind"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="60" Value="{Binding MaterialRefraction, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialRefraction}" MarginLeft="8" Width="48"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding MaterialKind, Converter={conv:MaterialKnobVisibilityConverter}, ConverterParameter=FilmGrain}">
                        <TextBlock Text="Grain — hides the banding an 8-bit capture brings"
                                   Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2" TextWrapping="WrapByWords"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Minimum="0" Maximum="0.2" Value="{Binding MaterialGrain, Mode=TwoWay}" Width="240"/>
                            <TextBlock Text="{Binding MaterialGrain}" MarginLeft="8" Width="48"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Tint colour" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MaterialTint, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- Aura and Shadow: the soft band around a shape. Two properties rather than one with the offset zeroed -
                 a shadow has a DIRECTION and an aura does not. Both are the shape's own signed distance read further out,
                 so they batch with everything else: no offscreen target, no blur pass.
                 The panel CLIPS on purpose - drag Margin down and watch the band get cut off. That is the one thing the
                 engine will not do for you: the band is drawn outside the element's bounds, and the room is the author's. -->
            </StackPanel>

            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Aura}">
            <TextBlock Text="Aura / Shadow — live (the band is drawn OUTSIDE the element; the margin is yours to leave)" FontSize="18" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" MarginBottom="20">
                <!-- A MID-TONE backdrop on purpose: the other stands sit on near-black, but a dark shadow is invisible
                     there and a bright aura blows out. This one has to show both at once. -->
                <Border Width="420" Height="300" Margin="10" Background="#485061">
                    <!-- The clip goes HERE when it is asked for, not on the panel: this box is exactly the figure plus its
                         margin, so the margin then decides how much of the band survives. On the panel it would never
                         bite - the panel is far bigger than any band - and the rule would stay invisible. -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="{Binding HaloClip}">
                        <Rectangle Width="180" Height="120"
                                   Fill="#E2E8F0"
                                   Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                   CornerRadius="{Binding HaloRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                                   Aura="{Binding LiveAura}"
                                   Shadow="{Binding LiveShadow}"
                                   Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                        <Ellipse Width="180" Height="120"
                                 Fill="#E2E8F0"
                                 Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                 Aura="{Binding LiveAura}"
                                 Shadow="{Binding LiveShadow}"
                                 Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                        <!-- Tessellated shapes: their band reads a distance field baked per mesh, so it follows a
                             concave outline - the star's notches keep their own glow instead of being bridged over. -->
                        <RegularPolygon Width="120" Height="120"
                                 Corners="{Binding ShapeCornerCount}"
                                 StartAngle="{Binding ShapeStartAngle}"
                                 Fill="#E2E8F0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                 Aura="{Binding LiveAura}"
                                 Shadow="{Binding LiveShadow}"
                                 Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}"/>
                        <Polygon Points="{Binding HaloStar}"
                                 Fill="#E2E8F0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                 Aura="{Binding LiveAura}"
                                 Shadow="{Binding LiveShadow}"
                                 Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding HaloShapes}" SelectedItem="{Binding HaloShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <!-- Only for the polygon: on a rect or an ellipse these two numbers mean nothing, and a control that
                         does nothing is worse than one that is not there. -->
                    <StackPanel Orientation="Vertical" Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}">
                        <!-- The polygon's two numbers, shared by every stand on this tab: change them here and all of them follow. -->
                        <TextBlock Text="Corners — 3 is a triangle, enough of them a circle" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="6">
                            <Slider Value="{Binding ShapeCorners, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="3" Maximum="24"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                            <NumericUpDown Width="88" Minimum="3" Maximum="24" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeCorners, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                        <TextBlock Text="Start angle — where corner 0 sits" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Value="{Binding ShapeStartAngle, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                            <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeStartAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}">
                        <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Value="{Binding HaloRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="60" Width="186"/>
                            <NumericUpDown Width="88" Minimum="0" Maximum="60" SmallChange="1"
                                           SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding HaloRadius, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Margin is LAYOUT, not a band parameter - it does nothing to the glow itself. It is here only to
                         show the one rule the engine will not keep for you: bounds are never grown to fit a band, so a
                         clipping ancestor cuts whatever the author left no room for. Hence it lives with the clip. -->
                    <CheckBox Content="Clip to the element's box" IsChecked="{Binding HaloClip, Mode=TwoWay}" MarginBottom="4"/>
                    <TextBlock Text="Margin — layout, not a band setting. With the clip on, drop it below the radius and the band is cut: bounds are never grown to fit a glow."
                               TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="14">
                        <Slider Value="{Binding HaloMargin, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="70" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="70" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding HaloMargin, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>

                    <CheckBox Content="AURA — no direction" IsChecked="{Binding AuraOn, Mode=TwoWay}" FontSize="14" MarginBottom="6"/>
                    <TextBlock Text="Radius — how far it reaches" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding AuraRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="60" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="60" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding AuraRadius, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Spread — solid rim before the fade" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding AuraSpread, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="30" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="30" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding AuraSpread, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Opacity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding AuraOpacity, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="1" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding AuraOpacity, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <CheckBox Content="Inner (glow inward — needs no margin at all)" IsChecked="{Binding AuraInner, Mode=TwoWay}" MarginBottom="6"/>
                    <TextBlock Text="Colour" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor, Mode=TwoWay}" MarginBottom="14"/>

                    <!-- LIVING: at Turbulence 0 this is the still band above and the living pass is never reached, so a
                         plain glow pays nothing for the noise. -->
                    <TextBlock Text="ALIVE — the reach breathes" FontSize="14" MarginBottom="6"/>
                    <TextBlock Text="Turbulence — how far the reach wanders (0 = still)"
                               TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding AuraTurbulence, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="2" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="2" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding AuraTurbulence, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Flow — how fast it drifts" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding AuraFlow, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="3" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="3" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding AuraFlow, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Detail — how many tongues run around it" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding AuraDetail, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0.5" Maximum="12" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0.5" Maximum="12" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding AuraDetail, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <CheckBox Content="Palette — travel four colours instead of one" IsChecked="{Binding AuraPalette, Mode=TwoWay}" MarginBottom="6"/>
                    <StackPanel Orientation="Vertical" Visibility="{Binding AuraPalette, Converter={conv:BoolToVisibilityConverter}}">
                        <TextBlock Text="The four it travels through" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal">
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor1, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor2, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor3, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor4, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- The shadow's own column: the two sets are independent, and stacking them made one tall strip nobody
                     could take in at a glance. -->
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="24" VerticalAlignment="Center">
                    <CheckBox Content="SHADOW — thrown where the light is not" IsChecked="{Binding ShadowOn, Mode=TwoWay}" FontSize="14" MarginBottom="6"/>
                    <TextBlock Text="Offset X / Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="6">
                        <Slider Value="{Binding ShadowOffsetX, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-40" Maximum="40" Width="186"/>
                        <NumericUpDown Width="88" Minimum="-40" Maximum="40" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShadowOffsetX, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding ShadowOffsetY, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-40" Maximum="40" Width="186"/>
                        <NumericUpDown Width="88" Minimum="-40" Maximum="40" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShadowOffsetY, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Blur radius — how soft the edge is" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding ShadowBlur, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="60" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="60" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShadowBlur, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Spread — how HIGH it floats (negative peeks out from one edge)"
                               TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding ShadowSpread, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-20" Maximum="30" Width="186"/>
                        <NumericUpDown Width="88" Minimum="-20" Maximum="30" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShadowSpread, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Opacity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding ShadowOpacity, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="1" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShadowOpacity, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <CheckBox Content="Inner (inset — the pressed look)" IsChecked="{Binding ShadowInner, Mode=TwoWay}" MarginBottom="6"/>
                    <TextBlock Text="Colour" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding ShadowColor, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- One labelled swatch per noise type. At the TOP so any shader device-lost is caught on launch. -->
            </StackPanel>

            <!-- Reference rows belong to the stand they are ABOUT, not to a switch of their own: pick Noise and its
                 swatches come with it. That is also why the caption below can say "the live panel" and mean it. -->
            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Noise}">
            <TextBlock Text="Noise types (all selectable in the live panel below)" FontSize="18" Margin="0,0,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Simplex" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#7DD3FC"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Simplex" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Perlin" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#86EFAC"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Perlin" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Value" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#FDE68A"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Value" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Worley" Scale="52" Octaves="2" Color1="#0B1220" Color2="#FCA5A5"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Worley" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Worley" Scale="56" Octaves="1" Animate="true" FlowSpeed="0.8" Color1="#0B1220" Color2="#C4B5FD"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Worley (flow)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Ridged" Scale="60" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#FBBF24"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Ridged" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Turbulence" Scale="54" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#38BDF8"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Turbulence" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="VoronoiBorders" Scale="46" Animate="true" FlowSpeed="0.7" Color1="#0B1220" Color2="#67E8F9"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Voronoi borders" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Combustible (fire)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"
                                        UseFirePalette="false" Color1="#020617" MidColor="#0EA5E9" Color2="#E0F2FE"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Combustible (custom)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
            </WrapPanel>

            </StackPanel>

            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Gradients}">

            <TextBlock Text="Linear gradients — rectangles" FontSize="18" Margin="0,0,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- diagonal, 3 stops -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="0.5"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- horizontal -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#22C55E" Offset="0"/>
                            <GradientStop Color="#EAB308" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- vertical, with a stroke -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10" Stroke="White" StrokeThickness="3">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <TextBlock Text="Radial gradients — rectangles" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- centred spotlight -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#FDE68A" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- off-centre focal (top-left highlight) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.3,0.28" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#A7F3D0" Offset="0"/>
                            <GradientStop Color="#14B8A6" Offset="0.6"/>
                            <GradientStop Color="#0F766E" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <TextBlock Text="Conic gradients — angular sweep (NEW)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- full-spectrum sweep (a colour wheel's hue): start at top, clockwise; last stop meets the first -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- two-colour sweep rotated to start from the right (StartAngle 90) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5" StartAngle="90">
                            <GradientStop Color="#1E293B" Offset="0"/>
                            <GradientStop Color="#38BDF8" Offset="0.5"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- pie chart: hard segments (a stop doubled at each boundary) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#EF4444" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="0.25"/>
                            <GradientStop Color="#22C55E" Offset="0.25"/>
                            <GradientStop Color="#22C55E" Offset="0.6"/>
                            <GradientStop Color="#3B82F6" Offset="0.6"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- conic on a circle = a proper colour wheel -->
                <Ellipse Width="140" Height="140" Margin="10">
                    <Ellipse.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </ConicGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </WrapPanel>

            <!-- Mesh gradient: four CORNER colours blended bilinearly across the shape - no axis, no stops. WPF has
                 nothing like it; this is the Figma/Illustrator "mesh gradient" in its 4-corner form. Was deferred while
                 the gradient pass would not survive the extra code on the old driver. -->
            <!-- ImageBrush stand: ONE picture, laid down once or repeated. The sample is deliberately asymmetric, so a
                 plain Tile shows its seams and a Flip mode visibly meets its own reflection. Stretch only matters while
                 TileMode is None - a tile is sized by Tile size instead. -->
            </StackPanel>

            <!-- DrawingBrush stand: the SAME four mechanisms as the ImageBrush, on content that has no pixels at all.
                 Worth poking in this order - viewport sizes the tile, viewbox picks what a tile shows, stretch fits the
                 content in it and alignment says where, tile mode repeats it. Stretch and alignment stay meaningful
                 while tiling: a Uniform fit letterboxes EVERY copy, not the lot. -->

            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Drawing}">
            <TextBlock Text="DrawingBrush — live (a drawing as a fill: viewbox, viewport, stretch, tiling)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="360" Height="240" Margin="10" Background="#101418">
                    <Grid Width="{Binding DrawingWidth}"
                          Height="{Binding DrawingHeight}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Rectangle Width="{Binding DrawingWidth}"
                                   Height="{Binding DrawingHeight}"
                                   Fill="{Binding LiveDrawing}"
                                   CornerRadius="{Binding DrawingRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                                   Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                        <Ellipse Width="{Binding DrawingWidth}"
                                 Height="{Binding DrawingHeight}"
                                 Fill="{Binding LiveDrawing}"
                                 Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                        <RegularPolygon Width="{Binding DrawingPolygonSize}"
                                 Height="{Binding DrawingPolygonSize}"
                                 Corners="{Binding ShapeCornerCount}"
                                 StartAngle="{Binding ShapeStartAngle}"
                                 Fill="{Binding LiveDrawing}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}"/>
                        <Polygon Points="{Binding DrawingStar}"
                                 Fill="{Binding LiveDrawing}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding PreviewShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <!-- Only for the polygon: on a rect or an ellipse these two numbers mean nothing, and a control that
                         does nothing is worse than one that is not there. -->
                    <StackPanel Orientation="Vertical" Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}">
                        <!-- The polygon's two numbers, shared by every stand on this tab: change them here and all of them follow. -->
                        <TextBlock Text="Corners — 3 is a triangle, enough of them a circle" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="6">
                            <Slider Value="{Binding ShapeCorners, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="3" Maximum="24"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                            <NumericUpDown Width="88" Minimum="3" Maximum="24" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeCorners, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                        <TextBlock Text="Start angle — where corner 0 sits" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Value="{Binding ShapeStartAngle, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                            <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeStartAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Tile mode" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding TileModes}" SelectedItem="{Binding DrawingTileMode, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Stretch — fits the content inside ONE tile" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding Stretches}" SelectedItem="{Binding DrawingStretch, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Alignment X (only while the fit leaves room)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding AlignmentsX}" SelectedItem="{Binding DrawingAlignmentX, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Alignment Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding AlignmentsY}" SelectedItem="{Binding DrawingAlignmentY, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewport units — px, or a fraction of the shape" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding MappingModes}" SelectedItem="{Binding DrawingViewportUnits, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewport size — one tile (sizes the SINGLE copy too, so None puts it in a corner)" Foreground="{ResourceReference TextFillColorSecondary}" TextWrapping="WrapByWords" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingViewportSize, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="16" Maximum="200" Width="186"/>
                        <NumericUpDown Width="88" Minimum="16" Maximum="200" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingViewportSize, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Viewport origin X — shifts the whole grid" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingViewportOriginX, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-100" Maximum="100" Width="186"/>
                        <NumericUpDown Width="88" Minimum="-100" Maximum="100" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingViewportOriginX, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Viewport origin Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingViewportOriginY, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-100" Maximum="100" Width="186"/>
                        <NumericUpDown Width="88" Minimum="-100" Maximum="100" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingViewportOriginY, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16">
                    <TextBlock Text="Viewbox X — which part of the drawing a tile shows" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingViewboxX, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="1" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingViewboxX, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Viewbox Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingViewboxY, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="1" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingViewboxY, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Viewbox size — 1 is the whole drawing" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingViewboxSize, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0.1" Maximum="1" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0.1" Maximum="1" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingViewboxSize, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Width" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingWidth, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="340" Width="186"/>
                        <NumericUpDown Width="88" Minimum="40" Maximum="340" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingWidth, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Height" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingHeight, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="220" Width="186"/>
                        <NumericUpDown Width="88" Minimum="40" Maximum="220" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingHeight, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="100" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="100" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingRadius, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Grid rotation — turns the TILING, not the content" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingRotation, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingRotation, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Opacity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding DrawingOpacity, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="1" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding DrawingOpacity, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Tint" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding DrawingTint, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- VisualBrush stand: the one brush whose content is a LIVE element rather than a recording. The panel on
                 the left is ordinary, interactive UI; the three shapes beside it are FILLED with it. Drag the slider
                 inside the source and the fills follow - the picture is re-taken when the element says it changed. -->
            </StackPanel>

            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Visual}">
            <TextBlock Text="VisualBrush — live (a real element as the fill)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <!-- THE SOURCE. Ordinary, interactive UI - drag ITS slider and every fill below follows, which is the
                     one thing that separates this brush from a picture taken once. -->
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="The source (drag me)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Border x:Name="ReflectionSource" Width="240" Height="150" Background="#101418" CornerRadius="8">
                        <StackPanel Orientation="Vertical" Margin="14">
                            <TextBlock Text="I am a live element" MarginBottom="8"/>
                            <!-- No field beside this one: the slider is INSIDE the brush's source, so anything added here
                                 is repainted in the reflection too. What this stand shows is the reflection, not a form. -->
                            <Slider Value="{Binding VisualSourceValue, Mode=TwoWay}" Minimum="10" Maximum="180" Width="200" MarginBottom="10"/>
                            <!-- 44 = two whole rows of the pattern's 22px cell. At 34 the second row landed on the
                                 element's own edge and came out sliced in half, which reads as a rendering fault. -->
                            <Border Height="44" Width="{Binding VisualSourceValue}" CornerRadius="4" HorizontalAlignment="Left"
                                    Background="{Binding LivePattern}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PAINTED WITH IT. The box is the sliders, not what the figure happens to measure - same reason as the
                     ImageBrush stand: a figure that keeps its proportions would otherwise slide along the box's edge. -->
                <!-- GREY, not the near-black the others use: the source's own background is near-black too, so on a dark
                     box the figure's outline vanished into it and only the tinted content showed where the fill was. -->
                <Border Width="300" Height="230" Margin="10" Background="#3A4048">
                    <Grid Width="{Binding VisualWidth}"
                          Height="{Binding VisualHeight}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Rectangle Width="{Binding VisualWidth}"
                                   Height="{Binding VisualHeight}"
                                   CornerRadius="{Binding VisualRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                                   Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}">
                            <Rectangle.Fill>
                                <VisualBrush Visual="{Binding ElementName=ReflectionSource}"
                                             TileMode="{Binding VisualTileMode}"
                                             Stretch="{Binding VisualStretch}"
                                             AlignmentX="{Binding VisualAlignmentX}"
                                             AlignmentY="{Binding VisualAlignmentY}"
                                             ViewportUnits="Absolute"
                                             Viewport="{Binding VisualViewportSize, Converter={conv:DoubleToSquareViewportConverter}}"
                                             RotationAngle="{Binding VisualRotation}"
                                             Opacity="{Binding VisualOpacity}"
                                             Tint="{Binding VisualTint}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse Width="{Binding VisualWidth}"
                                 Height="{Binding VisualHeight}"
                                 Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}">
                            <Ellipse.Fill>
                                <VisualBrush Visual="{Binding ElementName=ReflectionSource}"
                                             TileMode="{Binding VisualTileMode}"
                                             Stretch="{Binding VisualStretch}"
                                             AlignmentX="{Binding VisualAlignmentX}"
                                             AlignmentY="{Binding VisualAlignmentY}"
                                             ViewportUnits="Absolute"
                                             Viewport="{Binding VisualViewportSize, Converter={conv:DoubleToSquareViewportConverter}}"
                                             RotationAngle="{Binding VisualRotation}"
                                             Opacity="{Binding VisualOpacity}"
                                             Tint="{Binding VisualTint}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <RegularPolygon Width="{Binding VisualPolygonSize}"
                                 Height="{Binding VisualPolygonSize}"
                                 Corners="{Binding ShapeCornerCount}"
                                 StartAngle="{Binding ShapeStartAngle}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}">
                            <RegularPolygon.Fill>
                                <VisualBrush Visual="{Binding ElementName=ReflectionSource}"
                                             TileMode="{Binding VisualTileMode}"
                                             Stretch="{Binding VisualStretch}"
                                             AlignmentX="{Binding VisualAlignmentX}"
                                             AlignmentY="{Binding VisualAlignmentY}"
                                             ViewportUnits="Absolute"
                                             Viewport="{Binding VisualViewportSize, Converter={conv:DoubleToSquareViewportConverter}}"
                                             RotationAngle="{Binding VisualRotation}"
                                             Tint="{Binding VisualTint}"/>
                            </RegularPolygon.Fill>
                        </RegularPolygon>
                        <Polygon Points="{Binding VisualStar}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}">
                            <Polygon.Fill>
                                <VisualBrush Visual="{Binding ElementName=ReflectionSource}"
                                             TileMode="{Binding VisualTileMode}"
                                             Stretch="{Binding VisualStretch}"
                                             AlignmentX="{Binding VisualAlignmentX}"
                                             AlignmentY="{Binding VisualAlignmentY}"
                                             ViewportUnits="Absolute"
                                             Viewport="{Binding VisualViewportSize, Converter={conv:DoubleToSquareViewportConverter}}"
                                             RotationAngle="{Binding VisualRotation}"
                                             Tint="{Binding VisualTint}"/>
                            </Polygon.Fill>
                        </Polygon>
                    </Grid>
                </Border>

                <StackPanel Orientation="Vertical" Width="290" MarginLeft="16">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding PreviewShape, Mode=TwoWay}" Width="270" MarginBottom="10"/>
                    <!-- Only for the polygon: on a rect or an ellipse these two numbers mean nothing, and a control that
                         does nothing is worse than one that is not there. -->
                    <StackPanel Orientation="Vertical" Visibility="{Binding PreviewShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Polygon}">
                        <!-- The polygon's two numbers, shared by every stand on this tab: change them here and all of them follow. -->
                        <TextBlock Text="Corners — 3 is a triangle, enough of them a circle" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="6">
                            <Slider Value="{Binding ShapeCorners, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="3" Maximum="24"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="170"/>
                            <NumericUpDown Width="88" Minimum="3" Maximum="24" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeCorners, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                        <TextBlock Text="Start angle — where corner 0 sits" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal" MarginBottom="10">
                            <Slider Value="{Binding ShapeStartAngle, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360"
                                    TickFrequency="1" IsSnapToTickEnabled="true" Width="170"/>
                            <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                           IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                           Value="{Binding ShapeStartAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Tile mode" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding TileModes}" SelectedItem="{Binding VisualTileMode, Mode=TwoWay}" Width="270" MarginBottom="10"/>
                    <TextBlock Text="Stretch — fits the source inside ONE tile" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding Stretches}" SelectedItem="{Binding VisualStretch, Mode=TwoWay}" Width="270" MarginBottom="10"/>
                    <!-- Without this the alignments read as broken: one of the two axes is inert at any given Stretch,
                         which is correct and completely invisible from the two dropdowns alone. -->
                    <TextBlock Text="Alignment moves the source only where the fit LEFT ROOM, and Uniform leaves room on exactly ONE axis. The source is 240×150 in a square tile: Uniform fills the width, so only Y can move; UniformToFill crops the width instead, so only X can; Fill leaves no room at all."
                               Foreground="{ResourceReference TextFillColorSecondary}" TextWrapping="WrapByWords" Width="270" MarginBottom="6"/>
                    <TextBlock Text="Alignment X" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding AlignmentsX}" SelectedItem="{Binding VisualAlignmentX, Mode=TwoWay}" Width="270" MarginBottom="10"/>
                    <TextBlock Text="Alignment Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding AlignmentsY}" SelectedItem="{Binding VisualAlignmentY, Mode=TwoWay}" Width="270" MarginBottom="10"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Width="290" MarginLeft="16">
                    <TextBlock Text="Tile size (px) — smaller than the shape starts tiling" Foreground="{ResourceReference TextFillColorSecondary}" TextWrapping="WrapByWords" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding VisualViewportSize, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="30" Maximum="300" Width="176"/>
                        <NumericUpDown Width="88" Minimum="30" Maximum="300" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding VisualViewportSize, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Grid rotation" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding VisualRotation, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360" Width="176"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding VisualRotation, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Width" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding VisualWidth, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="60" Maximum="290" Width="176"/>
                        <NumericUpDown Width="88" Minimum="60" Maximum="290" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding VisualWidth, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Height" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding VisualHeight, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="60" Maximum="220" Width="176"/>
                        <NumericUpDown Width="88" Minimum="60" Maximum="220" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding VisualHeight, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding VisualRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="100" Width="176"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="100" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding VisualRadius, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Opacity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding VisualOpacity, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="176"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="1" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding VisualOpacity, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Tint" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding VisualTint, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
            </StackPanel>

            <!-- The nine-slice stand: drag the frame's own SIZE and watch the corners refuse to distort while everything
                 between them gives. Cut moves the four lines the source is cut on; Border says how big the corners are
                 DRAWN (0 = the source's own pixels). -->




            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Gradients}">
            <TextBlock Text="Gradients — ellipses" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Ellipse Width="120" Height="120" Margin="10">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.35,0.32" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="0.7"/>
                            <GradientStop Color="#1E3A8A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="160" Height="110" Margin="10" Stroke="#40FFFFFF" StrokeThickness="2">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EC4899" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </WrapPanel>

            <TextBlock Text="Gradients — arbitrary shapes (Polygon / Path)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <RegularPolygon Width="120" Height="120" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                    <RegularPolygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F472B6" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </RegularPolygon.Fill>
                </RegularPolygon>
                <Polygon Points="60,0 75,45 120,45 84,72 96,116 60,90 24,116 36,72 0,45 45,45" Margin="10">
                    <Polygon.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.4" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#FEF08A" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="0.6"/>
                            <GradientStop Color="#B45309" Offset="1"/>
                        </RadialGradientBrush>
                    </Polygon.Fill>
                </Polygon>
                <Path Data="F0 M110,10 L168.78,190.9 L14.89,79.1 L205.11,79.1 L51.22,190.9 Z" Width="200" Height="200" Margin="10">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#22D3EE" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="0.5"/>
                            <GradientStop Color="#1E1B4B" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </WrapPanel>

            <TextBlock Text="Spread method — Pad / Reflect / Repeat (stops span 0..0.5)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Pad">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Reflect">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Repeat">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <!-- Opacity composites onto the whole subtree (the label fades with the card); SelfOpacity fades only the
                 element's own fill, so the card dims while its label stays crisp. -->
            </StackPanel>



            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Gradients}">
            <TextBlock Text="Gradient interpolation — sRGB vs OKLab (NEW)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" MarginRight="24">
                    <TextBlock Text="sRGB — muddy midpoints" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                    <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#FACC15" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="300" Height="40" CornerRadius="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                                <GradientStop Color="#EC4899" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="OKLab — perceptual" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                    <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#FACC15" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="300" Height="40" CornerRadius="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                                <GradientStop Color="#EC4899" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </StackPanel>

            <!-- OKLab on ARBITRARY geometry: a Polygon fill routes through the general-geometry gradient batch, so this
                 proves the interp mode flows there too (left sRGB, right OKLab; same blue->yellow stops). -->
            <TextBlock Text="…and on arbitrary geometry (Polygon) — left sRGB, right OKLab"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginTop="12"
                       MarginBottom="6"/>
            <WrapPanel Orientation="Horizontal">
                <RegularPolygon Width="110" Height="110" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                    <RegularPolygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Srgb">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </RegularPolygon.Fill>
                </RegularPolygon>
                <RegularPolygon Width="110" Height="110" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                    <RegularPolygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Oklab">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </RegularPolygon.Fill>
                </RegularPolygon>
            </WrapPanel>

            <!-- NINE-SLICE: one 64x64 picture dressing four different sizes. The orange corners are drawn at their own
                 size in all four - that is the whole point; stretching the picture would smear them. The blue edges take
                 the axis they run along, and EdgeMode says whether they stretch (the studs smear) or repeat (the studs
                 keep their rhythm and the last one is cut short). -->
            </StackPanel>

            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=NineSlice}">
            <TextBlock Text="NineSliceBrush — one picture, any size, corners never distort" FontSize="18" Margin="0,20,0,10"/>
            <TextBlock Text="The source is 64×64 with a 16px frame (Slice = 0.25). Compare with the plain ImageBrush at the end: the same picture stretched."
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginBottom="8"/>
            <WrapPanel Orientation="Horizontal">
                <Border Width="90" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                    </Border.Background>
                    <TextBlock Text="stretched edges" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                        Slice="0.25"
                                        EdgeMode="Repeat"/>
                    </Border.Background>
                    <TextBlock Text="repeated edges" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="240" Height="140" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                        Slice="0.25"
                                        EdgeMode="Repeat"
                                        DrawCenter="False"/>
                    </Border.Background>
                    <TextBlock Text="frame only (DrawCenter=False)" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>

            <TextBlock Text="…and the same picture as a plain ImageBrush — stretched, corners and all"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginTop="12"
                       MarginBottom="6"/>
            <WrapPanel Orientation="Horizontal">
                <Border Width="90" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png" Tint="#66FF88"/>
                    </Border.Background>
                    <TextBlock Text="tinted" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</View>
