<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.Game.Sandbox.Converters"
      xmlns:nav="clr-namespace:Adamantium.UI.Controls.Navigation;assembly=Adamantium.UI.Controls">
    <!-- DataContext is the BrushesViewModel. Every gradient below is authored in AUML (element syntax:
         <Shape.Fill><LinearGradientBrush><GradientStop/>...) - proving gradients are fully markup-authorable, on any
         element, and batched by the SDF gradient batches. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="24">

            <!-- ONE LIVE STAND, and a selector that swaps which brush is in it. The tab used to run a section per family
                 down one page: fourteen stands, each with its own copy of the same figure picker, so comparing two of
                 them meant scrolling past everything in between and re-picking the figure when you got there. Now the
                 figure is chosen ONCE, here, and every family paints on it in turn. -->
            <TextBlock Text="Brushes — live" FontSize="20" MarginBottom="10"/>

            <!-- BUTTONS, not a dropdown: every family is on screen at once, so what the tab covers is readable without
                 opening anything, and swapping between two of them is one click each way rather than four. They all bind
                 the SAME property and name their own value - see EnumToBoolConverter. -->
            <WrapPanel Orientation="Horizontal" MarginBottom="10">
                <ToggleButton Content="Gradients" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Gradients, Mode=TwoWay}"/>
                <ToggleButton Content="Mesh gradient" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Mesh, Mode=TwoWay}"/>
                <ToggleButton Content="Pattern" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Pattern, Mode=TwoWay}"/>
                <ToggleButton Content="Noise" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Noise, Mode=TwoWay}"/>
                <ToggleButton Content="Fractal" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Fractal, Mode=TwoWay}"/>
                <ToggleButton Content="Image" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Image, Mode=TwoWay}"/>
                <ToggleButton Content="Nine-slice" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=NineSlice, Mode=TwoWay}"/>
                <ToggleButton Content="Drawing" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Drawing, Mode=TwoWay}"/>
                <ToggleButton Content="Visual" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Visual, Mode=TwoWay}"/>
                <ToggleButton Content="Material" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Material, Mode=TwoWay}"/>
                <ToggleButton Content="Aura / Shadow" MarginRight="6" MarginBottom="6"
                              IsChecked="{Binding LiveStand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Aura, Mode=TwoWay}"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" MarginBottom="4">
                <StackPanel Orientation="Vertical" Width="300">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding PreviewShape, Mode=TwoWay}" Width="280"/>
                </StackPanel>
            </StackPanel>

            <!-- THE STAND ITSELF. Each one is its own view over this same view-model, navigated in by key - so leaving a
                 stand drops its markup instead of leaving it built and hidden, and the shared figure and slot survive
                 the switch because the object behind them never changed. -->
            <!-- KNOWN DEFECT, left ON so it stays visible: with the transition running, the MATERIAL stand draws from
                 the presenter's origin instead of its own laid-out position - its header ends up underneath its own
                 preview box. Turning ContentTransition off puts it right, which is how it was pinned to the transition
                 rather than to the markup. The lead is in ContentTransitions.Run: a sliding view is promoted to a motion
                 node and never demoted, and that promotion changes how its subtree is baked - node-relative rather than
                 world-baked. It shows on the material because that stand is the largest; the smaller ones hide it. -->
            <ContentControl nav:Region.Source="{Binding Region}" ContentTransition="SlideLeft"/>


            <!-- BACKDROP MATERIALS, live. Unlike every other brush here, these have nothing of their own to show: they
                 are made of what is BEHIND them. So the stand is built the other way round from the rest - the controls
                 change not only the material but WHAT IT SITS OVER, because a backdrop over a flat colour proves
                 nothing at all.
                 The three kinds are one dropdown apart on purpose. Acrylic and liquid glass take exactly the same
                 capture and differ only in the treatment - one scatters it, the other bends it - and switching between
                 them in place, over the same field, is the only way to see that. Mica differs in the third way: same
                 treatment, different SOURCE - the desktop wallpaper rather than this frame, so scrolling the page
                 leaves it still while moving the window changes it. -->
            <!-- Aura and Shadow: the soft band around a shape. Two properties rather than one with the offset zeroed -
                 a shadow has a DIRECTION and an aura does not. Both are the shape's own signed distance read further out,
                 so they batch with everything else: no offscreen target, no blur pass.
                 The panel CLIPS on purpose - drag Margin down and watch the band get cut off. That is the one thing the
                 engine will not do for you: the band is drawn outside the element's bounds, and the room is the author's. -->

            <!-- One labelled swatch per noise type. At the TOP so any shader device-lost is caught on launch. -->

            <!-- Reference rows belong to the stand they are ABOUT, not to a switch of their own: pick Noise and its
                 swatches come with it. That is also why the caption below can say "the live panel" and mean it. -->
            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Noise}">
            <TextBlock Text="Noise types (all selectable in the live panel below)" FontSize="18" Margin="0,0,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Simplex" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#7DD3FC"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Simplex" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Perlin" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#86EFAC"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Perlin" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Value" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#FDE68A"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Value" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Worley" Scale="52" Octaves="2" Color1="#0B1220" Color2="#FCA5A5"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Worley" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Worley" Scale="56" Octaves="1" Animate="true" FlowSpeed="0.8" Color1="#0B1220" Color2="#C4B5FD"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Worley (flow)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Ridged" Scale="60" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#FBBF24"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Ridged" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Turbulence" Scale="54" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#38BDF8"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Turbulence" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="VoronoiBorders" Scale="46" Animate="true" FlowSpeed="0.7" Color1="#0B1220" Color2="#67E8F9"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Voronoi borders" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Combustible (fire)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"
                                        UseFirePalette="false" Color1="#020617" MidColor="#0EA5E9" Color2="#E0F2FE"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Combustible (custom)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
            </WrapPanel>

            </StackPanel>

            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Gradients}">

            <TextBlock Text="Linear gradients — rectangles" FontSize="18" Margin="0,0,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- diagonal, 3 stops -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="0.5"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- horizontal -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#22C55E" Offset="0"/>
                            <GradientStop Color="#EAB308" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- vertical, with a stroke -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10" Stroke="White" StrokeThickness="3">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <TextBlock Text="Radial gradients — rectangles" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- centred spotlight -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#FDE68A" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- off-centre focal (top-left highlight) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.3,0.28" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#A7F3D0" Offset="0"/>
                            <GradientStop Color="#14B8A6" Offset="0.6"/>
                            <GradientStop Color="#0F766E" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <TextBlock Text="Conic gradients — angular sweep (NEW)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- full-spectrum sweep (a colour wheel's hue): start at top, clockwise; last stop meets the first -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- two-colour sweep rotated to start from the right (StartAngle 90) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5" StartAngle="90">
                            <GradientStop Color="#1E293B" Offset="0"/>
                            <GradientStop Color="#38BDF8" Offset="0.5"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- pie chart: hard segments (a stop doubled at each boundary) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#EF4444" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="0.25"/>
                            <GradientStop Color="#22C55E" Offset="0.25"/>
                            <GradientStop Color="#22C55E" Offset="0.6"/>
                            <GradientStop Color="#3B82F6" Offset="0.6"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- conic on a circle = a proper colour wheel -->
                <Ellipse Width="140" Height="140" Margin="10">
                    <Ellipse.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </ConicGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </WrapPanel>

            <!-- Mesh gradient: four CORNER colours blended bilinearly across the shape - no axis, no stops. WPF has
                 nothing like it; this is the Figma/Illustrator "mesh gradient" in its 4-corner form. Was deferred while
                 the gradient pass would not survive the extra code on the old driver. -->
            <!-- ImageBrush stand: ONE picture, laid down once or repeated. The sample is deliberately asymmetric, so a
                 plain Tile shows its seams and a Flip mode visibly meets its own reflection. Stretch only matters while
                 TileMode is None - a tile is sized by Tile size instead. -->
            </StackPanel>

            <!-- DrawingBrush stand: the SAME four mechanisms as the ImageBrush, on content that has no pixels at all.
                 Worth poking in this order - viewport sizes the tile, viewbox picks what a tile shows, stretch fits the
                 content in it and alignment says where, tile mode repeats it. Stretch and alignment stay meaningful
                 while tiling: a Uniform fit letterboxes EVERY copy, not the lot. -->

            <!-- VisualBrush stand: the one brush whose content is a LIVE element rather than a recording. The panel on
                 the left is ordinary, interactive UI; the three shapes beside it are FILLED with it. Drag the slider
                 inside the source and the fills follow - the picture is re-taken when the element says it changed. -->


            <!-- The nine-slice stand: drag the frame's own SIZE and watch the corners refuse to distort while everything
                 between them gives. Cut moves the four lines the source is cut on; Border says how big the corners are
                 DRAWN (0 = the source's own pixels). -->




            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Gradients}">
            <TextBlock Text="Gradients — ellipses" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Ellipse Width="120" Height="120" Margin="10">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.35,0.32" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="0.7"/>
                            <GradientStop Color="#1E3A8A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="160" Height="110" Margin="10" Stroke="#40FFFFFF" StrokeThickness="2">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EC4899" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </WrapPanel>

            <TextBlock Text="Gradients — arbitrary shapes (Polygon / Path)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <RegularPolygon Width="120" Height="120" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                    <RegularPolygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F472B6" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </RegularPolygon.Fill>
                </RegularPolygon>
                <Polygon Points="60,0 75,45 120,45 84,72 96,116 60,90 24,116 36,72 0,45 45,45" Margin="10">
                    <Polygon.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.4" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#FEF08A" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="0.6"/>
                            <GradientStop Color="#B45309" Offset="1"/>
                        </RadialGradientBrush>
                    </Polygon.Fill>
                </Polygon>
                <Path Data="F0 M110,10 L168.78,190.9 L14.89,79.1 L205.11,79.1 L51.22,190.9 Z" Width="200" Height="200" Margin="10">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#22D3EE" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="0.5"/>
                            <GradientStop Color="#1E1B4B" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </WrapPanel>

            <TextBlock Text="Spread method — Pad / Reflect / Repeat (stops span 0..0.5)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Pad">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Reflect">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Repeat">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <!-- Opacity composites onto the whole subtree (the label fades with the card); SelfOpacity fades only the
                 element's own fill, so the card dims while its label stays crisp. -->
            </StackPanel>



            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Gradients}">
            <TextBlock Text="Gradient interpolation — sRGB vs OKLab (NEW)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" MarginRight="24">
                    <TextBlock Text="sRGB — muddy midpoints" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                    <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#FACC15" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="300" Height="40" CornerRadius="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                                <GradientStop Color="#EC4899" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="OKLab — perceptual" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                    <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#FACC15" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="300" Height="40" CornerRadius="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                                <GradientStop Color="#EC4899" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </StackPanel>

            <!-- OKLab on ARBITRARY geometry: a Polygon fill routes through the general-geometry gradient batch, so this
                 proves the interp mode flows there too (left sRGB, right OKLab; same blue->yellow stops). -->
            <TextBlock Text="…and on arbitrary geometry (Polygon) — left sRGB, right OKLab"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginTop="12"
                       MarginBottom="6"/>
            <WrapPanel Orientation="Horizontal">
                <RegularPolygon Width="110" Height="110" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                    <RegularPolygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Srgb">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </RegularPolygon.Fill>
                </RegularPolygon>
                <RegularPolygon Width="110" Height="110" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                    <RegularPolygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Oklab">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </RegularPolygon.Fill>
                </RegularPolygon>
            </WrapPanel>

            <!-- NINE-SLICE: one 64x64 picture dressing four different sizes. The orange corners are drawn at their own
                 size in all four - that is the whole point; stretching the picture would smear them. The blue edges take
                 the axis they run along, and EdgeMode says whether they stretch (the studs smear) or repeat (the studs
                 keep their rhythm and the last one is cut short). -->
            </StackPanel>

            <StackPanel Orientation="Vertical" Visibility="{Binding LiveStand, Converter={conv:EnumVisibilityConverter}, ConverterParameter=NineSlice}">
            <TextBlock Text="NineSliceBrush — one picture, any size, corners never distort" FontSize="18" Margin="0,20,0,10"/>
            <TextBlock Text="The source is 64×64 with a 16px frame (Slice = 0.25). Compare with the plain ImageBrush at the end: the same picture stretched."
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginBottom="8"/>
            <WrapPanel Orientation="Horizontal">
                <Border Width="90" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                    </Border.Background>
                    <TextBlock Text="stretched edges" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                        Slice="0.25"
                                        EdgeMode="Repeat"/>
                    </Border.Background>
                    <TextBlock Text="repeated edges" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="240" Height="140" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                        Slice="0.25"
                                        EdgeMode="Repeat"
                                        DrawCenter="False"/>
                    </Border.Background>
                    <TextBlock Text="frame only (DrawCenter=False)" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>

            <TextBlock Text="…and the same picture as a plain ImageBrush — stretched, corners and all"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginTop="12"
                       MarginBottom="6"/>
            <WrapPanel Orientation="Horizontal">
                <Border Width="90" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png" Tint="#66FF88"/>
                    </Border.Background>
                    <TextBlock Text="tinted" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</View>
