<View xmlns="http://adamantium/ui"
      xmlns:conv="clr-namespace:Adamantium.Game.Sandbox.Converters">
    <!-- DataContext is the BrushesViewModel. Every gradient below is authored in AUML (element syntax:
         <Shape.Fill><LinearGradientBrush><GradientStop/>...) - proving gradients are fully markup-authorable, on any
         element, and batched by the SDF gradient batches. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="24">

            <!-- Aura and Shadow: the soft band around a shape. Two properties rather than one with the offset zeroed -
                 a shadow has a DIRECTION and an aura does not. Both are the shape's own signed distance read further out,
                 so they batch with everything else: no offscreen target, no blur pass.
                 The panel CLIPS on purpose - drag Margin down and watch the band get cut off. That is the one thing the
                 engine will not do for you: the band is drawn outside the element's bounds, and the room is the author's. -->
            <TextBlock Text="Aura / Shadow — live (the band is drawn OUTSIDE the element; the margin is yours to leave)" FontSize="18" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" MarginBottom="20">
                <!-- A MID-TONE backdrop on purpose: the other stands sit on near-black, but a dark shadow is invisible
                     there and a bright aura blows out. This one has to show both at once. -->
                <Border Width="420" Height="300" Margin="10" Background="#485061">
                    <!-- The clip goes HERE when it is asked for, not on the panel: this box is exactly the figure plus its
                         margin, so the margin then decides how much of the band survives. On the panel it would never
                         bite - the panel is far bigger than any band - and the rule would stay invisible. -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="{Binding HaloClip}">
                        <Rectangle Width="180" Height="120"
                                   Fill="#E2E8F0"
                                   Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                   CornerRadius="{Binding HaloRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                                   Aura="{Binding LiveAura}"
                                   Shadow="{Binding LiveShadow}"
                                   Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                        <Ellipse Width="180" Height="120"
                                 Fill="#E2E8F0"
                                 Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                 Aura="{Binding LiveAura}"
                                 Shadow="{Binding LiveShadow}"
                                 Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                        <!-- Tessellated shapes: their band reads a distance field baked per mesh, so it follows a
                             concave outline - the star's notches keep their own glow instead of being bridged over. -->
                        <Polygon Points="{Binding HaloTriangle}"
                                 Fill="#E2E8F0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                 Aura="{Binding LiveAura}"
                                 Shadow="{Binding LiveShadow}"
                                 Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Triangle}"/>
                        <Polygon Points="{Binding HaloStar}"
                                 Fill="#E2E8F0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="{Binding HaloMargin, Converter={conv:DoubleToThicknessConverter}}"
                                 Aura="{Binding LiveAura}"
                                 Shadow="{Binding LiveShadow}"
                                 Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding HaloShapes}" SelectedItem="{Binding HaloShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <StackPanel Orientation="Vertical" Visibility="{Binding HaloShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}">
                        <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding HaloRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="60" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <!-- Margin is LAYOUT, not a band parameter - it does nothing to the glow itself. It is here only to
                         show the one rule the engine will not keep for you: bounds are never grown to fit a band, so a
                         clipping ancestor cuts whatever the author left no room for. Hence it lives with the clip. -->
                    <CheckBox Content="Clip to the element's box" IsChecked="{Binding HaloClip, Mode=TwoWay}" MarginBottom="4"/>
                    <TextBlock Text="Margin — layout, not a band setting. With the clip on, drop it below the radius and the band is cut: bounds are never grown to fit a glow."
                               TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding HaloMargin, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="70" Width="280" MarginBottom="14"/>

                    <CheckBox Content="AURA — no direction" IsChecked="{Binding AuraOn, Mode=TwoWay}" FontSize="14" MarginBottom="6"/>
                    <TextBlock Text="Radius — how far it reaches" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding AuraRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="60" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Spread — solid rim before the fade" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding AuraSpread, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="30" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Opacity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding AuraOpacity, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="280" MarginBottom="10"/>
                    <CheckBox Content="Inner (glow inward — needs no margin at all)" IsChecked="{Binding AuraInner, Mode=TwoWay}" MarginBottom="6"/>
                    <TextBlock Text="Colour" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor, Mode=TwoWay}" MarginBottom="14"/>

                    <!-- LIVING: at Turbulence 0 this is the still band above and the living pass is never reached, so a
                         plain glow pays nothing for the noise. -->
                    <TextBlock Text="ALIVE — the reach breathes" FontSize="14" MarginBottom="6"/>
                    <TextBlock Text="Turbulence — how far the reach wanders (0 = still)"
                               TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding AuraTurbulence, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="2" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Flow — how fast it drifts" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding AuraFlow, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="3" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Detail — how many tongues run around it" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding AuraDetail, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0.5" Maximum="12" Width="280" MarginBottom="10"/>
                    <CheckBox Content="Palette — travel four colours instead of one" IsChecked="{Binding AuraPalette, Mode=TwoWay}" MarginBottom="6"/>
                    <StackPanel Orientation="Vertical" Visibility="{Binding AuraPalette, Converter={conv:BoolToVisibilityConverter}}">
                        <TextBlock Text="The four it travels through" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal">
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor1, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor2, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor3, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding AuraColor4, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- The shadow's own column: the two sets are independent, and stacking them made one tall strip nobody
                     could take in at a glance. -->
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="24" VerticalAlignment="Center">
                    <CheckBox Content="SHADOW — thrown where the light is not" IsChecked="{Binding ShadowOn, Mode=TwoWay}" FontSize="14" MarginBottom="6"/>
                    <TextBlock Text="Offset X / Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ShadowOffsetX, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-40" Maximum="40" Width="280" MarginBottom="6"/>
                    <Slider Value="{Binding ShadowOffsetY, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-40" Maximum="40" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Blur radius — how soft the edge is" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ShadowBlur, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="60" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Spread — how HIGH it floats (negative peeks out from one edge)"
                               TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ShadowSpread, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-20" Maximum="30" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Opacity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ShadowOpacity, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="280" MarginBottom="10"/>
                    <CheckBox Content="Inner (inset — the pressed look)" IsChecked="{Binding ShadowInner, Mode=TwoWay}" MarginBottom="6"/>
                    <TextBlock Text="Colour" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding ShadowColor, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- One labelled swatch per noise type. At the TOP so any shader device-lost is caught on launch. -->
            <TextBlock Text="Noise types (all selectable in the live panel below)" FontSize="18" Margin="0,0,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Simplex" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#7DD3FC"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Simplex" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Perlin" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#86EFAC"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Perlin" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Value" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#FDE68A"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Value" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Worley" Scale="52" Octaves="2" Color1="#0B1220" Color2="#FCA5A5"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Worley" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Worley" Scale="56" Octaves="1" Animate="true" FlowSpeed="0.8" Color1="#0B1220" Color2="#C4B5FD"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Worley (flow)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Ridged" Scale="60" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#FBBF24"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Ridged" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="Turbulence" Scale="54" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#38BDF8"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Turbulence" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="VoronoiBorders" Scale="46" Animate="true" FlowSpeed="0.7" Color1="#0B1220" Color2="#67E8F9"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Voronoi borders" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Combustible (fire)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <Rectangle Width="150" Height="110" CornerRadius="12">
                        <Rectangle.Fill>
                            <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"
                                        UseFirePalette="false" Color1="#020617" MidColor="#0EA5E9" Color2="#E0F2FE"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Combustible (custom)" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock Text="Linear gradients — rectangles" FontSize="18" Margin="0,0,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- diagonal, 3 stops -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="0.5"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- horizontal -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#22C55E" Offset="0"/>
                            <GradientStop Color="#EAB308" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- vertical, with a stroke -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10" Stroke="White" StrokeThickness="3">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <TextBlock Text="Radial gradients — rectangles" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- centred spotlight -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#FDE68A" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- off-centre focal (top-left highlight) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.3,0.28" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#A7F3D0" Offset="0"/>
                            <GradientStop Color="#14B8A6" Offset="0.6"/>
                            <GradientStop Color="#0F766E" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <TextBlock Text="Conic gradients — angular sweep (NEW)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <!-- full-spectrum sweep (a colour wheel's hue): start at top, clockwise; last stop meets the first -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- two-colour sweep rotated to start from the right (StartAngle 90) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5" StartAngle="90">
                            <GradientStop Color="#1E293B" Offset="0"/>
                            <GradientStop Color="#38BDF8" Offset="0.5"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- pie chart: hard segments (a stop doubled at each boundary) -->
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#EF4444" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="0.25"/>
                            <GradientStop Color="#22C55E" Offset="0.25"/>
                            <GradientStop Color="#22C55E" Offset="0.6"/>
                            <GradientStop Color="#3B82F6" Offset="0.6"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </ConicGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- conic on a circle = a proper colour wheel -->
                <Ellipse Width="140" Height="140" Margin="10">
                    <Ellipse.Fill>
                        <ConicGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </ConicGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </WrapPanel>

            <!-- Mesh gradient: four CORNER colours blended bilinearly across the shape - no axis, no stops. WPF has
                 nothing like it; this is the Figma/Illustrator "mesh gradient" in its 4-corner form. Was deferred while
                 the gradient pass would not survive the extra code on the old driver. -->
            <!-- ImageBrush stand: ONE picture, laid down once or repeated. The sample is deliberately asymmetric, so a
                 plain Tile shows its seams and a Flip mode visibly meets its own reflection. Stretch only matters while
                 TileMode is None - a tile is sized by Tile size instead. -->
            <TextBlock Text="ImageBrush — live (tile it, mirror it, or fit one copy)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="360" Height="240" Margin="10" Background="#101418">
                    <!-- The BOX is the sliders, not whatever the figure happens to measure: a figure that keeps its
                         proportions never fills both axes, and letting the box follow it makes the figure slide along
                         the box's edge as the sliders move instead of growing in place. -->
                    <Grid Width="{Binding ImageWidth}"
                          Height="{Binding ImageHeight}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Rectangle Width="{Binding ImageWidth}"
                                   Height="{Binding ImageHeight}"
                                   Fill="{Binding LiveImage}"
                                   CornerRadius="{Binding ImageRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                                   Visibility="{Binding ImageShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                        <Ellipse Width="{Binding ImageWidth}"
                                 Height="{Binding ImageHeight}"
                                 Fill="{Binding LiveImage}"
                                 Visibility="{Binding ImageShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                        <!-- A Polygon keeps its authored coordinates, so its points follow the size sliders from the
                             view-model rather than stretching to the slot. -->
                        <Polygon Points="{Binding ImageTriangle}"
                                 Fill="{Binding LiveImage}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding ImageShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Triangle}"/>
                        <Polygon Points="{Binding ImageStar}"
                                 Fill="{Binding LiveImage}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding ImageShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding ImageShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Tile mode" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding TileModes}" SelectedItem="{Binding ImageTileMode, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Stretch (only while Tile mode is None)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding Stretches}" SelectedItem="{Binding ImageStretch, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Tile size" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ImageTile, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="8" Maximum="160" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Width" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ImageWidth, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="340" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Height" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ImageHeight, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="220" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ImageRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="100" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Grid rotation — turns the TILING" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding ImageRotation, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Tint" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding ImageTint, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- DrawingBrush stand: the SAME four mechanisms as the ImageBrush above, on content that has no pixels at
                 all. Worth poking in this order - viewport sizes the tile, viewbox picks what a tile shows, stretch
                 fits the content in it and alignment says where, tile mode repeats it. Stretch and alignment stay
                 meaningful while tiling: a Uniform fit letterboxes EVERY copy, not the lot. -->
            <TextBlock Text="DrawingBrush — live (a drawing as a fill: viewbox, viewport, stretch, tiling)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="360" Height="240" Margin="10" Background="#101418">
                    <Grid Width="{Binding DrawingWidth}"
                          Height="{Binding DrawingHeight}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Rectangle Width="{Binding DrawingWidth}"
                                   Height="{Binding DrawingHeight}"
                                   Fill="{Binding LiveDrawing}"
                                   CornerRadius="{Binding DrawingRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                                   Visibility="{Binding DrawingShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                        <Ellipse Width="{Binding DrawingWidth}"
                                 Height="{Binding DrawingHeight}"
                                 Fill="{Binding LiveDrawing}"
                                 Visibility="{Binding DrawingShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                        <Polygon Points="{Binding DrawingTriangle}"
                                 Fill="{Binding LiveDrawing}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding DrawingShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Triangle}"/>
                        <Polygon Points="{Binding DrawingStar}"
                                 Fill="{Binding LiveDrawing}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding DrawingShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding DrawingShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Tile mode" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding TileModes}" SelectedItem="{Binding DrawingTileMode, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Stretch — fits the content inside ONE tile" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding Stretches}" SelectedItem="{Binding DrawingStretch, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Alignment X (only while the fit leaves room)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding AlignmentsX}" SelectedItem="{Binding DrawingAlignmentX, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Alignment Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding AlignmentsY}" SelectedItem="{Binding DrawingAlignmentY, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewport units — px, or a fraction of the shape" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding MappingModes}" SelectedItem="{Binding DrawingViewportUnits, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewport size — one tile (sizes the SINGLE copy too, so None puts it in a corner)" Foreground="{ResourceReference TextFillColorSecondary}" TextWrapping="WrapByWords" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingViewportSize, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="16" Maximum="200" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewport origin X — shifts the whole grid" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingViewportOriginX, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-100" Maximum="100" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewport origin Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingViewportOriginY, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="-100" Maximum="100" Width="280" MarginBottom="10"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16">
                    <TextBlock Text="Viewbox X — which part of the drawing a tile shows" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingViewboxX, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewbox Y" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingViewboxY, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Viewbox size — 1 is the whole drawing" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingViewboxSize, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0.1" Maximum="1" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Width" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingWidth, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="340" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Height" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingHeight, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="220" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="100" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Grid rotation — turns the TILING, not the content" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingRotation, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Opacity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding DrawingOpacity, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="1" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Tint" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding DrawingTint, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Mesh gradient — live (four corners, pick each)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Height="200" Margin="10">
                    <Rectangle Width="300" Height="200" Fill="{Binding LiveMesh}"
                               CornerRadius="{Binding MeshRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                               Visibility="{Binding MeshShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                    <Ellipse Width="300" Height="200" Fill="{Binding LiveMesh}"
                             Visibility="{Binding MeshShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                    <Polygon Points="150,0 300,200 0,200" Fill="{Binding LiveMesh}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding MeshShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Triangle}"/>
                    <Polygon Points="{Binding FixedStar}" Fill="{Binding LiveMesh}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding MeshShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                </Grid>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding MeshShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Corners (top-left / top-right)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MeshTopLeft, Mode=TwoWay}" MarginRight="8"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MeshTopRight, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="Corners (bottom-left / bottom-right)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MeshBottomLeft, Mode=TwoWay}" MarginRight="8"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding MeshBottomRight, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding MeshShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}">
                        <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding MeshRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="100" Width="280"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- The nine-slice stand: drag the frame's own SIZE and watch the corners refuse to distort while everything
                 between them gives. Cut moves the four lines the source is cut on; Border says how big the corners are
                 DRAWN (0 = the source's own pixels). -->
            <TextBlock Text="Nine-slice — live (drag the size: the corners keep theirs, the edges give)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="360" Height="240" Margin="10" Background="#101418">
                    <Border Width="{Binding SliceWidth}"
                            Height="{Binding SliceHeight}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding LiveNineSlice}"/>
                </Border>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Skin" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding Skins}" SelectedItem="{Binding Skin, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Width" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding SliceWidth, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="340" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Height" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding SliceHeight, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="220" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Cut — where the SOURCE is cut (0.25 = these skins&apos; own 16px frame; move it and the pieces take each other&apos;s pixels)"
                               TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding SliceCut, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0.05" Maximum="0.45" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Border (0 = the source's own pixels)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding SliceBorder, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="48" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Edge mode" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding EdgeModes}" SelectedItem="{Binding SliceEdgeMode, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <CheckBox Content="Draw the centre" IsChecked="{Binding SliceDrawCenter, Mode=TwoWay}" MarginBottom="6"/>
                    <CheckBox Content="Tile the centre too (off = stretched, as CSS border-image does)" IsChecked="{Binding SliceTileCenter, Mode=TwoWay}" MarginBottom="10"/>
                    <TextBlock Text="Tint" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding SliceTint, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Pattern — live (pick a type; drag cell size, corner radius and colours — replaces the static swatches)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Height="200" Margin="10">
                    <Rectangle Width="300" Height="200" Fill="{Binding LivePattern}"
                               CornerRadius="{Binding PatternRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                               Visibility="{Binding PatternShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                    <Ellipse Width="300" Height="200" Fill="{Binding LivePattern}"
                             Visibility="{Binding PatternShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                    <Polygon Points="150,0 300,200 0,200" Fill="{Binding LivePattern}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding PatternShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Triangle}"/>
                    <Polygon Points="{Binding FixedStar}" Fill="{Binding LivePattern}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding PatternShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                </Grid>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding PatternShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Pattern type" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PatternTypes}" SelectedItem="{Binding PatternKind, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Cell size" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding PatternCell, Mode=TwoWay}" Minimum="6" Maximum="60" Width="280" MarginBottom="10"/>
                    <StackPanel Orientation="Vertical" Visibility="{Binding PatternKind, Converter={conv:PatternParamVisibilityConverter}, ConverterParameter=Hatch}">
                        <TextBlock Text="Hatch angle" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding PatternHatchAngle, Mode=TwoWay}" Minimum="0" Maximum="180" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding PatternShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}">
                        <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding PatternRadius, Mode=TwoWay}" Minimum="0" Maximum="100" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <TextBlock Text="Colours (background / feature)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal">
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding PatternColor1, Mode=TwoWay}" MarginRight="8"/>
                        <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding PatternColor2, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Noise — live (drag to re-bake; tick “Mid colour” for a 3-colour gradient-map ramp)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Height="200" Margin="10">
                    <Rectangle Width="300" Height="200" Fill="{Binding LiveNoise}"
                               CornerRadius="{Binding NoiseRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                               Visibility="{Binding NoiseShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}"/>
                    <Ellipse Width="300" Height="200" Fill="{Binding LiveNoise}"
                             Visibility="{Binding NoiseShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Ellipse}"/>
                    <Polygon Points="150,0 300,200 0,200" Fill="{Binding LiveNoise}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding NoiseShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Triangle}"/>
                    <Polygon Points="{Binding FixedStar}" Fill="{Binding LiveNoise}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding NoiseShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Star}"/>
                </Grid>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Paint it on" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding PreviewShapes}" SelectedItem="{Binding NoiseShape, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <TextBlock Text="Noise type" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <DropDown ItemsSource="{Binding NoiseTypes}" SelectedItem="{Binding NoiseKind, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                    <CheckBox Content="Animate (flow — best with Worley)" IsChecked="{Binding NoiseAnimate, Mode=TwoWay}" MarginBottom="6"/>
                    <TextBlock Text="Flow speed" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider Value="{Binding NoiseFlowSpeed, Mode=TwoWay}" Minimum="0.1" Maximum="3" Width="280" MarginBottom="10"/>
                    <StackPanel Orientation="Vertical" Visibility="{Binding NoiseShape, Converter={conv:PreviewShapeVisibilityConverter}, ConverterParameter=Rectangle}">
                        <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding NoiseRadius, Mode=TwoWay}" Minimum="0" Maximum="100" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Scale}">
                        <TextBlock Text="Scale" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding NoiseScale, Mode=TwoWay}" Minimum="6" Maximum="120" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Fbm}">
                        <TextBlock Text="Octaves" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding NoiseOctaves, Mode=TwoWay}" Minimum="1" Maximum="8" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Seed}">
                        <TextBlock Text="Seed" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding NoiseSeed, Mode=TwoWay}" Minimum="0" Maximum="50" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Fbm}">
                        <TextBlock Text="Lacunarity" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding NoiseLacunarity, Mode=TwoWay}" Minimum="1.5" Maximum="3.5" Width="280" MarginBottom="10"/>
                        <TextBlock Text="Gain" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <Slider Value="{Binding NoiseGain, Mode=TwoWay}" Minimum="0.2" Maximum="0.8" Width="280" MarginBottom="10"/>
                    </StackPanel>
                    <CheckBox Content="Fire palette (off = use colours below)" IsChecked="{Binding NoiseFirePalette, Mode=TwoWay}" MarginBottom="6"
                              Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=FirePalette}"/>
                    <StackPanel Orientation="Vertical">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{conv:CombustibleColorsVisibilityConverter}">
                                <Binding Path="NoiseKind"/>
                                <Binding Path="NoiseFirePalette"/>
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <CheckBox Content="Mid colour (3-colour gradient-map ramp)" IsChecked="{Binding NoiseUseMid, Mode=TwoWay}" MarginBottom="6"/>
                        <TextBlock Text="Colours (low / mid / high — mid used only when ticked)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                        <StackPanel Orientation="Horizontal">
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding NoiseColor1, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding NoiseMid, Mode=TwoWay}" MarginRight="8"/>
                            <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding NoiseColor2, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Gradients — ellipses" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Ellipse Width="120" Height="120" Margin="10">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.35,0.32" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="0.7"/>
                            <GradientStop Color="#1E3A8A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="160" Height="110" Margin="10" Stroke="#40FFFFFF" StrokeThickness="2">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EC4899" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </WrapPanel>

            <TextBlock Text="Gradients — arbitrary shapes (Polygon / Path)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Polygon Points="70,0 140,120 0,120" Margin="10">
                    <Polygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F472B6" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Polygon.Fill>
                </Polygon>
                <Polygon Points="60,0 75,45 120,45 84,72 96,116 60,90 24,116 36,72 0,45 45,45" Margin="10">
                    <Polygon.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.4" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#FEF08A" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="0.6"/>
                            <GradientStop Color="#B45309" Offset="1"/>
                        </RadialGradientBrush>
                    </Polygon.Fill>
                </Polygon>
                <Path Data="F0 M110,10 L168.78,190.9 L14.89,79.1 L205.11,79.1 L51.22,190.9 Z" Width="200" Height="200" Margin="10">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#22D3EE" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="0.5"/>
                            <GradientStop Color="#1E1B4B" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </WrapPanel>

            <TextBlock Text="Spread method — Pad / Reflect / Repeat (stops span 0..0.5)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Pad">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Reflect">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Repeat">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#111827" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <!-- Opacity composites onto the whole subtree (the label fades with the card); SelfOpacity fades only the
                 element's own fill, so the card dims while its label stays crisp. -->
            <TextBlock Text="Fractal brush — Julia / Mandelbrot (NEW)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                    <Rectangle.Fill>
                        <FractalBrush Fractal="Julia" C="-0.8,0.156" Zoom="1.1" Iterations="150" Color1="#0B122B" Color2="#22D3EE"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                    <Rectangle.Fill>
                        <FractalBrush Fractal="Julia" C="0.285,0.01" Zoom="1.1" Iterations="150" Color1="#1E1B4B" Color2="#F472B6"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                    <Rectangle.Fill>
                        <FractalBrush Fractal="Mandelbrot" Center="-0.5,0" Zoom="0.85" Iterations="200" Color1="#0B1220" Color2="#FDE68A"/>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- New formulas (orthogonal to the Julia/Mandelbrot C-mode above): Burning Ship, Multibrot d=5, Newton. -->
                <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                    <Rectangle.Fill>
                        <FractalBrush Formula="BurningShip" Fractal="Mandelbrot" Center="-0.4,-0.5" Zoom="0.85" Iterations="200" Color1="#0B1220" Color2="#FB7185"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                    <Rectangle.Fill>
                        <FractalBrush Formula="Multibrot" Power="5" Fractal="Mandelbrot" Zoom="0.9" Iterations="180" Color1="#0B1220" Color2="#A78BFA"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                    <Rectangle.Fill>
                        <FractalBrush Formula="Newton" Zoom="0.8" Iterations="60" Color1="#22D3EE" Color2="#F472B6"/>
                    </Rectangle.Fill>
                </Rectangle>
            </WrapPanel>

            <TextBlock Text="Fractal — live (toggle auto-morph, drag every parameter)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <FractalView Width="720" Height="580" CornerRadius="12" Margin="10"
                             Fill="{Binding LiveFractal}"
                             CenterX="{Binding FractalCenterX, Mode=TwoWay}"
                             CenterY="{Binding FractalCenterY, Mode=TwoWay}"
                             ZoomExp="{Binding FractalZoomExp, Mode=TwoWay}"/>
                <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                    <TextBlock Text="Formula" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <DropDown ItemsSource="{Binding FractalFormulas}"
                              SelectedItem="{Binding Formula, Mode=TwoWay}"
                              Width="290" Margin="0 10 0 10"/>
                    <CheckBox Content="Auto-morph (real-time)"
                              IsChecked="{Binding FractalAnimate, Mode=TwoWay}"
                              MarginBottom="6"/>
                    <CheckBox Content="Mandelbrot mode (C = pixel; off = Julia)"
                              IsChecked="{Binding FractalMandelbrot, Mode=TwoWay}"
                              MarginBottom="12"/>
                    <TextBlock Text="Power — Multibrot exponent d" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding FractalPower, Mode=TwoWay}" Minimum="2" Maximum="8" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding PowerText}" Width="52" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="Zoom (log, ×)" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding FractalZoomExp, Mode=TwoWay}" Minimum="-0.52" Maximum="15" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding ZoomText}" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="Iterations" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding FractalIterations, Mode=TwoWay}" Minimum="20" Maximum="400" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding IterationsText}" Width="52" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="Morph speed" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding FractalMorphSpeed, Mode=TwoWay}" Minimum="0" Maximum="4" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding MorphSpeedText}" Width="52" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="C.x (Julia constant)" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding FractalCx, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding CxText}" Width="52" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="C.y (Julia constant)" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding FractalCy, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding CyText}" Width="52" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="Pan X — fine, ×(1/zoom), stays precise deep (drag the fractal for coarse)" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding FractalFineX, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding FineXText}" Width="52" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="Fine pan Y — ×(1/zoom)" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Value="{Binding FractalFineY, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="230"/>
                        <TextBlock Text="{Binding FineYText}" Width="52" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <!-- Colours: right of the controls, in the free zone. Cohesive ColorPickerButton controls - a swatch that
                     reveals the ColorPicker inline (compact when closed), so the editors don't scatter the panel. -->
                <StackPanel Orientation="Vertical" MarginLeft="24" VerticalAlignment="Top">
                    <TextBlock Text="Colours — click a swatch to edit" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="8"/>
                    <TextBlock Text="Color 1 (inside / edge)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton SelectedColor="{Binding FractalColor1, Mode=TwoWay}" Width="200" Height="30" MarginBottom="12"/>
                    <TextBlock Text="Color 2 (escaping outside)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <ColorPickerButton SelectedColor="{Binding FractalColor2, Mode=TwoWay}" Width="200" Height="30"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Drag the fractal to pan, wheel to zoom toward the cursor (built into FractalView)."
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="10,6,0,0"/>

            <TextBlock Text="Gradient interpolation — sRGB vs OKLab (NEW)" FontSize="18" Margin="0,20,0,10"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" MarginRight="24">
                    <TextBlock Text="sRGB — muddy midpoints" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                    <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#FACC15" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="300" Height="40" CornerRadius="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                                <GradientStop Color="#EC4899" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="OKLab — perceptual" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                    <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#FACC15" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="300" Height="40" CornerRadius="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                                <GradientStop Color="#EC4899" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </StackPanel>

            <!-- OKLab on ARBITRARY geometry: a Polygon fill routes through the general-geometry gradient batch, so this
                 proves the interp mode flows there too (left sRGB, right OKLab; same blue->yellow stops). -->
            <TextBlock Text="…and on arbitrary geometry (Polygon) — left sRGB, right OKLab"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginTop="12"
                       MarginBottom="6"/>
            <WrapPanel Orientation="Horizontal">
                <Polygon Points="60,0 120,110 0,110" Margin="10">
                    <Polygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Srgb">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </Polygon.Fill>
                </Polygon>
                <Polygon Points="60,0 120,110 0,110" Margin="10">
                    <Polygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Oklab">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </Polygon.Fill>
                </Polygon>
            </WrapPanel>

            <!-- NINE-SLICE: one 64x64 picture dressing four different sizes. The orange corners are drawn at their own
                 size in all four - that is the whole point; stretching the picture would smear them. The blue edges take
                 the axis they run along, and EdgeMode says whether they stretch (the studs smear) or repeat (the studs
                 keep their rhythm and the last one is cut short). -->
            <TextBlock Text="NineSliceBrush — one picture, any size, corners never distort" FontSize="18" Margin="0,20,0,10"/>
            <TextBlock Text="The source is 64×64 with a 16px frame (Slice = 0.25). Compare with the plain ImageBrush at the end: the same picture stretched."
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginBottom="8"/>
            <WrapPanel Orientation="Horizontal">
                <Border Width="90" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                    </Border.Background>
                    <TextBlock Text="stretched edges" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                        Slice="0.25"
                                        EdgeMode="Repeat"/>
                    </Border.Background>
                    <TextBlock Text="repeated edges" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="240" Height="140" Margin="10">
                    <Border.Background>
                        <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                        Slice="0.25"
                                        EdgeMode="Repeat"
                                        DrawCenter="False"/>
                    </Border.Background>
                    <TextBlock Text="frame only (DrawCenter=False)" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>

            <TextBlock Text="…and the same picture as a plain ImageBrush — stretched, corners and all"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MarginTop="12"
                       MarginBottom="6"/>
            <WrapPanel Orientation="Horizontal">
                <Border Width="90" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png"/>
                    </Border.Background>
                </Border>
                <Border Width="240" Height="90" Margin="10">
                    <Border.Background>
                        <ImageBrush Source="Textures/nine-slice-frame.png" Tint="#66FF88"/>
                    </Border.Background>
                    <TextBlock Text="tinted" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>

            <TextBlock Text="Opacity (whole subtree) vs SelfOpacity (this element only)" FontSize="18" Margin="0,20,0,10"/>
            <WrapPanel Orientation="Horizontal">
                <Border Width="150" Height="96" CornerRadius="14" Margin="10" Background="#3B82F6">
                    <TextBlock Text="baseline" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="150" Height="96" CornerRadius="14" Margin="10" Background="#3B82F6" Opacity="0.35">
                    <TextBlock Text="Opacity 0.35" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="150" Height="96" CornerRadius="14" Margin="10" Background="#3B82F6" SelfOpacity="0.35">
                    <TextBlock Text="SelfOpacity 0.35" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</View>
