<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.Game.Sandbox.Converters"
      xmlns:app="clr-namespace:Adamantium.Game.Sandbox">
    <ResourceContext.Resources>
        <DataTemplate x:Key="RectTileTemplate">
            <Rectangle Fill="{Binding Color, Converter={conv:StringToBrushConverter}}"
                       CornerRadius="10"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3"/>
        </DataTemplate>

        <DataTemplate x:Key="EllipseTileTemplate">
            <Ellipse Fill="{Binding Color, Converter={conv:StringToBrushConverter}}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3"/>
        </DataTemplate>
    </ResourceContext.Resources>
    <!-- DataContext is the LayoutViewModel. A big virtualized, wrapping, scrolling grid of filled tiles whose cell WIDTH and
         HEIGHT are driven by two independent sliders (bound to the WrapPanel), so the aspect ratio is adjustable. The
         "Ellipses" toggle flips ShowEllipses; a DataTrigger then swaps ItemTemplate between the two templates that live in
         LayoutResources (AUML) - a rounded RECTANGLE (RectBatch SDF) or an ELLIPSE (EllipseBatch SDF). Both are SDF, so this
         is the live check that the ellipse SDF renders a real ellipse (rx != ry) crisply at any aspect. The resource
         dictionary is linked into the Local scope above, so it lives only while this tab is open. (Stroke/Pen playground
         moved to the Shapes tab - here we keep just size + template.) -->
    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Width:" VerticalAlignment="Center"/>
            <Slider Width="180" Minimum="24" Maximum="240" Value="{Binding CellWidth, Mode=TwoWay}" Margin="8,0,0,0"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding CellWidth}" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <TextBlock Text="Height:" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Slider Width="180" Minimum="24" Maximum="240" Value="{Binding CellHeight, Mode=TwoWay}" Margin="8,0,0,0"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding CellHeight}" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <CheckBox Content="Ellipses" IsChecked="{Binding ShowEllipses, Mode=TwoWay}" VerticalAlignment="Center" Margin="24,0,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="0 14 0 0"
                 ItemsSource="{Binding Rectangles}"
                 SelectedItem="{Binding SelectedRect, Mode=TwoWay}">
            <!-- The base template (rounded rectangle) is a Setter, NOT a local ItemTemplate attribute: a local value
                 (priority Local=1) would outrank the DataTrigger's Setter (Trigger=3) and the toggle could never swap it.
                 As a Setter (Style=5) the trigger wins while ShowEllipses is true (-> ellipses) and falls back to the
                 rectangle when it's false. Changing the effective ItemTemplate regenerates the containers. -->
            <ListBox.Styles>
                <Style Selector="ListBox">
                    <Setter Property="ItemTemplate" Value="{ResourceReference RectTileTemplate}"/>
                    <DataTrigger Binding="{Binding ShowEllipses}" Value="true">
                        <Setter Property="ItemTemplate" Value="{ResourceReference EllipseTileTemplate}"/>
                    </DataTrigger>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemContainerStyle>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               ItemWidth="{Binding CellWidth}"
                               ItemHeight="{Binding CellHeight}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</View>
