<View x:KeepAlive="Required"
      xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.Game.Sandbox.Converters"
      xmlns:app="clr-namespace:Adamantium.Game.Sandbox">
    <ResourceContext.Resources>
        <DataTemplate x:Key="RectTileTemplate">
            <Rectangle Fill="{Binding Color, Converter={conv:StringToBrushConverter}}"
                       CornerRadius="10"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3"/>
        </DataTemplate>

        <DataTemplate x:Key="EllipseTileTemplate">
            <Ellipse Fill="{Binding Color, Converter={conv:StringToBrushConverter}}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3"/>
        </DataTemplate>
    </ResourceContext.Resources>
    <!-- DataContext is the LayoutViewModel. A big virtualized, wrapping, scrolling grid of filled tiles whose cell WIDTH and
         HEIGHT are driven by two independent sliders (bound to the WrapPanel), so the aspect ratio is adjustable. The
         "Ellipses" toggle flips ShowEllipses; a DataTrigger then swaps ItemTemplate between the two templates that live in
         LayoutResources (AUML) - a rounded RECTANGLE (RectBatch SDF) or an ELLIPSE (EllipseBatch SDF). Both are SDF, so this
         is the live check that the ellipse SDF renders a real ellipse (rx != ry) crisply at any aspect. The resource
         dictionary is linked into the Local scope above, so it lives only while this tab is open. (Stroke/Pen playground
         moved to the Shapes tab - here we keep just size + template.) -->
    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Width:" VerticalAlignment="Center"/>
            <Slider Width="180" Minimum="24" Maximum="240" Value="{Binding CellWidth, Mode=TwoWay}" Margin="8,0,0,0"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding CellWidth}" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <TextBlock Text="Height:" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Slider Width="180" Minimum="24" Maximum="240" Value="{Binding CellHeight, Mode=TwoWay}" Margin="8,0,0,0"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding CellHeight}" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <CheckBox Content="Ellipses" IsChecked="{Binding ShowEllipses, Mode=TwoWay}" VerticalAlignment="Center" Margin="24,0,0,0"/>

            <!-- The bind budget, live. 0 = no budget at all (one honest pass), higher = smaller slices. Fixed-width
                 readout for the same reason as the opacity one below: a changing string re-measures the row. -->
            <TextBlock Text="Bind ms:" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <Slider Width="140" Minimum="0" Maximum="32" Margin="8,0,0,0"
                    Value="{Binding BindBudgetMs, Mode=TwoWay}"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding BindBudgetMs}" Width="36" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <!-- Fades the WHOLE tile grid by hand. Element Opacity composites down the tree, and the cost of that is the
                 point of this control: the value goes into the subtree's opacity SLOT, so dragging this should not cost
                 the frame anything however many tiles are on screen. Bound straight to the ListBox below by name - no
                 view-model property, because what is being watched is the renderer, not the binding. -->
            <TextBlock Text="Opacity:" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <Slider Width="180" Minimum="0" Maximum="1" Margin="8,0,0,0"
                    Value="{Binding Opacity, ElementName=TileGrid, Mode=TwoWay}"/>
            <!-- FIXED width on purpose. The text changes on every step of the drag ("0.55" -> "0.5" -> "0.475"), and a
                 different string is a different desired size - which re-measures the row, then the Grid, then the tile
                 grid under it. Measured at a 94 ms layout peak while dragging: the readout, not the opacity, was the
                 cost. A fixed width keeps the desired size constant, so the change stops at this element. -->
            <TextBlock Text="{Binding Opacity, ElementName=TileGrid}" Width="56"
                       VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="TileGrid"
                 Margin="0 14 0 0"
                 ItemsSource="{Binding Rectangles}"
                 SelectedItem="{Binding SelectedRect, Mode=TwoWay}">
            <!-- The base template (rounded rectangle) is a Setter, NOT a local ItemTemplate attribute: a local value
                 (priority Local=1) would outrank the DataTrigger's Setter (Trigger=3) and the toggle could never swap it.
                 As a Setter (Style=5) the trigger wins while ShowEllipses is true (-> ellipses) and falls back to the
                 rectangle when it's false. Changing the effective ItemTemplate regenerates the containers. -->
            <ListBox.Styles>
                <Style Selector="ListBox">
                    <Setter Property="ItemTemplate" Value="{ResourceReference RectTileTemplate}"/>
                    <DataTrigger Binding="{Binding ShowEllipses}" Value="true">
                        <Setter Property="ItemTemplate" Value="{ResourceReference EllipseTileTemplate}"/>
                    </DataTrigger>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemContainerStyle>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- ScrollBindBudget is how many milliseconds ONE pass may spend (re)binding containers while the
                         list is scrolling; whatever does not fit is deferred and shows a skeleton. 0 means no budget -
                         bind the whole window in one pass. It is a dial here on purpose: measured on this very tab, 6 ms
                         binds ~357 slots a pass and defers ~4487, so on a big window the panel never catches up, while on
                         a small one binding everything at once is simply better. Drag the slider above to the minimum
                         cell, then move this one, and the difference between a smooth dribble and one honest pass is
                         visible without any instrument. -->
                    <WrapPanel Orientation="Horizontal"
                               ItemWidth="{Binding CellWidth}"
                               ItemHeight="{Binding CellHeight}"
                               ScrollBindBudget="{Binding BindBudgetMs}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</View>
