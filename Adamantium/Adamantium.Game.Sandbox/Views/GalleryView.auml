<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:vm="clr-namespace:Adamantium.Game.Sandbox.ViewModels"
      xmlns:app="clr-namespace:Adamantium.Game.Sandbox"
      xmlns:controls="clr-namespace:Adamantium.UI.Controls;assembly=Adamantium.UI.Controls"
      x:ViewModel="{x:Type vm:GalleryViewModel}">

    <Grid RowDefinitions="Auto,*" Margin="16">
        <!-- Enum-bound DropDown that moves the tab strip to any edge live (exercises TabControl.TabStripPlacement). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Tab strip placement:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DropDown EnumType="{x:Type controls:TabStripPlacement}"
                      SelectedItem="{Binding TabPlacement, Mode=TwoWay}"
                      Width="140"/>
        </StackPanel>

        <!-- Data-driven tabs: the TabControl binds to the root view-model's Tabs collection. Each tab's header comes from
             the ItemTemplate ({Binding Header}); its body is chosen by the TabViewSelector, which maps each tab view-model
             to its View. No per-tab wiring in markup - add a tab by adding its view-model to GalleryViewModel.Tabs. -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    TabStripPlacement="{Binding TabPlacement}"
                    ShowCloseButton="True">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" VerticalTextAlignment="Center"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplateSelector>
                <app:TabViewSelector/>
            </TabControl.ContentTemplateSelector>
        </TabControl>
    </Grid>
</View>
