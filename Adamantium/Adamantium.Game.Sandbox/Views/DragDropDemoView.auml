<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <StackPanel Orientation="Vertical" Margin="24">

        <TextBlock Text="Drag &amp; Drop (in-window)" FontSize="20" MarginBottom="4"/>
        <TextBlock Text="Press an item and move past the threshold: it bakes into a ghost that follows the cursor (a real layered OS window). Release over a panel to drop - the panel's DropCommand moves the item in the view-model and the lists rebind."
                   FontSize="13"
                   Foreground="{ResourceReference TextFillColorSecondary}"
                   MaxWidth="760"
                   MarginBottom="12"/>

        <Button Content="Open drop window (cross-window test)" Command="{Binding OpenDropWindowCommand}"
                Width="280" Height="32" HorizontalAlignment="Left" MarginBottom="18"/>

        <StackPanel Orientation="Horizontal">

            <Border Background="#FF141C28" CornerRadius="8" Padding="12" Width="220" MinHeight="300" MarginRight="16"
                    DragDrop.AllowDrop="True" DragDrop.DropCommand="{Binding DropLeftCommand}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Fruits" Foreground="#FFE0B040" MarginBottom="10"/>
                    <ListBox ItemsSource="{Binding Left}" SelectedItems="{Binding LeftSelection}"
                             SelectionMode="Extended" Background="Transparent" MaxHeight="240">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF2E3B4E" CornerRadius="6" Padding="10" MarginBottom="6"
                                        DragDrop.AllowDrag="True" DragDrop.DragData="{Binding}"
                                        DragDrop.DragStartedCommand="{Ancestor ItemsControl, DataContext.DragStartedCommand}"
                                        DragDrop.DragCompletedCommand="{Ancestor ItemsControl, DataContext.DragCompletedCommand}">
                                    <TextBlock Text="{Binding}" Foreground="#FFFFFFFF"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Background="#FF141C28" CornerRadius="8" Padding="12" Width="220" MinHeight="300"
                    DragDrop.AllowDrop="True" DragDrop.DropCommand="{Binding DropRightCommand}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Animals" Foreground="#FF40C0E0" MarginBottom="10"/>
                    <ListBox ItemsSource="{Binding Right}" SelectedItems="{Binding RightSelection}"
                             SelectionMode="Extended" Background="Transparent" MaxHeight="240">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF2E3B4E" CornerRadius="6" Padding="10" MarginBottom="6"
                                        DragDrop.AllowDrag="True" DragDrop.DragData="{Binding}"
                                        DragDrop.DragStartedCommand="{Ancestor ItemsControl, DataContext.DragStartedCommand}"
                                        DragDrop.DragCompletedCommand="{Ancestor ItemsControl, DataContext.DragCompletedCommand}">
                                    <TextBlock Text="{Binding}" Foreground="#FFFFFFFF"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </StackPanel>
</View>
