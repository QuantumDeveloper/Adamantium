<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:m="clr-namespace:Adamantium.UI.Core.Media;assembly=Adamantium.UI.Core">
    <!-- DataContext is the ShapesViewModel. ONE Stroke settings object drives the stroke of EVERY shape in the gallery
         and the big preview - the pen panel (thickness/dashes/trim/corner/cap/join/colour) retraces them all at once.
         Wrapped in a ScrollViewer (horizontal Disabled so the WrapPanels wrap to the viewport). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Vertical" Margin="24">

        <!-- Shape gallery: every shape (incl. the Bézier + NURBS curves) binds its stroke off Stroke.*, so the pen panel
             below drives ALL of them - not just the rect+ellipse preview. Fills stay per-shape; the curves are stroke-only. -->
        <TextBlock Text="Shape gallery — every shape's stroke is driven by the pen panel below:" Margin="0,0,0,6"/>
        <WrapPanel Orientation="Horizontal">
            <Ellipse Width="96" Height="96" Fill="#3B82F6" Margin="10"
                     Stroke="{Binding Stroke.StrokeBrush}" StrokeThickness="{Binding Stroke.StrokeWidth}"
                     StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                     StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                     StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                     StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
            <Rectangle Width="120" Height="90" Fill="#22C55E" Margin="10" CornerRadius="{Binding Stroke.CornerRadius}"
                     Stroke="{Binding Stroke.StrokeBrush}" StrokeThickness="{Binding Stroke.StrokeWidth}"
                     StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                     StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                     StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                     StrokeLineJoin="{Binding Stroke.Join}"
                     StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
            <Polygon Points="60,0 120,96 0,96" Fill="#F59E0B" Margin="10"
                     Stroke="{Binding Stroke.StrokeBrush}" StrokeThickness="{Binding Stroke.StrokeWidth}"
                     StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                     StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                     StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                     StrokeLineJoin="{Binding Stroke.Join}"
                     StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
            <Path Fill="Magenta" Width="200" Height="200" Margin="10"
                  Data="F0 M110,10 L168.78,190.9 L14.89,79.1 L205.11,79.1 L51.22,190.9 Z"
                  Stroke="{Binding Stroke.StrokeBrush}" StrokeThickness="{Binding Stroke.StrokeWidth}"
                  StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                  StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                  StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                  StrokeLineJoin="{Binding Stroke.Join}"
                  StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
          <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Cubic Bézier" HorizontalAlignment="Center" MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <CubicBezierCurve Width="240" Height="160" Samples="{Binding Stroke.Samples}"
                     StartPoint="15,140" ControlPoint1="75,10" ControlPoint2="165,150" EndPoint="225,20"
                     Stroke="{Binding Stroke.StrokeBrush}" StrokeThickness="{Binding Stroke.StrokeWidth}"
                     StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                     StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                     StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                     StrokeLineJoin="{Binding Stroke.Join}"
                     StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
          </StackPanel>
            <!-- Quadratic Bézier curve (open, stroke-only). -->
          <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Quadratic Bézier" HorizontalAlignment="Center" MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <QuadraticBezierCurve Width="220" Height="150"
                                  Samples="{Binding Stroke.Samples}"
                                    StartPoint="10,130" 
                                  ControlPoint="110,-10" 
                                  EndPoint="210,130"
                     Stroke="{Binding Stroke.StrokeBrush}" 
                                  StrokeThickness="{Binding Stroke.StrokeWidth}"
                     StrokeDashSymbols="{Binding Stroke.DashSymbols}" 
                                  StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                     StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                     StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" 
                                  StartLineCap="{Binding Stroke.StartCap}" 
                                  EndLineCap="{Binding Stroke.EndCap}"
                     StrokeLineJoin="{Binding Stroke.Join}"
                     StrokeTrimStart="{Binding Stroke.TrimStart}"
                                  StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
          </StackPanel>
            <!-- NURBS curve (open, stroke-only). -->
          <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="NURBS" HorizontalAlignment="Center" MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <Nurbs Width="300" Height="160" Samples="{Binding Stroke.Samples}"
                     IsUniform="{Binding Stroke.NurbsUniform}" Degree="{Binding Stroke.NurbsDegree}"
                     Weights="{Binding Stroke.NurbsWeights}"
                     Points="10,140 60,20 130,20 180,140 250,140 290,30"
                     Stroke="{Binding Stroke.StrokeBrush}" StrokeThickness="{Binding Stroke.StrokeWidth}"
                     StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                     StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                     StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                     StrokeLineJoin="{Binding Stroke.Join}"
                     StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
          </StackPanel>
            <!-- B-spline curve (open, stroke-only). -->
          <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="B-spline" HorizontalAlignment="Center" MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <BSpline Width="300" Height="160"
                     Samples="{Binding Stroke.Samples}"
                     Degree="{Binding Stroke.NurbsDegree}" IsUniform="{Binding Stroke.NurbsUniform}"
                     Points="10,140 60,20 130,20 180,140 250,140 290,30"
                     Stroke="{Binding Stroke.StrokeBrush}" 
                     StrokeThickness="{Binding Stroke.StrokeWidth}"
                     StrokeDashSymbols="{Binding Stroke.DashSymbols}" 
                     StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                     StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                     StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" 
                     StartLineCap="{Binding Stroke.StartCap}" 
                     EndLineCap="{Binding Stroke.EndCap}"
                     StrokeLineJoin="{Binding Stroke.Join}"
                     StrokeTrimStart="{Binding Stroke.TrimStart}"
                     StrokeTrimEnd="{Binding Stroke.TrimEnd}"/>
          </StackPanel>
        </WrapPanel>

        <!-- The pen playground. Thickness/dash/trim/corner are sliders; Cap and Join are enum DropDowns; Colour is a
             ColorPicker (compact button that opens the full HSV picker). Everything mutates the one Stroke object above. -->
        <TextBlock Text="Stroke / Pen parameters:" Margin="0,20,0,6"/>
        <Grid ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Thickness" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="30" Value="{Binding Stroke.StrokeWidth, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.StrokeWidth}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Dash on" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding Stroke.DashOn, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.DashOn}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Dash gap" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding Stroke.DashGap, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.DashGap}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Dash offset" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="60" Value="{Binding Stroke.DashOffset, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.DashOffset}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Trim start" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="1" Value="{Binding Stroke.TrimStart, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.TrimStart}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Trim end" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="1" Value="{Binding Stroke.TrimEnd, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.TrimEnd}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Corner" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="60" Value="{Binding Stroke.Corner, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.Corner}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Samples" Width="80" VerticalAlignment="Center"/>
                        <Slider Width="130" Minimum="0" Maximum="50" Value="{Binding Stroke.Samples, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Stroke.Samples}" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <!-- Four caps, kept apart on purpose. Start/End are the ends of the WHOLE stroke; the two dash caps
                         are the two ends of every dash. Bound to one setting they were indistinguishable, which is
                         precisely why the way they interact at the first and last dash went unexamined. Setting the two
                         dash caps DIFFERENTLY (concave behind, convex tip in front) turns each dash into an arrowhead. -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Dash start" Width="80" VerticalAlignment="Center"/>
                        <DropDown Width="176" EnumType="{x:Type m:PenLineCap}" SelectedItem="{Binding Stroke.DashStartCap, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Dash end" Width="80" VerticalAlignment="Center"/>
                        <DropDown Width="176" EnumType="{x:Type m:PenLineCap}" SelectedItem="{Binding Stroke.DashEndCap, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Start cap" Width="80" VerticalAlignment="Center"/>
                        <DropDown Width="176" EnumType="{x:Type m:PenLineCap}" SelectedItem="{Binding Stroke.StartCap, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="End cap" Width="80" VerticalAlignment="Center"/>
                        <DropDown Width="176" EnumType="{x:Type m:PenLineCap}" SelectedItem="{Binding Stroke.EndCap, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Join" Width="80" VerticalAlignment="Center"/>
                        <DropDown Width="176" EnumType="{x:Type m:PenLineJoin}" SelectedItem="{Binding Stroke.Join, Mode=TwoWay}"/>
                    </StackPanel>
                    <!-- A closed contour's perimeter almost never divides by the dash period, and the remainder lands
                         at the seam (for a rounded rect, its bottom-right corner - where the arc length starts). This
                         stretches the pattern to a whole number of periods so the ring closes on itself. -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Dash fit" Width="80" VerticalAlignment="Center"/>
                        <ToggleSwitch IsChecked="{Binding Stroke.DashFit, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Color" Width="80" VerticalAlignment="Center"/>
                        <ColorPickerButton Width="176" Height="28" SelectedColor="{Binding Stroke.SelectedColor, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Rectangle Width="160" Height="120" Fill="#1E293B" Stroke="{Binding Stroke.StrokeBrush}"
                           CornerRadius="{Binding Stroke.CornerRadius}"
                           StrokeThickness="{Binding Stroke.StrokeWidth}"
                           StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                           StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                           StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                           StrokeLineJoin="{Binding Stroke.Join}"
                           StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <Ellipse Width="160" Height="120" Fill="#1E293B" Stroke="{Binding Stroke.StrokeBrush}"
                         StrokeThickness="{Binding Stroke.StrokeWidth}"
                         StrokeDashSymbols="{Binding Stroke.DashSymbols}" StrokeDashGlyphs="{Binding Stroke.DashGlyphs}"
                         StrokeDashOffset="{Binding Stroke.DashOffset}" StrokeDashFit="{Binding Stroke.DashFit}"
                         StrokeDashStartCap="{Binding Stroke.DashStartCap}" StrokeDashEndCap="{Binding Stroke.DashEndCap}" StartLineCap="{Binding Stroke.StartCap}" EndLineCap="{Binding Stroke.EndCap}"
                         StrokeTrimStart="{Binding Stroke.TrimStart}" StrokeTrimEnd="{Binding Stroke.TrimEnd}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- NURBS playground: weights + degree + knot-uniformity are exactly what a plain B-spline lacks. Drag Weight and
             the NURBS bulges toward its two peak control points; raise Degree for a smoother/looser curve; toggle Uniform
             knots. The B-spline (same control points) stays fixed for comparison. -->
        <TextBlock Text="NURBS parameters (a B-spline has none of these):" Margin="0,20,0,6"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Weight" Width="60" VerticalAlignment="Center"/>
            <Slider Width="130" Minimum="0.1" Maximum="10" Value="{Binding Stroke.NurbsWeight, Mode=TwoWay}"/>
            <TextBlock Text="{Binding Stroke.NurbsWeight}" Width="40" VerticalAlignment="Center" Margin="6,0,24,0"/>
            <TextBlock Text="Degree" Width="60" VerticalAlignment="Center"/>
            <Slider Width="100" Minimum="1" Maximum="5" Value="{Binding Stroke.NurbsDegree, Mode=TwoWay}"/>
            <TextBlock Text="{Binding Stroke.NurbsDegree}" Width="30" VerticalAlignment="Center" Margin="6,0,24,0"/>
            <TextBlock Text="Uniform" Width="60" VerticalAlignment="Center"/>
            <ToggleSwitch IsChecked="{Binding Stroke.NurbsUniform, Mode=TwoWay}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Border showcase: uniform + non-uniform thickness, sharp + rounded corners, all with TRANSLUCENT fills and
             brushes (the alpha composites over whatever is behind). Left-to-right: uniform | non-uniform thickness |
             single-side accent | thick non-uniform sharp | thin non-uniform rounded | thin non-uniform sharp. -->
        <TextBlock Text="Borders — non-uniform thickness &amp; translucent brushes:" Margin="0,20,0,6"/>
        <WrapPanel Orientation="Horizontal">
            <Border Width="120" Height="80" Margin="8" Background="#30FFFFFF" BorderBrush="#803B82F6" BorderThickness="4" CornerRadius="12"/>
            <Border Width="120" Height="80" Margin="8" Background="#30FFFFFF" BorderBrush="#803B82F6" BorderThickness="2,6,10,14" CornerRadius="12"/>
            <Border Width="120" Height="80" Margin="8" Background="#303B82F6" BorderBrush="#B0F59E0B" BorderThickness="0,0,0,10"/>
            <Border Width="120" Height="80" Margin="8" Background="#20000000" BorderBrush="#90EF4444" BorderThickness="12,3,12,3"/>
            <!-- Thin non-uniform rings (~1px per side). -->
            <Border Width="120" Height="80" Margin="8" Background="#30FFFFFF" BorderBrush="#C03B82F6" BorderThickness="1,2,1,2" CornerRadius="10"/>
            <Border Width="120" Height="80" Margin="8" Background="#30FFFFFF" BorderBrush="#C0EF4444" BorderThickness="1,1,2,1" CornerRadius="0"/>
        </WrapPanel>

        <!-- Animated dashed outline (hover to trace it) - moved from the old MainWindow demo. -->
        <TextBlock Text="Hover the line to animate its dash:" Margin="0,16,0,6"/>
        <Line X1="0" Y1="0" X2="360" Y2="0"
              Stroke="Lime" StrokeThickness="10"
              StrokeDashArray="36 25"
              StartLineCap="ConvexRound" EndLineCap="ConvexRound" StrokeDashStartCap="ConvexRound" StrokeDashEndCap="ConvexRound"
              HorizontalAlignment="Left">
            <Line.Triggers>
                <PropertyTrigger Property="IsMouseOver" Value="true">
                    <PropertyTrigger.EnterActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:2.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="550"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.EnterActions>
                    <PropertyTrigger.ExitActions>
                        <RunAnimationAction>
                            <Animation Duration="0:0:2.2" Easing="CubicOut">
                                <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="550"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                            </Animation>
                        </RunAnimationAction>
                    </PropertyTrigger.ExitActions>
                </PropertyTrigger>
            </Line.Triggers>
        </Line>
    </StackPanel>
    </ScrollViewer>
</View>
