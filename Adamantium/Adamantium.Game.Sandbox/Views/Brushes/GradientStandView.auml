<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.Game.Sandbox.Converters">
    <!-- One of the brushes tab's stands, navigated into its region under the key "Gradients". The DataContext is the
         tab's own view-model - the locator sets it - so every binding here reads exactly as it did when this markup
         lived on the tab, and leaving the stand drops this view instead of leaving it hidden. -->
    <StackPanel Orientation="Vertical">

        <!-- THE LIVE ONE. The rows on the tab are fixed samples; this is the same three brushes with one set of stops
             driving all of them, so switching the kind changes the GEOMETRY and nothing else. -->
        <TextBlock Text="Gradient — live (one set of stops, three geometries)" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" MarginBottom="24">
            <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Margin="10">
                <Rectangle Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Fill="{Binding LiveGradient}"
                           CornerRadius="{Binding GradientCorner, Converter={conv:DoubleToCornerRadiusConverter}}"
                           Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Rectangle}"/>
                <Ellipse Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Fill="{Binding LiveGradient}"
                         Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Ellipse}"/>
                <RegularPolygon Width="{Binding PreviewSquare}" Height="{Binding PreviewSquare}" Corners="{Binding ShapeCornerCount}"
                                StartAngle="{Binding ShapeStartAngle}" Fill="{Binding LiveGradient}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Polygon}"/>
                <Polygon Points="{Binding FixedStar}" Fill="{Binding LiveGradient}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Star}"/>
            </Grid>
            <StackPanel Orientation="Vertical" Width="330" MarginLeft="16" VerticalAlignment="Center">
                <TextBlock Text="Geometry" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown ItemsSource="{Binding GradientKinds}" SelectedItem="{Binding GradientKind, Mode=TwoWay}" Width="300" MarginBottom="10"/>

                <!-- Only the linear one runs along a direction; on the other two an angle would mean nothing. -->
                <StackPanel Orientation="Vertical" Visibility="{Binding GradientKind, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Linear}">
                    <TextBlock Text="Direction — degrees" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding GradientAngle, Mode=TwoWay}" Minimum="0" Maximum="360" IsMoveToPointEnabled="true" Width="190"/>
                        <NumericUpDown Width="96" Minimum="0" Maximum="360" SmallChange="1" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding GradientAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8"/>
                    </StackPanel>
                    <TextBlock Text="Span — shorten it to see Reflect and Repeat" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding GradientSpan, Mode=TwoWay}" Minimum="0.1" Maximum="1" IsMoveToPointEnabled="true" Width="190"/>
                        <NumericUpDown Width="96" Minimum="0.1" Maximum="1" SmallChange="0.05" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding GradientSpan, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Vertical" Visibility="{Binding GradientKind, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Radial}">
                    <TextBlock Text="Radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding GradientRadius, Mode=TwoWay}" Minimum="0.05" Maximum="1" IsMoveToPointEnabled="true" Width="190"/>
                        <NumericUpDown Width="96" Minimum="0.05" Maximum="1" SmallChange="0.05" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding GradientRadius, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Vertical" Visibility="{Binding GradientKind, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Conic}">
                    <TextBlock Text="Start angle — where the sweep begins" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding GradientStartAngle, Mode=TwoWay}" Minimum="0" Maximum="360" IsMoveToPointEnabled="true" Width="190"/>
                        <NumericUpDown Width="96" Minimum="0" Maximum="360" SmallChange="1" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding GradientStartAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Only the rectangle has corners to round; on the other figures the number would drive nothing. -->
                <StackPanel Orientation="Vertical" Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Rectangle}">
                    <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="8">
                        <Slider Value="{Binding GradientCorner, Mode=TwoWay}" Minimum="0" Maximum="120" IsMoveToPointEnabled="true" Width="190"/>
                        <NumericUpDown Width="96" Minimum="0" Maximum="120" SmallChange="1" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding GradientCorner, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Outside the stops" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown ItemsSource="{Binding GradientSpreads}" SelectedItem="{Binding GradientSpread, Mode=TwoWay}" Width="300" MarginBottom="10"/>

                <TextBlock Text="Interpolated in" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown ItemsSource="{Binding GradientInterpolations}" SelectedItem="{Binding GradientInterpolation, Mode=TwoWay}" Width="300" MarginBottom="10"/>

                <TextBlock Text="Stops — start / end, and an optional middle" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding GradientColor1, Mode=TwoWay}" MarginRight="8"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding GradientColor3, Mode=TwoWay}" MarginRight="8"/>
                    <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding GradientColor2, Mode=TwoWay}"/>
                </StackPanel>
                <CheckBox Content="Middle stop" IsChecked="{Binding GradientMidStop, Mode=TwoWay}" MarginBottom="6"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding GradientMidOffset, Mode=TwoWay}" Minimum="0.05" Maximum="0.95" IsMoveToPointEnabled="true" Width="190"/>
                    <NumericUpDown Width="96" Minimum="0.05" Maximum="0.95" SmallChange="0.05" StringFormat="N2"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding GradientMidOffset, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- The authored reference rows belong to THIS stand: the live panel above drives one brush, and these are the
             fixed cases it can be compared against - every geometry, every spread method, both interpolation spaces. -->
        <TextBlock Text="Linear gradients — rectangles" FontSize="18" Margin="0,20,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <!-- diagonal, 3 stops -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="0.5"/>
                        <GradientStop Color="#EC4899" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- horizontal -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#22C55E" Offset="0"/>
                        <GradientStop Color="#EAB308" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- vertical, with a stroke -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10" Stroke="White" StrokeThickness="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#EF4444" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </WrapPanel>

        <TextBlock Text="Radial gradients — rectangles" FontSize="18" Margin="0,20,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <!-- centred spotlight -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#FDE68A" Offset="0"/>
                        <GradientStop Color="#F59E0B" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- off-centre focal (top-left highlight) -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.3,0.28" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#A7F3D0" Offset="0"/>
                        <GradientStop Color="#14B8A6" Offset="0.6"/>
                        <GradientStop Color="#0F766E" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </WrapPanel>

        <TextBlock Text="Conic gradients — angular sweep" FontSize="18" Margin="0,20,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <!-- full-spectrum sweep (a colour wheel's hue): start at top, clockwise; last stop meets the first -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <ConicGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </ConicGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- two-colour sweep rotated to start from the right (StartAngle 90) -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <ConicGradientBrush Center="0.5,0.5" StartAngle="90">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#38BDF8" Offset="0.5"/>
                        <GradientStop Color="#1E293B" Offset="1"/>
                    </ConicGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- pie chart: hard segments (a stop doubled at each boundary) -->
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <ConicGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#EF4444" Offset="0"/>
                        <GradientStop Color="#EF4444" Offset="0.25"/>
                        <GradientStop Color="#22C55E" Offset="0.25"/>
                        <GradientStop Color="#22C55E" Offset="0.6"/>
                        <GradientStop Color="#3B82F6" Offset="0.6"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </ConicGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- conic on a circle = a proper colour wheel -->
            <Ellipse Width="140" Height="140" Margin="10">
                <Ellipse.Fill>
                    <ConicGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </ConicGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </WrapPanel>

        <TextBlock Text="Gradients — ellipses" FontSize="18" Margin="0,20,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <Ellipse Width="120" Height="120" Margin="10">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.35,0.32" RadiusX="0.55" RadiusY="0.55">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="0.7"/>
                        <GradientStop Color="#1E3A8A" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="160" Height="110" Margin="10" Stroke="#40FFFFFF" StrokeThickness="2">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EC4899" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </WrapPanel>

        <TextBlock Text="Gradients — arbitrary shapes (Polygon / Path)" FontSize="18" Margin="0,20,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <RegularPolygon Width="120" Height="120" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                <RegularPolygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F472B6" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="1"/>
                    </LinearGradientBrush>
                </RegularPolygon.Fill>
            </RegularPolygon>
            <Polygon Points="60,0 75,45 120,45 84,72 96,116 60,90 24,116 36,72 0,45 45,45" Margin="10">
                <Polygon.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.4" RadiusX="0.55" RadiusY="0.55">
                        <GradientStop Color="#FEF08A" Offset="0"/>
                        <GradientStop Color="#F59E0B" Offset="0.6"/>
                        <GradientStop Color="#B45309" Offset="1"/>
                    </RadialGradientBrush>
                </Polygon.Fill>
            </Polygon>
            <Path Data="F0 M110,10 L168.78,190.9 L14.89,79.1 L205.11,79.1 L51.22,190.9 Z" Width="200" Height="200" Margin="10">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22D3EE" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="0.5"/>
                        <GradientStop Color="#1E1B4B" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </WrapPanel>

        <TextBlock Text="Spread method — Pad / Reflect / Repeat (stops span 0..0.5)" FontSize="18" Margin="0,20,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Pad">
                        <GradientStop Color="#0EA5E9" Offset="0"/>
                        <GradientStop Color="#111827" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Reflect">
                        <GradientStop Color="#0EA5E9" Offset="0"/>
                        <GradientStop Color="#111827" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="150" Height="96" CornerRadius="14" Margin="10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5" SpreadMethod="Repeat">
                        <GradientStop Color="#0EA5E9" Offset="0"/>
                        <GradientStop Color="#111827" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </WrapPanel>

        <TextBlock Text="Gradient interpolation — sRGB vs OKLab" FontSize="18" Margin="0,20,0,10"/>
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical" MarginRight="24">
                <TextBlock Text="sRGB — muddy midpoints" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="300" Height="40" CornerRadius="8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Srgb">
                            <GradientStop Color="#EC4899" Offset="0"/>
                            <GradientStop Color="#22C55E" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="OKLab — perceptual" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="4"/>
                <Rectangle Width="300" Height="40" CornerRadius="8" MarginBottom="8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#FACC15" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="300" Height="40" CornerRadius="8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" ColorInterpolationMode="Oklab">
                            <GradientStop Color="#EC4899" Offset="0"/>
                            <GradientStop Color="#22C55E" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>
        </StackPanel>

        <!-- OKLab on ARBITRARY geometry: a Polygon fill routes through the general-geometry gradient batch, so this
             proves the interp mode flows there too (left sRGB, right OKLab; same blue->yellow stops). -->
        <TextBlock Text="…and on arbitrary geometry (Polygon) — left sRGB, right OKLab"
                   Foreground="{ResourceReference TextFillColorSecondary}"
                   MarginTop="12"
                   MarginBottom="6"/>
        <WrapPanel Orientation="Horizontal">
            <RegularPolygon Width="110" Height="110" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                <RegularPolygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Srgb">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#FACC15" Offset="1"/>
                    </LinearGradientBrush>
                </RegularPolygon.Fill>
            </RegularPolygon>
            <RegularPolygon Width="110" Height="110" Corners="{Binding ShapeCornerCount}" StartAngle="{Binding ShapeStartAngle}" Margin="10">
                <RegularPolygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" ColorInterpolationMode="Oklab">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#FACC15" Offset="1"/>
                    </LinearGradientBrush>
                </RegularPolygon.Fill>
            </RegularPolygon>
        </WrapPanel>
    </StackPanel>
</View>
