<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.Game.Sandbox.Converters">
    <!-- Navigated into the brushes tab's region under the key "Image"; the DataContext is the tab's own view-model.
         This stand keeps its OWN width and height: they are what it demonstrates - how a tiling survives a resize. -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="ImageBrush — live (tile it, mirror it, or fit one copy)" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Border Width="360" Height="240" Margin="10" Background="#101418">
                <!-- The BOX is the sliders, not whatever the figure happens to measure: a figure that keeps its
                     proportions never fills both axes, and letting the box follow it makes the figure slide along
                     the box's edge as the sliders move instead of growing in place. -->
                <Grid Width="{Binding ImageWidth}"
                      Height="{Binding ImageHeight}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Rectangle Width="{Binding ImageWidth}"
                               Height="{Binding ImageHeight}"
                               Fill="{Binding LiveImage}"
                               CornerRadius="{Binding ImageRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                               Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Rectangle}"/>
                    <Ellipse Width="{Binding ImageWidth}"
                             Height="{Binding ImageHeight}"
                             Fill="{Binding LiveImage}"
                             Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Ellipse}"/>
                    <!-- The polygon takes its shape from two numbers (below), so the same preview is a triangle, a
                         hexagon or a near-circle without a second control ever being touched. -->
                    <RegularPolygon Width="{Binding ImagePolygonSize}"
                             Height="{Binding ImagePolygonSize}"
                             Corners="{Binding ShapeCornerCount}"
                             StartAngle="{Binding ShapeStartAngle}"
                             Fill="{Binding LiveImage}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Polygon}"/>
                    <Polygon Points="{Binding ImageStar}"
                             Fill="{Binding LiveImage}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Star}"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                <!-- Only for the polygon: on a rect or an ellipse these two numbers mean nothing. -->
                <StackPanel Orientation="Vertical" Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Polygon}">
                    <TextBlock Text="Corners — 3 is a triangle, enough of them a circle" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="6">
                        <Slider Value="{Binding ShapeCorners, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="3" Maximum="24"
                                TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                        <NumericUpDown Width="88" Minimum="3" Maximum="24" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShapeCorners, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                    <TextBlock Text="Start angle — where corner 0 sits" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider Value="{Binding ShapeStartAngle, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360"
                                TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShapeStartAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Tile mode" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown ItemsSource="{Binding TileModes}" SelectedItem="{Binding ImageTileMode, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                <TextBlock Text="Stretch (only while Tile mode is None)" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown ItemsSource="{Binding Stretches}" SelectedItem="{Binding ImageStretch, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                <TextBlock Text="Tile size" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider Value="{Binding ImageTile, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="8" Maximum="160" Width="186"/>
                    <NumericUpDown Width="88" Minimum="8" Maximum="160" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding ImageTile, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                </StackPanel>
                <TextBlock Text="Width" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider Value="{Binding ImageWidth, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="340" Width="186"/>
                    <NumericUpDown Width="88" Minimum="40" Maximum="340" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding ImageWidth, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                </StackPanel>
                <TextBlock Text="Height" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider Value="{Binding ImageHeight, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="220" Width="186"/>
                    <NumericUpDown Width="88" Minimum="40" Maximum="220" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding ImageHeight, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                </StackPanel>
                <TextBlock Text="Corner radius" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider Value="{Binding ImageRadius, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="100" Width="186"/>
                    <NumericUpDown Width="88" Minimum="0" Maximum="100" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding ImageRadius, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                </StackPanel>
                <TextBlock Text="Grid rotation — turns the TILING" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider Value="{Binding ImageRotation, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360" Width="186"/>
                    <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding ImageRotation, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6"/>
                </StackPanel>
                <TextBlock Text="Tint" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding ImageTint, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</View>
