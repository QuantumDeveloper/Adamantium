<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- PropertyChangedBase (INPC base) + ICommand (the generated commands implement it) both live in Core, so this
             library is UI-free and safe to reference from any layer (e.g. Adamantium.ECS.Components). -->
        <ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
    </ItemGroup>

</Project>
