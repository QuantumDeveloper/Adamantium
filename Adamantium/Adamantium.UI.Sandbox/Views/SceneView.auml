<View x:KeepAlive="Required"
      xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors">
    <!-- DataContext is the SceneViewModel. The RenderTargetPanel runs the 3D universe as the backdrop; an overlay
         menu sits on top, shown/hidden via the view-model (a DataTrigger collapses it), and its buttons load models. -->
    <Grid>
        <RenderTargetPanel Background="#0B0E14" MouseLookMode="Drag" IsMouseLookEnabled="{Binding MouseLookEnabled}">
            <RenderTargetPanel.Behaviors>
                <behaviors:DemoUniverseBehavior/>
            </RenderTargetPanel.Behaviors>
        </RenderTargetPanel>

        <!-- Always-visible toggle in the corner, with the camera's travel speed under it. -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
            <Button Content="{Binding MenuButtonText}"
                    Command="{Binding ToggleMenuCommand}"
                    Width="120" Height="34"/>
            <TextBlock Text="Camera speed" MarginTop="10" MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <NumericUpDown Value="{Binding CameraSpeed, Mode=TwoWay}"
                           Width="120"
                           Minimum="0.01"
                           Maximum="100"
                           SmallChange="0.01"
                           LargeChange="0.1"
                           StringFormat="N2"/>
            <Button Content="Reset camera" Command="{Binding ResetCameraCommand}"
                    Width="120" Height="30" MarginTop="10"/>
            <TextBlock Text="Tool"
                       MarginTop="10"
                       MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <RadioButton Classes="Toggle"
                         GroupName="SceneTool"
                         Content="Select"
                         Width="120"
                         IsChecked="{Binding IsSelecting, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         GroupName="SceneTool"
                         Content="Move"
                         Width="120"
                         MarginTop="4"
                         IsChecked="{Binding IsMoving, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         GroupName="SceneTool"
                         Content="Rotate"
                         Width="120"
                         MarginTop="4"
                         IsChecked="{Binding IsRotating, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         GroupName="SceneTool"
                         Content="Scale"
                         Width="120"
                         MarginTop="4"
                         IsChecked="{Binding IsScaling, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         GroupName="SceneTool"
                         Content="Pivot"
                         Width="120"
                         MarginTop="4"
                         IsChecked="{Binding IsMovingPivot, Mode=TwoWay}"/>
        </StackPanel>

        <!-- What the UNIVERSE'S OWN rendering costs, opposite corner - not the rate the panel ticks it at, which would
             only ever report the interface back. -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
            <TextBlock Text="{Binding Fps, StringFormat='FPS: {0:F0}'}"
                       HorizontalAlignment="Right"
                       FontSize="18" Foreground="{ResourceReference TextFillColorPrimary}"/>
            <TextBlock Text="{Binding FrameCostMs, StringFormat='{0:F2} ms/frame'}"
                       HorizontalAlignment="Right" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
        </StackPanel>

        <!-- How to fly it, bottom-left. A world with no landmarks tells a person nothing about what the keyboard does,
             and the keys are the engine's (InputService), not this tab's - so they are stated, not guessed at. -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16">
            <TextBlock Text="WASD — move, mouse — look around"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <TextBlock Text="Q / E — up / down" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <TextBlock Text="Numpad + / − — double or halve the speed" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <TextBlock Text="F1 — free camera, F3 / F4 / F5 — follow the model" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
        </StackPanel>

        <!-- The overlay menu: collapsed when IsMenuVisible is false (declarative DataTrigger). Themed - a card surface with
             an accent outline, so it follows a theme/accent swap instead of hardcoded colours. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="280"
                Background="{ResourceReference CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource AccentFillColorDefault}" BorderThickness="1"
                CornerRadius="12" Padding="24">
            <Border.Triggers>
                <DataTrigger Binding="{Binding IsMenuVisible}" Value="false">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Border.Triggers>
            <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center">
                <TextBlock Text="MENU" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,16"
                           Foreground="{ResourceReference TextFillColorPrimary}"/>
                <Button Content="Continue" Command="{Binding ToggleMenuCommand}" Height="36" Margin="0,0,0,8"/>
                <Button Content="Load F-15" Command="{Binding LoadF15Command}" Height="36" Margin="0,0,0,8"/>
                <!-- No Swordman: it is a rigged model and character animation is not connected yet, so loading it
                     takes the application down. Bring the button back with the animation. -->
                <Button Content="Load Monkey" Command="{Binding LoadMonkeyCommand}" Height="36"/>
                <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Margin="0,16,0,0"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</View>
