<View xmlns="http://adamantium/ui">
    <!-- DataContext is the TabsViewModel. Two strips, each showing one thing a tab strip has to survive. -->
    <Grid RowDefinitions="Auto,*,Auto,*" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="A thousand tabs" FontSize="18"/>
            <TextBlock Margin="0,4,0,0"
                       Text="A virtualizing strip builds only the headers on screen. It needs a uniform slot to do it - slot n starts at n x TabWidth, so a tab that was never built still has an exact position. Turn it off and the same strip builds every tab: 2517ms of layout against 45ms."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="IsVirtualizing" IsChecked="{Binding IsVirtualizing, Mode=TwoWay}"/>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           Text="Off: every tab is built and sized to its own title - watch the strip go ragged, and the window with it."/>
            </StackPanel>
        </StackPanel>

        <!-- The long titles are the point: a uniform slot cannot grow to fit one, so the header trims with an ellipsis. -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding ManyTabs}"
                    IsVirtualizing="{Binding IsVirtualizing}"
                    TabWidth="220"
                    ShowCloseButton="True">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <!-- A template that brings its OWN TextBlock owns its trimming too: the presenter only stamps
                         TextTrimming on the label it generates itself, and this one is authored. -->
                    <TextBlock Text="{Binding Name}" TextTrimming="CharEllipses"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <TextBlock Margin="16" Text="{Binding Name}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,24,0,10">
            <TextBlock Text="A capped strip" FontSize="18"/>
            <TextBlock Margin="0,4,0,0"
                       Text="MaxOpenedTabs is a ceiling on how many tabs may be open at once. Past it the OLDEST-opened tab is closed to make room, the way an editor's strip works - never the tab just opened, never the one being read, and never a pinned one."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Max opened tabs:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <NumericUpDown Width="90" InputMode="Integers"
                               Minimum="0" Maximum="12" SmallChange="1"
                               Value="{Binding MaxOpenedTabs, Mode=TwoWay}"/>
                <TextBlock Text="0 turns the cap off" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Content="Open a tab" Command="{Binding AddTabCommand}" Height="32" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="3"
                    ItemsSource="{Binding FewTabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    MaxOpenedTabs="{Binding MaxOpenedTabs}"
                    ShowCloseButton="True">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <!-- A template that brings its OWN TextBlock owns its trimming too: the presenter only stamps
                         TextTrimming on the label it generates itself, and this one is authored. -->
                    <TextBlock Text="{Binding Name}" TextTrimming="CharEllipses"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <TextBlock Margin="16" Text="{Binding Name}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</View>
