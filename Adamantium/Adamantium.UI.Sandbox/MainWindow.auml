<Window
    	xmlns="http://adamantium/ui"
     	xmlns:x="http://adamantium/ui/xaml/extensions"        
		x:Namespace="Adamantium.UI.Sandbox.MainWindow"
        Title="Adamantium Window"
        Width="1280"
        Height="720"
        Background="{ResourceReference SolidBackgroundFillColorBase}"
        AnalyticAntialiasing="true">
    <RenderTargetPanel x:Name="TestGrid1">

        <ToggleSwitch Width="120"
                      VerticalAlignment="Center"
            HorizontalAlignment="Left"/>

        <Border Width="280"
                Height="155"
                Background="Red"
                HorizontalAlignment="Center"
                CornerRadius="100"
                BorderThickness="8"
                BorderBrush="Blue"
        />
    </RenderTargetPanel>
</Window>