<Project>

  <!-- The AUML source generator reads .auml through AdditionalFiles, but MSBuild's CoreCompile does not count those as
       inputs: editing a theme or a view left the build "up to date", so the app kept running the PREVIOUSLY generated
       code and a template change looked like it had no effect at all. CustomAdditionalCompileInputs is in CoreCompile's
       Inputs, which is what makes the incremental check honest. -->
  <ItemGroup>
    <CustomAdditionalCompileInputs Include="@(AdditionalFiles)" />
  </ItemGroup>

</Project>
