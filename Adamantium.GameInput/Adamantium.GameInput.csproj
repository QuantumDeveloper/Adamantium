<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <Description>Microsoft GameInput gamepads for the Adamantium engine, with the native shim that exposes the GameInput API to C#.</Description>
    <PackageTags>adamantium;gameinput;gamepad;input</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adamantium.Multiverse\Adamantium.Multiverse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Adamantium.EngineTests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="native\build\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- In the package the shim is a native runtime asset: the consumer's build copies it for the platform it runs on. -->
    <Content Include="gameinput-c-shared.dll" Condition="Exists('gameinput-c-shared.dll')" PackagePath="runtimes\win-x64\native">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuantumBinding.Utils" Version="3.0.1" />
  </ItemGroup>

</Project>
